// Cloudflare Workers config for opendj.app: serves the static site that
// build.sh writes to dist/. Workers Builds settings: root directory
// `website`, build command `./build.sh`, deploy command `npx wrangler deploy`.
{
  "name": "opendj",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
