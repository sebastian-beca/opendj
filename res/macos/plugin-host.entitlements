<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Plugins are signed by their own developers (or not at all), so the
       helper that loads them may load code from any team. Only the helper
       has this; openDJ itself keeps library validation. -->
  <key>com.apple.security.cs.disable-library-validation</key><true/>
  <!-- Some plugins generate code at run time (JIT, scripting engines). -->
  <key>com.apple.security.cs.allow-jit</key><true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key><true/>
</dict>
</plist>
