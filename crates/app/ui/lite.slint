// 2-Deck: the lighter two-deck layout. No jogs and no tempo faders: each
// deck is its header over one row with SYNC, the tempo, PLAY and CUE,
// beside a slim mixer. The pads and the loop sit in a bar under the decks
// that the PADS button shows (PadBar). A deck holding a Groove Box or an
// instrument shows the full deck instead (see main.slint), as in
// 2-Deck Pro.
import { Theme } from "theme.slint";
import { ControlButton, ControlFader, Controls, Crossfader, CueHeadphones, StereoMeter, SyncButton } from "controls.slint";
import { DeckInfo, Header, LoopSection, Pads, PlayButton, TempoStep } from "deck.slint";
import { Knob, ModeMenu, SideKnob } from "mixer.slint";
import { TempoMenu } from "fourdeck.slint";
import { TrackDrag } from "library.slint";
import { InstrumentsUi } from "instruments.slint";

// The heights of the row of decks and of the pad bar.
export global LiteUi {
    out property <length> deck-height: 176px;
    out property <length> bar-height: 104px;
}

// SYNC, the BPM with its tempo menu (key lock, quantize, reset) and fine
// − and +. Deck B is the mirror image.
component LiteTempo inherits HorizontalLayout {
    in property <string> group;
    in property <DeckInfo> info;
    in property <color> tint;
    in property <bool> mirrored;
    spacing: 10px;
    alignment: start;
    if mirrored: TempoStep { group: group; key: "rate_perm_down_small"; text: "−"; tint: tint; y: (parent.height - self.height) / 2; }
    if mirrored: VerticalLayout {
        width: 56px;
        alignment: center;
        Text { text: info.loaded ? info.bpm : "--"; color: Theme.text; font-size: 15px; font-weight: 600; horizontal-alignment: center; }
        TempoMenu { group: group; rate: info.rate; tint: tint; }
    }
    if mirrored: TempoStep { group: group; key: "rate_perm_up_small"; text: "+"; tint: tint; y: (parent.height - self.height) / 2; }
    SyncButton { group: group; tint: tint; menu-right-aligned: mirrored; font-size: 14px; width: 72px; height: 38px; y: (parent.height - self.height) / 2; tour-id: group + ",sync_enabled"; }
    if !mirrored: TempoStep { group: group; key: "rate_perm_down_small"; text: "−"; tint: tint; y: (parent.height - self.height) / 2; }
    if !mirrored: VerticalLayout {
        width: 56px;
        alignment: center;
        Text { text: info.loaded ? info.bpm : "--"; color: Theme.text; font-size: 15px; font-weight: 600; horizontal-alignment: center; }
        TempoMenu { group: group; rate: info.rate; tint: tint; }
    }
    if !mirrored: TempoStep { group: group; key: "rate_perm_up_small"; text: "+"; tint: tint; y: (parent.height - self.height) / 2; }
}

export component LiteDeck inherits Rectangle {
    in property <int> deck;
    in property <DeckInfo> info;
    in property <image> overview;
    in property <bool> mirrored: false;
    out property <length> overview-width: header.overview-width;
    out property <length> overview-height: header.overview-height;
    property <string> group: "[Channel" + (deck + 1) + "]";
    property <color> tint: Theme.deck-color(deck);
    // Files dragged in from Finder or a file manager (see TrackDrag.files-over).
    property <bool> under-files: TrackDrag.files-x >= self.absolute-position.x && TrackDrag.files-x < self.absolute-position.x + self.width
        && TrackDrag.files-y >= self.absolute-position.y && TrackDrag.files-y < self.absolute-position.y + self.height;
    property <bool> files-here: TrackDrag.files-over && under-files;
    property <int> files-dropped: TrackDrag.files-dropped;
    changed files-dropped => {
        if under-files {
            TrackDrag.drop-files(deck);
        }
    }
    drop := DropArea {
        can-drop(e) => { TrackDrag.accepts(e.data) || InstrumentsUi.item(e.data) >= 0 ? DragAction.copy : DragAction.none }
        dropped(e) => {
            if InstrumentsUi.item(e.data) >= 0 {
                InstrumentsUi.drop(deck, InstrumentsUi.item(e.data));
            } else {
                TrackDrag.drop(deck, e.data);
            }
            TrackDrag.active = false;
            InstrumentsUi.dragging = false;
            DragAction.copy
        }
    }
    VerticalLayout {
        spacing: 1px;
        header := Header { deck: deck; info: info; overview: overview; mirrored: mirrored; group: group; }
        Rectangle {
            background: Theme.panel;
            vertical-stretch: 1;
            // Outside in: SYNC and the tempo, then PLAY and CUE by the mixer,
            // centred in the room under the header.
            VerticalLayout {
            alignment: center;
            HorizontalLayout {
                height: 40px;
                padding-left: 10px;
                padding-right: 10px;
                spacing: 8px;
                if mirrored: PlayButton { group: group; tint: tint; width: 72px; height: 38px; y: (parent.height - self.height) / 2; tour-id: group + ",play"; }
                if mirrored: ControlButton { group: group; key: "cue_default"; text: "CUE"; momentary: true; tint: tint; outline-when-lit: true; font-size: 14px; width: 72px; height: 38px; y: (parent.height - self.height) / 2; }
                if mirrored: Rectangle { horizontal-stretch: 1; }
                LiteTempo { group: group; info: info; tint: tint; mirrored: mirrored; }
                if !mirrored: Rectangle { horizontal-stretch: 1; }
                if !mirrored: PlayButton { group: group; tint: tint; width: 72px; height: 38px; y: (parent.height - self.height) / 2; tour-id: group + ",play"; }
                if !mirrored: ControlButton { group: group; key: "cue_default"; text: "CUE"; momentary: true; tint: tint; outline-when-lit: true; font-size: 14px; width: 72px; height: 38px; y: (parent.height - self.height) / 2; }
            }
            }
        }
    }
    if TrackDrag.active || InstrumentsUi.dragging || TrackDrag.files-over || drop.has-drag: Rectangle {
        border-radius: Theme.radius + 2px;
        border-width: drop.has-drag || files-here ? 3px : 2px;
        border-color: drop.has-drag || files-here ? tint : tint.transparentize(0.55);
        background: drop.has-drag || files-here ? tint.transparentize(0.9) : transparent;
    }
}

// A channel by the meters: a small gain knob on top of a short fader.
component LiteChannel inherits VerticalLayout {
    in property <string> group;
    in property <color> tint;
    spacing: 2px;
    Knob { group: group; key: "pregain"; size: 16px; tour-id: group + ",pregain"; }
    HorizontalLayout {
        alignment: center;
        vertical-stretch: 1;
        ControlFader { group: group; key: "volume"; tint: tint; ticks: 7; width: 30px; tour-id: group + ",volume"; }
    }
}

// The four knobs down one side (EQ, stems or sculpt), smaller than in
// 2-Deck Pro.
component LiteSide inherits VerticalLayout {
    in property <int> deck;
    width: 46px;
    alignment: space-between;
    for place in 4: SideKnob { deck: deck; place: place; size: 16px; }
}

// The slim mixer: the knobs down the outsides, gain over each fader on the
// inner side, the headphone buttons and the knob mode over the meters, and
// the crossfader along the bottom. As wide as 2-Deck Pro's, so the Beat FX
// under it lines up.
export component LiteMixer inherits Rectangle {
    background: Theme.panel;
    width: 254px;
    VerticalLayout {
        padding: 6px;
        padding-top: 4px;
        spacing: 2px;
        HorizontalLayout {
            vertical-stretch: 1;
            LiteSide { deck: 0; }
            HorizontalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 4px;
                LiteChannel { group: "[Channel1]"; tint: Theme.deck1; }
                VerticalLayout {
                    spacing: 3px;
                    HorizontalLayout {
                        alignment: center;
                        spacing: 4px;
                        CueHeadphones { group: "[Channel1]"; tint: Theme.deck1; tour-id: "[Channel1],pfl"; }
                        CueHeadphones { group: "[Channel2]"; tint: Theme.deck2; tour-id: "[Channel2],pfl"; }
                    }
                    ModeMenu { height: 16px; }
                    HorizontalLayout {
                        alignment: center;
                        spacing: 4px;
                        vertical-stretch: 1;
                        StereoMeter { group: "[Channel1]"; }
                        StereoMeter { group: "[Channel2]"; }
                    }
                }
                LiteChannel { group: "[Channel2]"; tint: Theme.deck2; }
            }
            LiteSide { deck: 1; }
        }
        HorizontalLayout {
            padding-left: 48px;
            padding-right: 48px;
            Rectangle {
                horizontal-stretch: 1;
                height: 22px;
                Crossfader { x: 8px; width: parent.width - 16px; height: 22px; tour-id: "[Master],crossfader"; }
            }
        }
    }
}

// One deck's half of the pad bar: the pads (tabs over two rows of four, as
// on most controllers) and the loop on the mixer side.
component PadBarHalf inherits Rectangle {
    in property <int> deck;
    in property <DeckInfo> info;
    in property <bool> mirrored;
    property <string> group: "[Channel" + (deck + 1) + "]";
    property <color> tint: Theme.deck-color(deck);
    background: Theme.panel;
    horizontal-stretch: 1;
    min-width: 0px;
    HorizontalLayout {
        padding: 6px;
        padding-left: 8px;
        padding-right: 8px;
        spacing: 10px;
        if mirrored: LoopSection { group: group; info: info; tint: tint; mirrored: true; }
        Pads { deck: deck; group: group; info: info; horizontal-stretch: 1; }
        if !mirrored: LoopSection { group: group; info: info; tint: tint; }
    }
}

// The pad bar: deck 1's pads and loop | under the mixer | deck 2's.
export component PadBar inherits Rectangle {
    in property <[DeckInfo]> decks;
    background: #000000;
    HorizontalLayout {
        spacing: 1px;
        PadBarHalf { deck: 0; info: decks[0]; }
        Rectangle { background: Theme.panel; width: 254px; }
        PadBarHalf { deck: 1; info: decks[1]; mirrored: true; }
    }
}
