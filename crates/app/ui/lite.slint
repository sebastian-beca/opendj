// 2-Deck Basic: the lighter two-deck layout. No jogs and no tempo faders: each
// deck is its header over one row with SYNC, the tempo, PLAY and CUE,
// beside a slim mixer. The pads and the loop sit in a bar under the decks
// that the PADS button shows (PadBarHalf), with the mixer running down
// between its halves. A deck holding a Groove Box or an
// instrument shows the full deck instead (see main.slint), as in
// 2-Deck.
import { Theme } from "theme.slint";
import { ControlButton, ControlFader, Controls, Crossfader, CueHeadphones, StereoMeter, SyncButton } from "controls.slint";
import { DeckInfo, Header, Jog, LoopSection, Pads, PlayButton, TempoStep } from "deck.slint";
import { Knob, ModeMenu, SideKnob } from "mixer.slint";
import { TrackDrag } from "library.slint";
import { InstrumentsUi } from "instruments.slint";

// The heights of the row of decks and of the pad bar.
export global LiteUi {
    out property <length> deck-height: 176px;
    out property <length> bar-height: 104px;
    // JOG on the top bar: a jog on the mixer side of each deck, the full
    // height of the deck, with the header and overview narrower beside it.
    in-out property <bool> jogs: false;
}

// The BPM's menu in 2-Deck Basic: a short tempo slider with fine − and +, key
// lock, quantize and reset, then Edit BPM (halve, double, tap) for a track
// whose BPM was read wrong.
component LiteTempoMenu inherits Rectangle {
    in property <string> group;
    in property <DeckInfo> info;
    in property <color> tint;
    in property <bool> mirrored;
    property <int> rate-index: Controls.resolve(group, "rate");
    height: 14px;
    HorizontalLayout {
        alignment: center;
        spacing: 3px;
        Text { text: info.rate; color: ta.has-hover ? Theme.text : Theme.text-dim; font-size: 10px; vertical-alignment: center; }
        Path {
            width: 6px;
            height: 4px;
            y: (parent.height - self.height) / 2;
            commands: "M 0 0 L 3 3.5 L 6 0";
            stroke: ta.has-hover ? Theme.text : Theme.text-dim;
            stroke-width: 1.2px;
            fill: transparent;
        }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { menu.show(); } }
    menu := PopupWindow {
        x: mirrored ? root.width - 230px + 40px : -40px;
        y: root.height + 6px;
        width: 230px;
        close-policy: close-on-click-outside;
        Rectangle {
            background: Theme.panel-raised;
            border-radius: Theme.radius + 2px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 12px;
            drop-shadow-color: Theme.s-000000a0;
        }
        VerticalLayout {
            padding: 10px;
            spacing: 8px;
            HorizontalLayout {
                Text { text: "TEMPO"; color: Theme.text-dim; font-size: 10px; font-weight: 700; }
                Rectangle { horizontal-stretch: 1; }
                Text { text: info.loaded ? info.bpm + "   " + info.rate : info.rate; color: Theme.text; font-size: 11px; font-family: "Inter Tabular"; }
            }
            HorizontalLayout {
                spacing: 4px;
                height: 24px;
                TempoStep { group: group; key: "rate_perm_down_small"; text: "−"; tint: tint; y: (parent.height - self.height) / 2; }
                ControlFader {
                    horizontal-stretch: 1;
                    height: 24px;
                    group: group;
                    key: "rate";
                    vertical: false;
                    center-mark: true;
                    ticks: 9;
                    tint: tint;
                }
                TempoStep { group: group; key: "rate_perm_up_small"; text: "+"; tint: tint; y: (parent.height - self.height) / 2; }
            }
            HorizontalLayout {
                spacing: 6px;
                ControlButton { group: group; key: "keylock"; text: "KEY LOCK"; tint: tint; fill-when-lit: true; font-size: 11px; height: 26px; horizontal-stretch: 1; }
                ControlButton { group: group; key: "quantize"; text: "QUANTIZE"; tint: tint; fill-when-lit: true; font-size: 11px; height: 26px; horizontal-stretch: 1; }
            }
            Rectangle {
                height: 26px;
                border-radius: Theme.radius;
                background: rta.pressed ? Theme.control-pressed : rta.has-hover ? Theme.n-1d1d20 : Theme.control;
                border-width: 1px;
                border-color: Theme.border;
                Text { text: "RESET TEMPO"; color: Theme.text; font-size: 11px; font-weight: 700; }
                rta := TouchArea { clicked => { Controls.set-value(rate-index, 0); } }
            }
            Rectangle { height: 1px; background: Theme.border; }
            Text { text: "EDIT BPM"; color: Theme.text-dim; font-size: 10px; font-weight: 700; }
            HorizontalLayout {
                spacing: 6px;
                ControlButton { group: group; key: "beats_scale_half"; text: "/2"; momentary: true; tint: tint; font-size: 12px; height: 26px; width: 44px; }
                Rectangle {
                    horizontal-stretch: 1;
                    height: 26px;
                    border-radius: Theme.radius;
                    background: Theme.well;
                    Text { text: info.loaded ? info.bpm : "--"; color: Theme.text; font-size: 13px; font-weight: 600; font-family: "Inter Tabular"; }
                }
                ControlButton { group: group; key: "beats_scale_double"; text: "x2"; momentary: true; tint: tint; font-size: 12px; height: 26px; width: 44px; }
            }
            ControlButton { group: group; key: "bpm_tap"; text: "TAP"; momentary: true; tint: tint; font-size: 11px; height: 26px; }
        }
    }
}

// SYNC and the BPM with its menu (LiteTempoMenu), nothing else, as on
// djay. Deck B is the mirror image.
component LiteTempo inherits HorizontalLayout {
    in property <string> group;
    in property <DeckInfo> info;
    in property <color> tint;
    in property <bool> mirrored;
    spacing: 10px;
    alignment: start;
    if mirrored: VerticalLayout {
        width: 64px;
        alignment: center;
        Text { text: info.loaded ? info.bpm : "--"; color: Theme.text; font-size: 15px; font-weight: 600; horizontal-alignment: center; }
        LiteTempoMenu { group: group; info: info; tint: tint; mirrored: true; }
    }
    SyncButton { group: group; tint: tint; menu-right-aligned: mirrored; font-size: 14px; width: 72px; height: 38px; y: (parent.height - self.height) / 2; tour-id: group + ",sync_enabled"; }
    if !mirrored: VerticalLayout {
        width: 64px;
        alignment: center;
        Text { text: info.loaded ? info.bpm : "--"; color: Theme.text; font-size: 15px; font-weight: 600; horizontal-alignment: center; }
        LiteTempoMenu { group: group; info: info; tint: tint; }
    }
}

// With JOG on: the jog on the mixer side, as tall as the deck.
component LiteJog inherits Rectangle {
    in property <string> group;
    in property <DeckInfo> info;
    in property <color> tint;
    in property <angle> spin;
    background: Theme.panel;
    width: self.height;
    Jog {
        group: group;
        info: info;
        tint: tint;
        spin: spin;
        width: parent.height - 12px;
        height: self.width;
    }
}

export component LiteDeck inherits Rectangle {
    in property <int> deck;
    in property <DeckInfo> info;
    in property <image> overview;
    in property <bool> mirrored: false;
    in property <angle> spin;
    out property <length> overview-width: header.overview-width;
    out property <length> overview-height: header.overview-height;
    property <string> group: "[Channel" + (deck + 1) + "]";
    property <color> tint: Theme.deck-color(deck);
    // Files dragged in from Finder or a file manager (see TrackDrag.files-over).
    property <bool> under-files: TrackDrag.files-x >= self.absolute-position.x && TrackDrag.files-x < self.absolute-position.x + self.width
        && TrackDrag.files-y >= self.absolute-position.y && TrackDrag.files-y < self.absolute-position.y + self.height;
    property <bool> files-here: TrackDrag.files-over && under-files;
    property <int> files-dropped: TrackDrag.files-dropped;
    changed files-dropped => {
        if under-files {
            TrackDrag.drop-files(deck);
        }
    }
    drop := DropArea {
        can-drop(e) => { TrackDrag.accepts(e.data) || InstrumentsUi.item(e.data) >= 0 ? DragAction.copy : DragAction.none }
        dropped(e) => {
            if InstrumentsUi.item(e.data) >= 0 {
                InstrumentsUi.drop(deck, InstrumentsUi.item(e.data));
            } else {
                TrackDrag.drop(deck, e.data);
            }
            TrackDrag.active = false;
            InstrumentsUi.dragging = false;
            DragAction.copy
        }
    }
    HorizontalLayout {
        spacing: 1px;
        if mirrored && LiteUi.jogs: LiteJog { group: group; info: info; tint: tint; spin: spin; }
        VerticalLayout {
            spacing: 1px;
            horizontal-stretch: 1;
            header := Header { deck: deck; info: info; overview: overview; mirrored: mirrored; group: group; beat-counter: false; }
            Rectangle {
                background: Theme.panel;
                vertical-stretch: 1;
                // Outside in: SYNC and the tempo, then PLAY and CUE by the mixer,
                // centred in the room under the header.
                VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    height: 40px;
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;
                    if mirrored: PlayButton { group: group; tint: tint; width: 72px; height: 38px; y: (parent.height - self.height) / 2; tour-id: group + ",play"; }
                    if mirrored: ControlButton { group: group; key: "cue_default"; text: "CUE"; momentary: true; tint: tint; outline-when-lit: true; font-size: 14px; width: 72px; height: 38px; y: (parent.height - self.height) / 2; }
                    if mirrored: Rectangle { horizontal-stretch: 1; }
                    LiteTempo { group: group; info: info; tint: tint; mirrored: mirrored; }
                    if !mirrored: Rectangle { horizontal-stretch: 1; }
                    if !mirrored: PlayButton { group: group; tint: tint; width: 72px; height: 38px; y: (parent.height - self.height) / 2; tour-id: group + ",play"; }
                    if !mirrored: ControlButton { group: group; key: "cue_default"; text: "CUE"; momentary: true; tint: tint; outline-when-lit: true; font-size: 14px; width: 72px; height: 38px; y: (parent.height - self.height) / 2; }
                }
                }
            }
        }
        if !mirrored && LiteUi.jogs: LiteJog { group: group; info: info; tint: tint; spin: spin; }
    }
    if TrackDrag.active || InstrumentsUi.dragging || TrackDrag.files-over || drop.has-drag: Rectangle {
        border-radius: Theme.radius + 2px;
        border-width: drop.has-drag || files-here ? 3px : 2px;
        border-color: drop.has-drag || files-here ? tint : tint.transparentize(0.55);
        background: drop.has-drag || files-here ? tint.transparentize(0.9) : transparent;
    }
}

// A channel by the meters: a small gain knob on top of a short fader.
component LiteChannel inherits VerticalLayout {
    in property <string> group;
    in property <color> tint;
    in property <length> knob: 16px;
    spacing: 2px;
    Knob { group: group; key: "pregain"; size: knob; tour-id: group + ",pregain"; }
    HorizontalLayout {
        alignment: center;
        vertical-stretch: 1;
        ControlFader { group: group; key: "volume"; tint: tint; ticks: 7; width: 30px; tour-id: group + ",volume"; }
    }
}

// The four knobs down one side (EQ, stems or sculpt), smaller than in
// 2-Deck.
component LiteSide inherits VerticalLayout {
    in property <int> deck;
    in property <length> size: 16px;
    width: 46px;
    alignment: space-between;
    for place in 4: SideKnob { deck: deck; place: place; size: size; }
}

// The slim mixer: the knobs down the outsides, gain over each fader on the
// inner side, the headphone buttons and the knob mode over the meters, and
// the crossfader along the bottom. As wide as 2-Deck's, so the Beat FX
// under it lines up. Tall when the pads show: it then runs down between the
// two halves of the pad bar, with bigger knobs and longer faders.
export component LiteMixer inherits Rectangle {
    in property <bool> tall;
    property <length> knob: tall ? 22px : 16px;
    background: Theme.panel;
    width: 254px;
    VerticalLayout {
        padding: 6px;
        padding-top: 4px;
        spacing: 2px;
        HorizontalLayout {
            vertical-stretch: 1;
            LiteSide { deck: 0; size: knob; }
            HorizontalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 4px;
                LiteChannel { group: "[Channel1]"; tint: Theme.deck1; knob: knob; }
                VerticalLayout {
                    spacing: 3px;
                    HorizontalLayout {
                        alignment: center;
                        spacing: 4px;
                        CueHeadphones { group: "[Channel1]"; tint: Theme.deck1; tour-id: "[Channel1],pfl"; }
                        CueHeadphones { group: "[Channel2]"; tint: Theme.deck2; tour-id: "[Channel2],pfl"; }
                    }
                    ModeMenu { height: 16px; }
                    HorizontalLayout {
                        alignment: center;
                        spacing: 4px;
                        vertical-stretch: 1;
                        StereoMeter { group: "[Channel1]"; }
                        StereoMeter { group: "[Channel2]"; }
                    }
                }
                LiteChannel { group: "[Channel2]"; tint: Theme.deck2; knob: knob; }
            }
            LiteSide { deck: 1; size: knob; }
        }
        HorizontalLayout {
            padding-left: 48px;
            padding-right: 48px;
            Rectangle {
                horizontal-stretch: 1;
                height: 22px;
                Crossfader { x: 8px; width: parent.width - 16px; height: 22px; tour-id: "[Master],crossfader"; }
            }
        }
    }
}

// One deck's half of the pad bar, under that deck: the pads (tabs over two
// rows of four, as on most controllers) and the loop on the mixer side.
export component PadBarHalf inherits Rectangle {
    in property <int> deck;
    in property <DeckInfo> info;
    in property <bool> mirrored;
    property <string> group: "[Channel" + (deck + 1) + "]";
    property <color> tint: Theme.deck-color(deck);
    background: Theme.panel;
    horizontal-stretch: 1;
    min-width: 0px;
    HorizontalLayout {
        padding: 6px;
        padding-left: 8px;
        padding-right: 8px;
        spacing: 10px;
        if mirrored: LoopSection { group: group; info: info; tint: tint; mirrored: true; }
        Pads { deck: deck; group: group; info: info; horizontal-stretch: 1; }
        if !mirrored: LoopSection { group: group; info: info; tint: tint; }
    }
}
