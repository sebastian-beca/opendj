// The SAMPLER pad page, as djay Pro has it: a SAMPLE PACK menu under the
// pads, a pencil for edit mode (a level knob and "…" on each pad), and the
// Choose Sample popover. Sixteen slots, eight at a time: the 1/2 button on
// the outer side of the pads flips the deck's `sampler_page`.
import { LineEdit } from "std-widgets.slint";
import { ScrollView } from "scroll.slint";
import { Theme } from "theme.slint";
import { Controls, ControlKnob } from "controls.slint";

export struct SamplerPad {
    name: string,
    // Nothing on the slot: "+" opens Choose Sample.
    empty: bool,
    // Its file is gone.
    missing: bool,
}

export struct SamplePack {
    name: string,
    cover: image,
    has-cover: bool,
}

export struct SampleChoice {
    name: string,
    // "0:00.7"
    length: string,
}

export global SamplerUi {
    // The 16 slots, in order.
    in property <[SamplerPad]> pads;
    in property <[SamplePack]> packs;
    // The pack the pads play.
    in property <int> pack;
    in-out property <bool> editing;
    // Choose Sample: the pack it lists and its samples.
    in property <int> choose-pack;
    in property <[SampleChoice]> choices;
    callback pick-pack(index: int);
    callback new-pack(name: string);
    // Lists pack `index` in Choose Sample.
    callback browse(index: int);
    // Puts row `row` of the listed pack on slot `slot`.
    callback choose(slot: int, row: int);
    // Plays row `row` in the headphones.
    callback preview(row: int);
    callback load-file(slot: int);
    callback rename(slot: int, name: string);
    callback reset(slot: int);
    callback clear(slot: int);
    pure callback accepts(data: data-transfer) -> bool;
    // What dragging pad `slot` carries in edit mode.
    pure callback pad-payload(slot: int) -> data-transfer;
    callback drop(slot: int, data: data-transfer);
}

component PopupBackground inherits Rectangle {
    background: Theme.panel-raised;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.border;
    drop-shadow-blur: 16px;
    drop-shadow-color: #000000b0;
}

// A line in a pad's menu.
component MenuItem inherits Rectangle {
    in property <string> text;
    in property <bool> checked;
    in property <bool> enabled: true;
    callback clicked();
    height: 24px;
    border-radius: 5px;
    background: ta.has-hover && enabled ? #3a3a3d : transparent;
    Text {
        x: 22px;
        text: root.text;
        color: enabled ? Theme.text : Theme.text-dim;
        font-size: 12px;
        vertical-alignment: center;
    }
    if checked: Text { x: 7px; text: "✓"; color: Theme.accent; font-size: 12px; vertical-alignment: center; }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component MenuSeparator inherits Rectangle {
    height: 9px;
    Rectangle { y: 4px; height: 1px; background: Theme.separator; }
}

// A pack's cover, or its initial on lilac.
component PackCover inherits Rectangle {
    in property <SamplePack> pack;
    width: 28px;
    height: 28px;
    border-radius: 6px;
    clip: true;
    background: Theme.lilac.darker(0.35);
    if pack.has-cover: Image { width: parent.width; height: parent.height; source: pack.cover; image-fit: cover; }
    if !pack.has-cover: Text { text: pack.name == "" ? "" : "♪"; color: Theme.text; font-size: 14px; }
}

// The pack menu: every pack with its cover, + for a new one, and Get more
// Packs at the bottom.
component PackMenu inherits Rectangle {
    callback picked();
    callback add();
    width: 250px;
    VerticalLayout {
        padding: 10px;
        spacing: 2px;
        HorizontalLayout {
            height: 32px;
            Text { text: "Sample Packs"; color: Theme.text; font-size: 15px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
            Rectangle {
                width: 28px;
                border-radius: 6px;
                background: plus.has-hover ? #3a3a3d : transparent;
                Text { text: "+"; color: Theme.text; font-size: 20px; }
                plus := TouchArea { clicked => { root.add(); } }
            }
        }
        ScrollView {
            height: min(SamplerUi.packs.length * 38px, 300px);
            VerticalLayout {
                for p[i] in SamplerUi.packs: Rectangle {
                    height: 38px;
                    border-radius: 6px;
                    background: i == SamplerUi.pack ? Theme.selection : pta.has-hover ? #3a3a3d : transparent;
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        spacing: 10px;
                        PackCover { pack: p; y: 5px; }
                        Text { text: p.name; color: i == SamplerUi.pack ? Theme.on-row-selection : Theme.text; font-size: 13px; vertical-alignment: center; overflow: elide; }
                    }
                    pta := TouchArea {
                        clicked => {
                            SamplerUi.pick-pack(i);
                            root.picked();
                        }
                    }
                }
            }
        }
        Rectangle { height: 6px; }
        Rectangle {
            height: 32px;
            border-radius: 7px;
            background: #3a3a3d;
            Text { text: "Get more Packs · soon"; color: Theme.text-dim; font-size: 13px; font-weight: 600; }
        }
    }
}

// SAMPLE PACK, the pack's name with a menu, and the edit pencil.
component PackBar inherits Rectangle {
    height: 20px;
    background: Theme.well;
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 2px;
        spacing: 6px;
        Text { text: "SAMPLE PACK"; color: Theme.text-dim; font-size: 9px; font-weight: 600; letter-spacing: 0.5px; vertical-alignment: center; }
        Rectangle {
            horizontal-stretch: 1;
            min-width: 0px;
            border-radius: 4px;
            background: name-ta.has-hover ? #1d1d20 : transparent;
            HorizontalLayout {
                spacing: 4px;
                alignment: start;
                Text {
                    text: SamplerUi.pack >= 0 && SamplerUi.pack < SamplerUi.packs.length ? SamplerUi.packs[SamplerUi.pack].name : "";
                    color: Theme.text;
                    font-size: 11px;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Text { text: "▾"; color: Theme.text-dim; font-size: 10px; vertical-alignment: center; }
            }
            name-ta := TouchArea { clicked => { packs.show(); } }
        }
        Rectangle {
            width: 24px;
            border-radius: 4px;
            background: SamplerUi.editing ? Theme.accent.with-alpha(0.25) : edit-ta.has-hover ? #1d1d20 : transparent;
            // A pencil.
            Path {
                width: 11px;
                height: 11px;
                viewbox-width: 12;
                viewbox-height: 12;
                fill: SamplerUi.editing ? Theme.accent : Theme.text-dim;
                commands: "M 8.5 0.8 L 11.2 3.5 L 4 10.7 L 0.8 11.2 L 1.3 8 Z";
            }
            edit-ta := TouchArea { clicked => { SamplerUi.editing = !SamplerUi.editing; } }
        }
    }
    packs := PopupWindow {
        x: 70px;
        y: root.height + 2px;
        width: 250px;
        close-policy: close-on-click-outside;
        PopupBackground {}
        PackMenu {
            picked => { packs.close(); }
            add => {
                packs.close();
                new-pack.show();
            }
        }
    }
    new-pack := PopupWindow {
        x: 70px;
        y: root.height + 2px;
        width: 250px;
        close-policy: close-on-click-outside;
        PopupBackground {}
        VerticalLayout {
            padding: 10px;
            spacing: 6px;
            Text { text: "New sample pack"; color: Theme.text; font-size: 13px; font-weight: 600; }
            LineEdit {
                placeholder-text: "Name";
                accepted(t) => {
                    if t != "" {
                        SamplerUi.new-pack(t);
                    }
                    new-pack.close();
                }
                init => { self.focus(); }
            }
        }
    }
}

// One sampler pad: plays its slot, lit while it plays. Right-click (or "…"
// in edit mode) opens its menu; files and tracks can be dropped on it.
component SamplerPadCell inherits Rectangle {
    in property <int> slot;
    in property <SamplerPad> pad;
    in property <color> tint;
    property <string> group: "[Sampler" + (slot + 1) + "]";
    property <int> go-index: Controls.resolve(group, "cue_gotoandplay");
    property <int> stop-index: Controls.resolve(group, "cue_gotoandstop");
    property <int> mode-index: Controls.resolve(group, "play_mode");
    property <int> mode: Controls.value(mode-index, Controls.tick);
    property <bool> lit: Controls.value(Controls.resolve(group, "play_indicator"), Controls.tick) > 0;
    // The press under way stops the sample (Shift) rather than playing it.
    property <bool> stopping;
    property <string> rename-text;
    background: drop.has-drag ? Theme.accent.with-alpha(0.25)
        : touch.pressed ? Theme.control-pressed : lit ? tint.with-alpha(0.18) : touch.has-hover ? #1d1d20 : Theme.control;
    border-width: drop.has-drag ? 1px : 0px;
    border-color: Theme.accent;
    // First, so the knob and "…" in edit mode sit above it. In edit mode a
    // pad can be dragged onto another to swap them.
    DragArea {
        enabled: SamplerUi.editing && !pad.empty;
        data: SamplerUi.pad-payload(slot);
        allow-copy: true;
    touch := TouchArea {
        pointer-event(e) => {
            if e.button == PointerEventButton.right && e.kind == PointerEventKind.down {
                menu.show();
                return;
            }
            if e.button != PointerEventButton.left {
                return;
            }
            if e.kind == PointerEventKind.down {
                if pad.empty || pad.missing {
                    SamplerUi.browse(SamplerUi.pack);
                    choose.show();
                } else if e.modifiers.shift {
                    stopping = true;
                    Controls.set-value(stop-index, 1);
                } else {
                    Controls.set-value(go-index, 1);
                }
            } else if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                if stopping {
                    stopping = false;
                    Controls.set-value(stop-index, 0);
                } else {
                    Controls.set-value(go-index, 0);
                }
            }
        }
    }
    }
    HorizontalLayout {
        padding-left: SamplerUi.editing ? 2px : 4px;
        padding-right: SamplerUi.editing ? 0px : 4px;
        spacing: 2px;
        if SamplerUi.editing && !pad.empty: ControlKnob {
            group: root.group;
            key: "pregain";
            size: 14px;
            bipolar: true;
            y: (parent.height - self.height) / 2;
        }
        Text {
            horizontal-stretch: 1;
            min-width: 0px;
            text: pad.empty ? "+" : pad.missing ? "! " + pad.name : pad.name;
            color: pad.empty || pad.missing ? Theme.text-dim : lit ? tint : Theme.text;
            font-size: pad.empty ? 15px : 12px;
            font-weight: pad.empty ? 400 : 700;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
        if SamplerUi.editing: Rectangle {
            width: 18px;
            border-radius: 9px;
            background: dots.has-hover ? #3a3a3d : transparent;
            Text { text: "•••"; color: Theme.text-dim; font-size: 7px; }
            dots := TouchArea { clicked => { menu.show(); } }
        }
    }
    drop := DropArea {
        can-drop(e) => { SamplerUi.accepts(e.data) ? DragAction.copy : DragAction.none }
        dropped(e) => {
            SamplerUi.drop(slot, e.data);
            DragAction.copy
        }
    }
    menu := PopupWindow {
        x: 0px;
        y: root.height + 2px;
        width: 190px;
        close-policy: close-on-click-outside;
        PopupBackground {}
        VerticalLayout {
            padding: 5px;
            MenuItem {
                text: "Choose Sample…";
                clicked => {
                    menu.close();
                    SamplerUi.browse(SamplerUi.pack);
                    choose.show();
                }
            }
            MenuItem {
                text: pad.missing ? "Locate File…" : "Load File…";
                clicked => {
                    menu.close();
                    SamplerUi.load-file(slot);
                }
            }
            MenuItem {
                text: "Rename…";
                enabled: !pad.empty;
                clicked => {
                    menu.close();
                    rename-text = pad.name;
                    rename.show();
                }
            }
            MenuSeparator {}
            for name[m] in ["One shot", "Hold", "On/Off", "Loop"]: MenuItem {
                text: name;
                checked: mode == m;
                clicked => {
                    // Before closing, which ends this row.
                    Controls.set-value(mode-index, m);
                    menu.close();
                }
            }
            MenuSeparator {}
            MenuItem {
                text: "Reset to Pack Sample";
                clicked => {
                    menu.close();
                    SamplerUi.reset(slot);
                }
            }
            MenuItem {
                text: "Clear";
                enabled: !pad.empty;
                clicked => {
                    menu.close();
                    SamplerUi.clear(slot);
                }
            }
        }
    }
    rename := PopupWindow {
        x: 0px;
        y: root.height + 2px;
        width: 200px;
        close-policy: close-on-click-outside;
        PopupBackground {}
        VerticalLayout {
            padding: 10px;
            spacing: 6px;
            Text { text: "Pad name"; color: Theme.text-dim; font-size: 12px; }
            LineEdit {
                text <=> rename-text;
                accepted(t) => {
                    if t != "" {
                        SamplerUi.rename(slot, t);
                    }
                    rename.close();
                }
                init => {
                    self.focus();
                    self.select-all();
                }
            }
        }
    }
    // Choose Sample, above the pad as in djay.
    choose := PopupWindow {
        property <bool> picking-pack;
        x: (root.width - 270px) / 2;
        y: -334px;
        width: 270px;
        height: 330px;
        close-policy: close-on-click-outside;
        PopupBackground {}
        VerticalLayout {
            padding: 12px;
            spacing: 8px;
            Text { text: "Choose Sample"; color: Theme.text; font-size: 15px; font-weight: 700; height: 22px; }
            Rectangle {
                height: 28px;
                border-radius: 6px;
                background: pick-ta.has-hover ? #48484c : #3a3a3d;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    Text {
                        horizontal-stretch: 1;
                        text: SamplerUi.choose-pack >= 0 && SamplerUi.choose-pack < SamplerUi.packs.length ? SamplerUi.packs[SamplerUi.choose-pack].name : "";
                        color: Theme.text;
                        font-size: 13px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Text { text: choose.picking-pack ? "▴" : "▾"; color: Theme.text-dim; font-size: 12px; vertical-alignment: center; }
                }
                pick-ta := TouchArea { clicked => { choose.picking-pack = !choose.picking-pack; } }
            }
            if choose.picking-pack: ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    for p[i] in SamplerUi.packs: Rectangle {
                        height: 30px;
                        border-radius: 5px;
                        background: i == SamplerUi.choose-pack ? Theme.selection : ppta.has-hover ? #3a3a3d : transparent;
                        Text { x: 10px; text: p.name; color: Theme.text; font-size: 13px; vertical-alignment: center; overflow: elide; }
                        ppta := TouchArea {
                            clicked => {
                                SamplerUi.browse(i);
                                choose.picking-pack = false;
                            }
                        }
                    }
                }
            }
            if !choose.picking-pack: ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    for c[i] in SamplerUi.choices: Rectangle {
                        height: 30px;
                        border-radius: 5px;
                        background: cta.has-hover ? #3a3a3d : transparent;
                        HorizontalLayout {
                            padding-left: 4px;
                            padding-right: 10px;
                            spacing: 8px;
                            Rectangle {
                                width: 24px;
                                Rectangle {
                                    width: 20px;
                                    height: 20px;
                                    border-radius: 10px;
                                    border-width: 1.5px;
                                    border-color: play-ta.has-hover ? Theme.accent : Theme.text;
                                    Path {
                                        x: 7px;
                                        width: 7px;
                                        height: 8px;
                                        viewbox-width: 7;
                                        viewbox-height: 8;
                                        fill: play-ta.has-hover ? Theme.accent : Theme.text;
                                        commands: "M 0 0 L 7 4 L 0 8 Z";
                                    }
                                }
                                play-ta := TouchArea { clicked => { SamplerUi.preview(i); } }
                            }
                            Text { horizontal-stretch: 1; text: c.name; color: Theme.text; font-size: 13px; vertical-alignment: center; overflow: elide; }
                            Text { text: c.length; color: Theme.text-dim; font-size: 12px; font-family: "Inter Tabular"; vertical-alignment: center; }
                        }
                        cta := TouchArea {
                            // Leaves the play button to its own area.
                            x: 30px;
                            width: parent.width - 30px;
                            clicked => {
                                SamplerUi.choose(slot, i);
                                choose.close();
                            }
                        }
                    }
                    if SamplerUi.choices.length == 0: Text {
                        height: 40px;
                        text: "This pack is empty.";
                        color: Theme.text-dim;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
            Rectangle {
                height: 28px;
                border-radius: 6px;
                background: file-ta.has-hover ? #48484c : #3a3a3d;
                Text { text: "From File…"; color: Theme.text; font-size: 13px; font-weight: 600; }
                file-ta := TouchArea {
                    clicked => {
                        choose.close();
                        SamplerUi.load-file(slot);
                    }
                }
            }
        }
    }
}

// The 1/2 page button: two halves, the deck's page lit lilac.
component PageButton inherits Rectangle {
    in property <string> group;
    property <int> index: Controls.resolve(group, "sampler_page");
    property <int> page: Controls.value(index, Controls.tick);
    width: 18px;
    background: #000000;
    VerticalLayout {
        spacing: 1px;
        for p in 2: Rectangle {
            vertical-stretch: 1;
            background: page == p ? Theme.accent.with-alpha(0.22) : pta.has-hover ? #1d1d20 : Theme.control;
            Text { text: p + 1; color: page == p ? Theme.accent : Theme.text-dim; font-size: 11px; font-weight: 700; }
            pta := TouchArea { clicked => { Controls.set-value(index, p); } }
        }
    }
}

// The SAMPLER page of a deck's pads.
export component SamplerPanel inherits VerticalLayout {
    in property <int> deck;
    in property <string> group;
    // The 1/2 button sits on the outer side: left on decks 1 and 3.
    property <bool> left-side: mod(deck, 2) == 0;
    property <int> page: Controls.value(Controls.resolve(group, "sampler_page"), Controls.tick);
    spacing: 0px;
    Rectangle {
        vertical-stretch: 1;
        background: #000000;
        border-width: 1px;
        border-color: #000000;
        HorizontalLayout {
            padding: 1px;
            spacing: 1px;
            if left-side: PageButton { group: group; }
            VerticalLayout {
                spacing: 1px;
                horizontal-stretch: 1;
                for row in [0, 1]: HorizontalLayout {
                    spacing: 1px;
                    min-height: 26px;
                    vertical-stretch: 1;
                    for i in 4: SamplerPadCell {
                        slot: page * 8 + row * 4 + i;
                        pad: SamplerUi.pads[page * 8 + row * 4 + i];
                        tint: Theme.hotcues[row * 4 + i];
                        horizontal-stretch: 1;
                        min-width: 0px;
                        preferred-width: 0px;
                    }
                }
            }
            if !left-side: PageButton { group: group; }
        }
    }
    // Under the pads, so the tabs sit right on them.
    PackBar {}
}
