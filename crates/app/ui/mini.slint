// The mini player: a small square window of album art, on top of the
// others, for when openDJ plays in the background. Nothing covers the art
// until the pointer comes in; then the art dims and ✕ (back to the main
// window), the title, artist, progress and transport show over it, as in
// other music players' mini players.
//
// It has no title bar: drag the art to move it, and the corner grip to
// resize it (it stays square). It is its own window, so it shares no
// globals with the main one: mini_player.rs copies what is playing into
// its properties and runs its buttons on the main window.
import { Theme } from "theme.slint";

component MiniButton inherits Rectangle {
    in property <bool> enabled: true;
    in property <string> icon;
    in property <bool> filled: true;
    in property <length> glyph: 16px;
    in property <brush> rest: transparent;
    callback clicked();
    width: 34px;
    height: 34px;
    border-radius: self.width / 2;
    background: enabled && ta.has-hover ? #ffffff26 : rest;
    Path {
        width: glyph;
        height: glyph;
        viewbox-width: 18;
        viewbox-height: 18;
        fill: filled ? (enabled ? #ffffffe6 : #ffffff55) : transparent;
        stroke: filled ? transparent : (enabled ? #ffffffe6 : #ffffff55);
        stroke-width: filled ? 0px : 1.8px;
        commands: icon;
    }
    ta := TouchArea {
        mouse-cursor: enabled ? pointer : default;
        clicked => {
            if enabled {
                root.clicked();
            }
        }
    }
}

component MiniPlay inherits Rectangle {
    in property <bool> playing;
    in property <length> size: 44px;
    callback clicked();
    width: size;
    height: size;
    border-radius: size / 2;
    background: ta.pressed ? #d0d0d4 : #ffffff;
    if playing: Path {
        width: size * 0.4;
        height: size * 0.4;
        viewbox-width: 16;
        viewbox-height: 16;
        fill: #111113;
        commands: "M 3 2 L 6 2 L 6 14 L 3 14 Z M 10 2 L 13 2 L 13 14 L 10 14 Z";
    }
    if !playing: Path {
        x: size * 0.33;
        width: size * 0.4;
        height: size * 0.4;
        viewbox-width: 16;
        viewbox-height: 16;
        fill: #111113;
        commands: "M 2 1 L 15 8 L 2 15 Z";
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component MiniPlayer inherits Window {
    in property <string> track-title: "Nothing playing";
    in property <string> artist;
    in property <image> art-image;
    in property <bool> has-cover;
    in property <string> initials;
    in property <color> tint: #1d7bff;
    in property <bool> loaded;
    in property <bool> playing;
    // How far through the track, 0 to 1, and Automix's next mix (both 0
    // when none), as fractions of the track.
    in property <float> progress;
    in property <float> mix-from;
    in property <float> mix-to;
    // "NEXT IN 0:42" when Automix has a next track.
    in property <string> next-in;
    in property <bool> can-next;
    callback play-pause();
    callback previous();
    callback next();
    callback seek(float);
    // Back to the main window.
    callback expand();
    // A press on the art: the window moves with the pointer.
    callback start-move();
    // A press on the corner grip: the window resizes with the pointer.
    callback start-resize();
    title: "openDJ";
    no-frame: true;
    always-on-top: true;
    background: #161819;
    min-width: 200px;
    min-height: 200px;
    preferred-width: 300px;
    preferred-height: 300px;
    property <string> prev-icon: "M 2 3 L 4 3 L 4 15 L 2 15 Z M 15 3 L 6 9 L 15 15 Z";
    property <string> next-icon: "M 14 3 L 16 3 L 16 15 L 14 15 Z M 3 3 L 12 9 L 3 15 Z";
    property <string> close-icon: "M 4 4 L 14 14 M 14 4 L 4 14";
    property <length> side: min(root.width, root.height);

    // The art fills the window.
    Rectangle {
        clip: true;
        background: loaded ? @linear-gradient(135deg, tint 0%, tint.darker(0.6) 55%, #101012 100%) : #232428;
        if !has-cover: Text {
            text: loaded ? initials : "♪";
            color: #ffffffd0;
            font-size: side / 3;
            font-weight: 700;
        }
        if has-cover: Image { width: parent.width; height: parent.height; source: art-image; image-fit: cover; }
    }

    // The pointer anywhere on the window. The controls are inside it, so
    // it stays hovered while the pointer is on a button. A press on the
    // art itself moves the window.
    hover := TouchArea {
        pointer-event(e) => {
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                start-move();
            }
        }

        Rectangle {
            opacity: hover.has-hover ? 1 : 0;
            animate opacity { duration: 120ms; }
            background: #0000008c;

            // ✕: back to the main window.
            MiniButton {
                x: 10px;
                y: 10px;
                width: 36px;
                height: 36px;
                icon: close-icon;
                filled: false;
                glyph: 15px;
                rest: #ffffff1a;
                clicked => { expand(); }
            }

            VerticalLayout {
                y: root.height - self.height - 14px;
                height: self.preferred-height;
                padding-left: 18px;
                padding-right: 18px;
                spacing: 2px;
                Text { text: root.track-title; color: #ffffff; font-size: clamp(side / 16, 15px, 26px); font-weight: 700; overflow: elide; }
                Text { text: root.artist; color: #e2e0ea; font-size: clamp(side / 22, 12px, 19px); overflow: elide; }
                if next-in != "": Text { text: next-in; color: Theme.accent; font-size: 11px; font-weight: 600; }
                // The progress line: white, lilac under the pointer; a
                // click jumps there.
                Rectangle {
                    height: 20px;
                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        height: line-ta.has-hover ? 5px : 4px;
                        border-radius: self.height / 2;
                        background: #ffffff40;
                        clip: true;
                        if mix-to > mix-from: Rectangle { x: parent.width * mix-from; width: parent.width * (mix-to - mix-from); background: #8a78c8; }
                        Rectangle { x: 0; width: parent.width * clamp(progress, 0, 1); background: line-ta.has-hover ? Theme.accent : #ffffff; }
                    }
                    line-ta := TouchArea {
                        enabled: loaded;
                        mouse-cursor: pointer;
                        clicked => { seek(clamp(self.mouse-x / self.width, 0, 1)); }
                    }
                }
                HorizontalLayout {
                    alignment: center;
                    spacing: 24px;
                    VerticalLayout { alignment: center; MiniButton { icon: prev-icon; enabled: loaded; clicked => { previous(); } } }
                    MiniPlay { playing: playing; clicked => { play-pause(); } }
                    VerticalLayout { alignment: center; MiniButton { icon: next-icon; enabled: can-next; clicked => { next(); } } }
                }
            }

            // The corner grip: drag to resize (the window stays square).
            Rectangle {
                x: root.width - self.width;
                y: root.height - self.height;
                width: 18px;
                height: 18px;
                Path {
                    width: 10px;
                    height: 10px;
                    viewbox-width: 10;
                    viewbox-height: 10;
                    stroke: #ffffff80;
                    stroke-width: 1.2px;
                    commands: "M 9 3 L 3 9 M 9 6 L 6 9";
                }
                TouchArea {
                    mouse-cursor: nwse-resize;
                    pointer-event(e) => {
                        if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                            start-resize();
                        }
                    }
                }
            }
        }
    }
}
