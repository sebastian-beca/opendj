// openDJ Layouts: the DJ's layouts (the ones the layout menu offers) and
// Settings › Layouts, where they're added, taken out and reordered. Filled
// by layouts.rs.
import { Theme } from "theme.slint";

export struct LayoutEntry {
    // The value of `layout`: 0 2-Deck Pro, 1 Player, 2 4-Deck, 3 Prep,
    // 4 2-Deck.
    layout: int,
    name: string,
    // What it's for, on Settings › Layouts.
    detail: string,
}

export global LayoutsUi {
    // The layout menu's rows: the DJ's layouts, and the one in use if it
    // isn't one of them.
    in property <[LayoutEntry]> menu;
    // Your layouts, in menu order.
    in property <[LayoutEntry]> mine;
    // The other layouts, under More layouts.
    in property <[LayoutEntry]> more;
    // The layout showing.
    in property <int> current;
    // Switch to a layout.
    callback pick(layout: int);
    callback add(layout: int);
    callback remove(layout: int);
    // Moves a layout `by` places in the list: −1 up, 1 down.
    callback move(layout: int, by: int);
    // Opens Settings › Layouts (the cog in the layout menu).
    callback edit();
}

// A part of a preview, on a 160 x 100 grid scaled to the preview's size.
component Part inherits Rectangle {
    in property <length> pw;
    in property <length> ph;
    in property <float> gx;
    in property <float> gy;
    in property <float> gw;
    in property <float> gh;
    x: pw * gx / 160;
    y: ph * gy / 100;
    width: pw * gw / 160;
    height: ph * gh / 100;
}

// A scrolling waveform strip in a deck's color.
component WavePart inherits Part {
    in property <color> tint;
    background: tint.with-alpha(0.16);
    Rectangle {
        y: parent.height * 0.3;
        height: parent.height * 0.4;
        background: tint.with-alpha(0.55);
        border-radius: 1px;
    }
}

// A jog wheel.
component JogPart inherits Part {
    in property <color> tint;
    background: #2c2c30;
    border-radius: self.width / 2;
    border-width: 1px;
    border-color: tint;
}

// Eight pads, 2 rows of 4.
component PadsPart inherits Part {
    in property <color> tint;
    for i in 8: Rectangle {
        x: parent.width * (Math.mod(i, 4) * 0.25);
        y: parent.height * (i < 4 ? 0 : 0.52);
        width: parent.width * 0.21;
        height: parent.height * 0.44;
        border-radius: 1px;
        background: tint.with-alpha(0.45);
    }
}

// The library: the sidebar and track rows, one picked.
component LibraryPart inherits Part {
    property <int> rows: Math.max(1, Math.floor(root.gh / 7));
    Rectangle { x: 0; width: parent.width * 30 / 160; background: Theme.panel; }
    for i in rows: Rectangle {
        x: parent.width * 32 / 160;
        y: parent.height * (i * 7) / root.gh;
        width: parent.width * 128 / 160;
        height: parent.height * 6 / root.gh;
        background: i == 1 ? Theme.selection : Math.mod(i, 2) == 1 ? Theme.row-alt : Theme.row;
    }
}

// A drawing of layout `kind` in the theme's colors, so it follows the look
// and never goes stale like a screenshot would.
export component LayoutPreview inherits Rectangle {
    in property <int> kind;
    property <length> pw: self.width;
    property <length> ph: self.height;
    background: Theme.background;
    border-radius: 4px;
    clip: true;
    // The top bar with the layout pill.
    Part { pw: root.pw; ph: root.ph; gx: 0; gy: 0; gw: 160; gh: 7; background: Theme.panel; }
    Part { pw: root.pw; ph: root.ph; gx: 3; gy: 1.5; gw: 22; gh: 4; background: #2c2c30; border-radius: 2px; }
    // Player: the library, and the bar along the bottom.
    if kind == 1: Part { pw: root.pw; ph: root.ph; gx: 50; gy: 1.5; gw: 60; gh: 4; background: #2c2c30; border-radius: 2px; }
    if kind == 1: LibraryPart { pw: root.pw; ph: root.ph; gx: 0; gy: 9; gw: 160; gh: 74; }
    if kind == 1: Part { pw: root.pw; ph: root.ph; gx: 0; gy: 85; gw: 160; gh: 15; background: Theme.panel; }
    if kind == 1: Part { pw: root.pw; ph: root.ph; gx: 3; gy: 87; gw: 11; gh: 11; background: Theme.accent.with-alpha(0.7); border-radius: 1px; }
    if kind == 1: Part { pw: root.pw; ph: root.ph; gx: 17; gy: 89; gw: 30; gh: 2.5; background: Theme.text; }
    if kind == 1: Part { pw: root.pw; ph: root.ph; gx: 17; gy: 94; gw: 20; gh: 2; background: Theme.text-dim; }
    if kind == 1: Part { pw: root.pw; ph: root.ph; gx: 77; gy: 86.5; gw: 6; gh: 6; background: Theme.text; border-radius: self.height / 2; }
    if kind == 1: Part { pw: root.pw; ph: root.ph; gx: 55; gy: 96; gw: 50; gh: 1; background: Theme.text-dim; }
    // 2-Deck Pro: waveforms, full decks with pads and jogs, the mixer.
    if kind == 0: WavePart { pw: root.pw; ph: root.ph; gx: 0; gy: 8; gw: 160; gh: 9; tint: Theme.deck1; }
    if kind == 0: WavePart { pw: root.pw; ph: root.ph; gx: 0; gy: 18; gw: 160; gh: 9; tint: Theme.deck2; }
    if kind == 0: Part { pw: root.pw; ph: root.ph; gx: 0; gy: 28; gw: 160; gh: 30; background: Theme.panel; }
    if kind == 0: PadsPart { pw: root.pw; ph: root.ph; gx: 4; gy: 34; gw: 24; gh: 12; tint: Theme.deck1; }
    if kind == 0: JogPart { pw: root.pw; ph: root.ph; gw: 22 * 1.6 * root.ph / root.pw; gx: 48 - self.gw / 2; gy: 32; gh: 22; tint: Theme.deck1; }
    if kind == 0: PadsPart { pw: root.pw; ph: root.ph; gx: 132; gy: 34; gw: 24; gh: 12; tint: Theme.deck2; }
    if kind == 0: JogPart { pw: root.pw; ph: root.ph; gw: 22 * 1.6 * root.ph / root.pw; gx: 112 - self.gw / 2; gy: 32; gh: 22; tint: Theme.deck2; }
    if kind == 0: Part { pw: root.pw; ph: root.ph; gx: 66; gy: 30; gw: 28; gh: 26; background: #2c2c30; }
    if kind == 0: LibraryPart { pw: root.pw; ph: root.ph; gx: 0; gy: 60; gw: 160; gh: 40; }
    // 2-Deck: waveforms, slim decks, the pad bar under them.
    if kind == 4: WavePart { pw: root.pw; ph: root.ph; gx: 0; gy: 8; gw: 160; gh: 10; tint: Theme.deck1; }
    if kind == 4: WavePart { pw: root.pw; ph: root.ph; gx: 0; gy: 19; gw: 160; gh: 10; tint: Theme.deck2; }
    if kind == 4: Part { pw: root.pw; ph: root.ph; gx: 0; gy: 30; gw: 160; gh: 15; background: Theme.panel; }
    if kind == 4: Part { pw: root.pw; ph: root.ph; gx: 66; gy: 30; gw: 28; gh: 15; background: #2c2c30; }
    if kind == 4: Part { pw: root.pw; ph: root.ph; gx: 4; gy: 37; gw: 12; gh: 5; border-width: 1px; border-color: Theme.deck1; border-radius: 1px; }
    if kind == 4: Part { pw: root.pw; ph: root.ph; gx: 19; gy: 37; gw: 12; gh: 5; border-width: 1px; border-color: Theme.deck1; border-radius: 1px; }
    if kind == 4: Part { pw: root.pw; ph: root.ph; gx: 129; gy: 37; gw: 12; gh: 5; border-width: 1px; border-color: Theme.deck2; border-radius: 1px; }
    if kind == 4: Part { pw: root.pw; ph: root.ph; gx: 144; gy: 37; gw: 12; gh: 5; border-width: 1px; border-color: Theme.deck2; border-radius: 1px; }
    if kind == 4: Part { pw: root.pw; ph: root.ph; gx: 0; gy: 46; gw: 160; gh: 12; background: Theme.panel; }
    if kind == 4: PadsPart { pw: root.pw; ph: root.ph; gx: 4; gy: 47; gw: 24; gh: 10; tint: Theme.deck1; }
    if kind == 4: PadsPart { pw: root.pw; ph: root.ph; gx: 132; gy: 47; gw: 24; gh: 10; tint: Theme.deck2; }
    if kind == 4: LibraryPart { pw: root.pw; ph: root.ph; gx: 0; gy: 60; gw: 160; gh: 40; }
    // 4-Deck: four waveforms, four strips around the mixer.
    if kind == 2: WavePart { pw: root.pw; ph: root.ph; gx: 0; gy: 8; gw: 160; gh: 5; tint: Theme.deck3; }
    if kind == 2: WavePart { pw: root.pw; ph: root.ph; gx: 0; gy: 14; gw: 160; gh: 5; tint: Theme.deck1; }
    if kind == 2: WavePart { pw: root.pw; ph: root.ph; gx: 0; gy: 20; gw: 160; gh: 5; tint: Theme.deck2; }
    if kind == 2: WavePart { pw: root.pw; ph: root.ph; gx: 0; gy: 26; gw: 160; gh: 5; tint: Theme.deck4; }
    if kind == 2: Part { pw: root.pw; ph: root.ph; gx: 0; gy: 33; gw: 160; gh: 22; background: Theme.panel; }
    if kind == 2: Part { pw: root.pw; ph: root.ph; gx: 2; gy: 35; gw: 28; gh: 18; background: #2c2c30; border-radius: 2px; Rectangle { y: 0; height: 2px; background: Theme.deck3; } }
    if kind == 2: Part { pw: root.pw; ph: root.ph; gx: 34; gy: 35; gw: 28; gh: 18; background: #2c2c30; border-radius: 2px; Rectangle { y: 0; height: 2px; background: Theme.deck1; } }
    if kind == 2: Part { pw: root.pw; ph: root.ph; gx: 66; gy: 35; gw: 28; gh: 18; background: #2c2c30; }
    if kind == 2: Part { pw: root.pw; ph: root.ph; gx: 98; gy: 35; gw: 28; gh: 18; background: #2c2c30; border-radius: 2px; Rectangle { y: 0; height: 2px; background: Theme.deck2; } }
    if kind == 2: Part { pw: root.pw; ph: root.ph; gx: 130; gy: 35; gw: 28; gh: 18; background: #2c2c30; border-radius: 2px; Rectangle { y: 0; height: 2px; background: Theme.deck4; } }
    if kind == 2: LibraryPart { pw: root.pw; ph: root.ph; gx: 0; gy: 57; gw: 160; gh: 43; }
    // Prep: one tall waveform, deck 1 and the cue list.
    if kind == 3: WavePart { pw: root.pw; ph: root.ph; gx: 0; gy: 8; gw: 160; gh: 16; tint: Theme.deck1; }
    if kind == 3: Part { pw: root.pw; ph: root.ph; gx: 0; gy: 26; gw: 110; gh: 26; background: Theme.panel; }
    if kind == 3: PadsPart { pw: root.pw; ph: root.ph; gx: 40; gy: 33; gw: 24; gh: 12; tint: Theme.deck1; }
    if kind == 3: Part { pw: root.pw; ph: root.ph; gx: 112; gy: 26; gw: 48; gh: 26; background: Theme.panel; }
    for i in (kind == 3 ? 4 : 0): Part { pw: root.pw; ph: root.ph; gx: 115; gy: 29 + i * 5.5; gw: 42; gh: 4; background: #2c2c30; }
    if kind == 3: LibraryPart { pw: root.pw; ph: root.ph; gx: 0; gy: 54; gw: 160; gh: 46; }
}

// A small square button with one sign on it: ↑, ↓, − or +.
component SignButton inherits Rectangle {
    in property <string> sign;
    in property <bool> enabled: true;
    in property <bool> accent;
    callback clicked();
    width: 26px;
    height: 26px;
    border-radius: 6px;
    background: !enabled ? transparent : ta.pressed ? Theme.control-pressed : ta.has-hover ? #2e2e32 : Theme.panel-raised;
    border-width: 1px;
    border-color: enabled ? (accent ? Theme.accent : Theme.border) : transparent;
    Text {
        text: sign;
        color: !enabled ? Theme.text-dim.with-alpha(0.3) : accent ? Theme.accent : Theme.text;
        font-size: 14px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// A small heading, as Settings' own.
component Heading inherits Text {
    color: Theme.text-dim;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.6px;
}

// One of the DJ's layouts: preview, name, what it's for, and ↑ ↓ −.
component MineRow inherits Rectangle {
    in property <LayoutEntry> entry;
    in property <bool> first;
    in property <bool> last;
    property <bool> current: entry.layout == LayoutsUi.current;
    height: 66px;
    border-radius: 8px;
    background: ta.has-hover ? #1e1f21 : Theme.row;
    border-width: current ? 1.5px : 0px;
    border-color: Theme.accent;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { LayoutsUi.pick(entry.layout); }
    }
    HorizontalLayout {
        padding: 8px;
        padding-right: 12px;
        spacing: 14px;
        LayoutPreview { kind: entry.layout; width: 80px; height: 50px; }
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Text { text: entry.name; color: current ? Theme.accent : Theme.text; font-size: 14px; font-weight: 600; }
                if current: Text { text: "In use"; color: Theme.text-dim; font-size: 11px; vertical-alignment: center; }
            }
            Text { text: entry.detail; color: Theme.text-dim; font-size: 12px; wrap: word-wrap; }
        }
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 6px;
                SignButton { sign: "↑"; enabled: !first; clicked => { LayoutsUi.move(entry.layout, -1); } }
                SignButton { sign: "↓"; enabled: !last; clicked => { LayoutsUi.move(entry.layout, 1); } }
                // The layout in use stays, so the menu is never empty.
                SignButton { sign: "−"; enabled: !current && !(first && last); clicked => { LayoutsUi.remove(entry.layout); } }
            }
        }
    }
}

// A layout not in the list: a larger preview, its name, what it's for and
// + Add. Clicking the card switches to it.
component MoreCard inherits Rectangle {
    in property <LayoutEntry> entry;
    property <bool> current: entry.layout == LayoutsUi.current;
    border-radius: 10px;
    background: ta.has-hover ? #2a2a2d : Theme.panel-raised;
    border-width: current ? 1.5px : 0px;
    border-color: Theme.accent;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { LayoutsUi.pick(entry.layout); }
    }
    VerticalLayout {
        padding: 10px;
        spacing: 8px;
        LayoutPreview { kind: entry.layout; height: self.width * 0.56; }
        HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                spacing: 3px;
                horizontal-stretch: 1;
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: entry.name; color: current ? Theme.accent : Theme.text; font-size: 14px; font-weight: 600; }
                    if current: Text { text: "In use"; color: Theme.text-dim; font-size: 11px; vertical-alignment: center; }
                }
                Text { text: entry.detail; color: Theme.text-dim; font-size: 12px; wrap: word-wrap; }
            }
            VerticalLayout {
                alignment: start;
                Rectangle {
                    width: 64px;
                    height: 26px;
                    border-radius: 6px;
                    background: add.pressed ? Theme.control-pressed : add.has-hover ? #2e2e32 : Theme.panel;
                    border-width: 1px;
                    border-color: Theme.accent;
                    Text { text: "+ Add"; color: Theme.accent; font-size: 12px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                    add := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { LayoutsUi.add(entry.layout); }
                    }
                }
            }
        }
    }
}

// Settings › Layouts.
export component LayoutsPage inherits VerticalLayout {
    spacing: 8px;
    padding-top: 6px;
    padding-bottom: 12px;
    Heading { text: "YOUR LAYOUTS"; }
    Text {
        text: "The layout menu at the top left offers these, in this order. A controller's VIEW button steps through them.";
        color: Theme.text-dim;
        font-size: 12px;
        wrap: word-wrap;
    }
    for e[i] in LayoutsUi.mine: MineRow {
        entry: e;
        first: i == 0;
        last: i == LayoutsUi.mine.length - 1;
    }
    Rectangle { height: 10px; }
    Heading { text: "MORE LAYOUTS"; }
    if LayoutsUi.more.length == 0: Text {
        text: "Every layout is in your menu.";
        color: Theme.text-dim;
        font-size: 12px;
    }
    // Three cards to a row.
    for r in Math.ceil(LayoutsUi.more.length / 3): HorizontalLayout {
        spacing: 12px;
        // Equal thirds: a card or, after the last card, an empty slot.
        for c in Math.min(3, LayoutsUi.more.length - r * 3): MoreCard {
            entry: LayoutsUi.more[r * 3 + c];
            horizontal-stretch: 1;
            preferred-width: 100px;
        }
        for c in 3 - Math.min(3, LayoutsUi.more.length - r * 3): Rectangle {
            horizontal-stretch: 1;
            preferred-width: 100px;
        }
    }
}
