// openDJ Layouts: the DJ's layouts (the ones the layout menu offers), and
// the menu's chooser where they're switched on or off and reordered. Filled
// by layouts.rs.

export struct LayoutEntry {
    // The value of `layout`: 0 2-Deck, 1 Player, 2 4-Deck, 3 Prep,
    // 4 2-Deck Basic.
    layout: int,
    name: string,
    // What it's for.
    detail: string,
    // Switched on: in the layout menu.
    on: bool,
    // Its switch can't be turned off: the layout in use, or the last on.
    locked: bool,
}

export global LayoutsUi {
    // The layout menu's rows: the DJ's layouts, and the one in use if it
    // isn't one of them.
    in property <[LayoutEntry]> menu;
    // Every layout, on or off, in the chooser's order (the menu's pencil).
    in property <[LayoutEntry]> all;
    // The layout showing.
    in property <int> current;
    // Switch to a layout.
    callback pick(layout: int);
    // The chooser: switches a layout on or off, drags one `by` rows, and
    // goes back to the starting list.
    callback toggled(layout: int);
    callback moved(layout: int, by: int);
    callback reset();
    // Appearance, as Settings › Appearance saves it: 0 Dark,
    // 1 Light, 2 Match system (Auto in the menu). Set by appearance.rs.
    in property <int> appearance;
    callback appearance-picked(mode: int);
}
