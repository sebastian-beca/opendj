// A deck: a header with cover, title,
// overview and tempo, then the loop and pads on the outer side, loop controls, the
// jog circle and the pitch fader towards the mixer. Deck B is mirrored.
// Large artwork, flat dark controls, white pointers.
import { TrackDrag } from "library.slint";
import { SamplerPanel } from "sampler.slint";
import { Theme, KeyNotation, EdgeLine, EdgeVLine } from "theme.slint";
import { Caption, ControlButton, ControlFader, ControlKnob, Controls, HoverTip, KeyLock, MasterBadge, PitchReset, QuantizeButton } from "controls.slint";

// A line of the key menu: a key shift and the key it gives.
export struct KeyItem {
    shift: int,
    // e.g. "-1  Em"
    text: string,
    // Mixes with the other deck's key.
    compatible: bool,
    // The shift in use.
    current: bool,
}

// The overview tooltip for a phrase.
export struct PhraseTip {
    title: string,
    body: string,
}

export struct DeckInfo {
    loaded: bool,
    title: string,
    artist: string,
    initials: string,
    // album art, when the track has any
    cover: image,
    has-cover: bool,
    bpm: string,
    rate: string,
    range: string,
    key: string,
    elapsed: string,
    remaining: string,
    // Remaining time in whole seconds, for the deck header.
    remaining-seconds: string,
    // The key shift in semitones, e.g. "-1"; empty when not shifted.
    key-shift: string,
    // Shifts from -3 to +3, and the full menu from -6 to +6.
    key-menu: [KeyItem],
    key-menu-all: [KeyItem],
    total: string,
    // Track length in seconds, for the minute dots on the overview.
    duration: float,
    loop-size: string,
    // How many tempo sections the beat grid has (1 for a steady tempo).
    grid-sections: int,
    // The loaded track's stems (none without stems), and how preparing
    // high-quality stems is going ("" when it isn't).
    stem-names: [string],
    stem-colors: [color],
    stem-status: string,
    // High-quality stems play (HTDemucs, or an NI STEM file).
    stem-hq: bool,
    // High-quality stems are being prepared.
    stem-preparing: bool,
    // Whether high-quality stems can be prepared (a file without them,
    // nothing preparing).
    can-prepare-hq: bool,
    // 0..1 through the track
    progress: float,
    effects: [string],
}

component Arc inherits Path {
    in property <angle> from;
    in property <angle> to;
    in property <float> r: 46;
    viewbox-width: 100;
    viewbox-height: 100;
    stroke-width: 4px;
    // Three segments keep each arc below 180 degrees.
    property <angle> step: (to - from) / 3;
    MoveTo { x: 50 + r * sin(from); y: 50 - r * cos(from); }
    ArcTo { radius-x: r; radius-y: r; sweep: true; x: 50 + r * sin(from + step); y: 50 - r * cos(from + step); }
    ArcTo { radius-x: r; radius-y: r; sweep: true; x: 50 + r * sin(from + 2 * step); y: 50 - r * cos(from + 2 * step); }
    ArcTo { radius-x: r; radius-y: r; sweep: true; x: 50 + r * sin(to); y: 50 - r * cos(to); }
}

// A line of the beat grid menu that presses one control.
component GridMenuItem inherits Rectangle {
    in property <string> group;
    in property <string> key;
    in property <string> text;
    height: 26px;
    border-radius: 4px;
    background: ta.has-hover ? #3a3a3d : transparent;
    Text { x: 10px; text: root.text; color: Theme.text; font-size: 13px; vertical-alignment: center; }
    ta := TouchArea {
        clicked => {
            Controls.set-value(Controls.resolve(group, key), 1);
            Controls.set-value(Controls.resolve(group, key), 0);
        }
    }
}

// A pair of small buttons in the beat grid menu, e.g. earlier and later.
component GridNudge inherits HorizontalLayout {
    in property <string> group;
    in property <string> label;
    in property <string> less-key;
    in property <string> more-key;
    in property <string> less-text;
    in property <string> more-text;
    height: 26px;
    spacing: 4px;
    padding-left: 10px;
    Text { text: label; color: Theme.text; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; }
    ControlButton { group: group; key: less-key; text: less-text; momentary: true; font-size: 13px; width: 44px; }
    ControlButton { group: group; key: more-key; text: more-text; momentary: true; font-size: 13px; width: 44px; }
}

// Beat grid editing, opened from the tempo on the jog: move the grid,
// adjust the tempo, and add or remove tempo sections for tracks whose
// tempo drifts.
component GridMenu inherits PopupWindow {
    in property <string> group;
    in property <DeckInfo> info;
    width: 240px;
    close-policy: close-on-click-outside;
    Rectangle {
        background: Theme.panel-raised;
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 12px;
        drop-shadow-color: #000000a0;
    }
    VerticalLayout {
        padding: 6px;
        spacing: 2px;
        Text {
            height: 24px;
            x: 10px;
            text: info.grid-sections > 1 ? "Beat grid: " + info.grid-sections + " tempo sections" : "Beat grid: steady tempo";
            color: Theme.text-dim;
            font-size: 12px;
            vertical-alignment: center;
        }
        GridMenuItem { group: group; key: "beats_translate_curpos"; text: "Put a beat here"; }
        GridNudge { group: group; label: "Move grid"; less-key: "beats_translate_earlier"; more-key: "beats_translate_later"; less-text: "‹"; more-text: "›"; }
        GridNudge { group: group; label: "Tempo here"; less-key: "beats_adjust_slower"; more-key: "beats_adjust_faster"; less-text: "−"; more-text: "+"; }
        GridNudge { group: group; label: "Tempo × ½ / × 2"; less-key: "beats_scale_half"; more-key: "beats_scale_double"; less-text: "½"; more-text: "2"; }
        Rectangle { height: 9px; Rectangle { height: 1px; background: Theme.border; } }
        GridMenuItem { group: group; key: "beats_section_add"; text: "New tempo section from here"; }
        if info.grid-sections > 1: GridMenuItem { group: group; key: "beats_section_remove"; text: "Remove this tempo section"; }
        Rectangle { height: 9px; Rectangle { height: 1px; background: Theme.border; } }
        GridMenuItem { group: group; key: "beats_undo_adjustment"; text: "Undo"; }
    }
}

// The jog: a black platter with the progress ring on its rim,
// a coloured sticker that turns with the record, and a grey centre with the
// rate, tempo, and elapsed and remaining time.
export component Jog inherits Rectangle {
    in property <string> group;
    in property <DeckInfo> info;
    // Rotation of the sticker, one turn per 1.8 s like a 33 rpm record.
    in property <angle> spin;
    in property <color> tint;
    // Just the platter, progress ring and sticker, with no text (the
    // Player layout's small jogs).
    in property <bool> plain: false;
    // Sized by the deck: it fills the space above the transport buttons.
    width: 104px;
    height: 104px;
    property <float> scale: self.width / 104px;
    // The last hot cue pressed colours the sticker; the deck colour until then.
    property <int> last-cue: Controls.value(Controls.resolve(group, "hotcue_focus"), Controls.tick);
    property <color> sticker: last-cue >= 1 ? Theme.hotcues[last-cue - 1] : tint;
    property <length> centre: 70px * scale;
    property <int> jog-index: Controls.resolve(group, "jog");
    property <int> bend-index: Controls.resolve(group, "jog_bend");
    // Dragging round the black rim bends the speed like a controller's jog
    // rim: clockwise faster, counterclockwise slower, by how fast it turns.
    property <bool> bending: false;
    property <angle> bend-angle;
    // Scrolling over the jog nudges the track in fine steps: up runs it
    // forward, down back, playing or paused.
    rim := TouchArea {
        mouse-cursor: bending ? MouseCursor.grabbing : MouseCursor.default;
        pointer-event(e) => {
            if e.button != PointerEventButton.left {
                return;
            }
            if e.kind == PointerEventKind.down {
                let dx = (self.mouse-x - root.width / 2) / 1px;
                let dy = (self.mouse-y - root.height / 2) / 1px;
                let r = sqrt(dx * dx + dy * dy) * 1px;
                bending = info.loaded && r > centre / 2 && r <= root.width / 2;
                bend-angle = atan2(dy, dx);
            } else if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                bending = false;
            }
        }
        moved => {
            if !bending {
                return;
            }
            let a = atan2((self.mouse-y - root.height / 2) / 1px, (self.mouse-x - root.width / 2) / 1px);
            let d = a - bend-angle > 180deg ? a - bend-angle - 360deg
                : a - bend-angle < -180deg ? a - bend-angle + 360deg
                : a - bend-angle;
            bend-angle = a;
            // jog_bend counts rim ticks, 720 to a turn: two a degree.
            Controls.set-value(bend-index, Controls.value(bend-index, Controls.tick) + d / 1deg * 2);
        }
        scroll-event(e) => {
            if !info.loaded || e.delta-y == 0 {
                return reject;
            }
            // One jog unit is 10 ms of track, so a pixel of scroll is 1 ms.
            Controls.set-value(jog-index, Controls.value(jog-index, Controls.tick) + e.delta-y / 1px * 0.1);
            accept
        }
    }
    Rectangle {
        border-radius: self.width / 2;
        background: #0a0a0b;
        border-width: 1px;
        border-color: #000000;
    }
    Arc { width: parent.width; height: parent.height; from: 0deg; to: 359.9deg; stroke: #232326; stroke-width: 3px; }
    if info.progress > 0.002: Arc {
        width: parent.width;
        height: parent.height;
        from: 0deg;
        to: info.progress * 359.9deg;
        stroke: tint;
        stroke-width: 3px;
    }
    // The sticker: a short, wide bar between the centre and the rim.
    if info.loaded: Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 100;
        viewbox-height: 100;
        stroke: sticker;
        stroke-width: 5px * scale;
        MoveTo { x: 50 + 35.5 * sin(spin); y: 50 - 35.5 * cos(spin); }
        LineTo { x: 50 + 47 * sin(spin); y: 50 - 47 * cos(spin); }
    }
    Rectangle {
        width: centre;
        height: centre;
        border-radius: self.width / 2;
        background: #2a2a2d;
        border-width: 1px;
        border-color: #00000000;
    }
    // The small jogs carry the openDJ mark in light grey instead of text.
    if plain: Image {
        source: @image-url("icons/opendj-mark.svg");
        colorize: #a1a1a6;
        width: centre * 0.62;
        height: self.width / 1.6;
    }
    // Placed by hand rather than in a layout: their size follows the jog's,
    // and a layout would feed that back into the jog's own size. Everything
    // is centred; the app's font has digits all one width (SF on macOS,
    // Inter Tabular elsewhere), so the numbers don't jitter as they change.
    if !plain: Text {
        y: parent.height / 2 - 27px * scale;
        height: 9px * scale;
        width: parent.width;
        text: info.rate;
        color: #9e9ea3;
        font-size: 7.5px * scale;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    // Click the tempo to edit the beat grid. A grid whose tempo changes
    // within the track shows a small dot beside it.
    if !plain: Text {
        y: parent.height / 2 - 19px * scale;
        height: 20px * scale;
        width: parent.width;
        text: info.loaded ? info.bpm : "--";
        color: bta.has-hover && info.loaded ? Theme.accent : Theme.text;
        font-size: 16px * scale;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        bta := TouchArea {
            mouse-cursor: info.loaded ? pointer : default;
            clicked => {
                if info.loaded {
                    grid-menu.show();
                }
            }
        }
    }
    if !plain && info.grid-sections > 1: Rectangle {
        x: parent.width / 2 + 27px * scale;
        y: parent.height / 2 - 11px * scale;
        width: 4px * scale;
        height: 4px * scale;
        border-radius: 2px * scale;
        background: tint;
    }
    grid-menu := GridMenu { group: group; info: info; x: (parent.width - 240px) / 2; y: parent.height / 2; }
    if !plain: Rectangle {
        x: (parent.width - 44px * scale) / 2;
        y: parent.height / 2 + 3px * scale;
        width: 44px * scale;
        height: 1px;
        background: #48484c;
    }
    // Elapsed over remaining, right-aligned to each other so the digits
    // line up, and centred in the jog as one block.
    if !plain: VerticalLayout {
        x: (parent.width - self.preferred-width) / 2;
        y: parent.height / 2 + 5px * scale;
        width: self.preferred-width;
        Text {
            height: 10px * scale;
            text: info.loaded ? info.elapsed : "00:00.0";
            color: #9e9ea3;
            font-size: 8.5px * scale;
            font-weight: 500;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        Text {
            height: 10px * scale;
            text: "-" + (info.loaded ? info.remaining : "00:00.0");
            color: Theme.text;
            font-size: 8.5px * scale;
            font-weight: 600;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}

// Album art, large; without any, the deck colour with the
// artist's initials. Picking it up drags the deck's track to another deck,
// the side panel or one of the DJ's lists.
component Cover inherits Rectangle {
    in property <int> deck;
    in property <color> tint;
    in property <DeckInfo> info;
    in property <length> size: 96px;
    width: size;
    height: size;
    border-radius: 4px;
    clip: true;
    background: info.loaded ? @linear-gradient(135deg, tint 0%, tint.darker(0.6) 55%, #101012 100%) : Theme.control;
    border-width: info.loaded ? 0px : 1px;
    border-color: Theme.border;
    if !info.has-cover: Text { text: info.loaded ? info.initials : "♪"; color: info.loaded ? #ffffffe0 : Theme.text-dim; font-size: size / 3; font-weight: 700; }
    if info.has-cover: Image {
        width: parent.width;
        height: parent.height;
        source: info.cover;
        image-fit: cover;
    }
    if info.loaded: DragArea {
        data: TrackDrag.deck-payload(deck);
        allow-copy: true;
        changed dragging => { TrackDrag.active = self.dragging; }
        TouchArea { mouse-cursor: grab; }
    }
}

// A bare + or − beside the key: no button, the sign lights on hover.
component KeyStep inherits Rectangle {
    in property <string> group;
    in property <string> key;
    in property <string> text;
    property <int> index: Controls.resolve(group, key);
    width: 14px;
    height: 13px;
    Text { text: root.text; color: ta.pressed ? Theme.accent : ta.has-hover ? Theme.text : Theme.text-dim; font-size: 14px; font-weight: 600; vertical-alignment: center; horizontal-alignment: center; }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Controls.set-value(index, 1);
            Controls.set-value(index, 0);
        }
    }
}

component KeyBox inherits VerticalLayout {
    in property <string> group;
    in property <DeckInfo> info;
    in property <color> tint;
    property <bool> more;
    property <int> pitch-index: Controls.resolve(group, "pitch");
    width: 72px;
    alignment: center;
    HorizontalLayout {
        alignment: center;
        spacing: 2px;
        // Key up a semitone above, down below, to the left of the key.
        VerticalLayout {
            alignment: center;
            KeyStep { group: group; key: "pitch_up"; text: "+"; }
            KeyStep { group: group; key: "pitch_down"; text: "−"; }
        }
        // Click to switch every key display between Camelot and notes.
        Text {
            text: info.loaded ? info.key : "--";
            // A shifted key is shown in the accent colour.
            color: info.key-shift != "" ? Theme.accent : Theme.key;
            font-size: 18px;
            font-weight: 600;
            vertical-alignment: center;
            TouchArea {
                mouse-cursor: pointer;
                clicked => { KeyNotation.camelot = !KeyNotation.camelot; }
            }
        }
        if info.key-shift != "": Text { text: info.key-shift; color: Theme.accent; font-size: 10px; font-weight: 600; vertical-alignment: top; }
        // Opens the key menu.
        Rectangle {
            width: 14px;
            Path {
                width: 10px;
                height: 10px;
                viewbox-width: 10;
                viewbox-height: 10;
                stroke: kta.has-hover ? Theme.text : Theme.text-dim;
                stroke-width: 1.5px;
                fill: transparent;
                commands: "M 1.5 3.5 L 5 7 L 8.5 3.5";
            }
            kta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    if info.key-menu.length > 0 {
                        more = false;
                        menu.show();
                    }
                }
            }
        }
    }
    // Key shifts with the key each gives.
    menu := PopupWindow {
        x: 0px;
        y: 30px;
        width: 210px;
        close-policy: close-on-click-outside;
        Rectangle {
            background: Theme.panel-raised;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 12px;
            drop-shadow-color: #000000a0;
        }
        VerticalLayout {
            padding: 6px;
            spacing: 0px;
            for item in more ? info.key-menu-all : info.key-menu: Rectangle {
                height: 26px;
                border-radius: 4px;
                background: ita.has-hover ? #3a3a3d : transparent;
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    spacing: 6px;
                    Text { width: 14px; text: item.current ? "✓" : ""; color: Theme.text; font-size: 13px; vertical-alignment: center; }
                    Text { text: item.text; color: Theme.text; font-size: 13px; vertical-alignment: center; }
                    Text { text: item.compatible ? "(compatible)" : ""; color: Theme.text-dim; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
                }
                ita := TouchArea {
                    clicked => {
                        Controls.set-value(pitch-index, item.shift);
                        menu.close();
                    }
                }
            }
            if !more: Rectangle {
                height: 26px;
                border-radius: 4px;
                background: mta.has-hover ? #3a3a3d : transparent;
                Text { x: 26px; text: "More…"; color: Theme.text; font-size: 13px; }
                mta := TouchArea { clicked => { more = true; } }
            }
            Rectangle { height: 9px; Rectangle { height: 1px; background: Theme.border; } }
            Rectangle {
                height: 26px;
                border-radius: 4px;
                background: sta.has-hover ? #3a3a3d : transparent;
                Text { x: 26px; text: "Match key to the other deck"; color: Theme.text; font-size: 13px; }
                sta := TouchArea {
                    clicked => {
                        Controls.set-value(Controls.resolve(group, "sync_key"), 1);
                        Controls.set-value(Controls.resolve(group, "sync_key"), 0);
                        menu.close();
                    }
                }
            }
        }
    }
}

// Remaining time and total length, then the key with its + and − shifts, on
// the right of both decks.
component TimeKey inherits HorizontalLayout {
    in property <string> group;
    in property <DeckInfo> info;
    in property <color> tint;
    // Off in the 4-Deck strips, which show the time beside the overview.
    in property <bool> show-time: true;
    spacing: 12px;
    if show-time: VerticalLayout {
        alignment: center;
        Text { text: info.loaded ? "-" + info.remaining-seconds : "-0:00"; color: Theme.text; font-size: 23px; font-weight: 500; horizontal-alignment: right; }
        Text { text: info.loaded ? info.total : ""; color: Theme.text-dim; font-size: 11px; horizontal-alignment: right; }
    }
    if show-time: EdgeVLine { top: 6px; bottom: 6px; line-color: #2c2c2f; }
    KeyBox { group: group; info: info; tint: tint; }
}

// Deck header: big artwork on the outer edge, title and artist, the remaining
// time and key, and the overview waveform underneath.
export component Header inherits Rectangle {
    in property <int> deck;
    in property <DeckInfo> info;
    in property <image> overview;
    in property <bool> mirrored;
    in property <string> group;
    // The 4-Deck strips' header: the deck number, a small cover, smaller
    // type, and the time beside the overview.
    in property <bool> compact: false;
    // The deck number lit: a two-deck controller's side is on this deck.
    in property <bool> number-lit: false;
    callback number-clicked();
    out property <length> overview-width: ov.width;
    out property <length> overview-height: ov.height;
    property <color> tint: Theme.deck-color(deck);
    property <int> scrub-index: Controls.resolve(group, "scrub_position");
    property <int> scrub-enable-index: Controls.resolve(group, "scrub_enable");
    property <int> position-index: Controls.resolve(group, "playposition");
    // Where a press on the overview started, and whether it became a drag.
    property <length> press-x;
    property <bool> scrubbing;
    // Where the overview's right-click menu opens.
    property <length> menu-x;
    property <length> menu-y;
    // The phrase under the pointer, named in a tooltip below the overview
    // while the pointer rests there.
    property <PhraseTip> phrase-tip: PhraseView.visible && info.loaded && ota.has-hover
        ? PhraseView.describe(deck, clamp(ota.mouse-x / ota.width, 0, 1) * info.duration) : { title: "", body: "" };
    property <bool> tip-mine;
    changed phrase-tip => {
        if tip-mine {
            if phrase-tip.title == "" {
                hide-tip();
            } else {
                show-tip();
            }
        }
    }
    // The tooltip follows the pointer along the overview.
    property <length> hover-x: ota.mouse-x;
    changed hover-x => {
        if tip-mine && phrase-tip.title != "" {
            show-tip();
        }
    }
    function show-tip() {
        // Beside the pointer, on whichever side has more room.
        HoverTip.title = phrase-tip.title;
        HoverTip.body = phrase-tip.body;
        HoverTip.right-aligned = ota.mouse-x > ota.width / 2;
        HoverTip.x = ota.absolute-position.x + ota.mouse-x;
        HoverTip.y = ov.absolute-position.y + ov.height + 6px;
        HoverTip.shown = true;
    }
    function hide-tip() {
        if tip-mine {
            tip-mine = false;
            HoverTip.shown = false;
        }
    }
    height: compact ? 92px : 108px;
    // Cover, title, info and overview share one black box.
    background: Theme.well;

    HorizontalLayout {
        padding: 6px;
        spacing: compact ? 8px : 10px;
        if compact: VerticalLayout {
            alignment: start;
            Rectangle {
                width: 26px;
                height: 26px;
                border-radius: 4px;
                background: number-lit ? tint : nta.pressed ? Theme.control-pressed : Theme.control;
                border-width: 1px;
                border-color: tint;
                Text { text: deck + 1; color: number-lit ? #000000 : Theme.text; font-size: 15px; font-weight: 700; }
                nta := TouchArea { mouse-cursor: pointer; clicked => { number-clicked(); } }
            }
        }
        if !mirrored: VerticalLayout {
            alignment: start;
            Cover { deck: deck; tint: tint; info: info; size: compact ? 40px : 96px; }
        }
        VerticalLayout {
            spacing: 4px;
            horizontal-stretch: 1;
            // Title, artist and BPM on the left, time and key on the right, on both decks.
            HorizontalLayout {
                spacing: compact ? 8px : 12px;
                height: compact ? 36px : 44px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;
                    Text { text: info.loaded ? info.title : "Empty deck"; color: Theme.text; font-size: compact ? 14px : 18px; font-weight: 500; overflow: elide; }
                    Text {
                        text: info.loaded ? (compact ? info.artist : info.artist + "   |   " + info.bpm) : compact ? "Drop a track here" : "Drop a track here or double-click one in the browser";
                        color: Theme.text-dim;
                        font-size: compact ? 11px : 13px;
                        overflow: elide;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    MasterBadge { group: group; font-size: compact ? 9px : 10px; height: compact ? 16px : 18px; }
                }
                TimeKey { group: group; info: info; tint: tint; show-time: !compact; }
            }
            // Out to the header's edge on the side away from the cover.
            EdgeLine { left: mirrored ? 6px : 0px; right: mirrored ? 0px : 6px; line-color: #2c2c2f; }
            // Overview waveform, rendered on the GPU. Click to jump; drag to
            // move through the track, the deck gliding after the pointer and
            // playing what it passes.
            HorizontalLayout {
            vertical-stretch: 1;
            spacing: 8px;
            ov := Rectangle {
                horizontal-stretch: 1;
                background: Theme.well;
                // No border-radius here: a rounded clip renders into a cached
                // layer, which would freeze the GPU-updated image.
                clip: true;
                Image { width: parent.width; height: parent.height; source: overview; image-fit: fill; }
                // The waveform, a dot at every minute and the phrase bar
                // are all drawn into the image, stacked so none overlap.
                ota := TouchArea {
                    mouse-cursor: ew-resize;
                    pointer-event(e) => {
                        if e.kind == PointerEventKind.down {
                            hide-tip();
                        }
                        if e.button == PointerEventButton.right && e.kind == PointerEventKind.down {
                            menu-x = self.mouse-x;
                            menu-y = self.mouse-y;
                            phrase-menu.show();
                            return;
                        }
                        if e.button != PointerEventButton.left {
                            return;
                        }
                        // A click jumps straight there, silently; dragging
                        // glides through the audio.
                        if e.kind == PointerEventKind.down {
                            press-x = self.mouse-x;
                            scrubbing = false;
                            Controls.set-value(position-index, clamp(self.mouse-x / self.width, 0, 1));
                        } else if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                            if scrubbing {
                                Controls.set-value(scrub-enable-index, 0);
                            }
                            scrubbing = false;
                        }
                    }
                    moved => {
                        if self.pressed {
                            if !scrubbing && abs(self.mouse-x - press-x) > 4px {
                                scrubbing = true;
                                Controls.set-value(scrub-index, clamp(self.mouse-x / self.width, 0, 1));
                                Controls.set-value(scrub-enable-index, 1);
                            }
                            if scrubbing {
                                Controls.set-value(scrub-index, clamp(self.mouse-x / self.width, 0, 1));
                            }
                        }
                    }
                }
                Timer {
                    interval: 600ms;
                    running: ota.has-hover && !ota.pressed && !tip-mine && phrase-tip.title != "";
                    triggered => {
                        tip-mine = true;
                        show-tip();
                    }
                }
                phrase-menu := PopupWindow {
                    x: min(menu-x, ov.width - 130px);
                    y: menu-y;
                    width: 130px;
                    Rectangle {
                        background: Theme.panel-raised;
                        border-radius: Theme.radius;
                        border-width: 1px;
                        border-color: Theme.border;
                        drop-shadow-blur: 8px;
                        drop-shadow-color: #00000080;
                    }
                    VerticalLayout {
                        padding: 4px;
                        Rectangle {
                            height: 24px;
                            background: pta.has-hover ? Theme.panel-raised.brighter(0.3) : transparent;
                            border-radius: 4px;
                            Text {
                                x: 10px;
                                text: PhraseView.visible ? "Hide phrases" : "Show phrases";
                                color: Theme.text;
                                font-size: 11px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                            pta := TouchArea {
                                clicked => {
                                    PhraseView.visible = !PhraseView.visible;
                                    PhraseView.changed(PhraseView.visible);
                                }
                            }
                        }
                    }
                }
            }
            if compact: Text {
                text: info.loaded ? "-" + info.remaining-seconds : "-0:00";
                color: Theme.text;
                font-size: 20px;
                font-weight: 500;
                vertical-alignment: center;
                horizontal-alignment: right;
                min-width: 64px;
            }
            }
        }
        if mirrored: VerticalLayout {
            alignment: start;
            Cover { deck: deck; tint: tint; info: info; size: compact ? 40px : 96px; }
        }
    }
}

// The effects every slot can hold, in loaded_effect order (1 = the first);
// set once from the engine's list.
// Phrase bars on the deck overviews: shown or hidden from an overview's
// right-click menu, for every deck at once.
export global PhraseView {
    in-out property <bool> visible: true;
    callback changed(on: bool);
    // The phrase at `seconds` into the track on `deck`, for the overview's
    // tooltip; an empty title where there is none.
    pure callback describe(deck: int, seconds: float) -> PhraseTip;
}

// Deck actions that aren't controls.
export global DeckActions {
    // Prepares high-quality stems for the track on `deck` in the
    // background; they take over from the quick ones when ready.
    callback prepare-hq-stems(deck: int);
}

export global EffectList {
    in property <[string]> names;
    // The Color FX the filter knobs can play, `loaded_chain_preset` 1 and up.
    in property <[string]> color-fx: ["Filter", "Space", "Dub Echo", "Noise", "Crush"];
    // The microphone's effect unit, from 0 (MIC_FX_UNIT).
    in property <int> mic-unit: 5;
    // The parameter (from 0) each effect's slider in the FX bar sets, in
    // `loaded_effect` order (the engine's AVAILABLE_EFFECTS); -1 for the
    // beat-synced ones, which show their length in beats instead.
    // Reverb decay, Filter resonance, Bitcrusher bit depth, Noise sweep.
    in property <[int]> slider-params: [-1, 0, 1, -1, 0, -1, -1, -1, -1, -1, 1, -1];
}

// One effect slot: clicking the name turns the effect on
// and off, the arrow beside it opens the list to pick another, the knob is
// the effect's main control and the switch beside it its length in beats.
export component FxSlot inherits HorizontalLayout {
    in property <int> deck;
    in property <int> slot;
    in property <string> name;
    // The effect unit, from 0: the deck's own unless set.
    in property <int> unit: deck;
    in property <color> tint: Theme.deck-color(deck);
    property <string> fx: "[EffectRack1_EffectUnit" + (unit + 1) + "_Effect" + (slot + 1) + "]";
    property <int> enabled-index: Controls.resolve(fx, "enabled");
    property <int> loaded-index: Controls.resolve(fx, "loaded_effect");
    property <bool> on: Controls.value(enabled-index, Controls.tick) > 0;
    property <int> loaded: Controls.value(loaded-index, Controls.tick);
    property <int> beats-index: Controls.resolve(fx, "beats");
    property <float> beats: Controls.value(beats-index, Controls.tick);
    spacing: 0px;
    height: 22px;
    // The name turns the effect on and off; the arrow at its right end opens
    // the effect list.
    arrow := Rectangle {
        horizontal-stretch: 1;
        min-width: 0px;
        preferred-width: 0px;
        background: on ? tint : nta.pressed || ata.pressed ? Theme.control-pressed : nta.has-hover || ata.has-hover ? #1d1d20 : Theme.control;
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: on ? tint : Theme.border;
        Text { x: 10px; width: parent.width - 34px; text: name == "" ? "No effect" : name; color: on ? #ffffff : name == "" ? Theme.text-dim : Theme.text; font-size: 12px; font-weight: on ? 700 : 500; overflow: elide; }
        nta := TouchArea {
            x: 0px;
            width: parent.width - 24px;
            mouse-cursor: pointer;
            clicked => {
                if name != "" {
                    Controls.toggle(enabled-index);
                }
            }
        }
        Path {
            x: parent.width - 18px;
            width: 10px;
            height: 10px;
            viewbox-width: 10;
            viewbox-height: 10;
            stroke: on ? #ffffff : ata.has-hover ? Theme.text : Theme.text-dim;
            stroke-width: 1.5px;
            fill: transparent;
            commands: "M 1.5 3.5 L 5 7 L 8.5 3.5";
        }
        ata := TouchArea {
            x: parent.width - 24px;
            width: 24px;
            mouse-cursor: pointer;
            clicked => { menu.show(); }
        }
    }
    Rectangle { width: 6px; }
    ControlKnob { group: fx; key: "meta"; size: 22px; }
    Rectangle { width: 6px; }
    // The effect's length, halved and doubled from 1/16 to 4 beats; blank
    // for effects that have none. Just wide enough for "‹ 1/16 ›", leaving
    // the rest to the effect name.
    Rectangle {
        width: 66px;
        HorizontalLayout {
            visible: beats > 0;
            Rectangle {
                width: 16px;
                Path {
                    width: 7px;
                    height: 12px;
                    viewbox-width: 7;
                    viewbox-height: 12;
                    commands: "M 6 1 L 1 6 L 6 11";
                    stroke: beats > 0 && lta.has-hover ? Theme.text : Theme.text-dim;
                    stroke-width: 1.5px;
                    fill: transparent;
                }
                lta := TouchArea {
                    clicked => {
                        if beats > 0 {
                            Controls.set-value(beats-index, beats / 2);
                        }
                    }
                }
            }
            Text {
                horizontal-stretch: 1;
                text: beats <= 0 ? "–" : beats < 1 ? "1/" + round(1 / beats) : round(beats);
                color: beats > 0 ? Theme.text : Theme.text-dim;
                font-size: 12px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            Rectangle {
                width: 16px;
                Path {
                    width: 7px;
                    height: 12px;
                    viewbox-width: 7;
                    viewbox-height: 12;
                    commands: "M 1 1 L 6 6 L 1 11";
                    stroke: beats > 0 && rta.has-hover ? Theme.text : Theme.text-dim;
                    stroke-width: 1.5px;
                    fill: transparent;
                }
                rta := TouchArea {
                    clicked => {
                        if beats > 0 {
                            Controls.set-value(beats-index, beats * 2);
                        }
                    }
                }
            }
        }
    }

    // The effects to pick from, opening to the right of the slot. Picking one loads it and turns it on.
    menu := PopupWindow {
        x: arrow.x + arrow.width + 4px;
        y: 0px;
        width: 190px;
        close-policy: close-on-click-outside;
        Rectangle {
            background: Theme.panel-raised;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 12px;
            drop-shadow-color: #000000a0;
        }
        VerticalLayout {
            padding: 6px;
            spacing: 0px;
            for e[i] in EffectList.names: Rectangle {
                property <bool> current: loaded == i + 1;
                height: 26px;
                border-radius: 4px;
                background: current ? tint.with-alpha(0.35) : eta.has-hover ? #3a3a3d : transparent;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    Text { text: e; color: Theme.text; font-size: 12px; font-weight: current ? 700 : 400; vertical-alignment: center; horizontal-stretch: 1; }
                }
                eta := TouchArea {
                    clicked => {
                        if current {
                            Controls.toggle(enabled-index);
                        } else {
                            Controls.set-value(loaded-index, i + 1);
                            Controls.set-value(enabled-index, 1);
                        }
                        menu.close();
                    }
                }
            }
        }
    }
}

struct Pad {
    key: string,
    light: string,
    text: string,
}

// A Pad FX pad: hold it to put an effect on the deck.
// It loads the effect into the first slot of the deck's pad FX unit (units
// 6 to 9 for decks 1 to 4), turns it on and routes the unit to the deck;
// letting go turns it off again.
// A STEMS pad: a stem (1 to 5), or one of StemPads.
struct StemPadSpec {
    stem: int,
    text: string,
    tint: color,
}

struct PadEffect {
    // loaded_effect: 1 Echo, 2 Reverb, 3 Filter, 4 Flanger, 5 Bitcrusher, 6 Phaser
    effect: int,
    // Where the effect's meta knob sits while held.
    meta: float,
    text: string,
}

component PadFxButton inherits Rectangle {
    in property <int> deck;
    in property <PadEffect> fx;
    in property <color> tint;
    property <string> unit: "[EffectRack1_EffectUnit" + (deck + 6) + "]";
    property <string> slot: "[EffectRack1_EffectUnit" + (deck + 6) + "_Effect1]";
    property <bool> held: touch.pressed;
    background: held ? tint.with-alpha(0.25) : touch.has-hover ? #1d1d20 : Theme.control;
    Text { text: fx.text; color: held ? tint : Theme.text; font-size: 12px; font-weight: 700; }
    touch := TouchArea {
        pointer-event(e) => {
            if e.button != PointerEventButton.left {
                return;
            }
            if e.kind == PointerEventKind.down {
                Controls.set-value(Controls.resolve(slot, "loaded_effect"), fx.effect);
                Controls.set-value(Controls.resolve(slot, "meta"), fx.meta);
                Controls.set-value(Controls.resolve(unit, "mix"), 1);
                Controls.set-value(Controls.resolve(unit, "enabled"), 1);
                Controls.set-value(Controls.resolve(unit, "group_[Channel" + (deck + 1) + "]_enable"), 1);
                Controls.set-value(Controls.resolve(slot, "enabled"), 1);
            } else if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                Controls.set-value(Controls.resolve(slot, "enabled"), 0);
            }
        }
    }
}

// A line in the menu of pad panels.
component PanelMenuItem inherits Rectangle {
    in property <string> text;
    in property <bool> current;
    callback picked();
    height: 24px;
    background: ta.has-hover ? Theme.panel-raised.brighter(0.3) : transparent;
    border-radius: 4px;
    Text {
        x: 10px;
        text: root.text;
        color: current ? Theme.accent : Theme.text;
        font-size: 11px;
        font-weight: 600;
        vertical-alignment: center;
    }
    ta := TouchArea { clicked => { root.picked(); } }
}

// The kinds of STEMS pad that aren't a stem.
export global StemPads {
    out property <int> acapella: 0;
    out property <int> instrumental: -1;
    out property <int> fx: -2;
}

// A STEMS pad, laid out as VirtualDJ's (see Pads.stem-pads). A stem's pad
// mutes it and is lit while it plays; ACAPELLA plays the vocals alone and
// INSTRUMENTAL everything but, a second press bringing every stem back.
// The levels are on the mixer's knobs in stems mode. Right-click for
// high-quality stems.
component StemPad inherits Rectangle {
    in property <int> deck;
    in property <DeckInfo> info;
    // 1 to 5 for a stem ([ChannelN_StemM]), else one of STEM-PAD-*.
    in property <int> stem;
    in property <string> text;
    in property <color> tint;
    property <string> base: "[Channel" + (deck + 1) + "_Stem";
    property <int> count: Controls.value(Controls.resolve("[Channel" + (deck + 1) + "]", "stem_count"), Controls.tick);
    property <int> m1: Controls.resolve(base + "1]", "mute");
    property <int> m2: Controls.resolve(base + "2]", "mute");
    property <int> m3: Controls.resolve(base + "3]", "mute");
    property <int> m4: Controls.resolve(base + "4]", "mute");
    property <int> m5: Controls.resolve(base + "5]", "mute");
    property <bool> on1: Controls.value(m1, Controls.tick) == 0;
    property <bool> on2: Controls.value(m2, Controls.tick) == 0;
    property <bool> on3: Controls.value(m3, Controls.tick) == 0;
    property <bool> on4: Controls.value(m4, Controls.tick) == 0;
    property <bool> on5: Controls.value(m5, Controls.tick) == 0 || count < 5;
    property <bool> others-on: on1 && on2 && on3 && on5;
    property <bool> others-off: !on1 && !on2 && !on3 && (!on5 || count < 5);
    property <bool> available: stem > 0 ? count >= stem : stem != StemPads.fx && count >= 4;
    property <bool> lit: !available ? false
        : stem == 1 ? on1 : stem == 2 ? on2 : stem == 3 ? on3 : stem == 4 ? on4 : stem == 5 ? on5
        : stem == StemPads.acapella ? on4 && others-off
        : stem == StemPads.instrumental ? !on4 && others-on : false;
    function set-all(vocals: bool, rest: bool) {
        Controls.set-value(m4, vocals ? 0 : 1);
        Controls.set-value(m1, rest ? 0 : 1);
        Controls.set-value(m2, rest ? 0 : 1);
        Controls.set-value(m3, rest ? 0 : 1);
        Controls.set-value(m5, rest ? 0 : 1);
    }
    background: !available ? Theme.control : ta.pressed ? Theme.control-pressed : lit ? tint.with-alpha(0.2) : ta.has-hover ? #1d1d20 : Theme.control;
    Text {
        y: (parent.height - self.height) / 2 - 3px;
        width: parent.width - 6px;
        text: root.text;
        font-size: 12px;
        font-weight: 600;
        color: !available ? Theme.text-dim.with-alpha(0.5) : lit ? Theme.text : Theme.text-dim;
        horizontal-alignment: center;
        overflow: elide;
    }
    // The stem's colour, under its name.
    Rectangle {
        y: parent.height / 2 + 8px;
        width: min(parent.width * 0.4, 44px);
        height: 3px;
        border-radius: 1px;
        background: !available ? tint.with-alpha(0.2) : lit ? tint : tint.with-alpha(0.5);
    }
    ta := TouchArea {
        pointer-event(e) => {
            if e.kind != PointerEventKind.down {
                return;
            }
            if e.button == PointerEventButton.right {
                menu.show();
            } else if e.button == PointerEventButton.left && available {
                if stem == 1 { Controls.toggle(m1); }
                else if stem == 2 { Controls.toggle(m2); }
                else if stem == 3 { Controls.toggle(m3); }
                else if stem == 4 { Controls.toggle(m4); }
                else if stem == 5 { Controls.toggle(m5); }
                else if stem == StemPads.acapella { set-all(true, lit); }
                else if stem == StemPads.instrumental { set-all(lit, true); }
            }
        }
    }
    menu := PopupWindow {
        x: ta.mouse-x;
        y: ta.mouse-y;
        width: 230px;
        Rectangle {
            background: Theme.panel-raised;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 8px;
            drop-shadow-color: #00000080;
        }
        VerticalLayout {
            padding: 4px;
            PanelMenuItem {
                text: info.stem-hq ? "High Quality Stems ✓"
                    : info.stem-preparing ? "Preparing High Quality Stems…"
                    : "Prepare High Quality Stems";
                current: info.stem-hq;
                picked => {
                    if info.can-prepare-hq {
                        DeckActions.prepare-hq-stems(deck);
                    }
                }
            }
            if info.stem-status != "": Text {
                x: 10px;
                width: parent.width - 20px;
                height: 22px;
                text: info.stem-status;
                color: Theme.text-dim;
                font-size: 10px;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}

// One cell of the pad grid: flat, lit in its colour while its light is on.
component PadCell inherits Rectangle {
    in property <string> group;
    in property <string> key;
    in property <string> light-key: key;
    in property <string> text;
    in property <color> tint;
    property <int> index: Controls.resolve(group, key);
    property <bool> lit: Controls.value(Controls.resolve(group, light-key), Controls.tick) > 0;
    background: touch.pressed ? Theme.control-pressed : lit ? tint.with-alpha(0.18) : touch.has-hover ? #1d1d20 : Theme.control;
    Text { text: root.text; color: lit ? tint : Theme.text; font-size: 12px; font-weight: 700; overflow: elide; }
    touch := TouchArea {
        pointer-event(e) => {
            if e.button != PointerEventButton.left {
                return;
            }
            if e.kind == PointerEventKind.down {
                Controls.set-value(index, 1);
            } else if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                Controls.set-value(index, 0);
            }
        }
    }
}

// A KEYBOARD or KEY SHIFT pad, lit while the deck plays at its key shift.
// KEYBOARD pads play the last hot cue pressed at `semitones`; KEY SHIFT pads
// set the key shift, and with Shift held move it by `step` instead, as the
// DDJ-FLX4's KEY SHIFT pads do.
component KeyPad inherits Rectangle {
    in property <string> group;
    in property <bool> keyboard;
    // The pad's number, 1 to 8, for keyboard_N_activate.
    in property <int> number;
    in property <float> semitones;
    in property <float> step;
    in property <color> tint;
    property <int> pitch-index: Controls.resolve(group, "pitch_adjust");
    property <int> press-index: Controls.resolve(group, "keyboard_" + number + "_activate");
    property <bool> lit: abs(Controls.value(pitch-index, Controls.tick) - semitones) < 0.01;
    background: touch.pressed ? Theme.control-pressed : lit ? tint.with-alpha(0.18) : touch.has-hover ? #1d1d20 : Theme.control;
    Text {
        text: semitones == 0 ? "±0" : semitones > 0 ? "+" + semitones : "−" + abs(semitones);
        color: lit ? tint : Theme.text;
        font-size: 12px;
        font-weight: 700;
    }
    touch := TouchArea {
        pointer-event(e) => {
            if e.button != PointerEventButton.left {
                return;
            }
            if keyboard {
                if e.kind == PointerEventKind.down {
                    Controls.set-value(press-index, 1);
                } else if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                    Controls.set-value(press-index, 0);
                }
            } else if e.kind == PointerEventKind.down {
                if e.modifiers.shift {
                    Controls.set-value(pitch-index, clamp(Controls.value(pitch-index, Controls.tick) + step, -6, 6));
                } else {
                    Controls.set-value(pitch-index, semitones);
                }
            }
        }
    }
}

// A hot cue: a small play triangle and the cue's time in
// its colour, or "+" while it isn't set (pressing sets it).
// Shift + press deletes a set cue, as on controllers.
component HotcueCell inherits Rectangle {
    in property <string> group;
    in property <int> number;
    in property <color> tint;
    property <int> index: Controls.resolve(group, "hotcue_" + number + "_activate");
    property <int> clear-index: Controls.resolve(group, "hotcue_" + number + "_clear");
    // The press under way is deleting the cue rather than playing it.
    property <bool> clearing;
    property <bool> set: Controls.value(Controls.resolve(group, "hotcue_" + number + "_enabled"), Controls.tick) > 0;
    property <float> seconds: Controls.value(Controls.resolve(group, "hotcue_" + number + "_position"), Controls.tick);
    // A saved loop (hotcue type 4, as in Mixxx) shows a loop instead of a play mark.
    property <bool> is-loop: Controls.value(Controls.resolve(group, "hotcue_" + number + "_type"), Controls.tick) == 4;
    property <int> minutes: floor(seconds / 60);
    property <int> secs: floor(mod(seconds, 60));
    property <string> time: (minutes < 10 ? "0" : "") + minutes + ":" + (secs < 10 ? "0" : "") + secs;
    background: touch.pressed ? (set ? tint.with-alpha(0.3) : Theme.control-pressed)
        : touch.has-hover ? #1d1d20 : Theme.control;
    if set: HorizontalLayout {
        alignment: center;
        spacing: 5px;
        if !is-loop: Path {
            width: 7px;
            height: 8px;
            y: (parent.height - self.height) / 2;
            viewbox-width: 7;
            viewbox-height: 8;
            fill: tint;
            commands: "M 0 0 L 7 4 L 0 8 Z";
        }
        if is-loop: Rectangle {
            width: 11px;
            height: 7px;
            y: (parent.height - self.height) / 2;
            border-width: 1.5px;
            border-radius: 3.5px;
            border-color: tint;
        }
        Text {
            text: time;
            color: tint;
            font-family: "Inter Tabular";
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    if !set: Text { text: "+"; color: Theme.text-dim; font-size: 15px; font-weight: 400; }
    touch := TouchArea {
        pointer-event(e) => {
            if e.button != PointerEventButton.left {
                return;
            }
            if e.kind == PointerEventKind.down {
                if e.modifiers.shift {
                    // An empty pad does nothing, rather than setting a cue.
                    clearing = true;
                    if set {
                        Controls.set-value(clear-index, 1);
                    }
                } else {
                    Controls.set-value(index, 1);
                }
            } else if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                if clearing {
                    clearing = false;
                    Controls.set-value(clear-index, 0);
                } else {
                    Controls.set-value(index, 0);
                }
            }
        }
    }
}

// The pad tabs: four at a time, tabs 1-4 or 5-8 (see `first`), each
// showing one panel. Right-click a tab to put a different panel in it.
component PadTabs inherits Rectangle {
    in property <[string]> names;
    in property <[int]> slots;
    in-out property <int> selected;
    // Puts `panel` in tab `tab`.
    callback pick(tab: int, panel: int);
    // The first tab shown: 0 or 4.
    in property <int> first;
    property <int> menu-tab;
    // Square tabs on top of the pad grid, split by the same black lines:
    // the open one is lit like the pads, the others sit back darker.
    height: 23px;
    background: #000000;
    HorizontalLayout {
        padding: 1px;
        padding-bottom: 0px;
        spacing: 1px;
        for n in 4: Rectangle {
            property <int> i: first + n;
            horizontal-stretch: 1;
            min-width: 0px;
            preferred-width: 0px;
            background: i == selected ? Theme.panel-raised : Theme.well;
            Text { text: names[slots[i]]; color: i == selected ? Theme.text : Theme.text-dim; font-size: 10px; font-weight: 600; overflow: elide; }
            TouchArea {
                pointer-event(e) => {
                    if e.kind != PointerEventKind.down {
                        return;
                    }
                    if e.button == PointerEventButton.left && e.modifiers.shift {
                        // Its partner, as Shift + a pad mode button.
                        selected = mod(i + 4, 8);
                    } else if e.button == PointerEventButton.left {
                        selected = i;
                    } else if e.button == PointerEventButton.right {
                        menu-tab = i;
                        menu.show();
                    }
                }
            }
        }
    }
    menu := PopupWindow {
        x: root.width / 4 * (menu-tab - first);
        y: root.height + 2px;
        width: 130px;
        Rectangle {
            background: Theme.panel-raised;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 8px;
            drop-shadow-color: #00000080;
        }
        VerticalLayout {
            padding: 4px;
            for name[p] in names: PanelMenuItem {
                text: name;
                current: slots[menu-tab] == p;
                picked => {
                    root.pick(menu-tab, p);
                    selected = menu-tab;
                }
            }
        }
    }
}

// The page shifter left of the pads, as rekordbox has it: 1 and 2 when the
// open pad page has two pages, ‹ and › when it has more, and dimmed ‹ › when
// it has one.
component PadPager inherits Rectangle {
    in property <int> count;
    in property <int> current;
    callback pick(page: int);
    width: 18px;
    background: #000000;
    VerticalLayout {
        padding: 1px;
        spacing: 1px;
        for p in 2: Rectangle {
            property <bool> numbers: count == 2;
            property <bool> on: numbers && current == p;
            property <bool> can: numbers || (p == 0 ? current > 0 : current < count - 1);
            vertical-stretch: 1;
            background: on ? Theme.accent.with-alpha(0.22) : ta.has-hover && can ? #1d1d20 : Theme.control;
            Text {
                text: numbers ? p + 1 : p == 0 ? "‹" : "›";
                color: on ? Theme.accent : can ? Theme.text : Theme.text-dim.with-alpha(0.4);
                font-size: numbers ? 11px : 15px;
                font-weight: 700;
            }
            ta := TouchArea {
                enabled: can;
                clicked => { root.pick(numbers ? p : p == 0 ? current - 1 : current + 1); }
            }
        }
    }
}

// Pad grid with pages: a grid of flat cells split by thin
// black lines. Eight tabs, four at a time, follow the DDJ-FLX4's pad mode
// buttons: hot cues, Pad FX 1, beat jump and sampler, then with Shift the
// keyboard, Pad FX 2, beat loop and key shift (Shift-click a tab for its
// partner). A right-click on a tab swaps in another panel (stems, loop
// rolls). The shifter on the left flips the open panel's own pages.
export component Pads inherits HorizontalLayout {
    in property <int> deck;
    in property <string> group;
    in property <DeckInfo> info;
    // Which tab is open, and the panel each of the eight tabs shows: the
    // deck's `pad_slot_N`, which a controller's pads follow too.
    in-out property <int> tab: 0;
    property <[int]> slot-index: [
        Controls.resolve(group, "pad_slot_1"), Controls.resolve(group, "pad_slot_2"),
        Controls.resolve(group, "pad_slot_3"), Controls.resolve(group, "pad_slot_4"),
        Controls.resolve(group, "pad_slot_5"), Controls.resolve(group, "pad_slot_6"),
        Controls.resolve(group, "pad_slot_7"), Controls.resolve(group, "pad_slot_8"),
    ];
    property <[int]> slots: [
        Controls.value(slot-index[0], Controls.tick), Controls.value(slot-index[1], Controls.tick),
        Controls.value(slot-index[2], Controls.tick), Controls.value(slot-index[3], Controls.tick),
        Controls.value(slot-index[4], Controls.tick), Controls.value(slot-index[5], Controls.tick),
        Controls.value(slot-index[6], Controls.tick), Controls.value(slot-index[7], Controls.tick),
    ];
    property <int> page: slots[tab];
    property <color> tint: Theme.deck-color(deck);
    // Back and forward in pairs, as on the DDJ-FLX4's BEAT JUMP pads.
    property <[Pad]> jumps: [
        { key: "beatjump_4_backward", light: "beatjump_4_backward", text: "‹ 4" },
        { key: "beatjump_4_forward", light: "beatjump_4_forward", text: "4 ›" },
        { key: "beatjump_8_backward", light: "beatjump_8_backward", text: "‹ 8" },
        { key: "beatjump_8_forward", light: "beatjump_8_forward", text: "8 ›" },
        { key: "beatjump_16_backward", light: "beatjump_16_backward", text: "‹ 16" },
        { key: "beatjump_16_forward", light: "beatjump_16_forward", text: "16 ›" },
        { key: "beatjump_32_backward", light: "beatjump_32_backward", text: "‹ 32" },
        { key: "beatjump_32_forward", light: "beatjump_32_forward", text: "32 ›" },
    ];
    // VirtualDJ's STEMS pads: stems 1 to 5 are kick, bass, instruments,
    // vocals and hi-hats (see mixxx_engine::stems::default_info).
    property <[StemPadSpec]> stem-pads: [
        { stem: 4, text: "Vocal", tint: #09AD18 },
        { stem: 3, text: "Instru", tint: #A26018 },
        { stem: 2, text: "Bass", tint: #A21418 },
        { stem: 0, text: "Acapella", tint: #A9AAAB },
        { stem: 1, text: "Kick", tint: #2E4E75 },
        { stem: 5, text: "HiHat", tint: #0960B1 },
        { stem: -2, text: "Stems FX", tint: #5D5D5E },
        { stem: -1, text: "Instrumental", tint: #A9AAAB },
    ];
    property <[PadEffect]> pad-fx: [
        { effect: 1, meta: 0.6, text: "ECHO" },
        { effect: 2, meta: 0.7, text: "REVERB" },
        { effect: 3, meta: 0.2, text: "LOW PASS" },
        { effect: 3, meta: 0.8, text: "HIGH PASS" },
        { effect: 4, meta: 0.7, text: "FLANGER" },
        { effect: 6, meta: 0.7, text: "PHASER" },
        { effect: 5, meta: 0.7, text: "CRUSH" },
        { effect: 1, meta: 1.0, text: "ECHO MAX" },
    ];
    // Pad FX 2: the rhythmic and build-up effects.
    property <[PadEffect]> pad-fx2: [
        { effect: 8, meta: 0.5, text: "ROLL" },
        { effect: 7, meta: 0.5, text: "GATE" },
        { effect: 9, meta: 0.6, text: "ECHO OUT" },
        { effect: 10, meta: 0.5, text: "BRAKE" },
        { effect: 11, meta: 0.7, text: "NOISE" },
        { effect: 12, meta: 0.7, text: "SPIRAL" },
        { effect: 7, meta: 0.9, text: "GATE FAST" },
        { effect: 2, meta: 1.0, text: "REVERB MAX" },
    ];
    // Beat loops by size, as on the DDJ-FLX4's BEAT LOOP pads.
    property <[Pad]> loops: [
        { key: "beatloop_0.25_toggle", light: "beatloop_0.25_enabled", text: "1/4" },
        { key: "beatloop_0.5_toggle", light: "beatloop_0.5_enabled", text: "1/2" },
        { key: "beatloop_1_toggle", light: "beatloop_1_enabled", text: "1" },
        { key: "beatloop_2_toggle", light: "beatloop_2_enabled", text: "2" },
        { key: "beatloop_4_toggle", light: "beatloop_4_enabled", text: "4" },
        { key: "beatloop_8_toggle", light: "beatloop_8_enabled", text: "8" },
        { key: "beatloop_16_toggle", light: "beatloop_16_enabled", text: "16" },
        { key: "beatloop_32_toggle", light: "beatloop_32_enabled", text: "32" },
    ];
    // Loop rolls: a loop while the pad is held, then back to where the track
    // would have been.
    property <[Pad]> rolls: [
        { key: "beatlooproll_0.0625_activate", light: "beatlooproll_0.0625_activate", text: "1/16" },
        { key: "beatlooproll_0.125_activate", light: "beatlooproll_0.125_activate", text: "1/8" },
        { key: "beatlooproll_0.25_activate", light: "beatlooproll_0.25_activate", text: "1/4" },
        { key: "beatlooproll_0.5_activate", light: "beatlooproll_0.5_activate", text: "1/2" },
        { key: "beatlooproll_1_activate", light: "beatlooproll_1_activate", text: "1" },
        { key: "beatlooproll_2_activate", light: "beatlooproll_2_activate", text: "2" },
        { key: "beatlooproll_4_activate", light: "beatlooproll_4_activate", text: "4" },
        { key: "beatlooproll_8_activate", light: "beatlooproll_8_activate", text: "8" },
    ];
    // The engine's KEYBOARD_SEMITONES, pad by pad.
    property <[float]> keyboard-semitones: [0, 1, 2, 3, -4, -3, -2, -1];
    // KEY SHIFT pads, as the DDJ-FLX4 mapping lays them out: a key shift
    // each, and with Shift a step up or down.
    property <[float]> key-shift: [0, 1, 2, 3, -3, -2, -1, 0];
    property <[float]> key-steps: [1, 2, 3, 4, -4, -3, -2, -1];
    // KEYBOARD pads take the colour of the hot cue they play.
    property <int> cue-focus: Controls.value(Controls.resolve(group, "hotcue_focus"), Controls.tick);
    property <color> keyboard-tint: cue-focus >= 1 && cue-focus <= 8 ? Theme.hotcues[cue-focus - 1] : tint;
    // A controller's pad mode buttons open a tab by its place through
    // `pad_tab` (0-7), whatever panel is in it.
    property <int> tab-index: Controls.resolve(group, "pad_tab");
    property <int> requested-tab: Controls.value(tab-index, Controls.tick);
    changed requested-tab => {
        if requested-tab < 0 || requested-tab >= 8 {
            return;
        }
        tab = requested-tab;
        Controls.set-value(tab-index, -1);
    }
    // Or ask for a panel through `pad_panel`: open the tab that shows it,
    // or put it in the open tab.
    property <int> panel-index: Controls.resolve(group, "pad_panel");
    property <int> requested: Controls.value(panel-index, Controls.tick);
    changed requested => {
        if requested < 0 || requested >= 10 {
            return;
        }
        let wanted = requested;
        Controls.set-value(panel-index, -1);
        if slots[tab] == wanted {
        } else if slots[0] == wanted {
            tab = 0;
        } else if slots[1] == wanted {
            tab = 1;
        } else if slots[2] == wanted {
            tab = 2;
        } else if slots[3] == wanted {
            tab = 3;
        } else if slots[4] == wanted {
            tab = 4;
        } else if slots[5] == wanted {
            tab = 5;
        } else if slots[6] == wanted {
            tab = 6;
        } else if slots[7] == wanted {
            tab = 7;
        } else {
            Controls.set-value(slot-index[tab], wanted);
        }
    }
    // The sampler's two pages are the deck's `sampler_page`, which its
    // pads on a controller follow too.
    property <int> sampler-page-index: Controls.resolve(group, "sampler_page");
    property <int> sampler-page: Controls.value(sampler-page-index, Controls.tick);
    spacing: 4px;
    PadPager {
        count: page == 3 ? 2 : 1;
        current: page == 3 ? sampler-page : 0;
        pick(p) => {
            if page == 3 {
                Controls.set-value(sampler-page-index, p);
            }
        }
    }
    VerticalLayout {
        horizontal-stretch: 1;
        // The tabs sit right on the grid.
        spacing: 0px;
        PadTabs { names: ["HOT CUES", "PAD FX 1", "BEAT JUMP", "SAMPLER", "STEMS", "BEAT LOOP", "PAD FX 2", "KEYBOARD", "KEY SHIFT", "LOOP ROLL"]; slots: slots; selected <=> tab; pick(t, p) => { Controls.set-value(slot-index[t], p); } first: tab >= 4 ? 4 : 0; }
        if page == 3: SamplerPanel { bank: sampler-page; vertical-stretch: 1; }
        // The black background shows through the 1px gaps as the grid lines.
        if page != 3: Rectangle {
            vertical-stretch: 1;
            background: #000000;
            border-width: 1px;
            border-color: #000000;
            VerticalLayout {
                padding: 1px;
                spacing: 1px;
                for row in [0, 1]: HorizontalLayout {
                    spacing: 1px;
                    // Taller when there's room, filling the space under FX and loop.
                    min-height: 26px;
                    vertical-stretch: 1;
                    if page == 0: HorizontalLayout {
                        spacing: 1px;
                        horizontal-stretch: 1;
                        for i in 4: HotcueCell {
                            group: group;
                            number: row * 4 + i + 1;
                            tint: Theme.hotcues[row * 4 + i];
                            horizontal-stretch: 1; min-width: 0px; preferred-width: 0px;
                        }
                    }
                    if page == 1: HorizontalLayout {
                        spacing: 1px;
                        horizontal-stretch: 1;
                        for i in 4: PadFxButton { deck: deck; fx: pad-fx[row * 4 + i]; tint: tint; horizontal-stretch: 1; min-width: 0px; preferred-width: 0px; }
                    }
                    if page == 2: HorizontalLayout {
                        spacing: 1px;
                        horizontal-stretch: 1;
                        for i in 4: PadCell {
                            group: group;
                            key: jumps[row * 4 + i].key;
                            text: jumps[row * 4 + i].text;
                            tint: tint;
                            horizontal-stretch: 1; min-width: 0px; preferred-width: 0px;
                        }
                    }
                    if page == 5 || page == 9: HorizontalLayout {
                        spacing: 1px;
                        horizontal-stretch: 1;
                        for i in 4: PadCell {
                            group: group;
                            key: page == 5 ? loops[row * 4 + i].key : rolls[row * 4 + i].key;
                            light-key: page == 5 ? loops[row * 4 + i].light : rolls[row * 4 + i].light;
                            text: page == 5 ? loops[row * 4 + i].text : rolls[row * 4 + i].text;
                            tint: tint;
                            horizontal-stretch: 1; min-width: 0px; preferred-width: 0px;
                        }
                    }
                    if page == 6: HorizontalLayout {
                        spacing: 1px;
                        horizontal-stretch: 1;
                        for i in 4: PadFxButton { deck: deck; fx: pad-fx2[row * 4 + i]; tint: tint; horizontal-stretch: 1; min-width: 0px; preferred-width: 0px; }
                    }
                    if page == 7 || page == 8: HorizontalLayout {
                        spacing: 1px;
                        horizontal-stretch: 1;
                        for i in 4: KeyPad {
                            group: group;
                            keyboard: page == 7;
                            number: row * 4 + i + 1;
                            semitones: page == 7 ? keyboard-semitones[row * 4 + i] : key-shift[row * 4 + i];
                            step: key-steps[row * 4 + i];
                            tint: page == 7 ? keyboard-tint : tint;
                            horizontal-stretch: 1; min-width: 0px; preferred-width: 0px;
                        }
                    }
                    if page == 4: HorizontalLayout {
                        spacing: 1px;
                        horizontal-stretch: 1;
                        for i in 4: StemPad {
                            deck: deck;
                            info: info;
                            stem: stem-pads[row * 4 + i].stem;
                            text: stem-pads[row * 4 + i].text;
                            // The track's own colour for a stem, else VirtualDJ's.
                            tint: stem-pads[row * 4 + i].stem > 0 && stem-pads[row * 4 + i].stem <= info.stem-colors.length
                                ? info.stem-colors[stem-pads[row * 4 + i].stem - 1] : stem-pads[row * 4 + i].tint;
                            horizontal-stretch: 1; min-width: 0px; preferred-width: 0px;
                        }
                    }
                }
            }
        }
    }
}

// One press-and-release part of a LoopStepper.
component StepperPart inherits Rectangle {
    in property <int> index;
    in property <string> text;
    in property <length> font-size;
    in property <color> label-color: Theme.text;
    background: ta.pressed ? Theme.control-pressed : ta.has-hover ? #1d1d20 : transparent;
    Text { text: root.text; color: root.label-color; font-size: root.font-size; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
    ta := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if e.button != PointerEventButton.left {
                return;
            }
            if e.kind == PointerEventKind.down {
                Controls.set-value(index, 1);
            } else if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                Controls.set-value(index, 0);
            }
        }
    }
}

// The loop control: one box with halve on the left, the loop length in
// the middle (press to loop, again to stop; green while looping) and double
// on the right.
export component LoopStepper inherits Rectangle {
    in property <string> group;
    in property <DeckInfo> info;
    property <int> activate-index: Controls.resolve(group, "beatloop_activate");
    property <int> halve-index: Controls.resolve(group, "loop_halve");
    property <int> double-index: Controls.resolve(group, "loop_double");
    property <int> enabled-index: Controls.resolve(group, "loop_enabled");
    property <bool> looping: Controls.value(enabled-index, Controls.tick) > 0;
    border-radius: Theme.radius;
    background: Theme.control;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;
    HorizontalLayout {
        StepperPart { width: 26px; index: halve-index; text: "‹"; font-size: 18px; }
        Rectangle { width: 1px; background: Theme.border; }
        StepperPart { horizontal-stretch: 1; index: activate-index; text: info.loop-size; font-size: 15px; label-color: looping ? Theme.loop : Theme.text; }
        Rectangle { width: 1px; background: Theme.border; }
        StepperPart { width: 26px; index: double-index; text: "›"; font-size: 18px; }
    }
}

// Loop controls in a short row over the pads, at the deck's outer edge:
// LOOP, the loop length box (see LoopStepper), then IN and OUT. The
// effects are in the FX bar.
export component LoopSection inherits HorizontalLayout {
    in property <string> group;
    in property <DeckInfo> info;
    in property <color> tint;
    in property <bool> mirrored;
    spacing: 6px;
    height: 26px;
    alignment: mirrored ? end : start;
    Text { text: "LOOP"; color: Theme.text-dim; font-size: 10px; font-weight: 700; letter-spacing: 0.5px; vertical-alignment: center; }
    LoopStepper { group: group; info: info; width: 96px; }
    // A loop of any length: IN on the nearest beat lights grey while the
    // waveform marks the loop out; OUT closes it, and it turns lilac.
    ControlButton { group: group; key: "loop_in"; light-key: "loop_in_pending"; text: "IN"; momentary: true; tint: #d1d1d6; font-size: 11px; width: 40px; }
    ControlButton { group: group; key: "loop_out"; light-key: "loop_enabled"; text: "OUT"; momentary: true; tint: Theme.lilac; font-size: 11px; width: 40px; }
}

// The column beside the tempo fader: pitch reset always at its middle,
// level with 0%, and key lock under it.
component PitchSide inherits Rectangle {
    in property <string> group;
    in property <color> tint;
    in property <bool> mirrored;
    width: 12px;
    reset := PitchReset {
        y: (parent.height - self.height) / 2;
        group: group;
        tint: tint;
        points-left: mirrored;
    }
    KeyLock {
        y: reset.y + reset.height + 6px;
        group: group;
        right-aligned: mirrored;
    }
}

// A fine tempo step, − or +: just the sign, no button around it, held
// down to keep stepping as the button did.
export component TempoStep inherits Rectangle {
    in property <string> group;
    in property <string> key;
    in property <string> text;
    in property <color> tint;
    property <int> index: Controls.resolve(group, key);
    width: 22px;
    height: 22px;
    Text {
        text: root.text;
        color: touch.pressed ? tint : touch.has-hover ? Theme.text : Theme.text-dim;
        font-size: 20px;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if e.button != PointerEventButton.left {
                return;
            }
            if e.kind == PointerEventKind.down {
                Controls.set-value(index, 1);
            } else if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                Controls.set-value(index, 0);
            }
        }
    }
}

// The tempo column, everything on its centre line: SYNC (Shift-click to
// sync once) over quantize, the tempo, the fader, and the fine − and +.
// Pitch reset and key lock sit in the margin on the fader's outer side.
component Pitch inherits VerticalLayout {
    in property <string> group;
    in property <DeckInfo> info;
    in property <color> tint;
    // Deck B: pitch reset goes on the fader's right, its outer side.
    in property <bool> mirrored;
    width: 56px;
    spacing: 5px;
    ControlButton { group: group; key: "sync_enabled"; shift-key: "beatsync"; text: "SYNC"; tint: tint; fill-when-lit: true; font-size: 13px; height: 30px; }
    QuantizeButton { group: group; height: 22px; }
    Text { text: info.rate; color: Theme.text; font-size: 12px; font-weight: 500; horizontal-alignment: center; }
    Rectangle {
        vertical-stretch: 1;
        ControlFader {
            x: (parent.width - self.width) / 2;
            width: 32px;
            height: parent.height;
            group: group;
            key: "rate";
            center-mark: true;
            ticks: 9;
            tint: tint;
        }
        PitchSide {
            x: mirrored ? parent.width - self.width : 0px;
            height: parent.height;
            group: group;
            tint: tint;
            mirrored: mirrored;
        }
    }
    HorizontalLayout {
        alignment: center;
        spacing: 8px;
        TempoStep { group: group; key: "rate_perm_down_small"; text: "−"; tint: tint; }
        TempoStep { group: group; key: "rate_perm_up_small"; text: "+"; tint: tint; }
    }
}

// Play and pause in one button showing ▶: it fills with the deck colour
// while playing and its background blinks while a track waits, like a CDJ's.
export component PlayButton inherits Rectangle {
    in property <string> group;
    in property <color> tint;
    property <int> index: Controls.resolve(group, "play");
    property <bool> playing: Controls.value(index, Controls.tick) > 0;
    property <bool> loaded: Controls.value(Controls.resolve(group, "track_loaded"), Controls.tick) > 0;
    // Only with a track to play. A plain on and off, as on a CDJ: fading
    // each blink would keep the window redrawing most of the time.
    property <bool> blink: loaded && Controls.blink;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: playing ? tint : Theme.border;
    background: playing ? tint : touch.pressed ? Theme.control-pressed : blink ? tint.with-alpha(0.28) : Theme.control;
    Path {
        width: 16px;
        height: 18px;
        viewbox-width: 16;
        viewbox-height: 18;
        fill: playing ? #ffffff : Theme.text;
        commands: "M 1 1 L 15 9 L 1 17 Z";
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { Controls.set-value(index, playing ? 0 : 1); }
    }
}

// Play and CUE side by side under the jog, play on the left; SYNC is over
// the tempo fader (see Pitch).
component Transport inherits HorizontalLayout {
    in property <string> group;
    in property <color> tint;
    spacing: 6px;
    height: 36px;
    PlayButton { group: group; tint: tint; width: 70px; }
    ControlButton { group: group; key: "cue_default"; text: "CUE"; momentary: true; tint: Theme.cue; font-size: 14px; width: 70px; }
}

// A thin line between sections of a deck.
// Dividers in the deck body. Its 8px padding is bridged so each line runs
// panel edge to panel edge: a full-height one from the top of the body to
// the bottom, the one beside FX from the top down to the line under it.
component VDivider inherits Rectangle {
    in property <length> top: 8px;
    in property <length> bottom: 8px;
    width: 17px;
    EdgeVLine { x: 8px; height: parent.height; top: top; bottom: bottom; }
}

component HDivider inherits Rectangle {
    height: 9px;
    EdgeLine { y: 4px; width: parent.width; left: 8px; right: 8px; }
}

// The jog, with play and CUE under it.
component PlaySection inherits VerticalLayout {
    in property <string> group;
    in property <DeckInfo> info;
    in property <color> tint;
    in property <angle> spin;
    spacing: 8px;
    width: 172px;
    // The jog fills the space down to the buttons.
    Rectangle {
        vertical-stretch: 1;
        Jog {
            group: group;
            info: info;
            tint: tint;
            spin: spin;
            width: min(parent.width, parent.height);
            height: self.width;
        }
    }
    HorizontalLayout {
        alignment: center;
        Transport { group: group; tint: tint; }
    }
}

export component Deck inherits Rectangle {
    in property <int> deck;
    in property <DeckInfo> info;
    in property <image> overview;
    in property <bool> mirrored: false;
    // Set from the renderer each frame, so the jog marker turns smoothly.
    in property <angle> spin;
    out property <length> overview-width: header.overview-width;
    out property <length> overview-height: header.overview-height;
    property <string> group: "[Channel" + (deck + 1) + "]";
    property <color> tint: Theme.deck-color(deck);
    // Square panels split by thin black lines.
    // flight every deck shows a faint outline; the one under the cursor lights up.
    // First, so the sampler pads' own drop areas sit above it.
    drop := DropArea {
        can-drop(e) => { TrackDrag.accepts(e.data) ? DragAction.copy : DragAction.none }
        dropped(e) => {
            TrackDrag.drop(deck, e.data);
            TrackDrag.active = false;
            DragAction.copy
        }
    }
    VerticalLayout {
        spacing: 1px;

        header := Header { deck: deck; info: info; overview: overview; mirrored: mirrored; group: group; }

        Rectangle {
            background: Theme.panel;
            vertical-stretch: 1;
            // Split by thin lines: the loop over the pads, beside the
            // play section (jog, transport and tempo). Deck B is the
            // mirror image.
            HorizontalLayout {
                padding: 8px;
                spacing: 0px;
                if mirrored: Pitch { group: group; info: info; tint: tint; mirrored: true; }
                if mirrored: Rectangle { width: 12px; }
                if mirrored: PlaySection { group: group; info: info; tint: tint; spin: spin; }
                if mirrored: VDivider { }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 0px;
                    LoopSection { group: group; info: info; tint: tint; mirrored: mirrored; }
                    HDivider { }
                    Pads { deck: deck; group: group; info: info; vertical-stretch: 1; }
                }
                if !mirrored: VDivider { }
                if !mirrored: PlaySection { group: group; info: info; tint: tint; spin: spin; }
                if !mirrored: Rectangle { width: 12px; }
                if !mirrored: Pitch { group: group; info: info; tint: tint; }
            }
        }
    }

    // Drop target for tracks dragged from the browser. While any drag is in
    if TrackDrag.active || drop.has-drag: Rectangle {
        border-radius: Theme.radius + 2px;
        border-width: drop.has-drag ? 3px : 2px;
        border-color: drop.has-drag ? tint : tint.transparentize(0.55);
        background: drop.has-drag ? tint.transparentize(0.9) : transparent;
    }
}
