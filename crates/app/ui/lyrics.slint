// The side panel's Lyrics tab: the lyrics of the playing track (or the
// selected one, or a deck's), from an .lrc file beside it or its tags.
// Timed lyrics follow the deck: the line sung now is lit and kept in view,
// and a click on a line plays from there. Find looks the track up on
// LRCLIB. PlayerLyrics shows the same lyrics large in Player mode.
import { Theme } from "theme.slint";
import { ListView } from "scroll.slint";

export struct LyricLine {
    // m:ss, empty for plain lyrics.
    time: string,
    text: string,
}

// A record LRCLIB has for the track, in the Find list.
export struct LyricMatch {
    title: string,
    // "Artist · Album · 3:41".
    detail: string,
    // 0 synced, 1 plain words, 2 instrumental.
    kind: int,
    // Its length is within 2 s of the track's, so its timing fits.
    fits: bool,
}

export global LyricsUi {
    // What the tab follows: 0 the deck playing, 1 the selected track,
    // 2 deck A, 3 deck B.
    in-out property <int> subject;
    callback set-subject(subject: int);
    in property <bool> has-track;
    // "Artist · Title".
    in property <string> title;
    // Where the lyrics are from and how they are timed, e.g.
    // "Timed by word · Song.lrc". Empty when there are none.
    in property <string> source;
    in property <[LyricLine]> lines;
    // The line sung now, -1 for none.
    in property <int> current: -1;
    // Whether the track is on a deck, so a line click plays from it.
    in property <bool> can-seek;
    callback seek(line: int);
    // The line sung now split at the playhead, when timed by word: sung
    // words and the rest. Untimed words are all in `to-come`.
    in property <string> sung;
    in property <string> to-come;
    // Player mode's large lyrics, from the Lyrics button on the Player bar.
    in-out property <bool> big;
    // Find: the track is a file, so lyrics can be saved beside it; the
    // Find list is open; what it says (looking, nothing found); the records.
    in property <bool> can-find;
    in property <bool> finding;
    in property <string> find-note;
    in property <[LyricMatch]> found;
    callback find();
    callback use-found(row: int);
    callback close-found();
}

component SmallButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    callback clicked();
    height: 24px;
    width: label.preferred-width + 18px;
    border-radius: Theme.radius;
    background: primary ? (ta.has-hover ? Theme.accent.brighter(0.1) : Theme.accent) : ta.pressed ? Theme.control-pressed : ta.has-hover ? #2a2a2e : Theme.control;
    border-width: primary ? 0px : 1px;
    border-color: Theme.border;
    label := Text { text: root.text; color: primary ? Theme.on-selection : Theme.text; font-size: 12px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// LRCLIB's records for the track, best first; Use saves one.
component FindList inherits VerticalLayout {
    spacing: 4px;
    HorizontalLayout {
        height: 26px;
        spacing: 6px;
        Text { text: "Find lyrics"; color: Theme.text; font-size: 13px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
        SmallButton { text: "Close"; clicked => { LyricsUi.close-found(); } }
    }
    if LyricsUi.find-note != "": Text {
        text: LyricsUi.find-note;
        color: Theme.text-dim;
        font-size: 12px;
        wrap: word-wrap;
    }
    ListView {
        vertical-stretch: 1;
        for m[i] in LyricsUi.found: Rectangle {
            height: 46px;
            border-radius: Theme.radius;
            background: mta.has-hover ? #ffffff0a : transparent;
            mta := TouchArea { }
            HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                spacing: 8px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    Text { text: m.title; color: Theme.text; font-size: 13px; font-weight: 600; overflow: elide; }
                    Text {
                        text: (m.fits ? "" : "Other length · ") + m.detail;
                        color: m.fits ? Theme.text-dim : Theme.health-check;
                        font-size: 11px;
                        overflow: elide;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: 18px;
                        width: kind-text.preferred-width + 12px;
                        border-radius: 9px;
                        background: m.kind == 0 ? Theme.accent.with-alpha(0.18) : #ffffff10;
                        kind-text := Text {
                            text: ["Synced", "Plain", "Instrumental"][m.kind];
                            color: m.kind == 0 ? Theme.accent : Theme.text-dim;
                            font-size: 10px;
                            font-weight: 700;
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    if m.kind != 2: SmallButton { text: "Use"; primary: i == 0; clicked => { LyricsUi.use-found(i); } }
                }
            }
        }
    }
    Text {
        text: "From LRCLIB (lrclib.net). Saved as an .lrc file beside the track.";
        color: Theme.label;
        font-size: 10px;
        wrap: word-wrap;
    }
}

export component LyricsPanel inherits Rectangle {
    property <length> row-height: 26px;
    background: Theme.browser;
    // Keeps the line sung now a third of the way down.
    function follow() {
        if LyricsUi.current >= 0 {
            list.content-y = min(0px, max(list.visible-height - LyricsUi.lines.length * row-height, -(LyricsUi.current * row-height - list.visible-height / 3)));
        }
    }
    changed width => { follow(); }
    VerticalLayout {
        padding: 6px;
        padding-top: 2px;
        spacing: 4px;
        HorizontalLayout {
            height: 30px;
            spacing: 6px;
            Text { text: "Lyrics"; color: Theme.text; font-size: 15px; font-weight: 600; vertical-alignment: center; }
            Rectangle {
                width: subject-text.preferred-width + 26px;
                border-radius: 4px;
                background: subject-ta.has-hover ? #ffffff10 : transparent;
                subject-text := Text {
                    x: 6px;
                    text: ["Playing", "Selected", "Deck A", "Deck B"][LyricsUi.subject] + "  ▾";
                    color: Theme.text-dim;
                    font-size: 13px;
                    vertical-alignment: center;
                }
                subject-ta := TouchArea { clicked => { subject-menu.show(); } }
                subject-menu := PopupWindow {
                    y: parent.height + 2px;
                    width: 150px;
                    Rectangle {
                        background: Theme.panel-raised;
                        border-radius: Theme.radius;
                        border-width: 1px;
                        border-color: Theme.border;
                        drop-shadow-blur: 12px;
                        drop-shadow-color: #000000a0;
                    }
                    VerticalLayout {
                        padding: 6px;
                        for s[i] in ["Playing track", "Selected track", "Deck A", "Deck B"]: Rectangle {
                            height: 26px;
                            border-radius: 4px;
                            background: sta.has-hover ? #3a3a3d : transparent;
                            Text {
                                x: 10px;
                                text: s;
                                color: i == LyricsUi.subject ? Theme.accent : Theme.text;
                                font-size: 13px;
                                vertical-alignment: center;
                            }
                            sta := TouchArea { clicked => { LyricsUi.set-subject(i); } }
                        }
                    }
                }
            }
            Rectangle { horizontal-stretch: 1; }
            if LyricsUi.has-track && LyricsUi.can-find && !LyricsUi.finding: VerticalLayout {
                alignment: center;
                SmallButton { text: "Find…"; clicked => { LyricsUi.find(); } }
            }
        }
        if LyricsUi.has-track: VerticalLayout {
            spacing: 1px;
            Text { text: LyricsUi.title; color: Theme.text; font-size: 12px; font-weight: 600; overflow: elide; }
            if LyricsUi.source != "": Text { text: LyricsUi.source; color: Theme.label; font-size: 11px; overflow: elide; }
        }
        if LyricsUi.finding: FindList { vertical-stretch: 1; }
        if !LyricsUi.finding && (!LyricsUi.has-track || LyricsUi.lines.length == 0): VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            padding: 20px;
            spacing: 6px;
            Text {
                text: !LyricsUi.has-track ? (LyricsUi.subject == 0 ? "Nothing playing" : "No track") : "No lyrics";
                color: Theme.text;
                font-size: 15px;
                font-weight: 600;
                horizontal-alignment: center;
            }
            Text {
                text: !LyricsUi.has-track
                    ? (LyricsUi.subject == 0 ? "Lyrics show here for the track playing." : LyricsUi.subject == 1 ? "Click a track in the browser to see its lyrics." : "Nothing is loaded on that deck.")
                    : "Put an .lrc file with the same name next to the track, add lyrics to its tags, or press Find.";
                color: Theme.text-dim;
                font-size: 12px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
        list := ListView {
            property <bool> shown: !LyricsUi.finding && LyricsUi.has-track && LyricsUi.lines.length > 0;
            // Hidden items still take room in a layout: none when hidden.
            vertical-stretch: shown ? 1 : 0;
            max-height: shown ? 100000px : 0px;
            visible: shown;
            for line[i] in LyricsUi.lines: Rectangle {
                height: row-height;
                property <bool> now: i == LyricsUi.current;
                property <bool> sung: LyricsUi.current >= 0 && i < LyricsUi.current;
                property <bool> seekable: LyricsUi.can-seek && line.time != "";
                border-radius: Theme.radius;
                background: now ? Theme.accent.with-alpha(0.14) : ta.has-hover && seekable ? #ffffff08 : transparent;
                ta := TouchArea {
                    mouse-cursor: seekable ? pointer : default;
                    clicked => {
                        if seekable { LyricsUi.seek(i); }
                    }
                }
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    spacing: 8px;
                    if line.time != "": Text {
                        width: 34px;
                        text: line.time;
                        color: now ? Theme.accent : Theme.text-dim.with-alpha(0.7);
                        font-family: "Inter Tabular";
                        font-size: 11px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                    Text {
                        horizontal-stretch: 1;
                        // A timed line with no words is a break in the singing.
                        text: line.text == "" && line.time != "" ? "♪" : line.text;
                        color: now ? Theme.text : sung ? Theme.text-dim.with-alpha(0.75) : line.text == "" ? Theme.text-dim : Theme.text.with-alpha(0.88);
                        font-size: 13px;
                        font-weight: now ? 700 : 400;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
    property <int> sung-now: LyricsUi.current;
    changed sung-now => { follow(); }
}

// Player mode's large lyrics, in place of the track list: the line sung now
// big and white with its sung words in lilac, lines gone by dimmed, the
// next ones under it. A click on a line plays from it.
export component PlayerLyrics inherits Rectangle {
    property <length> row-height: 54px;
    background: Theme.browser;
    Rectangle { background: @linear-gradient(180deg, Theme.accent.with-alpha(0.12) 0%, Theme.browser.with-alpha(0) 70%); }
    function follow() {
        if LyricsUi.current >= 0 {
            list.content-y = min(0px, max(list.visible-height - LyricsUi.lines.length * row-height, -(LyricsUi.current * row-height - list.visible-height * 0.38)));
        }
    }
    property <int> sung-now: LyricsUi.current;
    changed sung-now => { follow(); }
    changed height => { follow(); }
    if !LyricsUi.has-track || LyricsUi.lines.length == 0: VerticalLayout {
        alignment: center;
        spacing: 8px;
        Text {
            text: !LyricsUi.has-track ? "Nothing playing" : "No lyrics for this track";
            color: Theme.text;
            font-size: 24px;
            font-weight: 700;
            horizontal-alignment: center;
        }
        Text {
            text: !LyricsUi.has-track ? "Lyrics show here for the track playing." : "Put an .lrc file with the same name next to it, or use Find in the side panel's Lyrics tab.";
            color: Theme.text-dim;
            font-size: 14px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        if LyricsUi.has-track && LyricsUi.can-find: HorizontalLayout {
            alignment: center;
            SmallButton { text: "Find lyrics"; clicked => { LyricsUi.find(); } }
        }
    }
    list := ListView {
        x: 0;
        width: parent.width;
        visible: LyricsUi.has-track && LyricsUi.lines.length > 0;
        for line[i] in LyricsUi.lines: Rectangle {
            height: row-height;
            property <bool> now: i == LyricsUi.current;
            property <bool> gone: LyricsUi.current >= 0 && i < LyricsUi.current;
            property <bool> seekable: LyricsUi.can-seek && line.time != "";
            lta := TouchArea {
                mouse-cursor: seekable ? pointer : default;
                clicked => {
                    if seekable { LyricsUi.seek(i); }
                }
            }
            HorizontalLayout {
                padding-left: 48px;
                padding-right: 48px;
                alignment: start;
                if now && LyricsUi.sung != "": Text {
                    text: LyricsUi.sung;
                    color: Theme.accent;
                    font-size: 30px;
                    font-weight: 800;
                    vertical-alignment: center;
                }
                Text {
                    text: now && LyricsUi.sung != "" ? LyricsUi.to-come
                        : line.text == "" && line.time != "" ? "♪" : line.text;
                    color: now ? Theme.text
                        : gone ? Theme.text-dim.with-alpha(0.45)
                        : lta.has-hover && seekable ? Theme.text.with-alpha(0.85) : Theme.text-dim;
                    font-size: now ? 30px : 24px;
                    font-weight: now ? 800 : 700;
                    overflow: elide;
                    vertical-alignment: center;
                }
            }
        }
    }
}
