// The side panel's Lyrics tab: the lyrics of the playing track (or the
// selected one, or a deck's), from an .lrc file beside it or its tags.
// Timed lyrics follow the deck: the line sung now is lit and kept in view,
// and a click on a line plays from there. Find looks the track up on
// LRCLIB. PlayerLyrics shows the same lyrics large in Player mode.
import { Theme } from "theme.slint";
import { ListView } from "scroll.slint";

export struct LyricLine {
    // m:ss, empty for plain lyrics.
    time: string,
    text: string,
}

// A record LRCLIB has for the track, in the Find list.
export struct LyricMatch {
    title: string,
    // "Artist · Album · 3:41".
    detail: string,
    // 0 synced, 1 plain words, 2 instrumental.
    kind: int,
    // Its length is within 2 s of the track's, so its timing fits.
    fits: bool,
}

export global LyricsUi {
    // What the tab follows: 0 the deck playing, 1 the selected track,
    // 2 deck A, 3 deck B.
    in-out property <int> subject;
    callback set-subject(subject: int);
    in property <bool> has-track;
    // "Artist · Title".
    in property <string> title;
    // Where the lyrics are from and how they are timed, e.g.
    // "Timed by word · Song.lrc". Empty when there are none.
    in property <string> source;
    in property <[LyricLine]> lines;
    // The line sung now, -1 for none.
    in property <int> current: -1;
    // Whether the track is on a deck, so a line click plays from it.
    in property <bool> can-seek;
    callback seek(line: int);
    // The line sung now split at the playhead, when timed by word: sung
    // words and the rest. Untimed words are all in `to-come`.
    in property <string> sung;
    in property <string> to-come;
    // Player mode's large lyrics, from the Lyrics button on the Player bar.
    in-out property <bool> big;
    // Find: the track is a file, so lyrics can be saved beside it; the
    // Find list is open; what it says (looking, nothing found); the records.
    in property <bool> can-find;
    in property <bool> finding;
    in property <string> find-note;
    in property <[LyricMatch]> found;
    callback find();
    callback use-found(row: int);
    callback close-found();
    // Find lyrics online is off: the Find list says so and offers to turn it on.
    in property <bool> lookup-off;
    callback enable-lookup();
    // The karaoke screen, a window of its own; it follows the track playing.
    in-out property <bool> karaoke;
    callback set-karaoke(on: bool);
    // The guide vocal: the vocal stem's level on the deck the karaoke screen
    // follows, 0 gone to 1 full; -1 with nothing playing.
    in property <float> vocals: -1;
    callback set-vocals(level: float);
    // The karaoke page for a TV or another device's browser, served while
    // the karaoke screen is open and this is on; its address once it runs.
    in property <bool> page;
    in property <string> page-url;
    callback set-page(on: bool);
    // Time words: Whisper listens to the vocals and gives each word of the
    // lyrics shown its time. Offered for lyrics not timed by word yet;
    // what it is doing (downloading, separating, listening) or why it failed.
    in property <bool> can-time;
    in property <string> time-note;
    callback time-words();
    // Transcribe: the same for a track with no lyrics, writing down the
    // words heard (time-words does it when there are no lyrics).
    in property <bool> can-transcribe;
}

// A line of a deck's lyrics on its big waveform: seconds into the track.
export struct WaveLine {
    start: float,
    end: float,
    text: string,
}

export struct DeckLines {
    lines: [WaveLine],
}

// The lyrics along the bottom of each deck's big waveform.
export global WaveLyrics {
    // Settings › Decks › Lyrics on waveforms.
    in property <bool> shown: true;
    // Deck 1 first; a deck with no timed lyrics has no lines.
    in property <[DeckLines]> decks;
}

// The lyrics lane along the bottom of a big waveform: each line a strip
// from when it is sung to when it ends, scrolling with the audio, its words
// lilac as far as the playhead (the middle) has gone.
export component LyricsLane inherits Rectangle {
    in property <[WaveLine]> lines;
    // Seconds into the track at the playhead, and seconds across the width.
    in property <float> now;
    in property <float> visible-seconds: 10;
    property <length> per-second: self.width / max(visible-seconds, 0.1);
    property <length> mid: self.width / 2;
    height: 15px;
    clip: true;
    background: #000000a8;
    for line in lines: strip := Rectangle {
        x: mid + (line.start - now) * per-second;
        width: max(4px, (line.end - line.start) * per-second);
        y: 2px;
        height: parent.height - 4px;
        property <bool> singing: now >= line.start && now < line.end;
        visible: self.x < parent.width && self.x + self.width > 0;
        border-radius: 3px;
        background: singing ? Theme.accent.with-alpha(0.22) : #ffffff12;
        words := Text {
            x: 4px;
            width: parent.width - 6px;
            text: line.text;
            color: singing ? Theme.text : Theme.text-dim;
            font-size: 10px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
        // The part already sung, drawn over in lilac: the words fill in
        // step with the line, as far as it has been sung.
        Rectangle {
            x: 0;
            width: 4px + min(words.preferred-width, words.width) * clamp((now - line.start) / max(line.end - line.start, 0.01), 0, 1);
            clip: true;
            Text {
                x: 4px;
                width: strip.width - 6px;
                text: line.text;
                color: Theme.accent;
                font-size: 10px;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}

component SmallButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    callback clicked();
    height: 24px;
    width: label.preferred-width + 18px;
    border-radius: Theme.radius;
    background: primary ? (ta.has-hover ? Theme.accent.brighter(0.1) : Theme.accent) : ta.pressed ? Theme.control-pressed : ta.has-hover ? #2a2a2e : Theme.control;
    border-width: primary ? 0px : 1px;
    border-color: Theme.border;
    label := Text { text: root.text; color: primary ? Theme.on-selection : Theme.text; font-size: 12px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// The guide vocal slider: a thin track filled to a round thumb. A click
// jumps there, a drag moves it, a double click puts the voice back.
component VocalSlider inherits Rectangle {
    property <length> thumb: 16px;
    property <length> travel: self.width - thumb;
    height: 20px;
    min-width: 60px;
    Rectangle { x: thumb / 2; width: travel; height: 4px; border-radius: 2px; background: #3a3a3e; }
    Rectangle { x: thumb / 2; width: LyricsUi.vocals * travel; height: 4px; border-radius: 2px; background: Theme.accent; }
    Rectangle {
        x: LyricsUi.vocals * travel;
        width: thumb;
        height: 14px;
        border-radius: 7px;
        background: ta.pressed ? #d4d4d8 : #f2f2f4;
        drop-shadow-blur: 3px;
        drop-shadow-color: #00000080;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                LyricsUi.set-vocals(clamp((self.mouse-x - thumb / 2) / travel, 0, 1));
            }
        }
        moved => {
            if self.pressed {
                LyricsUi.set-vocals(clamp((self.mouse-x - thumb / 2) / travel, 0, 1));
            }
        }
        double-clicked => { LyricsUi.set-vocals(1); }
    }
}

// LRCLIB's records for the track, best first; Use saves one.
component FindList inherits VerticalLayout {
    spacing: 4px;
    HorizontalLayout {
        height: 26px;
        spacing: 6px;
        Text { text: "Find lyrics"; color: Theme.text; font-size: 13px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
        SmallButton { text: "Close"; clicked => { LyricsUi.close-found(); } }
    }
    if LyricsUi.find-note != "": Text {
        text: LyricsUi.find-note;
        color: Theme.text-dim;
        font-size: 12px;
        wrap: word-wrap;
    }
    if LyricsUi.lookup-off: HorizontalLayout {
        alignment: start;
        SmallButton { text: "Turn On and Find"; primary: true; clicked => { LyricsUi.enable-lookup(); } }
    }
    ListView {
        vertical-stretch: 1;
        for m[i] in LyricsUi.found: Rectangle {
            height: 46px;
            border-radius: Theme.radius;
            background: mta.has-hover ? #ffffff0a : transparent;
            mta := TouchArea { }
            HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                spacing: 8px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    Text { text: m.title; color: Theme.text; font-size: 13px; font-weight: 600; overflow: elide; }
                    Text {
                        text: (m.fits ? "" : "Other length · ") + m.detail;
                        color: m.fits ? Theme.text-dim : Theme.health-check;
                        font-size: 11px;
                        overflow: elide;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: 18px;
                        width: kind-text.preferred-width + 12px;
                        border-radius: 9px;
                        background: m.kind == 0 ? Theme.accent.with-alpha(0.18) : #ffffff10;
                        kind-text := Text {
                            text: ["Synced", "Plain", "Instrumental"][m.kind];
                            color: m.kind == 0 ? Theme.accent : Theme.text-dim;
                            font-size: 10px;
                            font-weight: 700;
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    if m.kind != 2: SmallButton { text: "Use"; primary: i == 0; clicked => { LyricsUi.use-found(i); } }
                }
            }
        }
    }
    Text {
        text: "From LRCLIB (lrclib.net). Saved as an .lrc file beside the track.";
        color: Theme.label;
        font-size: 10px;
        wrap: word-wrap;
    }
}

export component LyricsPanel inherits Rectangle {
    property <length> row-height: 26px;
    background: Theme.browser;
    // Keeps the line sung now a third of the way down.
    function follow() {
        if LyricsUi.current >= 0 {
            list.content-y = min(0px, max(list.visible-height - LyricsUi.lines.length * row-height, -(LyricsUi.current * row-height - list.visible-height / 3)));
        }
    }
    changed width => { follow(); }
    VerticalLayout {
        padding: 6px;
        padding-top: 2px;
        spacing: 4px;
        HorizontalLayout {
            height: 30px;
            spacing: 6px;
            Text { text: "Lyrics"; color: Theme.text; font-size: 15px; font-weight: 600; vertical-alignment: center; }
            Rectangle {
                width: subject-text.preferred-width + 26px;
                border-radius: 4px;
                background: subject-ta.has-hover ? #ffffff10 : transparent;
                subject-text := Text {
                    x: 6px;
                    text: ["Playing", "Selected", "Deck A", "Deck B"][LyricsUi.subject] + "  ▾";
                    color: Theme.text-dim;
                    font-size: 13px;
                    vertical-alignment: center;
                }
                subject-ta := TouchArea { clicked => { subject-menu.show(); } }
                subject-menu := PopupWindow {
                    y: parent.height + 2px;
                    width: 150px;
                    Rectangle {
                        background: Theme.panel-raised;
                        border-radius: Theme.radius;
                        border-width: 1px;
                        border-color: Theme.border;
                        drop-shadow-blur: 12px;
                        drop-shadow-color: #000000a0;
                    }
                    VerticalLayout {
                        padding: 6px;
                        for s[i] in ["Playing track", "Selected track", "Deck A", "Deck B"]: Rectangle {
                            height: 26px;
                            border-radius: 4px;
                            background: sta.has-hover ? #3a3a3d : transparent;
                            Text {
                                x: 10px;
                                text: s;
                                color: i == LyricsUi.subject ? Theme.accent : Theme.text;
                                font-size: 13px;
                                vertical-alignment: center;
                            }
                            sta := TouchArea { clicked => { LyricsUi.set-subject(i); } }
                        }
                    }
                }
            }
            Rectangle { horizontal-stretch: 1; }
            if LyricsUi.has-track && LyricsUi.can-find && !LyricsUi.finding: VerticalLayout {
                alignment: center;
                SmallButton { text: "Find…"; clicked => { LyricsUi.find(); } }
            }
            VerticalLayout {
                alignment: center;
                SmallButton { text: "Karaoke"; primary: LyricsUi.karaoke; clicked => { LyricsUi.set-karaoke(!LyricsUi.karaoke); } }
            }
        }
        // While the karaoke screen is open: how loud the singer's voice
        // stays in the mix, from gone (left) to full (right).
        if LyricsUi.karaoke: HorizontalLayout {
            height: 26px;
            spacing: 8px;
            Text { text: "Vocals"; color: Theme.text-dim; font-size: 12px; vertical-alignment: center; }
            if LyricsUi.vocals >= 0: VocalSlider { horizontal-stretch: 1; }
            if LyricsUi.vocals >= 0: Text {
                width: 36px;
                text: round(LyricsUi.vocals * 100) + "%";
                color: Theme.text-dim;
                font-size: 12px;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            if LyricsUi.vocals < 0: Text {
                horizontal-stretch: 1;
                text: "Nothing playing";
                color: Theme.label;
                font-size: 12px;
                vertical-alignment: center;
            }
        }
        // The same screen as a web page, for a TV or a tablet on the network.
        if LyricsUi.karaoke: HorizontalLayout {
            height: 26px;
            spacing: 8px;
            Text { text: "Web page"; color: Theme.text-dim; font-size: 12px; vertical-alignment: center; }
            Text {
                horizontal-stretch: 1;
                text: !LyricsUi.page ? "Off" : LyricsUi.page-url != "" ? LyricsUi.page-url : "Starting…";
                color: LyricsUi.page && LyricsUi.page-url != "" ? Theme.accent : Theme.label;
                font-size: 12px;
                vertical-alignment: center;
                overflow: elide;
            }
            VerticalLayout {
                alignment: center;
                SmallButton { text: LyricsUi.page ? "Stop" : "Share"; clicked => { LyricsUi.set-page(!LyricsUi.page); } }
            }
        }
        if LyricsUi.has-track: VerticalLayout {
            spacing: 1px;
            Text { text: LyricsUi.title; color: Theme.text; font-size: 12px; font-weight: 600; overflow: elide; }
            if LyricsUi.source != "" || LyricsUi.can-time: HorizontalLayout {
                spacing: 6px;
                Text {
                    horizontal-stretch: 1;
                    text: LyricsUi.source;
                    color: Theme.label;
                    font-size: 11px;
                    overflow: elide;
                    vertical-alignment: center;
                }
                // Whisper gives each word its time, so the words fill as
                // they are sung.
                if LyricsUi.can-time && !LyricsUi.finding: SmallButton {
                    text: "Time Words";
                    clicked => { LyricsUi.time-words(); }
                }
            }
            if LyricsUi.time-note != "": Text {
                text: LyricsUi.time-note;
                color: Theme.accent;
                font-size: 11px;
                wrap: word-wrap;
            }
        }
        if LyricsUi.finding: FindList { vertical-stretch: 1; }
        if !LyricsUi.finding && (!LyricsUi.has-track || LyricsUi.lines.length == 0): VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            padding: 20px;
            spacing: 6px;
            Text {
                text: !LyricsUi.has-track ? (LyricsUi.subject == 0 ? "Nothing playing" : "No track") : "No lyrics";
                color: Theme.text;
                font-size: 15px;
                font-weight: 600;
                horizontal-alignment: center;
            }
            Text {
                text: !LyricsUi.has-track
                    ? (LyricsUi.subject == 0 ? "Lyrics show here for the track playing." : LyricsUi.subject == 1 ? "Click a track in the browser to see its lyrics." : "Nothing is loaded on that deck.")
                    : LyricsUi.can-transcribe
                    ? "Put an .lrc file with the same name next to the track, add lyrics to its tags, press Find, or let openDJ write down the words it hears."
                    : "Put an .lrc file with the same name next to the track, add lyrics to its tags, or press Find.";
                color: Theme.text-dim;
                font-size: 12px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            if LyricsUi.has-track && LyricsUi.can-transcribe: HorizontalLayout {
                alignment: center;
                padding-top: 6px;
                SmallButton { text: "Transcribe"; clicked => { LyricsUi.time-words(); } }
            }
        }
        list := ListView {
            property <bool> shown: !LyricsUi.finding && LyricsUi.has-track && LyricsUi.lines.length > 0;
            // Hidden items still take room in a layout: none when hidden.
            vertical-stretch: shown ? 1 : 0;
            max-height: shown ? 100000px : 0px;
            visible: shown;
            for line[i] in LyricsUi.lines: Rectangle {
                height: row-height;
                property <bool> now: i == LyricsUi.current;
                property <bool> sung: LyricsUi.current >= 0 && i < LyricsUi.current;
                property <bool> seekable: LyricsUi.can-seek && line.time != "";
                border-radius: Theme.radius;
                background: now ? Theme.accent.with-alpha(0.14) : ta.has-hover && seekable ? #ffffff08 : transparent;
                ta := TouchArea {
                    mouse-cursor: seekable ? pointer : default;
                    clicked => {
                        if seekable { LyricsUi.seek(i); }
                    }
                }
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    spacing: 8px;
                    if line.time != "": Text {
                        width: 34px;
                        text: line.time;
                        color: now ? Theme.accent : Theme.text-dim.with-alpha(0.7);
                        font-family: "Inter Tabular";
                        font-size: 11px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                    Text {
                        horizontal-stretch: 1;
                        // A timed line with no words is a break in the singing.
                        text: line.text == "" && line.time != "" ? "♪" : line.text;
                        color: now ? Theme.text : sung ? Theme.text-dim.with-alpha(0.75) : line.text == "" ? Theme.text-dim : Theme.text.with-alpha(0.88);
                        font-size: 13px;
                        font-weight: now ? 700 : 400;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
    property <int> sung-now: LyricsUi.current;
    changed sung-now => { follow(); }
}

// Player mode's large lyrics, in place of the track list: the line sung now
// big and white with its sung words in lilac, lines gone by dimmed, the
// next ones under it. A click on a line plays from it.
export component PlayerLyrics inherits Rectangle {
    property <length> row-height: 54px;
    // Inside Now Playing: no background of its own, and the lines start at
    // its left edge.
    in property <bool> back: true;
    in property <length> inset: 48px;
    background: back ? Theme.browser : transparent;
    if back: Rectangle { background: @linear-gradient(180deg, Theme.accent.with-alpha(0.12) 0%, Theme.browser.with-alpha(0) 70%); }
    function follow() {
        if LyricsUi.current >= 0 {
            list.content-y = min(0px, max(list.visible-height - LyricsUi.lines.length * row-height, -(LyricsUi.current * row-height - list.visible-height * 0.38)));
        }
    }
    property <int> sung-now: LyricsUi.current;
    changed sung-now => { follow(); }
    changed height => { follow(); }
    if !LyricsUi.has-track || LyricsUi.lines.length == 0: VerticalLayout {
        alignment: center;
        spacing: 8px;
        Text {
            text: !LyricsUi.has-track ? "Nothing playing" : "No lyrics for this track";
            color: Theme.text;
            font-size: 24px;
            font-weight: 700;
            horizontal-alignment: center;
        }
        Text {
            text: !LyricsUi.has-track ? "Lyrics show here for the track playing." : "Put an .lrc file with the same name next to it, or use Find in the side panel's Lyrics tab.";
            color: Theme.text-dim;
            font-size: 14px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        if LyricsUi.has-track && LyricsUi.can-find: HorizontalLayout {
            alignment: center;
            SmallButton { text: "Find lyrics"; clicked => { LyricsUi.find(); } }
        }
    }
    list := ListView {
        x: 0;
        width: parent.width;
        visible: LyricsUi.has-track && LyricsUi.lines.length > 0;
        for line[i] in LyricsUi.lines: Rectangle {
            height: row-height;
            property <bool> now: i == LyricsUi.current;
            property <bool> gone: LyricsUi.current >= 0 && i < LyricsUi.current;
            property <bool> seekable: LyricsUi.can-seek && line.time != "";
            lta := TouchArea {
                mouse-cursor: seekable ? pointer : default;
                clicked => {
                    if seekable { LyricsUi.seek(i); }
                }
            }
            HorizontalLayout {
                padding-left: inset;
                padding-right: inset;
                alignment: start;
                if now && LyricsUi.sung != "": Text {
                    text: LyricsUi.sung;
                    color: Theme.accent;
                    font-size: 30px;
                    font-weight: 800;
                    vertical-alignment: center;
                }
                Text {
                    text: now && LyricsUi.sung != "" ? LyricsUi.to-come
                        : line.text == "" && line.time != "" ? "♪" : line.text;
                    color: now ? Theme.text
                        : gone ? Theme.text-dim.with-alpha(0.45)
                        : lta.has-hover && seekable ? Theme.text.with-alpha(0.85) : Theme.text-dim;
                    font-size: now ? 30px : 24px;
                    font-weight: now ? 800 : 700;
                    overflow: elide;
                    vertical-alignment: center;
                }
            }
        }
    }
    // Find, from the button above, when the side panel isn't showing it.
    if LyricsUi.finding: Rectangle {
        background: #000000a0;
        TouchArea { }
        Rectangle {
            width: min(560px, parent.width - 32px);
            height: min(460px, parent.height - 32px);
            background: Theme.browser;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            FindList { x: 12px; y: 10px; width: parent.width - 24px; height: parent.height - 20px; }
        }
    }
    // Opens the karaoke screen for a second display.
    SmallButton {
        x: parent.width - self.width - 16px;
        y: 12px;
        text: LyricsUi.karaoke ? "Close Karaoke" : "Karaoke Screen";
        primary: LyricsUi.karaoke;
        clicked => { LyricsUi.set-karaoke(!LyricsUi.karaoke); }
    }
}
