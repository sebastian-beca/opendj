// The side panel's Info tab: the track selected in the library (or on a
// deck), its tags and the library's own fields, editable in place, with a
// preview player for the headphones and a cover art search.
import { Theme, EdgeLine, CloseIcon } from "theme.slint";

// A tag in a tag field, and how many of the tracks shown have it.
export struct TagChip {
    tag: string,
    count: int,
    // The color the DJ gave the tag, when `has-color`.
    tint: color,
    has-color: bool,
}

// One line of the info list.
export struct InfoField {
    // What the line is, for `TrackInfo.edit` ("title", "artist", ...).
    id: string,
    label: string,
    value: string,
    // 0 text to edit, 1 text to read, 2 rating (value "0" to "5"),
    // 4 text to read with a button (`action`), 5 tags as `chips` with a
    // box to add more.
    kind: int,
    // Shown greyed in an empty field.
    hint: string,
    action: string,
    // The tab it is on: 0 Track, 1 Tags, 2 File.
    tab: int,
    // Short: it shares a line with the field next to it.
    half: bool,
    // With several tracks shown: how many values they have here (0 when
    // they share one), and whether a change waits for Apply.
    mixed: int,
    edited: bool,
    chips: [TagChip],
}

// A line of the info list: one field, or two short ones side by side.
export struct InfoLine {
    a: InfoField,
    b: InfoField,
    two: bool,
}

// A value several tracks have in a field, and how many have it.
export struct ValueChoice {
    value: string,
    count: int,
}

// A cover the search found.
export struct CoverChoice {
    image: image,
    source: string,
    // "599x535"
    size: string,
}

export global TrackInfo {
    in property <bool> has-track;
    // Its file can take tags: a local file that is on disk.
    in property <bool> editable;
    in property <string> title;
    in property <string> artist;
    in property <image> cover;
    in property <bool> has-cover;
    // The lines of the tab shown.
    in property <[InfoLine]> fields;
    // The tab shown (0 Track, 1 Tags, 2 File), and the tabs with changes
    // waiting for Apply.
    in property <int> tab;
    in property <[bool]> tab-edited;
    callback set-tab(tab: int);
    // Tag fields: adds the tags typed to every track shown, or takes one
    // off them all; while typing, the collection's tags that match.
    callback tag-add(id: string, tags: string);
    callback tag-remove(id: string, tag: string);
    callback tag-suggest(id: string, typed: string);
    in property <[string]> suggestions;
    in property <string> suggest-for;
    // The rating, shown under the title.
    in property <int> rating;
    // Several tracks shown (how many; 0 for one): fields edit them all,
    // and `pending` changes wait for Apply or Discard.
    in property <int> many;
    in property <int> pending;
    callback apply();
    callback discard();
    // Fills `choices` with the values the tracks have in field `id`.
    callback values(id: string);
    in property <[ValueChoice]> choices;
    // Takes back what was typed in field `id`, so each track keeps its own.
    callback keep(id: string);
    // What the panel shows: 0 the track selected in the list, 1 deck A, 2 deck B.
    in-out property <int> subject;
    callback set-subject(subject: int);
    callback edit(id: string, value: string);
    callback reveal();
    // Something went wrong saving, shown under the list until the next edit;
    // or, with `status-ok`, what an Apply did.
    in property <string> status;
    in property <bool> status-ok;

    // The preview player, heard in the headphones.
    in property <bool> preview-playing;
    // 0 to 1, and the time played.
    in property <float> preview-position;
    in property <string> preview-time;
    callback preview-toggle();
    callback preview-seek(position: float);
    // The track's mini waveform (white, colored here), once analysed; the
    // preview bar is a plain line until then.
    in property <image> wave;
    in property <bool> has-wave;

    // The cover art dialog.
    in-out property <bool> cover-open;
    in property <[CoverChoice]> covers;
    in property <bool> cover-searching;
    callback find-covers();
    // Saves cover `index` into the track's tags.
    callback save-cover(index: int);
}

// A word button with a thin border.
component TextButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked();
    width: label.preferred-width + 20px;
    height: 24px;
    border-radius: 5px;
    background: !enabled ? Theme.panel-raised : primary ? (ta.pressed ? Theme.accent.darker(0.2) : ta.has-hover ? Theme.accent.brighter(0.1) : Theme.accent)
        : ta.pressed ? Theme.control-pressed : ta.has-hover ? Theme.panel-raised.brighter(0.3) : Theme.panel-raised;
    border-width: primary ? 0px : 1px;
    border-color: Theme.border;
    label := Text {
        text: root.text;
        color: !enabled ? Theme.text-dim : primary ? Theme.on-selection : Theme.text;
        font-size: 12px;
        font-weight: 600;
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// A value that turns into a text field on click; Return or clicking
// elsewhere saves it.
component EditLine inherits Rectangle {
    in property <string> value;
    in property <string> hint;
    in property <bool> enabled: true;
    callback commit(text: string);
    height: 22px;
    border-radius: 4px;
    background: input.has-focus ? Theme.well : hover.has-hover && enabled ? #ffffff0c : transparent;
    border-width: input.has-focus ? 1px : 0px;
    border-color: Theme.accent;
    // Typing breaks the binding to `value`; a new track puts it back.
    changed value => { input.text = value; }
    hover := TouchArea {
        enabled: root.enabled;
        mouse-cursor: text;
        clicked => { input.focus(); }
    }
    if input.text == "" && !input.has-focus: Text {
        x: 6px;
        width: parent.width - 12px;
        text: hint;
        color: Theme.text-dim.with-alpha(0.6);
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }
    input := TextInput {
        x: 6px;
        width: parent.width - 12px;
        text: value;
        enabled: root.enabled;
        read-only: !root.enabled;
        single-line: true;
        color: Theme.text;
        selection-background-color: Theme.selection;
        selection-foreground-color: Theme.on-selection;
        font-size: 13px;
        vertical-alignment: center;
        accepted => {
            if self.text != value { commit(self.text); }
            self.clear-focus();
        }
        changed has-focus => {
            if !self.has-focus && self.text != value { commit(self.text); }
        }
    }
}

// Five stars to click; clicking the rating given takes it off.
component Stars inherits HorizontalLayout {
    in property <int> rating;
    in property <bool> enabled: true;
    callback rate(stars: int);
    spacing: 2px;
    alignment: start;
    property <int> hovered: -1;
    for i in 5: Rectangle {
        width: 20px;
        height: 22px;
        property <bool> lit: hovered >= 0 ? i <= hovered : i < rating;
        Text {
            text: lit ? "★" : "☆";
            color: lit ? Theme.accent : Theme.text-dim;
            font-size: 16px;
        }
        ta := TouchArea {
            enabled: root.enabled;
            changed has-hover => {
                if self.has-hover { hovered = i; } else if hovered == i { hovered = -1; }
            }
            clicked => { rate(rating == i + 1 ? 0 : i + 1); }
        }
    }
}

// A line of the values menu.
component ValueLine inherits Rectangle {
    in property <string> text;
    in property <int> count: -1;
    in property <bool> dim;
    callback clicked();
    height: 26px;
    border-radius: 4px;
    background: ta.has-hover ? Theme.selection : transparent;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text {
            horizontal-stretch: 1;
            text: root.text;
            color: ta.has-hover ? Theme.on-selection : dim ? Theme.text-dim : Theme.text;
            font-size: 13px;
            font-italic: dim;
            vertical-alignment: center;
            overflow: elide;
        }
        if count >= 0: Text {
            text: count;
            color: ta.has-hover ? Theme.on-selection : Theme.text-dim;
            font-size: 12px;
            vertical-alignment: center;
        }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// A tag. On only some of the tracks shown, it is outlined with how many
// have it, and a click puts it on all; × takes it off all.
component Chip inherits Rectangle {
    in property <string> tag;
    in property <int> count;
    in property <bool> enabled: true;
    // The tag's color, as a dot before its name.
    in property <color> tint;
    in property <bool> has-color;
    // A suggestion to add, not a tag the tracks have.
    in property <bool> offer;
    callback add();
    callback remove();
    property <bool> some: !offer && TrackInfo.many > 0 && count < TrackInfo.many;
    height: 22px;
    width: row.preferred-width;
    border-radius: 11px;
    background: offer ? (ta.has-hover ? Theme.selection : transparent)
        : some ? (ta.has-hover ? #ffffff10 : transparent) : #4A4A4D;
    border-width: offer || some ? 1px : 0px;
    border-color: offer ? Theme.accent.with-alpha(0.5) : Theme.text-dim;
    ta := TouchArea {
        enabled: root.enabled && (root.offer || root.some);
        mouse-cursor: self.enabled ? pointer : default;
        clicked => { root.add(); }
    }
    row := HorizontalLayout {
        padding-left: 8px;
        padding-right: offer ? 8px : 2px;
        spacing: 4px;
        if has-color: VerticalLayout {
            alignment: center;
            Rectangle { width: 8px; height: 8px; border-radius: 4px; background: root.tint; }
        }
        Text {
            text: root.tag;
            color: offer ? (ta.has-hover ? Theme.on-selection : Theme.accent) : some ? Theme.text-dim : Theme.text;
            font-size: 12px;
            vertical-alignment: center;
        }
        if some: Text {
            text: root.count + "/" + TrackInfo.many;
            color: Theme.text-dim;
            font-size: 11px;
            vertical-alignment: center;
        }
        if !offer: Rectangle {
            width: 16px;
            Rectangle {
                width: 14px;
                height: 14px;
                border-radius: 7px;
                background: x.has-hover ? #ffffff20 : transparent;
            }
            Text {
                text: "×";
                color: x.has-hover ? Theme.text : Theme.text-dim;
                font-size: 13px;
            }
            x := TouchArea {
                enabled: root.enabled;
                clicked => { root.remove(); }
            }
        }
    }
}

// A tag field: its tags, a box to type more in, and the collection's tags
// that match what is typed.
component TagField inherits VerticalLayout {
    in property <InfoField> field;
    in property <bool> editable;
    spacing: 4px;
    padding-top: 1px;
    padding-bottom: 1px;
    FlexboxLayout {
        spacing: 4px;
        for c in field.chips: Chip {
            tag: c.tag;
            count: c.count;
            tint: c.tint;
            has-color: c.has-color;
            enabled: editable;
            add => { TrackInfo.tag-add(field.id, c.tag); }
            remove => { TrackInfo.tag-remove(field.id, c.tag); }
        }
        Rectangle {
            width: 90px;
            height: 22px;
            border-radius: 11px;
            background: input.has-focus ? Theme.well : add-ta.has-hover ? #ffffff0c : transparent;
            border-width: 1px;
            border-color: input.has-focus ? Theme.accent : Theme.border;
            add-ta := TouchArea {
                enabled: editable;
                mouse-cursor: text;
                clicked => { input.focus(); }
            }
            if input.text == "" && !input.has-focus: Text {
                x: 9px;
                text: field.hint;
                color: Theme.text-dim.with-alpha(0.7);
                font-size: 12px;
                vertical-alignment: center;
            }
            input := TextInput {
                x: 9px;
                width: parent.width - 18px;
                enabled: editable;
                single-line: true;
                color: Theme.text;
                selection-background-color: Theme.selection;
                selection-foreground-color: Theme.on-selection;
                font-size: 12px;
                vertical-alignment: center;
                edited => { TrackInfo.tag-suggest(field.id, self.text); }
                accepted => {
                    if self.text != "" { TrackInfo.tag-add(field.id, self.text); }
                    self.text = "";
                }
                changed has-focus => {
                    if !self.has-focus { TrackInfo.tag-suggest(field.id, ""); }
                }
            }
        }
    }
    if TrackInfo.suggest-for == field.id && TrackInfo.suggestions.length > 0: FlexboxLayout {
        spacing: 4px;
        for s in TrackInfo.suggestions: Chip {
            tag: s;
            offer: true;
            enabled: editable;
            add => { TrackInfo.tag-add(field.id, s); }
        }
    }
}

// One field: its label and its value.
component InfoCell inherits Rectangle {
    in property <InfoField> field;
    in property <bool> editable;
    in property <length> label-width: 86px;
    min-height: 24px;
    HorizontalLayout {
        spacing: 6px;
        // Level with the first line of a field that takes several.
        VerticalLayout {
            alignment: start;
            Text {
                width: root.label-width;
                height: 24px;
                // A change waiting for Apply is marked in lilac.
                text: (field.edited ? "● " : "") + field.label;
                color: field.edited ? Theme.accent : Theme.label;
                font-size: 10px;
                font-weight: 600;
                letter-spacing: 0.4px;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        if field.kind == 5: TagField {
            horizontal-stretch: 1;
            field: root.field;
            editable: root.editable;
        }
        if field.kind == 0: EditLine {
            horizontal-stretch: 1;
            y: 1px;
            value: field.value;
            hint: field.hint;
            enabled: editable;
            commit(text) => { TrackInfo.edit(field.id, text); }
        }
        // With several tracks: the values they have, to pick one for all,
        // keep each track's own or clear it in all.
        if field.kind == 0 && TrackInfo.many > 0: Rectangle {
            width: 22px;
            border-radius: 4px;
            background: vta.has-hover ? #ffffff14 : transparent;
            Text {
                text: "▾";
                color: field.mixed > 1 || field.edited ? Theme.text : Theme.text-dim.with-alpha(0.5);
                font-size: 11px;
            }
            vta := TouchArea {
                enabled: editable;
                clicked => {
                    TrackInfo.values(field.id);
                    values-menu.show();
                }
            }
            values-menu := PopupWindow {
                x: parent.width - 240px;
                y: parent.height;
                width: 240px;
                Rectangle {
                    background: Theme.panel-raised;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: Theme.border;
                    drop-shadow-blur: 12px;
                    drop-shadow-color: #000000a0;
                }
                VerticalLayout {
                    padding: 6px;
                    ValueLine {
                        text: "Keep each track's own";
                        dim: true;
                        clicked => { TrackInfo.keep(field.id); }
                    }
                    Rectangle { height: 1px; background: Theme.border; }
                    for c in TrackInfo.choices: ValueLine {
                        text: c.value == "" ? "(empty)" : c.value;
                        dim: c.value == "";
                        count: c.count;
                        clicked => { TrackInfo.edit(field.id, c.value); }
                    }
                    Rectangle { height: 1px; background: Theme.border; }
                    ValueLine {
                        text: "Clear in all " + TrackInfo.many;
                        clicked => { TrackInfo.edit(field.id, ""); }
                    }
                }
            }
        }
        if field.kind == 1 || field.kind == 4: Text {
            horizontal-stretch: 1;
            text: field.value == "" ? "–" : field.value;
            color: Theme.text;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
        }
        if field.kind == 4: VerticalLayout {
            alignment: center;
            TextButton {
                text: field.action;
                clicked => { TrackInfo.reveal(); }
            }
        }
        if field.kind == 2: Stars {
            horizontal-stretch: 1;
            rating: field.value.to-float();
            enabled: editable;
            rate(n) => { TrackInfo.edit(field.id, n); }
        }
    }
}

// A line of the list: one field, or two short ones side by side, the
// second with a label just wide enough.
component InfoRow inherits HorizontalLayout {
    in property <InfoLine> line;
    in property <bool> editable;
    spacing: 10px;
    InfoCell {
        width: line.two ? (root.width - root.spacing) / 2 : root.width;
        field: line.a;
        editable: root.editable;
    }
    if line.two: InfoCell {
        width: (root.width - root.spacing) / 2;
        field: line.b;
        editable: root.editable;
        label-width: 52px;
    }
}

// The play button and a bar to seek with, for the preview player.
component PreviewBar inherits HorizontalLayout {
    spacing: 10px;
    height: 28px;
    Rectangle {
        width: 28px;
        border-radius: 14px;
        background: play.pressed ? Theme.control-pressed : play.has-hover ? Theme.panel-raised.brighter(0.3) : Theme.panel-raised;
        Path {
            width: 12px;
            height: 12px;
            viewbox-width: 12;
            viewbox-height: 12;
            fill: TrackInfo.preview-playing ? Theme.accent : Theme.text;
            commands: TrackInfo.preview-playing ? "M 1.5 1 L 4.5 1 L 4.5 11 L 1.5 11 Z M 7.5 1 L 10.5 1 L 10.5 11 L 7.5 11 Z" : "M 2.5 0.5 L 11 6 L 2.5 11.5 Z";
        }
        play := TouchArea { clicked => { TrackInfo.preview-toggle(); } }
    }
    bar := Rectangle {
        horizontal-stretch: 1;
        if !TrackInfo.has-wave: Rectangle {
            y: (parent.height - self.height) / 2;
            height: 3px;
            border-radius: 1.5px;
            background: Theme.border;
        }
        if !TrackInfo.has-wave: Rectangle {
            x: 0px;
            y: (parent.height - self.height) / 2;
            width: parent.width * TrackInfo.preview-position;
            height: 3px;
            border-radius: 1.5px;
            background: Theme.accent;
        }
        // The waveform: what has played in lilac, the rest gray.
        if TrackInfo.has-wave: Image {
            width: parent.width;
            height: parent.height;
            source: TrackInfo.wave;
            image-fit: fill;
            colorize: Theme.text-dim;
        }
        if TrackInfo.has-wave: Rectangle {
            x: 0px;
            width: parent.width * TrackInfo.preview-position;
            clip: true;
            Image {
                x: 0px;
                width: bar.width;
                height: bar.height;
                source: TrackInfo.wave;
                image-fit: fill;
                colorize: Theme.lilac;
            }
        }
        if TrackInfo.has-wave && TrackInfo.preview-position > 0: Rectangle {
            x: parent.width * TrackInfo.preview-position - 1px;
            width: 2px;
            background: Theme.text;
        }
        Rectangle {
            x: parent.width * TrackInfo.preview-position - self.width / 2;
            y: (parent.height - self.height) / 2;
            width: seek.has-hover || seek.pressed ? 11px : 0px;
            height: self.width;
            border-radius: self.width / 2;
            background: Theme.text;
        }
        seek := TouchArea {
            function to(x: length) {
                TrackInfo.preview-seek(max(0, min(1, x / parent.width)));
            }
            pointer-event(e) => {
                if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                    to(self.mouse-x);
                }
            }
            moved => {
                if self.pressed { to(self.mouse-x); }
            }
        }
    }
    Text {
        text: TrackInfo.preview-time;
        color: Theme.text-dim;
        font-size: 11px;
        vertical-alignment: center;
    }
}

// Covers found for the track, to pick one and save it to the tags.
component CoverDialog inherits Rectangle {
    property <int> picked: -1;
    background: Theme.panel-raised;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.border;
    drop-shadow-blur: 24px;
    drop-shadow-color: #000000c0;
    TouchArea { }
    VerticalLayout {
        padding: 14px;
        spacing: 10px;
        HorizontalLayout {
            height: 24px;
            Text {
                horizontal-stretch: 1;
                text: "Cover Art";
                color: Theme.text;
                font-size: 15px;
                font-weight: 700;
                vertical-alignment: center;
            }
            Rectangle {
                width: 24px;
                border-radius: 12px;
                background: close.has-hover ? Theme.control-pressed : transparent;
                CloseIcon { size: 10px; color: close.has-hover ? Theme.text : Theme.text-dim; }
                close := TouchArea { clicked => { TrackInfo.cover-open = false; } }
            }
        }
        Flickable {
            height: 196px;
            content-width: max(self.width, choices.preferred-width);
            choices := HorizontalLayout {
                spacing: 12px;
                alignment: start;
                for c[i] in TrackInfo.covers: Rectangle {
                    width: 150px;
                    border-radius: 6px;
                    background: i == picked ? Theme.accent.with-alpha(0.18) : pick.has-hover ? #ffffff0a : transparent;
                    border-width: i == picked ? 2px : 0px;
                    border-color: Theme.accent;
                    VerticalLayout {
                        padding: 6px;
                        spacing: 4px;
                        Rectangle {
                            height: 138px;
                            background: Theme.well;
                            clip: true;
                            Image { width: parent.width; height: parent.height; source: c.image; image-fit: contain; }
                        }
                        Text { text: c.source; color: Theme.text; font-size: 12px; font-weight: 600; horizontal-alignment: center; }
                        Text { text: c.size; color: Theme.text-dim; font-size: 11px; horizontal-alignment: center; }
                    }
                    pick := TouchArea {
                        clicked => { picked = i; }
                        double-clicked => {
                            TrackInfo.save-cover(i);
                        }
                    }
                }
                if TrackInfo.covers.length == 0: Text {
                    width: 400px;
                    text: TrackInfo.cover-searching ? "Looking for covers…" : "No covers found. Check the artist and album, then search again.";
                    color: Theme.text-dim;
                    font-size: 13px;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            Text {
                horizontal-stretch: 1;
                text: TrackInfo.cover-searching && TrackInfo.covers.length > 0 ? "Still looking…" : "";
                color: Theme.text-dim;
                font-size: 12px;
                vertical-alignment: center;
            }
            TextButton {
                text: "Search again";
                enabled: !TrackInfo.cover-searching;
                clicked => {
                    picked = -1;
                    TrackInfo.find-covers();
                }
            }
            TextButton {
                text: "Save to Tag";
                primary: true;
                enabled: picked >= 0 && picked < TrackInfo.covers.length && TrackInfo.editable;
                clicked => { TrackInfo.save-cover(picked); }
            }
        }
    }
}

// The Info tab's content.
export component InfoPanel inherits Rectangle {
    property <length> menu-y;
    if !TrackInfo.has-track: VerticalLayout {
        alignment: center;
        padding: 20px;
        spacing: 6px;
        Text { text: "No track"; color: Theme.text; font-size: 15px; font-weight: 600; horizontal-alignment: center; }
        Text {
            text: TrackInfo.subject == 0 ? "Click a track in the browser to see its info." : "Nothing is loaded on that deck.";
            color: Theme.text-dim;
            font-size: 12px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
    VerticalLayout {
        padding: 6px;
        padding-top: 2px;
        spacing: 8px;
        // What the panel follows: the selection or a deck.
        HorizontalLayout {
            height: 30px;
            spacing: 6px;
            Text { text: "Info"; color: Theme.text; font-size: 15px; font-weight: 600; vertical-alignment: center; }
            Rectangle {
                width: subject-text.preferred-width + 26px;
                border-radius: 4px;
                background: subject-ta.has-hover ? #ffffff10 : transparent;
                subject-text := Text {
                    x: 6px;
                    text: ["Selected", "Deck A", "Deck B"][TrackInfo.subject] + "  ▾";
                    color: Theme.text-dim;
                    font-size: 13px;
                    vertical-alignment: center;
                }
                subject-ta := TouchArea { clicked => { subject-menu.show(); } }
                subject-menu := PopupWindow {
                    y: parent.height + 2px;
                    width: 140px;
                    Rectangle {
                        background: Theme.panel-raised;
                        border-radius: Theme.radius;
                        border-width: 1px;
                        border-color: Theme.border;
                        drop-shadow-blur: 12px;
                        drop-shadow-color: #000000a0;
                    }
                    VerticalLayout {
                        padding: 6px;
                        for s[i] in ["Selected track", "Deck A", "Deck B"]: Rectangle {
                            height: 26px;
                            border-radius: 4px;
                            background: sta.has-hover ? #3a3a3d : transparent;
                            Text {
                                x: 10px;
                                text: s;
                                color: i == TrackInfo.subject ? Theme.accent : Theme.text;
                                font-size: 13px;
                                vertical-alignment: center;
                            }
                            sta := TouchArea { clicked => { TrackInfo.set-subject(i); } }
                        }
                    }
                }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        if TrackInfo.has-track: HorizontalLayout {
            spacing: 12px;
            height: 72px;
            art := Rectangle {
                width: 72px;
                border-radius: 4px;
                clip: true;
                background: Theme.control;
                border-width: art-ta.has-hover && !TrackInfo.has-cover ? 1px : 0px;
                border-color: Theme.border;
                if TrackInfo.has-cover: Image { width: parent.width; height: parent.height; source: TrackInfo.cover; image-fit: cover; }
                if !TrackInfo.has-cover: Text { text: "♪"; color: Theme.text-dim; font-size: 28px; }
                // Right-click (or click, when there is none) looks for a cover.
                art-ta := TouchArea {
                    clicked => {
                        if !TrackInfo.has-cover {
                            TrackInfo.cover-open = true;
                            TrackInfo.find-covers();
                        }
                    }
                    pointer-event(e) => {
                        if e.button == PointerEventButton.right && e.kind == PointerEventKind.down {
                            TrackInfo.cover-open = true;
                            TrackInfo.find-covers();
                        }
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 4px;
                Text { text: TrackInfo.title; color: Theme.text; font-size: 16px; font-weight: 600; overflow: elide; }
                Text { text: TrackInfo.artist; color: Theme.text-dim; font-size: 13px; overflow: elide; }
                // The rating, first thing to set while preparing a track.
                Stars {
                    rating: TrackInfo.rating;
                    enabled: TrackInfo.editable;
                    rate(n) => { TrackInfo.edit("rating", n); }
                }
            }
        }
        if TrackInfo.has-track && TrackInfo.many == 0: PreviewBar { }
        // The tabs: the names, the DJ's tags, the file.
        if TrackInfo.has-track: Rectangle {
            height: 28px;
            HorizontalLayout {
                for name[i] in ["Track", "Tags", "File"]: Rectangle {
                    horizontal-stretch: 1;
                    property <bool> on: i == TrackInfo.tab;
                    background: tab-ta.has-hover && !on ? #ffffff08 : transparent;
                    Text {
                        // A change waiting for Apply on a tab not shown.
                        text: (TrackInfo.tab-edited[i] ? "● " : "") + name;
                        color: on ? Theme.accent : tab-ta.has-hover || TrackInfo.tab-edited[i] ? Theme.text : Theme.text-dim;
                        font-size: 12px;
                        font-weight: 600;
                    }
                    Rectangle {
                        y: parent.height - self.height;
                        height: 2px;
                        background: on ? Theme.accent : transparent;
                    }
                    tab-ta := TouchArea { clicked => { TrackInfo.set-tab(i); } }
                }
            }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.separator;
            }
        }
        if TrackInfo.has-track: Rectangle {
            vertical-stretch: 1;
            list := Flickable {
                width: parent.width - 8px;
                x: 0px;
                content-height: rows.preferred-height;
                rows := VerticalLayout {
                    width: parent.width;
                    padding-bottom: 12px;
                    spacing: 2px;
                    alignment: start;
                    for l in TrackInfo.fields: InfoRow { line: l; editable: TrackInfo.editable; }
                    if TrackInfo.status != "": Text {
                        text: TrackInfo.status;
                        color: TrackInfo.status-ok ? Theme.text-dim : Theme.danger;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
            }
            // A thin scroll bar, while there is more to see.
            if list.content-height > list.height: Rectangle {
                x: parent.width - 4px;
                width: 4px;
                property <float> shown: list.height / list.content-height;
                height: max(24px, list.height * shown);
                y: -list.content-y / (list.content-height - list.height) * (list.height - self.height);
                border-radius: 2px;
                background: #ffffff40;
            }
        }
        // Several tracks: what waits, and Apply or Discard.
        if TrackInfo.has-track && TrackInfo.many > 0: HorizontalLayout {
            height: 30px;
            spacing: 8px;
            Text {
                horizontal-stretch: 1;
                text: TrackInfo.pending == 0 ? "Type in a field to change all " + TrackInfo.many
                    : (TrackInfo.pending == 1 ? "1 change" : TrackInfo.pending + " changes") + " · " + TrackInfo.many + " tracks";
                color: Theme.text-dim;
                font-size: 12px;
                vertical-alignment: center;
                overflow: elide;
            }
            VerticalLayout {
                alignment: center;
                TextButton {
                    text: "Discard";
                    enabled: TrackInfo.pending > 0;
                    clicked => { TrackInfo.discard(); }
                }
            }
            VerticalLayout {
                alignment: center;
                TextButton {
                    text: "Apply";
                    primary: true;
                    enabled: TrackInfo.pending > 0 && TrackInfo.editable;
                    clicked => { TrackInfo.apply(); }
                }
            }
        }
    }
    // Over the panel and to its left, so three covers fit side by side.
    property <bool> cover-open: TrackInfo.cover-open;
    changed cover-open => {
        if cover-open { cover-dialog.show(); } else { cover-dialog.close(); }
    }
    // Still open from before the tab was left.
    init => {
        if cover-open { cover-dialog.show(); }
    }
    cover-dialog := PopupWindow {
        x: root.width - self.width - 4px;
        y: 110px;
        width: 520px;
        height: 290px;
        close-policy: no-auto-close;
        CoverDialog { }
    }
}
