// The filter bar above the track list, as djay Pro has: a chip per field
// showing what it's set to, "+" to add another field, and a popup to pick
// values. The app turns the chips into search text.
import { LineEdit } from "std-widgets.slint";
import { ScrollView } from "scroll.slint";
import { Theme, CloseIcon } from "theme.slint";
import { TourMark } from "tourmark.slint";
import { CrateIcon } from "crate_icon.slint";

export struct FilterChip {
    // The field: "genre", "tag1", "bpm".
    field: string,
    label: string,
    // What it's set to, or "--".
    value: string,
    active: bool,
    pinned: bool,
    // 0 pick values, 1 tag words (any or all), 2 tempo, 3 key.
    kind: int,
}

export struct FilterChoice {
    label: string,
    count: int,
    on: bool,
    swatch: color,
    has-swatch: bool,
    // A crate's icon (see CrateIcon), -1 for none, and its color, -1 for
    // none.
    icon: int,
    icon-tint: int,
}

// A value the finder offers: "Mood · Dark 41".
export struct FilterSuggestion {
    field: string,
    value: string,
    count: int,
}

// The finder's list: values from any field that match what was typed;
// `highlight` is the one Return adds.
export component SuggestionList inherits Rectangle {
    in property <[FilterSuggestion]> items;
    in property <int> highlight: -1;
    callback picked(i: int);
    VerticalLayout {
        for s[i] in items: Rectangle {
            height: 28px;
            border-radius: 5px;
            background: i == highlight ? Theme.selection : sta.has-hover ? Theme.n-3a3a3d : transparent;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 8px;
                Text { text: s.field; color: i == highlight ? Theme.on-selection : Theme.text-dim; font-size: 12px; vertical-alignment: center; width: 76px; overflow: elide; }
                Text { text: s.value; color: i == highlight ? Theme.on-selection : Theme.text; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                Text { text: s.count; color: i == highlight ? Theme.on-selection : Theme.text-dim; font-size: 12px; vertical-alignment: center; }
            }
            sta := TouchArea { mouse-cursor: pointer; clicked => { picked(i); } }
        }
    }
}

export global FilterUi {
    // The bar shows above the list.
    in-out property <bool> shown: true;
    // Some chip narrows the list.
    in property <bool> any-active;
    in property <[FilterChip]> chips;
    // Fields not on the bar, for "+": names and ids.
    in property <[string]> addable;
    in property <[string]> addable-ids;
    // Where each is listed: 0 core, 1 the DJ's tag groups, 2 more.
    in property <[int]> addable-sections;
    // The chip whose popup is open, and what it offers.
    in property <int> editing: -1;
    in property <[FilterChoice]> choices;
    // Values left out of the list until "Show N more".
    in property <int> more;
    in-out property <string> choice-search;
    in property <bool> match-all;
    // Tempo or key follows the playing track, and what that is now.
    in property <bool> follow;
    in property <string> follow-note;
    in-out property <string> bpm-low;
    in-out property <string> bpm-high;
    in property <int> tolerance;
    in property <[string]> tolerances: ["±2%", "±4%", "±6%", "±8%", "±10%"];
    // Set to open the "Add Filter" menu, as for a new smart playlist, once
    // the bar is showing.
    in-out property <bool> open-add;
    callback set-shown(on: bool);
    // Puts a field on the bar; returns its chip.
    callback add(field: string) -> int;
    callback edit(chip: int);
    // BPM or Key: match the playing track, or stop filtering.
    callback quick(chip: int);
    callback toggle(choice: int);
    callback search-choices(text: string);
    callback show-more();
    // The finder: values of any field matching what's typed, and the one
    // ↑/↓ point at in the search bar's list.
    in property <[FilterSuggestion]> suggestions;
    in-out property <int> highlight: -1;
    callback find(text: string);
    callback pick-suggestion(i: int);
    callback set-match-all(on: bool);
    callback set-follow(on: bool);
    callback set-bpm(low: string, high: string);
    callback set-tolerance(i: int);
    // Key: by the app's setting, the same key, Harmonic or Fuzzy.
    in property <int> key-match;
    callback set-key-match(i: int);
    // Takes a chip off the bar.
    callback remove(chip: int);
    // Where each chip sits along the bar, so a dragged one knows where
    // it lands.
    callback placed(chip: int, x: length, width: length);
    // A chip dragged to `x` along the bar: Rust sets `drop-x` to where it
    // would land, or -1px when it would stay.
    callback drag(chip: int, x: length);
    callback drop(chip: int, x: length);
    in-out property <length> drop-x: -1px;
    callback clear(chip: int);
    callback clear-all();
}

component PopupBackground inherits Rectangle {
    background: Theme.panel-raised;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.border;
    drop-shadow-blur: 16px;
    drop-shadow-color: Theme.s-000000b0;
}

component Toggle inherits Rectangle {
    in property <bool> on;
    callback toggled();
    width: 34px;
    height: 20px;
    border-radius: 10px;
    background: on ? Theme.accent : Theme.n-48484a;
    Rectangle {
        x: on ? 16px : 2px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: Theme.n-ffffff;
    }
    TouchArea { mouse-cursor: pointer; clicked => { toggled(); } }
}

// A row of buttons, one lit: Any / All, the tempo tolerances.
component Segments inherits Rectangle {
    in property <[string]> items;
    in property <int> chosen;
    callback picked(i: int);
    height: 24px;
    border-radius: 6px;
    background: Theme.control;
    border-width: 1px;
    border-color: Theme.border;
    HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        for s[i] in items: Rectangle {
            border-radius: 4px;
            background: i == chosen ? Theme.accent : sta.has-hover ? Theme.n-2c2c2f : transparent;
            Text { text: s; color: i == chosen ? Theme.on-selection : Theme.text; font-size: 12px; font-weight: 600; }
            sta := TouchArea { mouse-cursor: pointer; clicked => { picked(i); } }
        }
    }
}

// A picked value: a small lilac box with a tick.
component Check inherits Rectangle {
    in property <bool> on;
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border-width: on ? 0px : 1.5px;
    border-color: Theme.text-dim;
    background: on ? Theme.accent : transparent;
    if on: Path {
        width: 10px;
        height: 10px;
        viewbox-width: 10;
        viewbox-height: 10;
        stroke: Theme.on-selection;
        stroke-width: 1.8px;
        stroke-line-cap: round;
        fill: transparent;
        commands: "M 1.5 5.2 L 4 7.6 L 8.6 2.4";
    }
}

component Chip inherits Rectangle {
    in property <FilterChip> chip;
    // BPM and Key: the chip itself matches the playing track, and a ▾ on
    // its right opens the options.
    property <bool> split: chip.kind == 2 || chip.kind == 3;
    callback clicked();
    callback opened();
    callback cleared();
    // Dragged along the bar to `x` (from the chip's left edge), and let
    // go there; `off` when dragged off the bar, to take it away.
    callback dragged(x: length, off: bool);
    callback dropped(x: length, off: bool);
    property <bool> dragging;
    property <bool> off;
    // The release that ends a drag isn't also a click.
    property <bool> just-dropped;
    opacity: dragging ? (off ? 0.3 : 0.6) : 1;
    height: 26px;
    horizontal-stretch: 0;
    border-radius: 13px;
    background: cta.has-hover ? Theme.n-2c2c2f : Theme.control;
    border-width: 1px;
    border-color: chip.active ? Theme.accent : Theme.border;
    HorizontalLayout {
        padding-left: 11px;
        padding-right: split ? 0px : chip.active ? 4px : 9px;
        spacing: 6px;
        Text {
            text: chip.label;
            color: Theme.text-dim;
            font-size: 12px;
            vertical-alignment: center;
        }
        Text {
            text: chip.value;
            color: chip.active ? Theme.lilac-text : Theme.text;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
            max-width: 150px;
            overflow: elide;
        }
        if !split && !chip.active: Text { text: "▾"; color: Theme.text-dim; font-size: 11px; vertical-alignment: center; }
        // Clears the chip, without opening it.
        if !split && chip.active: Rectangle {
            width: 18px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    height: 18px;
                    border-radius: 9px;
                    background: xta.has-hover ? Theme.n-ffffff26 : transparent;
                    CloseIcon { size: 7px; color: Theme.lilac-text; }
                }
            }
            xta := TouchArea { mouse-cursor: pointer; clicked => { cleared(); } }
        }
        // Opens the options: a tempo range or tolerance, picked keys.
        if split: Rectangle {
            width: 24px;
            border-radius: 13px;
            background: dta.has-hover ? Theme.n-ffffff1a : transparent;
            Rectangle {
                x: 0px;
                width: 1px;
                height: 14px;
                background: chip.active ? Theme.accent : Theme.border;
            }
            Text {
                x: 7px;
                text: "▾";
                color: dta.has-hover ? Theme.text : Theme.text-dim;
                font-size: 11px;
                vertical-alignment: center;
            }
            dta := TouchArea { mouse-cursor: pointer; clicked => { opened(); } }
        }
    }
    cta := TouchArea {
        // Under the ✕ and ▾, so they get their own clicks.
        z: -1;
        mouse-cursor: dragging ? MouseCursor.grabbing : MouseCursor.pointer;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                just-dropped = false;
            }
            if e.kind == PointerEventKind.up && dragging {
                dropped(self.mouse-x, off);
                dragging = false;
                off = false;
                just-dropped = true;
            }
        }
        moved => {
            if self.pressed && !dragging && abs(self.mouse-x - self.pressed-x) > 6px {
                dragging = true;
            }
            if dragging {
                off = abs(self.mouse-y - self.pressed-y) > 30px;
                dragged(self.mouse-x, off);
            }
        }
        clicked => {
            if !just-dropped { clicked(); }
            just-dropped = false;
        }
    }
    TourMark { id: chip.kind == 2 ? "ui,chip_bpm" : chip.kind == 3 ? "ui,chip_key" : ""; }
}

export component FilterBar inherits Rectangle {
    height: 34px;
    // Where the open popup hangs from.
    property <length> popup-x;
    // "+" shows the fields beyond the core ones and the DJ's tags.
    property <bool> more-fields;
    property <FilterChip> chip: FilterUi.editing >= 0 && FilterUi.editing < FilterUi.chips.length ? FilterUi.chips[FilterUi.editing] : { kind: -1 };

    Timer {
        interval: 100ms;
        running: FilterUi.open-add;
        triggered => {
            FilterUi.open-add = false;
            add-menu.show();
        }
    }

    function open(i: int, x: length) {
        FilterUi.edit(i);
        popup-x = min(x, root.width - 290px);
        editor.show();
    }

    HorizontalLayout {
        padding-left: 6px;
        spacing: 8px;
        Text {
            text: "Filter";
            color: Theme.text;
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
        }
        for c[i] in FilterUi.chips: VerticalLayout {
            alignment: center;
            init => { FilterUi.placed(i, self.x, self.width); }
            changed x => { FilterUi.placed(i, self.x, self.width); }
            changed width => { FilterUi.placed(i, self.x, self.width); }
            Chip {
                chip: c;
                clicked => {
                    if c.kind == 2 || c.kind == 3 {
                        FilterUi.quick(i);
                    } else {
                        open(i, self.absolute-position.x - root.absolute-position.x);
                    }
                }
                opened => { open(i, self.absolute-position.x - root.absolute-position.x); }
                cleared => { FilterUi.clear(i); }
                dragged(x, off) => {
                    if off {
                        FilterUi.drop-x = -1px;
                    } else {
                        FilterUi.drag(i, self.absolute-position.x - root.absolute-position.x + x);
                    }
                }
                dropped(x, off) => {
                    FilterUi.drop-x = -1px;
                    if off {
                        FilterUi.remove(i);
                    } else {
                        FilterUi.drop(i, self.absolute-position.x - root.absolute-position.x + x);
                    }
                }
            }
        }
        // Add a field.
        VerticalLayout {
            alignment: center;
            plus := Rectangle {
                width: 34px;
                height: 26px;
                border-radius: 13px;
                background: pta.has-hover ? Theme.n-3a3a3d : Theme.n-2c2c2f;
                Text { text: "+"; color: Theme.text; font-size: 17px; font-weight: 500; }
                pta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { add-menu.show(); }
                }
                TourMark { id: "ui,filter_add"; }
                add-menu := PopupWindow {
                    x: 0px;
                    y: 32px;
                    width: 260px;
                    close-policy: close-on-click-outside;
                    PopupBackground {}
                    VerticalLayout {
                        padding: 8px;
                        spacing: 1px;
                        Text { text: "Add Filter"; color: Theme.text; font-size: 15px; font-weight: 700; height: 30px; vertical-alignment: center; x: 8px; }
                        // Type a value ("dark") to add it without knowing its field.
                        add-find := LineEdit {
                            placeholder-text: "Find a value";
                            edited(t) => { FilterUi.find(t); }
                            accepted => {
                                if FilterUi.suggestions.length > 0 {
                                    FilterUi.pick-suggestion(0);
                                    self.text = "";
                                    add-menu.close();
                                }
                            }
                        }
                        if add-find.text != "": SuggestionList {
                            items: FilterUi.suggestions;
                            picked(i) => {
                                FilterUi.pick-suggestion(i);
                                add-find.text = "";
                                add-menu.close();
                            }
                        }
                        if add-find.text != "" && FilterUi.suggestions.length == 0: Text { x: 8px; height: 26px; text: "No value matches."; color: Theme.text-dim; font-size: 12px; vertical-alignment: center; }
                        ScrollView {
                            height: min(fields-list.preferred-height, 360px);
                            fields-list := VerticalLayout {
                                for name[i] in FilterUi.addable: VerticalLayout {
                                    property <int> section: FilterUi.addable-sections[i];
                                    property <bool> first: i == 0 || FilterUi.addable-sections[i - 1] != section;
                                    // A heading over core fields and the DJ's tags; the
                                    // rest wait behind "More fields".
                                    if first && section < 2: Text {
                                        x: 10px;
                                        height: 22px;
                                        text: section == 0 ? "CORE" : "YOUR TAGS";
                                        color: Theme.text-dim;
                                        font-size: 10px;
                                        font-weight: 600;
                                        letter-spacing: 0.8px;
                                        vertical-alignment: bottom;
                                    }
                                    if first && section == 2: Rectangle {
                                        height: 28px;
                                        border-radius: 5px;
                                        background: mfta.has-hover ? Theme.n-3a3a3d : transparent;
                                        Text {
                                            x: 10px;
                                            text: (more-fields ? "▾ " : "▸ ") + "More fields";
                                            color: Theme.lilac-text;
                                            font-size: 13px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }
                                        mfta := TouchArea { mouse-cursor: pointer; clicked => { more-fields = !more-fields; } }
                                    }
                                    if section < 2 || more-fields: Rectangle {
                                        height: 28px;
                                        border-radius: 5px;
                                        background: ata.has-hover ? Theme.n-3a3a3d : transparent;
                                        Text { x: section == 2 ? 22px : 10px; text: name; color: Theme.text; font-size: 13px; vertical-alignment: center; }
                                        ata := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                open(FilterUi.add(FilterUi.addable-ids[i]), plus.absolute-position.x - root.absolute-position.x);
                                                add-menu.close();
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        if FilterUi.addable.length == 0: Text { x: 8px; height: 26px; text: "Every field is on the bar."; color: Theme.text-dim; font-size: 12px; vertical-alignment: center; }
                    }
                }
            }
        }
        Rectangle { horizontal-stretch: 1; }
        if FilterUi.any-active: Rectangle {
            width: 50px;
            Text {
                text: "Clear";
                color: clta.has-hover ? Theme.text : Theme.lilac-text;
                font-size: 13px;
                font-weight: 600;
            }
            clta := TouchArea { mouse-cursor: pointer; clicked => { FilterUi.clear-all(); } }
            TourMark { id: "ui,filter_clear"; }
        }
    }

    // Where a dragged chip will land.
    if FilterUi.drop-x >= 0: Rectangle {
        x: FilterUi.drop-x - 1px;
        y: (root.height - 24px) / 2;
        width: 2px;
        height: 24px;
        border-radius: 1px;
        background: Theme.accent;
    }

    // A chip's values.
    editor := PopupWindow {
        x: popup-x;
        y: 32px;
        width: 280px;
        close-policy: close-on-click-outside;
        PopupBackground {}
        VerticalLayout {
            padding: 12px;
            spacing: 8px;
            HorizontalLayout {
                height: 24px;
                Text { text: chip.label; color: Theme.text; font-size: 15px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                if chip.active: Text {
                    text: "Clear";
                    color: ecta.has-hover ? Theme.text : Theme.lilac-text;
                    font-size: 13px;
                    font-weight: 600;
                    vertical-alignment: center;
                    ecta := TouchArea { mouse-cursor: pointer; clicked => { FilterUi.clear(FilterUi.editing); } }
                }
            }
            // Tempo: a range, or near the playing track.
            if chip.kind == 2: HorizontalLayout {
                spacing: 8px;
                height: 30px;
                LineEdit {
                    width: 112px;
                    placeholder-text: "From";
                    text <=> FilterUi.bpm-low;
                    edited(t) => { FilterUi.set-bpm(t, FilterUi.bpm-high); }
                }
                Text { text: "–"; color: Theme.text-dim; vertical-alignment: center; }
                LineEdit {
                    width: 112px;
                    placeholder-text: "To";
                    text <=> FilterUi.bpm-high;
                    edited(t) => { FilterUi.set-bpm(FilterUi.bpm-low, t); }
                }
            }
            if chip.kind == 2 || chip.kind == 3: HorizontalLayout {
                spacing: 10px;
                height: 24px;
                Text {
                    text: chip.kind == 2 ? "Near the playing track" : "Mixes with the playing track";
                    color: Theme.text;
                    font-size: 13px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                VerticalLayout {
                    alignment: center;
                    Toggle { on: FilterUi.follow; toggled => { FilterUi.set-follow(!FilterUi.follow); } }
                }
            }
            if chip.kind == 2 && FilterUi.follow: Segments {
                items: FilterUi.tolerances;
                chosen: FilterUi.tolerance;
                picked(i) => { FilterUi.set-tolerance(i); }
            }
            if chip.kind == 3 && FilterUi.follow: Segments {
                items: ["Setting", "Exact", "Harmonic", "Fuzzy"];
                chosen: FilterUi.key-match;
                picked(i) => { FilterUi.set-key-match(i); }
            }
            if (chip.kind == 2 || chip.kind == 3) && FilterUi.follow: Text {
                text: FilterUi.follow-note;
                color: Theme.text-dim;
                font-size: 12px;
                wrap: word-wrap;
            }
            // Tags: a track needs any of the words picked, or all of them.
            if chip.kind == 1: HorizontalLayout {
                spacing: 10px;
                Text { text: "Match"; color: Theme.text-dim; font-size: 12px; vertical-alignment: center; }
                Segments {
                    horizontal-stretch: 1;
                    items: ["Any", "All"];
                    chosen: FilterUi.match-all ? 1 : 0;
                    picked(i) => { FilterUi.set-match-all(i == 1); }
                }
            }
            if chip.kind != 2 && (FilterUi.choices.length + FilterUi.more > 12 || FilterUi.choice-search != ""): LineEdit {
                placeholder-text: "Find " + chip.label;
                text <=> FilterUi.choice-search;
                edited(t) => { FilterUi.search-choices(t); }
            }
            if chip.kind != 2: ScrollView {
                height: min(max(FilterUi.choices.length + (FilterUi.more > 0 ? 1 : 0), 1) * 28px, 308px);
                VerticalLayout {
                    for c[i] in FilterUi.choices: Rectangle {
                        height: 28px;
                        border-radius: 5px;
                        background: ota.has-hover ? Theme.n-3a3a3d : transparent;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 8px;
                            spacing: 8px;
                            VerticalLayout { alignment: center; Check { on: c.on; } }
                            if c.has-swatch: VerticalLayout {
                                alignment: center;
                                Rectangle { width: 12px; height: 12px; border-radius: 6px; background: c.swatch; }
                            }
                            if c.icon >= 0: VerticalLayout {
                                alignment: center;
                                CrateIcon { icon: c.icon; tint: c.icon-tint; width: 16px; height: 16px; }
                            }
                            Text {
                                text: c.label;
                                color: c.label == "(none)" ? Theme.text-dim : chip.kind == 1 ? Theme.lilac-text : Theme.text;
                                font-size: 13px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                            Text { text: c.count > 0 ? c.count : ""; color: Theme.text-dim; font-size: 12px; vertical-alignment: center; }
                        }
                        ota := TouchArea { mouse-cursor: pointer; clicked => { FilterUi.toggle(i); } }
                    }
                    if FilterUi.more > 0: Rectangle {
                        height: 28px;
                        border-radius: 5px;
                        background: mta.has-hover ? Theme.n-3a3a3d : transparent;
                        Text {
                            x: 6px;
                            text: "Show " + FilterUi.more + " more";
                            color: Theme.lilac-text;
                            font-size: 12px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        mta := TouchArea { mouse-cursor: pointer; clicked => { FilterUi.show-more(); } }
                    }
                    if FilterUi.choices.length == 0 && FilterUi.more == 0: Text {
                        height: 28px;
                        x: 6px;
                        text: FilterUi.choice-search != "" ? "Nothing matches." : "Nothing in this list to pick.";
                        color: Theme.text-dim;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.border; }
            HorizontalLayout {
                height: 24px;
                Rectangle { horizontal-stretch: 1; }
                Rectangle {
                    width: rt.preferred-width;
                    rt := Text {
                        text: "Remove from bar";
                        color: rta.has-hover ? Theme.text : Theme.text-dim;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    rta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            FilterUi.remove(FilterUi.editing);
                            editor.close();
                        }
                    }
                }
            }
        }
    }
}
