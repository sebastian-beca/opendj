// The Jam source (formerly Instruments) in the library rail: what a deck can play instead
// of a track. The Groove Box's kits, the instrument plugins ticked in
// Settings › Plugins, and the microphone and aux inputs, each dragged onto
// a deck to play through that deck's channel (its EQ, filter, effects,
// fader and crossfader). A track dropped on the deck, or EJECT on a
// stopped one, makes it a track deck again.

import { Theme } from "theme.slint";
import { Controls } from "controls.slint";
import { ScrollView } from "scroll.slint";

// One thing to drag onto a deck: a row of the list.
// A choice in a Mixer strip's input picker.
export struct PickerRow {
    // "1/2" (a pair) or "3" (one channel).
    label: string,
    // Each channel's meter, 0 to 1; r is -1 for one channel.
    l: float,
    r: float,
    // The strip takes it now.
    current: bool,
    // The first single channel, after the pairs: a line above it.
    gap: bool,
}

// A strip of the Mixer: an aux input set up in Settings › Audio.
export struct MixerStripInfo {
    // The aux input, from 1: `[AuxiliaryN]`.
    number: int,
    // Its name: "Ch N" until renamed.
    name: string,
    // Its channels on the interface: "3" (mono) or "1/2" (stereo).
    channels: string,
    // It takes a pair of channels: two meter bars.
    stereo: bool,
    // What is wrong with it (the device is missing), or "".
    problem: string,
    // It comes from another interface than the main output's, so it runs
    // on that interface's own clock and can drift.
    own-clock: bool,
    // Its controls' group: `[AuxiliaryN]`, `[Microphone]` or
    // `[Instrument1]`; what its number square reads ("3", "MIC",
    // "INST"); and the control that switches it on (`main_mix`, or the
    // mic's `talkover`).
    group: string,
    badge: string,
    on-key: string,
    // An aux input: its input can be picked and it can be renamed. The
    // mic and the instrument are removed from the Mixer instead.
    aux: bool,
    // The panel its button opens on the Mixer deck (see mixer-view): 0
    // none, 1 the instrument's (keys), 2 the Groove Box's.
    view: int,
}

export struct LiveItem {
    // 1 the Groove Box, 2 an instrument plugin, 3 the microphone, 4 an
    // aux input.
    kind: int,
    // The plugin's place in its list, or the aux input's (0 to 2).
    index: int,
    name: string,
    // What it is: "Drum machine", "Instrument", "Microphone", "Line input".
    type: string,
    // The plugin's maker, or where an input comes from ("M4 · In 3").
    maker: string,
    // CLAP, VST3 or AU; "Built in" for the Groove Box.
    format: string,
    // Shown in orange in place of `maker`: what's missing ("No input picked").
    problem: string,
}

// A line of the tree on the left.
export struct InstrumentNode {
    name: string,
    depth: int,
    // 0 no children, 1 closed, 2 open.
    children: int,
    // The icon: 0 a folder, 1 the Groove Box, 2 a plugin, 3 the microphone,
    // 4 the inputs, 5 a maker, 6 everything, 7 presets, 8 recently played,
    // 9 the Looper.
    kind: int,
    // How many instruments it holds; -1 to show none.
    count: int,
}

export struct PresetItem {
    name: string,
    // Its place in the app's preset list, for `PresetUi.load`.
    index: int,
}

// Presets of the instrument a deck plays (see the app's presets.rs).
export global PresetUi {
    // The Groove Box's presets, by name. Set by the app.
    in property <[PresetItem]> groove;
    // Each deck's preset name, "" for none. Set by the app.
    in property <[string]> current;
    // ‹ (-1) and › (1): the previous or next preset, by name.
    callback step(deck: int, by: int);
    // Saves what the deck plays over its preset.
    callback save(deck: int);
    callback save-as(deck: int, name: string);
    callback rename(deck: int, name: string);
    // Plays preset `index` (a browser row's) on deck `deck`.
    callback load(deck: int, index: int);
    // The tags a preset can have, types then characters, and how many are
    // types. Set by the app.
    in property <[string]> tag-names;
    in property <int> type-count;
    // Whether each deck's preset has each tag: deck after deck, a flag per
    // tag in `tag-names`. Set by the app.
    in property <[bool]> deck-tags;
    // Gives deck `deck`'s preset tag `tag`, or takes it away.
    callback toggle-tag(deck: int, tag: int);

    public pure function has-tag(deck: int, tag: int) -> bool {
        deck * tag-names.length + tag < deck-tags.length && deck-tags[deck * tag-names.length + tag]
    }

    public pure function name(deck: int) -> string {
        deck < current.length ? current[deck] : ""
    }
}

// A parameter of the playing instrument, to put on a knob.
export struct ParamMatch {
    id: int,
    name: string,
}

export global InstrumentsUi {
    // The tree, the line selected in it and the rows it lists, set by the app.
    in property <[InstrumentNode]> nodes;
    in property <int> current-node;
    in property <[LiveItem]> rows;
    // Text for an empty list, and the Settings page that fills it: 7 Plugins,
    // 0 Audio, -1 none.
    in property <string> empty-text;
    in property <int> empty-page: -1;
    in property <int> empty-tab;
    callback select-node(index: int);
    callback toggle-node(index: int);
    callback search(text: string);
    // The tag chips over the list, on or off, in PresetUi.tag-names' order:
    // with any on, the list shows the presets with all of them.
    in property <[bool]> chips;
    callback toggle-chip(tag: int);
    // The column the list is sorted by: -1 as listed, 0 name, 1 type,
    // 2 maker or input, 3 format; and which way. Set by the app.
    in property <int> sort-column: -1;
    in property <bool> sort-descending;
    // Sorts by `column`, or the other way if it already is.
    callback sort-by(column: int);
    // Item `item` (see `drop`) went onto a deck: Recently played lists it.
    callback played(item: int);
    // True while an item is being dragged, so every deck shows it takes drops.
    in-out property <bool> dragging;
    // What dragging `kind`/`index` carries.
    pure callback payload(kind: int, index: int) -> data-transfer;
    // The item a drag carries as kind * 1000 + index, or -1 for anything else.
    pure callback item(data: data-transfer) -> int;
    // Opens Settings on page `page`, tab `tab` (Plugins or Audio).
    callback open-settings(page: int, tab: int);
    // Settings' Audio and Plugins pages, set by the app.
    in property <int> audio-page;
    in property <int> plugins-page;
    // The MIDI keyboard that played the instrument last, set by the app;
    // empty before any has.
    in property <string> playing-from;
    // The instrument's parameter names, for its knobs
    // (`[Instrument1],parameterN` is the N-th). Set by the app.
    in property <[string]> param-names;
    // The instrument's knobs the DJ picked a parameter for (knob order),
    // and the parameters to pick from that match `search-params`' text.
    in property <[bool]> knob-picked;
    in property <[int]> knob-ids;
    in property <[ParamMatch]> param-matches;
    callback search-params(text: string);
    // Puts parameter `id` on knob `knob` (from 0); -1 gives the knob back
    // to the plugin's own choice.
    callback pick-knob(knob: int, id: int);
    // The page of eight knobs the instrument deck shows, from 0; the macro
    // lanes follow the same page.
    in-out property <int> knob-page;
    // What the instrument plays, set by the app while a deck shows it: the
    // notes held (`held[n]` is MIDI note 36 + n, C2 up) and its scope as
    // path commands in a 128 by 32 box.
    in property <[bool]> held;
    in property <string> scope;
    // Which MIDI keyboard and channel play the instrument: `midi-device` 0
    // any, else 1 + its place in `keyboards`; `midi-channel` 0 any, else 1
    // to 16. Set by the app; `set-midi-from` picks.
    in property <[string]> keyboards;
    in property <int> midi-device;
    in property <int> midi-channel;
    callback set-midi-from(device: int, channel: int);

    // Each input's device and channels as Settings › Audio shows them, in
    // the engine's input order (microphone, aux, instrument, aux 2 to 8),
    // then the Mixer's (its strips' interfaces and how many); "" while it
    // has none. Set by the app.
    in property <[string]> routes;
    // The Mixer's strips, in order: the aux inputs set up.
    in property <[MixerStripInfo]> strips;
    // The input picker (see the app's mixer_picker): the strip it is for
    // (from 1), the interface it lists, and its choices with their meters.
    in property <int> picker-strip;
    in property <string> picker-device;
    in property <[PickerRow]> picker-rows;
    // Opens it for strip `number` (from 1), or for a new strip with 0.
    callback open-picker(number: int);
    // It is open for a new strip (+): it also offers the mic and the
    // instrument plugin. Set by the app.
    in property <bool> picker-adding;
    // Names a Mixer channel; "" goes back to "Ch N".
    callback rename-strip(number: int, name: string);
    // Its popup is open: fresh meters, please.
    callback picker-tick();
    // Choice `index` of picker-rows picked.
    callback pick(index: int);
    // The picker's strip plays the Mixer deck's Groove Box; picking it.
    in property <bool> picker-groove;
    callback pick-groove();
    // A Mixer channel plays the Mixer deck's Groove Box.
    in property <bool> mixer-groove;
    // What the Mixer deck shows: 0 its channels, 1 the instrument's panel,
    // 2 the Groove Box's. A channel's view button opens one; the Mixer's
    // title bar stays, its MIXER › name to come back.
    in-out property <int> mixer-view;

    // Each ticked plugin's own image, in the picker's order, and each
    // input's (microphone, aux 1, aux 2, aux 3, Mixer), with whether there is one:
    // dropped on a deck playing it, or chosen from its cover's menu.
    // A plugin without one of the DJ's shows the art it brings, if any
    // (NKS artwork, its bundle's icon): plugin-own-art tells them apart.
    in property <[image]> plugin-art;
    in property <[bool]> plugin-has-art;
    in property <[bool]> plugin-own-art;
    // Each ticked plugin's format, in the picker's order: CLAP, VST3 or AU.
    in property <[string]> plugin-formats;
    in property <[image]> input-art;
    in property <[bool]> input-has-art;
    // Files dropped on deck `deck` playing `live`: an image becomes its art,
    // anything else loads like a track. `instrument` is the plugin picked.
    callback drop-art(deck: int, live: int, instrument: int);
    callback choose-art(live: int, instrument: int);
    // Solos strip `number` alone in the Mixer: aux input 1 to 8, 9 the
    // instrument, 10 the mic (Cmd/Ctrl-click on its S). 0 clears every
    // solo (CLEAR SOLO).
    public function solo-alone(number: int) {
        Controls.set-value(Controls.resolve("[Auxiliary1]", "solo"), number == 1 ? 1 : 0);
        Controls.set-value(Controls.resolve("[Auxiliary2]", "solo"), number == 2 ? 1 : 0);
        Controls.set-value(Controls.resolve("[Auxiliary3]", "solo"), number == 3 ? 1 : 0);
        Controls.set-value(Controls.resolve("[Auxiliary4]", "solo"), number == 4 ? 1 : 0);
        Controls.set-value(Controls.resolve("[Auxiliary5]", "solo"), number == 5 ? 1 : 0);
        Controls.set-value(Controls.resolve("[Auxiliary6]", "solo"), number == 6 ? 1 : 0);
        Controls.set-value(Controls.resolve("[Auxiliary7]", "solo"), number == 7 ? 1 : 0);
        Controls.set-value(Controls.resolve("[Auxiliary8]", "solo"), number == 8 ? 1 : 0);
        Controls.set-value(Controls.resolve("[Instrument1]", "solo"), number == 9 ? 1 : 0);
        Controls.set-value(Controls.resolve("[Microphone]", "solo"), number == 10 ? 1 : 0);
    }
    // The Mixer's strips besides the aux inputs: the instrument plugin
    // (number 9) and the mic (10), while their `mixer` is on.
    public pure function instrument-strip(tick: int) -> MixerStripInfo {
        {
            number: 9, name: "Instrument", channels: "", stereo: true, own-clock: false,
            group: "[Instrument1]", badge: "INST", on-key: "main_mix", aux: false, view: 1,
            problem: Controls.value(Controls.resolve("[Instrument1]", "input_configured"), tick) > 0 ? "" : "No plugin",
        }
    }
    public pure function mic-strip() -> MixerStripInfo {
        {
            number: 10, name: "Mic", channels: "", stereo: false, own-clock: false,
            group: "[Microphone]", badge: "MIC", on-key: "talkover", aux: false, problem: "", view: 0,
        }
    }
    public pure function in-mixer(group: string, tick: int) -> bool {
        Controls.value(Controls.resolve(group, "mixer"), tick) > 0
    }
    callback remove-art(live: int, instrument: int);

    // Where `live` sits in the input-art list; -1 for the plugin.
    pure function input-slot(live: int) -> int {
        live == 1 ? 0 : live == 2 ? 1 : live == 4 ? 2 : live == 5 ? 3 : live == mixer-live ? 4 : -1
    }

    // `live` (see `live`) has an image of its own.
    public pure function has-art(live: int) -> bool {
        live == 3 ? instrument() > 0 && instrument() <= plugin-has-art.length && plugin-has-art[instrument() - 1]
            : input-slot(live) >= 0 && input-slot(live) < input-has-art.length && input-has-art[input-slot(live)]
    }

    // `live`'s image is one the DJ gave, so it can be removed.
    public pure function own-art(live: int) -> bool {
        live == 3 ? instrument() > 0 && instrument() <= plugin-own-art.length && plugin-own-art[instrument() - 1]
            : has-art(live)
    }

    public pure function art(live: int) -> image {
        live == 3 ? plugin-art[instrument() - 1] : input-art[input-slot(live)]
    }

    // `live` for a deck playing the Mixer (the engine's inputs::MIXER).
    out property <int> mixer-live: 11;

    // The input deck `deck` plays: 0 none, 1 microphone, 2 aux, 3 instrument,
    // 4 to 10 aux 2 to 8 (1 + the engine's input), 11 the Mixer. A lone
    // aux input is how decks saved before the Mixer play one.
    public pure function live(deck: int) -> int {
        Controls.value(Controls.resolve("[Channel" + (deck + 1) + "]", "live_input"), Controls.tick)
    }

    public pure function groove(deck: int) -> bool {
        Controls.value(Controls.resolve("[Groove" + (deck + 1) + "]", "enabled"), Controls.tick) > 0
    }

    public pure function looper(deck: int) -> bool {
        Controls.value(Controls.resolve("[Looper" + (deck + 1) + "]", "enabled"), Controls.tick) > 0
    }

    // The instrument plugin picked, from 1; 0 none.
    public pure function instrument() -> int {
        Controls.value(Controls.resolve("[Instrument1]", "instrument"), Controls.tick)
    }

    // The picked instrument's format (CLAP, VST3, AU); empty for none.
    public pure function format() -> string {
        instrument() > 0 && instrument() <= plugin-formats.length ? plugin-formats[instrument() - 1] : ""
    }

    // The item is playing on deck `deck`.
    public pure function on-deck(deck: int, kind: int, index: int) -> bool {
        kind == 1 ? groove(deck) && Controls.value(Controls.resolve("[Groove" + (deck + 1) + "]", "kit"), Controls.tick) == index
            : kind == 2 ? live(deck) == 3 && instrument() == index + 1
            : kind == 3 ? live(deck) == 1
            : kind == 6 ? looper(deck)
            : kind == 7 ? live(deck) == mixer-live
            : false
    }

    // The LiveIcon kind for a deck playing `live`.
    public pure function live-icon(live: int) -> int {
        live == 1 ? 3 : live == 3 ? 2 : live == mixer-live ? 7 : 4
    }

    // The name of what a deck playing `live` plays; `instrument` is the
    // plugin's name.
    public pure function live-name(live: int, instrument: string) -> string {
        live == 1 ? "Microphone" : live == 2 ? "Aux input" : live == 3 ? instrument : live == mixer-live ? "Mixer" : "Aux " + (live - 2)
    }

    // Where input `live` comes from, "M4 · In 3", or "" when not set up.
    public pure function route(live: int) -> string {
        live > 0 && live <= routes.length ? routes[live - 1] : ""
    }

    // "Deck 2", "Decks 1 and 3", or "" while on no deck.
    public pure function decks-of(kind: int, index: int) -> string {
        (on-deck(0, kind, index) ? "1" : "")
            + (on-deck(1, kind, index) ? (on-deck(0, kind, index) ? ", 2" : "2") : "")
            + (on-deck(2, kind, index) ? (on-deck(0, kind, index) || on-deck(1, kind, index) ? ", 3" : "3") : "")
            + (on-deck(3, kind, index) ? (on-deck(0, kind, index) || on-deck(1, kind, index) || on-deck(2, kind, index) ? ", 4" : "4") : "")
    }

    // The deck a double-click loads on: the first shown deck with nothing
    // playing on it, else -1.
    public pure function free-deck(decks: int) -> int {
        free(0) ? 0 : free(1) ? 1 : decks > 2 && free(2) ? 2 : decks > 2 && free(3) ? 3 : -1
    }

    pure function free(deck: int) -> bool {
        Controls.value(Controls.resolve("[Channel" + (deck + 1) + "]", "play"), Controls.tick) == 0
            && live(deck) == 0 && !groove(deck) && !looper(deck)
    }

    // Puts the dragged item (see `item`) on deck `deck`. The engine stops
    // and ejects the deck's track, and takes an input off any other deck.
    public function drop(deck: int, item: int) {
        if item < 0 {
            return;
        }
        if item >= 1000 && item < 2000 {
            // The deck keeps the kit it last had; KIT on the deck changes it.
            Controls.set-value(Controls.resolve("[Groove" + (deck + 1) + "]", "enabled"), 1);
        } else if item >= 2000 && item < 3000 {
            Controls.set-value(Controls.resolve("[Instrument1]", "instrument"), Math.mod(item, 1000) + 1);
            Controls.set-value(Controls.resolve("[Channel" + (deck + 1) + "]", "live_input"), 3);
        } else if item >= 5000 && item < 6000 {
            PresetUi.load(deck, Math.mod(item, 1000));
        } else if item >= 6000 && item < 7000 {
            // The Looper records what it hears (the mix, until an input is
            // picked on the deck) and plays its layers through the deck.
            Controls.set-value(Controls.resolve("[Looper" + (deck + 1) + "]", "enabled"), 1);
        } else if item >= 3000 && item < 4000 {
            // The microphone is input 0 (see the engine's inputs);
            // live_input is 1 + the input.
            Controls.set-value(Controls.resolve("[Channel" + (deck + 1) + "]", "live_input"), 1);
        } else if item >= 7000 && item < 8000 {
            // The engine takes the Mixer off any other deck.
            Controls.set-value(Controls.resolve("[Channel" + (deck + 1) + "]", "live_input"), mixer-live);
        }
        played(item);
    }
}

// A small line drawing for each kind of item, in lilac.
export component LiveIcon inherits Rectangle {
    in property <int> kind;
    in property <color> tint: Theme.accent;
    in property <length> size: 30px;
    width: size;
    height: size;
    // A keyboard: the rail's Jam button and instrument plugins.
    if kind == 0 || kind == 2: Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 30;
        viewbox-height: 30;
        stroke: tint;
        stroke-width: 1.5px;
        stroke-line-join: round;
        fill: transparent;
        commands: "M 4 8 L 26 8 L 26 23 L 4 23 Z M 9.5 15.5 L 9.5 23 M 15 15.5 L 15 23 M 20.5 15.5 L 20.5 23";
    }
    if kind == 0 || kind == 2: Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 30;
        viewbox-height: 30;
        fill: tint;
        commands: "M 8 8 L 11 8 L 11 15.5 L 8 15.5 Z M 13.5 8 L 16.5 8 L 16.5 15.5 L 13.5 15.5 Z M 19 8 L 22 8 L 22 15.5 L 19 15.5 Z";
    }
    // The Groove Box: a grid of step pads, two of them lit.
    if kind == 1: Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 30;
        viewbox-height: 30;
        stroke: tint;
        stroke-width: 1.4px;
        stroke-line-join: round;
        fill: transparent;
        commands: "M 5 5 L 13 5 L 13 13 L 5 13 Z M 17 5 L 25 5 L 25 13 L 17 13 Z M 5 17 L 13 17 L 13 25 L 5 25 Z M 17 17 L 25 17 L 25 25 L 17 25 Z";
    }
    if kind == 1: Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 30;
        viewbox-height: 30;
        fill: tint;
        commands: "M 7 7 L 11 7 L 11 11 L 7 11 Z M 19 19 L 23 19 L 23 23 L 19 23 Z";
    }
    // The Looper: a loop going round, with its play head.
    if kind == 6: Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 30;
        viewbox-height: 30;
        stroke: tint;
        stroke-width: 1.5px;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
        commands: "M 22.5 9 A 9 9 0 1 0 24 15 M 22.5 4.5 L 22.5 9 L 18 9";
    }
    if kind == 6: Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 30;
        viewbox-height: 30;
        fill: tint;
        commands: "M 12 11 L 19 15 L 12 19 Z";
    }
    // The microphone.
    if kind == 3: Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 30;
        viewbox-height: 30;
        stroke: tint;
        stroke-width: 1.5px;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
        commands: "M 11.5 8 A 3.5 3.5 0 0 1 18.5 8 L 18.5 15 A 3.5 3.5 0 0 1 11.5 15 Z M 8 14 A 7 7 0 0 0 22 14 M 15 21 L 15 25 M 11 25 L 19 25";
    }
    // The Mixer: three lines, like a mixer's channels.
    if kind == 7: Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 30;
        viewbox-height: 30;
        stroke: tint;
        stroke-width: 1.5px;
        stroke-line-cap: round;
        fill: transparent;
        commands: "M 8 5 L 8 25 M 15 5 L 15 25 M 22 5 L 22 25";
    }
    // The aux input: a cable's jack.
    if kind == 4: Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 30;
        viewbox-height: 30;
        stroke: tint;
        stroke-width: 1.5px;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
        commands: "M 13 4 L 17 4 L 17 9 L 13 9 Z M 12 9 L 18 9 L 18 17 L 12 17 Z M 15 17 L 15 20 C 15 24 9 24 9 27 M 14 6.5 L 16 6.5";
    }
}

// The tree's icons: the LiveIcon drawings, plus a folder for the rest.
component NodeIcon inherits Rectangle {
    in property <int> kind;
    in property <color> tint;
    width: 18px;
    height: 18px;
    if kind == 1 || kind == 2 || kind == 3 || kind == 4 || kind == 9: LiveIcon {
        kind: kind == 9 ? 6 : kind;
        tint: tint;
        size: 18px;
    }
    if kind == 0 || kind == 5 || kind == 6 || kind == 7 || kind == 8: Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 18;
        viewbox-height: 18;
        stroke: tint;
        stroke-width: 1.3px;
        stroke-line-join: round;
        fill: transparent;
        commands: kind == 6 ? "M 3 4 L 15 4 L 15 14 L 3 14 Z M 6 4 L 6 10 M 9 4 L 9 10 M 12 4 L 12 10"
            // A preset: three sliders.
            : kind == 7 ? "M 4 3 L 4 15 M 9 3 L 9 15 M 14 3 L 14 15 M 2.5 11 L 5.5 11 M 7.5 6 L 10.5 6 M 12.5 9 L 15.5 9"
            // Recently played: a clock.
            : kind == 8 ? "M 9 2.5 A 6.5 6.5 0 1 1 8.99 2.5 Z M 9 5 L 9 9 L 12 11"
            : "M 2.5 5 L 7 5 L 8.5 6.5 L 15.5 6.5 L 15.5 14 L 2.5 14 Z";
    }
}

// The tree on the left: everything, the Groove Box, plugins by maker, inputs.
component InstrumentTree inherits Rectangle {
    background: Theme.browser;
    width: 270px;
    VerticalLayout {
        padding: 8px;
        spacing: 6px;
        Text { text: "Jam"; color: Theme.text; font-size: 15px; font-weight: 600; height: 30px; vertical-alignment: center; x: 4px; }
        ScrollView {
            gutter: true;
            VerticalLayout {
                alignment: start;
                for n[i] in InstrumentsUi.nodes: Rectangle {
                    height: 34px;
                    border-radius: Theme.radius;
                    background: i == InstrumentsUi.current-node ? Theme.selection : ta.has-hover ? Theme.n-232326 : transparent;
                    ta := TouchArea {
                        clicked => { InstrumentsUi.select-node(i); }
                        double-clicked => { InstrumentsUi.toggle-node(i); }
                    }
                    HorizontalLayout {
                        padding-left: 4px + n.depth * 16px;
                        padding-right: 8px;
                        spacing: 8px;
                        Rectangle {
                            width: 12px;
                            if n.children > 0: Path {
                                width: 10px;
                                height: 10px;
                                viewbox-width: 10;
                                viewbox-height: 10;
                                stroke: Theme.text-dim;
                                stroke-width: 1.6px;
                                stroke-line-cap: round;
                                fill: transparent;
                                commands: n.children == 2 ? "M 2 3.5 L 5 6.5 L 8 3.5" : "M 3.5 2 L 6.5 5 L 3.5 8";
                            }
                            TouchArea { clicked => { InstrumentsUi.toggle-node(i); } }
                        }
                        VerticalLayout {
                            alignment: center;
                            NodeIcon { kind: n.kind; tint: i == InstrumentsUi.current-node ? Theme.on-row-selection : Theme.accent; }
                        }
                        Text {
                            text: n.name;
                            color: i == InstrumentsUi.current-node ? Theme.on-row-selection : Theme.text;
                            font-size: 15px;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        if n.count >= 0: Text {
                            text: n.count;
                            color: i == InstrumentsUi.current-node ? Theme.on-row-selection : Theme.text-dim;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}

// A column heading.
component Heading inherits Text {
    color: Theme.text-dim;
    font-size: 11px;
    font-weight: 600;
    vertical-alignment: center;
    overflow: elide;
}

// A column heading to sort by: a click sorts, another the other way.
component SortHeading inherits Rectangle {
    in property <string> text;
    in property <int> column;
    property <bool> on: InstrumentsUi.sort-column == column;
    HorizontalLayout {
        spacing: 4px;
        Heading { text: root.text; color: on ? Theme.text : Theme.text-dim; }
        if on: Heading { text: InstrumentsUi.sort-descending ? "▼" : "▲"; color: Theme.lilac-text; font-size: 9px; }
        Rectangle { horizontal-stretch: 1; }
    }
    TouchArea { mouse-cursor: pointer; clicked => { InstrumentsUi.sort-by(column); } }
}

// One row of the list, laid out like a track row.
component InstrumentRow inherits Rectangle {
    in property <LiveItem> item;
    in property <int> line;
    in property <bool> selected;
    in property <length> type-width;
    in property <length> maker-width;
    in property <length> format-width;
    callback select();
    callback load();
    property <string> decks: InstrumentsUi.decks-of(item.kind, item.index);
    height: 32px;
    background: selected ? Theme.selection : Math.mod(line, 2) == 0 ? Theme.row : Theme.row-alt;
    drag := DragArea {
        data: InstrumentsUi.payload(item.kind, item.index);
        allow-copy: true;
        changed dragging => { InstrumentsUi.dragging = self.dragging; }
        TouchArea {
            mouse-cursor: grab;
            clicked => { select(); }
            double-clicked => { load(); }
        }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 24px;
                height: 24px;
                border-radius: 4px;
                background: Theme.n-000000;
                if item.kind != 5: LiveIcon { kind: item.kind; size: 20px; tint: Theme.accent; }
                if item.kind == 5: NodeIcon { kind: 7; tint: Theme.accent; }
            }
        }
        Text { text: item.name; color: selected ? Theme.on-row-selection : Theme.text; font-size: 13px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
        Text { width: type-width; text: item.type; color: selected ? Theme.on-row-selection : Theme.text-dim; font-size: 13px; vertical-alignment: center; overflow: elide; }
        Text {
            width: maker-width;
            text: item.problem != "" ? item.problem : item.maker;
            color: item.problem != "" ? Theme.c-ff9f0a : selected ? Theme.on-row-selection : Theme.text-dim;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
        }
        Text { width: format-width; text: item.format; color: selected ? Theme.on-row-selection : Theme.text-dim; font-size: 13px; vertical-alignment: center; overflow: elide; }
        Text {
            width: 64px;
            text: decks == "" ? "" : (decks.character-count > 1 ? "Decks " : "Deck ") + decks;
            color: selected ? Theme.on-row-selection : Theme.lilac-text;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// The list on the right: the selected node's instruments, like tracks.
// A tag to switch on or off: a chip over the list, or in a preset's tags.
export component TagChip inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    callback clicked();
    height: 22px;
    min-width: label.preferred-width + 16px;
    border-radius: 11px;
    background: on ? Theme.accent.with-alpha(0.25) : tcta.has-hover ? Theme.n-3a3a3d : Theme.control;
    border-width: 1px;
    border-color: on ? Theme.accent : Theme.border;
    label := Text { text: root.text; color: on ? Theme.text : Theme.text-dim; font-size: 11px; }
    tcta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// A row of tag chips: tags `from` to `to` (not included) of PresetUi.tag-names.
component TagRow inherits HorizontalLayout {
    in property <string> title;
    in property <int> from;
    in property <int> to;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 2px;
    padding-bottom: 2px;
    spacing: 4px;
    height: 26px;
    alignment: start;
    Text { text: title; width: 74px; color: Theme.text-dim; font-size: 10px; vertical-alignment: center; }
    for k in max(0, to - from): TagChip {
        text: PresetUi.tag-names[from + k];
        on: from + k < InstrumentsUi.chips.length && InstrumentsUi.chips[from + k];
        clicked => { InstrumentsUi.toggle-chip(from + k); }
    }
}

component InstrumentList inherits Rectangle {
    // How many decks are shown, for double-click.
    in property <int> decks;
    property <int> current: -1;
    property <length> type-width: 110px;
    property <length> maker-width: 200px;
    property <length> format-width: 70px;
    property <string> query;
    changed query => { InstrumentsUi.search(query); }
    property <int> node: InstrumentsUi.current-node;
    changed node => { current = -1; }
    background: Theme.browser;
    VerticalLayout {
        // Search, as over the track list.
        Rectangle {
            height: 44px;
            HorizontalLayout {
                padding: 8px;
                spacing: 8px;
                Rectangle {
                    min-width: 200px;
                    max-width: 420px;
                    horizontal-stretch: 1;
                    border-radius: Theme.radius;
                    background: Theme.panel;
                    border-width: 1px;
                    border-color: Theme.border;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        search := TextInput {
                            text <=> query;
                            color: Theme.text;
                            font-size: 13px;
                            vertical-alignment: center;
                            single-line: true;
                        }
                    }
                    if query == "": Text { x: 10px; text: "Search instruments"; color: Theme.text-dim; font-size: 13px; vertical-alignment: center; }
                }
                // Takes the rest of the row, so the box's max-width doesn't
                // cap the whole list's width.
                Rectangle { horizontal-stretch: 1; }
            }
        }
        // Tag chips: narrow the list to presets with every tag picked.
        TagRow { title: "TYPE"; from: 0; to: PresetUi.type-count; }
        TagRow { title: "CHARACTER"; from: PresetUi.type-count; to: PresetUi.tag-names.length; }
        // Column headings.
        Rectangle {
            height: 28px;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 10px;
                Rectangle { width: 24px; }
                SortHeading { text: "NAME"; column: 0; horizontal-stretch: 1; }
                SortHeading { width: type-width; text: "TYPE"; column: 1; }
                SortHeading { width: maker-width; text: "MAKER / INPUT"; column: 2; }
                SortHeading { width: format-width; text: "FORMAT"; column: 3; }
                Heading { width: 64px; text: "DECK"; }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.separator; }
        }
        ScrollView {
            VerticalLayout {
                alignment: start;
                for it[i] in InstrumentsUi.rows: InstrumentRow {
                    item: it;
                    line: i;
                    selected: i == current;
                    type-width: type-width;
                    maker-width: maker-width;
                    format-width: format-width;
                    select => { current = i; }
                    load => {
                        current = i;
                        if InstrumentsUi.free-deck(decks) >= 0 {
                            InstrumentsUi.drop(InstrumentsUi.free-deck(decks), it.kind * 1000 + it.index);
                        }
                    }
                }
                if InstrumentsUi.empty-text != "": Rectangle {
                    height: 64px;
                    Text {
                        text: InstrumentsUi.empty-text;
                        color: InstrumentsUi.empty-page >= 0 ? Theme.lilac-text : Theme.text-dim;
                        font-size: 13px;
                    }
                    if InstrumentsUi.empty-page >= 0: TouchArea {
                        mouse-cursor: pointer;
                        clicked => { InstrumentsUi.open-settings(InstrumentsUi.empty-page, InstrumentsUi.empty-tab); }
                    }
                }
            }
        }
        Text {
            height: 30px;
            x: 10px;
            text: "Drag onto a deck, or double-click to load on a free deck. It plays through that deck's channel; drop a track on the deck to go back.";
            color: Theme.text-dim;
            font-size: 11px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// The source's page: the tree and the list, in the browser's place.
export component InstrumentsPanel inherits HorizontalLayout {
    in property <int> decks: 2;
    InstrumentTree {}
    Rectangle { width: 1px; background: Theme.separator; }
    InstrumentList { decks: decks; horizontal-stretch: 1; }
}
