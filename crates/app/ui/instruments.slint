// The Instruments source in the library rail: what a deck can play instead
// of a track. The Groove Box's kits, the instrument plugins ticked in
// Settings › Plugins, and the microphone and aux inputs, each dragged onto
// a deck to play through that deck's channel (its EQ, filter, effects,
// fader and crossfader). A track dropped on the deck, or EJECT on a
// stopped one, makes it a track deck again.

import { Theme } from "theme.slint";
import { Controls } from "controls.slint";
import { ScrollView } from "scroll.slint";

// One thing to drag onto a deck.
export struct LiveItem {
    // 1 a Groove Box kit, 2 an instrument plugin, 3 the microphone, 4 the
    // aux input.
    kind: int,
    // The kit's or the plugin's place in its list.
    index: int,
    name: string,
    detail: string,
}

export global InstrumentsUi {
    // The Groove Box's kits and the ticked instrument plugins, set by the app.
    in property <[LiveItem]> kits;
    in property <[LiveItem]> plugins;
    // True while an item is being dragged, so every deck shows it takes drops.
    in-out property <bool> dragging;
    // What dragging `kind`/`index` carries.
    pure callback payload(kind: int, index: int) -> data-transfer;
    // The item a drag carries as kind * 1000 + index, or -1 for anything else.
    pure callback item(data: data-transfer) -> int;
    // Opens Settings on page `page`, tab `tab` (Plugins or Audio).
    callback open-settings(page: int, tab: int);

    // The input deck `deck` plays: 0 none, 1 microphone, 2 aux, 3 instrument.
    public pure function live(deck: int) -> int {
        Controls.value(Controls.resolve("[Channel" + (deck + 1) + "]", "live_input"), Controls.tick)
    }

    public pure function groove(deck: int) -> bool {
        Controls.value(Controls.resolve("[Groove" + (deck + 1) + "]", "enabled"), Controls.tick) > 0
    }

    // The instrument plugin picked, from 1; 0 none.
    public pure function instrument() -> int {
        Controls.value(Controls.resolve("[Instrument1]", "instrument"), Controls.tick)
    }

    // The item is playing on deck `deck`.
    public pure function on-deck(deck: int, kind: int, index: int) -> bool {
        kind == 1 ? groove(deck) && Controls.value(Controls.resolve("[Groove" + (deck + 1) + "]", "kit"), Controls.tick) == index
            : kind == 2 ? live(deck) == 3 && instrument() == index + 1
            : live(deck) == kind - 2
    }

    // "Deck 2", "Decks 1 and 3", or "" while on no deck.
    public pure function decks-of(kind: int, index: int) -> string {
        (on-deck(0, kind, index) ? "1" : "")
            + (on-deck(1, kind, index) ? (on-deck(0, kind, index) ? ", 2" : "2") : "")
            + (on-deck(2, kind, index) ? (on-deck(0, kind, index) || on-deck(1, kind, index) ? ", 3" : "3") : "")
            + (on-deck(3, kind, index) ? (on-deck(0, kind, index) || on-deck(1, kind, index) || on-deck(2, kind, index) ? ", 4" : "4") : "")
    }

    // Puts the dragged item (see `item`) on deck `deck`. The engine stops
    // and ejects the deck's track, and takes an input off any other deck.
    public function drop(deck: int, item: int) {
        if item < 0 {
            return;
        }
        if item >= 1000 && item < 2000 {
            Controls.set-value(Controls.resolve("[Groove" + (deck + 1) + "]", "kit"), Math.mod(item, 1000));
            Controls.set-value(Controls.resolve("[Groove" + (deck + 1) + "]", "enabled"), 1);
        } else if item >= 2000 && item < 3000 {
            Controls.set-value(Controls.resolve("[Instrument1]", "instrument"), Math.mod(item, 1000) + 1);
            Controls.set-value(Controls.resolve("[Channel" + (deck + 1) + "]", "live_input"), 3);
        } else if item >= 3000 && item < 5000 {
            // The microphone is input 0, the auxiliary inputs 1, 3 and 4
            // (see the engine's inputs); live_input is 1 + the input.
            Controls.set-value(Controls.resolve("[Channel" + (deck + 1) + "]", "live_input"), item < 4000 ? 1 : (Math.mod(item, 1000) == 0 ? 2 : Math.mod(item, 1000) + 3));
        }
    }
}

// A small line drawing for each kind of item, in lilac.
export component LiveIcon inherits Rectangle {
    in property <int> kind;
    in property <color> tint: Theme.accent;
    in property <length> size: 30px;
    width: size;
    height: size;
    // A keyboard: the rail's Instruments button and instrument plugins.
    if kind == 0 || kind == 2: Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 30;
        viewbox-height: 30;
        stroke: tint;
        stroke-width: 1.5px;
        stroke-line-join: round;
        fill: transparent;
        commands: "M 4 8 L 26 8 L 26 23 L 4 23 Z M 9.5 15.5 L 9.5 23 M 15 15.5 L 15 23 M 20.5 15.5 L 20.5 23";
    }
    if kind == 0 || kind == 2: Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 30;
        viewbox-height: 30;
        fill: tint;
        commands: "M 8 8 L 11 8 L 11 15.5 L 8 15.5 Z M 13.5 8 L 16.5 8 L 16.5 15.5 L 13.5 15.5 Z M 19 8 L 22 8 L 22 15.5 L 19 15.5 Z";
    }
    // The Groove Box: a grid of step pads, two of them lit.
    if kind == 1: Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 30;
        viewbox-height: 30;
        stroke: tint;
        stroke-width: 1.4px;
        stroke-line-join: round;
        fill: transparent;
        commands: "M 5 5 L 13 5 L 13 13 L 5 13 Z M 17 5 L 25 5 L 25 13 L 17 13 Z M 5 17 L 13 17 L 13 25 L 5 25 Z M 17 17 L 25 17 L 25 25 L 17 25 Z";
    }
    if kind == 1: Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 30;
        viewbox-height: 30;
        fill: tint;
        commands: "M 7 7 L 11 7 L 11 11 L 7 11 Z M 19 19 L 23 19 L 23 23 L 19 23 Z";
    }
    // The microphone.
    if kind == 3: Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 30;
        viewbox-height: 30;
        stroke: tint;
        stroke-width: 1.5px;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
        commands: "M 11.5 8 A 3.5 3.5 0 0 1 18.5 8 L 18.5 15 A 3.5 3.5 0 0 1 11.5 15 Z M 8 14 A 7 7 0 0 0 22 14 M 15 21 L 15 25 M 11 25 L 19 25";
    }
    // The aux input: a cable's jack.
    if kind == 4: Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 30;
        viewbox-height: 30;
        stroke: tint;
        stroke-width: 1.5px;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
        commands: "M 13 4 L 17 4 L 17 9 L 13 9 Z M 12 9 L 18 9 L 18 17 L 12 17 Z M 15 17 L 15 20 C 15 24 9 24 9 27 M 14 6.5 L 16 6.5";
    }
}

// One item: dragged onto a deck to play there.
component LiveTile inherits Rectangle {
    in property <LiveItem> item;
    in property <string> status;
    property <string> decks: InstrumentsUi.decks-of(item.kind, item.index);
    property <bool> used: decks != "";
    border-radius: 10px;
    background: drag.dragging ? #2f2f33 : ta.has-hover ? #262629 : #1c1d1f;
    border-width: used ? 1.5px : 1px;
    border-color: used ? Theme.accent : #2c2c2f;
    drag := DragArea {
        data: InstrumentsUi.payload(item.kind, item.index);
        allow-copy: true;
        changed dragging => { InstrumentsUi.dragging = self.dragging; }
        ta := TouchArea { mouse-cursor: grab; }
    }
    HorizontalLayout {
        padding: 12px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 44px;
                height: 44px;
                border-radius: 8px;
                background: #000000;
                LiveIcon { kind: item.kind; }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;
            Text { text: item.name; color: Theme.text; font-size: 14px; font-weight: 600; overflow: elide; }
            Text { text: status != "" ? status : item.detail; color: status != "" ? #ff9f0a : Theme.text-dim; font-size: 12px; overflow: elide; }
            Text {
                text: used ? (decks.character-count > 1 ? "On decks " : "On deck ") + decks : "Drag onto a deck";
                color: used ? Theme.accent : #6a6a70;
                font-size: 11px;
                font-weight: used ? 600 : 400;
            }
        }
    }
}

// A heading and its items in as many columns as fit.
component Section inherits VerticalLayout {
    in property <string> title;
    in property <string> about;
    in property <[LiveItem]> items;
    in property <[string]> statuses;
    property <length> gap: 10px;
    property <length> tile-height: 76px;
    property <int> columns: max(1, floor((self.width + gap) / (250px + gap)));
    property <length> tile-width: (self.width - (columns - 1) * gap) / columns;
    spacing: 8px;
    HorizontalLayout {
        spacing: 10px;
        Text { text: title; color: Theme.text; font-size: 13px; font-weight: 700; letter-spacing: 0.5px; vertical-alignment: center; }
        Text { text: about; color: Theme.text-dim; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
    }
    Rectangle {
        height: items.length == 0 ? 0px : ceil(items.length / columns) * (tile-height + gap) - gap;
        for it[i] in items: LiveTile {
            x: Math.mod(i, columns) * (tile-width + gap);
            y: floor(i / columns) * (tile-height + gap);
            width: tile-width;
            height: tile-height;
            item: it;
            status: i < statuses.length ? statuses[i] : "";
        }
    }
    @children
}

// A line that opens a page of Settings.
component SettingsLink inherits Rectangle {
    in property <string> text;
    callback clicked();
    height: 44px;
    border-radius: 10px;
    background: ta.has-hover ? #262629 : #1c1d1f;
    border-width: 1px;
    border-color: #3a3a3d;
    Text { x: 14px; text: root.text; color: Theme.accent; font-size: 13px; vertical-alignment: center; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// The source's page, in the browser's place.
export component InstrumentsPanel inherits Rectangle {
    background: Theme.browser;
    property <bool> mic-ready: Controls.value(Controls.resolve("[Microphone]", "input_configured"), Controls.tick) > 0;
    property <bool> aux-ready: Controls.value(Controls.resolve("[Auxiliary1]", "input_configured"), Controls.tick) > 0;
    property <bool> aux2-ready: Controls.value(Controls.resolve("[Auxiliary2]", "input_configured"), Controls.tick) > 0;
    property <bool> aux3-ready: Controls.value(Controls.resolve("[Auxiliary3]", "input_configured"), Controls.tick) > 0;
    ScrollView {
        VerticalLayout {
            padding: 16px;
            padding-right: 20px;
            spacing: 22px;
            alignment: start;
            VerticalLayout {
                spacing: 4px;
                Text { text: "Instruments"; color: Theme.text; font-size: 18px; font-weight: 600; }
                Text {
                    text: "Drag one onto a deck to play it through that deck's channel: EQ, filter, effects, fader and crossfader. Drop a track on the deck to go back.";
                    color: Theme.text-dim;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }
            Section {
                title: "GROOVE BOX";
                about: "A drum machine on the deck, in time with the mix. Pick a kit to start with.";
                items: InstrumentsUi.kits;
            }
            Section {
                title: "INSTRUMENT PLUGINS";
                about: "Play with a MIDI keyboard or the KEYBOARD pads. EDIT on the deck opens the plugin's own window for its sounds and presets.";
                items: InstrumentsUi.plugins;
                if InstrumentsUi.plugins.length == 0: SettingsLink {
                    text: "Tick the instruments you play in Settings › Plugins…";
                    clicked => { InstrumentsUi.open-settings(7, 1); }
                }
            }
            Section {
                title: "INPUTS";
                about: "Turntables, a drum machine, a singer: anything plugged into your audio interface.";
                // Auxiliary inputs 2 and 3 once they are set up.
                items: aux3-ready ? [
                    { kind: 3, index: 0, name: "Microphone", detail: "The mic input, with the deck's FX" },
                    { kind: 4, index: 0, name: "Aux input", detail: "Line in from other gear" },
                    { kind: 4, index: 1, name: "Aux 2", detail: "Line in from other gear" },
                    { kind: 4, index: 2, name: "Aux 3", detail: "Line in from other gear" },
                ] : aux2-ready ? [
                    { kind: 3, index: 0, name: "Microphone", detail: "The mic input, with the deck's FX" },
                    { kind: 4, index: 0, name: "Aux input", detail: "Line in from other gear" },
                    { kind: 4, index: 1, name: "Aux 2", detail: "Line in from other gear" },
                ] : [
                    { kind: 3, index: 0, name: "Microphone", detail: "The mic input, with the deck's FX" },
                    { kind: 4, index: 0, name: "Aux input", detail: "Line in from other gear" },
                ];
                statuses: [mic-ready ? "" : "No input picked yet", aux-ready ? "" : "No input picked yet"];
                if !mic-ready || !aux-ready: SettingsLink {
                    text: "Pick the inputs in Settings › Audio…";
                    clicked => { InstrumentsUi.open-settings(0, 0); }
                }
            }
        }
    }
}
