// The FX bar: a full-width row of its own under the decks, after djay
// Pro's. Each deck's three effects over its own width and the Beat FX in
// the middle, as wide as the mixer. An effect has its name (the list
// under it picks another), ON, its length in beats (beat-synced effects)
// or a slider for its second control (the others), and its D/W knob (the
// effect's main knob, `meta`, which controllers turn too). In 2-Deck each
// effect is a cell of two rows, the name stepped with arrows either side;
// in 4-Deck each deck's three are stacked in one-line rows. The FX button
// in the top bar shows and hides the bar.
import { Theme } from "theme.slint";
import { Controls } from "controls.slint";
import { EffectList } from "deck.slint";

// ‹ or ›, stepping to the previous or next effect.
component StepArrow inherits Rectangle {
    in property <bool> next;
    in property <int> index;
    width: 28px;
    Path {
        width: 6px;
        height: 10px;
        viewbox-width: 6;
        viewbox-height: 10;
        commands: next ? "M 1 1 L 5 5 L 1 9" : "M 5 1 L 1 5 L 5 9";
        stroke: ta.pressed ? Theme.text-dim : ta.has-hover ? Theme.text : #b0b0b5;
        stroke-width: 1.6px;
        stroke-line-cap: round;
        fill: transparent;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Controls.set-value(index, 1);
            Controls.set-value(index, 0);
        }
    }
}

// A filled triangle halving or doubling the beats.
component BeatArrow inherits Rectangle {
    in property <bool> next;
    in property <bool> enabled;
    callback clicked();
    width: 14px;
    Path {
        width: 9px;
        height: 12px;
        viewbox-width: 9;
        viewbox-height: 12;
        commands: next ? "M 0 0 L 9 6 L 0 12 Z" : "M 9 0 L 0 6 L 9 12 Z";
        fill: !enabled ? #3a3a3e : ta.pressed ? #6e6e73 : ta.has-hover ? #a8a8ad : #6e6e73;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ◀ 1/8 ▶: an effect's length, halved and doubled from 1/16 to 4 beats.
component BeatChooser inherits HorizontalLayout {
    in property <int> index;
    property <float> beats: Controls.value(index, Controls.tick);
    BeatArrow {
        enabled: beats > 1 / 16;
        clicked => {
            if beats > 1 / 16 {
                Controls.set-value(index, beats / 2);
            }
        }
    }
    Text {
        min-width: 22px;
        horizontal-stretch: 1;
        text: beats <= 0 ? "–" : beats < 1 ? "1/" + round(1 / beats) : round(beats);
        color: #b0b0b5;
        font-size: 13px;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    BeatArrow {
        next: true;
        enabled: beats > 0 && beats < 4;
        clicked => {
            if beats > 0 && beats < 4 {
                Controls.set-value(index, beats * 2);
            }
        }
    }
}

// A thin track with ticks and a round thumb: an effect's second control.
component ParamSlider inherits Rectangle {
    in property <int> index;
    property <float> pos: Controls.parameter(index, Controls.tick);
    property <length> thumb: 14px;
    property <length> travel: self.width - thumb;
    property <float> drag-start;
    min-width: 40px;
    horizontal-stretch: 1;
    Rectangle {
        x: thumb / 2;
        width: travel;
        height: 2px;
        background: #3a3a3e;
    }
    for t in 5: Rectangle {
        x: thumb / 2 + t * travel / 4 - 0.5px;
        y: parent.height / 2 - 4px;
        width: 1px;
        height: 8px;
        background: #3a3a3e;
    }
    Rectangle {
        x: pos * travel;
        width: thumb;
        height: thumb;
        border-radius: thumb / 2;
        background: touch.pressed ? @linear-gradient(180deg, #8e8e93 0%, #6e6e73 100%) : touch.has-hover ? @linear-gradient(180deg, #a8a8ad 0%, #7c7c81 100%) : @linear-gradient(180deg, #98989d 0%, #6e6e73 100%);
        drop-shadow-blur: 3px;
        drop-shadow-color: #00000080;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                let at = (self.mouse-x - thumb / 2) / travel;
                if abs(at - pos) * travel > thumb / 2 {
                    Controls.set-parameter(index, clamp(at, 0, 1));
                    drag-start = clamp(at, 0, 1);
                } else {
                    drag-start = pos;
                }
            }
        }
        moved => {
            if self.pressed {
                Controls.set-parameter(index, clamp(drag-start + (self.mouse-x - self.pressed-x) / travel, 0, 1));
            }
        }
        double-clicked => { Controls.reset(index); }
        scroll-event(e) => {
            let d = abs(e.delta-x / 1px) > abs(e.delta-y / 1px) ? -e.delta-x : e.delta-y;
            Controls.set-parameter(index, clamp(pos + max(-0.05, min(0.05, d / 400px)), 0, 1));
            accept
        }
    }
}

// A small round knob for D/W, its arc in the tint.
component DwKnob inherits Rectangle {
    in property <int> index;
    in property <color> tint;
    property <float> param: Controls.parameter(index, Controls.tick);
    property <float> drag-start;
    property <angle> a: -135deg + param * 270deg;
    width: 20px;
    height: 20px;
    Rectangle {
        border-radius: self.width / 2;
        background: ta.has-hover ? #2a2a2e : #121214;
        border-width: 1.5px;
        border-color: #58585d;
    }
    Path {
        viewbox-width: 100;
        viewbox-height: 100;
        stroke: param > 0.004 ? tint : #e4e4e8;
        stroke-width: 2px;
        stroke-line-cap: round;
        MoveTo { x: 50 + 4 * sin(a); y: 50 - 4 * cos(a); }
        LineTo { x: 50 + 34 * sin(a); y: 50 - 34 * cos(a); }
    }
    ta := TouchArea {
        mouse-cursor: ns-resize;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                drag-start = param;
            }
        }
        moved => {
            Controls.set-parameter(index, clamp(drag-start + (self.pressed-y - self.mouse-y) / 160px, 0, 1));
        }
        double-clicked => { Controls.reset(index); }
        scroll-event(e) => {
            Controls.set-parameter(index, clamp(param + (e.delta-y > 0 ? 0.02 : -0.02), 0, 1));
            accept
        }
    }
}

// One effect: the effect chooser on top, ON, beats or slider and D/W under it.

// The effect's name and ▾, opening the list of effects under it. Picking
// one loads it and turns it on; picking the loaded one turns it on or off.
component EffectPicker inherits Rectangle {
    in property <string> fx;
    in property <color> tint;
    in property <length> font-size: 14px;
    in property <bool> centred: true;
    property <int> loaded-index: Controls.resolve(fx, "loaded_effect");
    property <int> enabled-index: Controls.resolve(fx, "enabled");
    property <int> loaded: Controls.value(loaded-index, Controls.tick);
    property <bool> has-effect: loaded > 0 && loaded <= EffectList.names.length;
    min-width: 0px;
    horizontal-stretch: 1;
    HorizontalLayout {
        alignment: centred ? center : start;
        spacing: 5px;
        Text {
            min-width: 0px;
            text: has-effect ? EffectList.names[loaded - 1] : "No effect";
            color: !has-effect ? Theme.text-dim : ta.has-hover ? #ffffff : Theme.text;
            font-size: root.font-size;
            font-weight: 500;
            vertical-alignment: center;
            overflow: elide;
        }
        Path {
            width: 9px;
            height: 6px;
            y: (parent.height - self.height) / 2;
            viewbox-width: 9;
            viewbox-height: 6;
            commands: "M 1 1 L 4.5 4.5 L 8 1";
            stroke: ta.has-hover ? Theme.text : #b0b0b5;
            stroke-width: 1.6px;
            stroke-line-cap: round;
            fill: transparent;
        }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { menu.show(); } }
    menu := PopupWindow {
        x: centred ? (root.width - 190px) / 2 : 0px;
        y: root.height + 2px;
        width: 190px;
        close-policy: close-on-click-outside;
        Rectangle {
            background: Theme.panel-raised;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 12px;
            drop-shadow-color: #000000a0;
        }
        VerticalLayout {
            padding: 6px;
            spacing: 0px;
            for e[i] in EffectList.names: Rectangle {
                property <bool> current: loaded == i + 1;
                height: 26px;
                border-radius: 4px;
                background: current ? tint.with-alpha(0.35) : eta.has-hover ? #3a3a3d : transparent;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    Text { text: e; color: Theme.text; font-size: 12px; font-weight: current ? 700 : 400; vertical-alignment: center; horizontal-stretch: 1; }
                }
                eta := TouchArea {
                    clicked => {
                        if current {
                            Controls.toggle(enabled-index);
                        } else {
                            Controls.set-value(loaded-index, i + 1);
                            Controls.set-value(enabled-index, 1);
                        }
                        menu.close();
                    }
                }
            }
        }
    }
}

// ON, then (with `with-name`) the effect's name, its beats or slider, and D/W.
component FxControls inherits HorizontalLayout {
    in property <string> fx;
    in property <color> tint;
    in property <bool> with-name;
    property <int> enabled-index: Controls.resolve(fx, "enabled");
    property <int> loaded-index: Controls.resolve(fx, "loaded_effect");
    property <int> beats-index: Controls.resolve(fx, "beats");
    property <bool> on: Controls.value(enabled-index, Controls.tick) > 0;
    property <int> loaded: Controls.value(loaded-index, Controls.tick);
    property <float> beats: Controls.value(beats-index, Controls.tick);
    property <bool> has-effect: loaded > 0 && loaded <= EffectList.names.length;
    property <int> param: has-effect && loaded <= EffectList.slider-params.length ? EffectList.slider-params[loaded - 1] : -1;
    padding-left: 6px;
    padding-right: 6px;
    spacing: 4px;
    // ON, lit in the deck's colour while the effect plays.
    Rectangle {
        width: 34px;
        height: 23px;
        y: (parent.height - self.height) / 2;
        border-radius: 6px;
        background: on ? tint : ota.pressed ? Theme.control-pressed : ota.has-hover ? #222225 : #141416;
        border-width: 1px;
        border-color: on ? tint : #48484c;
        Text { text: "ON"; color: on ? #ffffff : has-effect ? Theme.text : Theme.text-dim; font-size: 12px; font-weight: 500; }
        ota := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                if has-effect {
                    Controls.toggle(enabled-index);
                }
            }
        }
    }
    if with-name: EffectPicker { fx: fx; tint: tint; font-size: 13px; centred: false; min-width: 64px; preferred-width: 110px; horizontal-stretch: 0; }
    Rectangle {
        horizontal-stretch: 1;
        min-width: 50px;
        if beats > 0: BeatChooser { width: parent.width; height: parent.height; index: beats-index; }
        if beats <= 0 && param >= 0: ParamSlider { width: parent.width; height: parent.height; index: Controls.resolve(fx, "parameter" + (param + 1)); }
    }
    HorizontalLayout {
        horizontal-stretch: 0;
        spacing: 2px;
        Text { text: "D"; color: Theme.text-dim; font-size: 10px; font-weight: 700; vertical-alignment: center; }
        VerticalLayout {
            alignment: center;
            DwKnob { index: Controls.resolve(fx, "meta"); tint: tint; }
        }
        Text { text: "W"; color: Theme.text-dim; font-size: 10px; font-weight: 700; vertical-alignment: center; }
    }
}

// 2-Deck: one effect as a cell of two rows, ‹ name ▾ › over its controls.
component FxCell inherits Rectangle {
    // The effect unit and slot, from 0.
    in property <int> unit;
    in property <int> slot;
    in property <color> tint;
    property <string> fx: "[EffectRack1_EffectUnit" + (unit + 1) + "_Effect" + (slot + 1) + "]";
    background: Theme.panel;
    horizontal-stretch: 1;
    min-width: 0px;
    preferred-width: 0px;
    VerticalLayout {
        spacing: 0px;
        HorizontalLayout {
            height: 30px;
            StepArrow { index: Controls.resolve(fx, "prev_effect"); }
            EffectPicker { fx: fx; tint: tint; }
            StepArrow { next: true; index: Controls.resolve(fx, "next_effect"); }
        }
        Rectangle { height: 1px; background: #000000; }
        FxControls { height: 37px; fx: fx; tint: tint; }
    }
}

// 4-Deck: a deck's three effects stacked, one line each.
component FxStack inherits Rectangle {
    in property <int> deck;
    background: Theme.panel;
    horizontal-stretch: 1;
    min-width: 0px;
    preferred-width: 0px;
    VerticalLayout {
        padding-top: 2px;
        padding-bottom: 2px;
        for i in 3: FxControls {
            vertical-stretch: 1;
            fx: "[EffectRack1_EffectUnit" + (deck + 1) + "_Effect" + (i + 1) + "]";
            tint: Theme.deck-color(deck);
            with-name: true;
        }
    }
}

// A word that lights up when chosen, as djay's MANUAL / INSTANT.
component TextToggle inherits Text {
    in property <bool> lit;
    callback clicked();
    color: lit ? Theme.accent : ta.has-hover ? Theme.text : Theme.text-dim;
    font-size: 11px;
    font-weight: 600;
    vertical-alignment: center;
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// The middle, as wide as the mixer: BEAT FX, the effect (its list under
// the name) and where it goes (deck 1, deck 2 or both), over ON, its
// length in beats and LEVEL as D/W. The DDJ-FLX4's BEAT FX section drives
// the same controls.
component BeatFxSection inherits Rectangle {
    property <string> unit: "[EffectRack1_EffectUnit5]";
    property <string> fx: "[EffectRack1_EffectUnit5_Effect1]";
    property <int> ch1-index: Controls.resolve(unit, "group_[Channel1]_enable");
    property <int> ch2-index: Controls.resolve(unit, "group_[Channel2]_enable");
    property <int> main-index: Controls.resolve(unit, "group_[Master]_enable");
    property <bool> ch1: Controls.value(ch1-index, Controls.tick) > 0;
    property <bool> ch2: Controls.value(ch2-index, Controls.tick) > 0;
    background: Theme.panel;
    width: 282px;
    VerticalLayout {
        alignment: center;
        spacing: 0px;
        HorizontalLayout {
            height: 30px;
            padding-left: 8px;
            padding-right: 8px;
            spacing: 6px;
            Text { text: "BEAT FX"; color: Theme.text-dim; font-size: 9px; font-weight: 700; letter-spacing: 0.5px; vertical-alignment: center; }
            EffectPicker { fx: fx; tint: Theme.accent; }
            // Where it goes: deck 1, deck 2 or both.
            for c[i] in ["1", "2", "1&2"]: TextToggle {
                text: c;
                lit: i == 0 ? ch1 && !ch2 : i == 1 ? ch2 && !ch1 : ch1 && ch2;
                clicked => {
                    Controls.set-value(ch1-index, i == 0 || i == 2 ? 1 : 0);
                    Controls.set-value(ch2-index, i == 1 || i == 2 ? 1 : 0);
                    Controls.set-value(main-index, 0);
                }
            }
        }
        Rectangle { height: 1px; background: #000000; }
        FxControls { height: 37px; fx: fx; tint: Theme.accent; }
    }
}

export component FxBar inherits Rectangle {
    // 4-Deck: decks 3 and 1 left of the Beat FX, 2 and 4 right of it, each
    // deck's effects stacked.
    in property <bool> four;
    background: #000000;
    height: four ? 96px : 68px;
    if !four: HorizontalLayout {
        spacing: 1px;
        // As wide as the decks above, either side of the mixer.
        HorizontalLayout {
            spacing: 1px;
            horizontal-stretch: 1;
            min-width: 400px;
            preferred-width: 400px;
            for i in 3: FxCell { unit: 0; slot: i; tint: Theme.deck1; }
        }
        BeatFxSection { }
        HorizontalLayout {
            spacing: 1px;
            horizontal-stretch: 1;
            min-width: 400px;
            preferred-width: 400px;
            for i in 3: FxCell { unit: 1; slot: i; tint: Theme.deck2; }
        }
    }
    if four: HorizontalLayout {
        spacing: 1px;
        FxStack { deck: 2; }
        FxStack { deck: 0; }
        BeatFxSection { }
        FxStack { deck: 1; }
        FxStack { deck: 3; }
    }
}
