// The compact row (PlayerDeck, PlayerMixer): shown over the expanded
// library in 2-Deck and 4-Deck, so the browser gets more room. The decks
// are just their headers (cover, title, time, key and overview); the
// middle holds the basics: on each outer side a small text-free jog over
// play, CUE and SYNC, then the EQs in a 2 x 2 grid, gain over the channel
// fader, and the meters in the centre. No pads, FX, loops, tempo faders or
// crossfader.
//
// PlayerBar, further down, is the Player layout itself.
import { LibraryEdit, ListPanel, TrackDrag } from "library.slint";
import { Theme } from "theme.slint";
import { NowPlayingUi } from "nowplaying.slint";
import { LineEdit } from "std-widgets.slint";
import { ControlButton, ControlFader, Controls, StereoMeter, SyncButton } from "controls.slint";
import { Cover, DeckInfo, Header, Jog, PlayButton } from "deck.slint";
import { LevelSlider } from "toppanels.slint";
import { Knob, ModeMenu, SideKnob } from "mixer.slint";

export component PlayerDeck inherits Rectangle {
    in property <int> deck;
    in property <DeckInfo> info;
    in property <image> overview;
    in property <bool> mirrored: false;
    out property <length> overview-width: header.overview-width;
    out property <length> overview-height: header.overview-height;
    property <color> tint: Theme.deck-color(deck);

    // As in Pro: the row is the track block's height.
    header := Header {
        width: parent.width;
        height: parent.height;
        deck: deck;
        info: info;
        overview: overview;
        mirrored: mirrored;
        group: "[Channel" + (deck + 1) + "]";
    }

    // Files dragged in from Finder or a file manager (see TrackDrag.files-over).
    property <bool> under-files: TrackDrag.files-x >= self.absolute-position.x && TrackDrag.files-x < self.absolute-position.x + self.width
        && TrackDrag.files-y >= self.absolute-position.y && TrackDrag.files-y < self.absolute-position.y + self.height;
    property <bool> files-here: TrackDrag.files-over && under-files;
    property <int> files-dropped: TrackDrag.files-dropped;
    changed files-dropped => {
        if under-files {
            TrackDrag.drop-files(deck);
        }
    }

    // Tracks dragged from the browser load here, as on the Pro deck.
    drop := DropArea {
        can-drop(e) => { TrackDrag.accepts(e.data) ? DragAction.copy : DragAction.none }
        dropped(e) => {
            TrackDrag.drop(deck, e.data);
            TrackDrag.active = false;
            DragAction.copy
        }
    }
    if TrackDrag.active || TrackDrag.files-over || drop.has-drag: Rectangle {
        border-radius: Theme.radius + 2px;
        border-width: drop.has-drag || files-here ? 3px : 2px;
        border-color: drop.has-drag || files-here ? tint : tint.transparentize(0.55);
        background: drop.has-drag || files-here ? tint.transparentize(0.9) : transparent;
    }
}

// A small jog with play, CUE and SYNC under it, all three the same size.
component PlayerTransport inherits VerticalLayout {
    in property <int> deck;
    in property <DeckInfo> info;
    in property <angle> spin;
    property <string> group: "[Channel" + (deck + 1) + "]";
    property <color> tint: Theme.deck-color(deck);
    alignment: center;
    spacing: 6px;
    HorizontalLayout {
        alignment: center;
        Jog { group: group; info: info; tint: tint; spin: spin; plain: true; width: 58px; height: 58px; }
    }
    HorizontalLayout {
        spacing: 4px;
        height: 26px;
        PlayButton { group: group; tint: tint; width: 42px; }
        ControlButton { group: group; key: "cue_default"; text: "CUE"; momentary: true; tint: tint; outline-when-lit: true; font-size: 11px; width: 42px; }
        SyncButton { group: group; tint: tint; menu-right-aligned: Math.mod(deck, 2) == 1; font-size: 11px; width: 42px; }
    }
}

// One deck's half of the middle, from the outer edge in: jog and buttons,
// the four EQ knobs in a 2 x 2 grid (or stems or sculpt, as the menu says),
// and gain over the channel fader. Deck B's is the mirror image.
component PlayerChannel inherits HorizontalLayout {
    in property <int> deck;
    in property <DeckInfo> info;
    in property <angle> spin;
    property <string> group: "[Channel" + (deck + 1) + "]";
    property <bool> right: deck == 1;
    spacing: 10px;
    if !right: PlayerTransport { deck: deck; info: info; spin: spin; }
    if right: VerticalLayout {
        spacing: 4px;
        Knob { group: group; key: "pregain"; size: 20px; }
        ControlFader { group: group; key: "volume"; tint: Theme.deck-color(deck); ticks: 9; width: 32px; vertical-stretch: 1; }
    }
    // HIGH and MID over LOW and FILTER.
    VerticalLayout {
        alignment: center;
        for row in 2: HorizontalLayout {
            SideKnob { deck: deck; place: row * 2; size: 22px; width: 42px; }
            SideKnob { deck: deck; place: row * 2 + 1; size: 22px; width: 42px; }
        }
    }
    if !right: VerticalLayout {
        spacing: 4px;
        Knob { group: group; key: "pregain"; size: 20px; }
        ControlFader { group: group; key: "volume"; tint: Theme.deck-color(deck); ticks: 9; width: 32px; vertical-stretch: 1; }
    }
    if right: PlayerTransport { deck: deck; info: info; spin: spin; }
}

export component PlayerMixer inherits Rectangle {
    in property <[DeckInfo]> decks;
    in property <angle> spin-1;
    in property <angle> spin-2;
    background: Theme.panel;
    HorizontalLayout {
        padding: 6px;
        spacing: 10px;
        PlayerChannel { deck: 0; info: decks[0]; spin: spin-1; }
        // The knob mode menu over the two channel meters.
        VerticalLayout {
            spacing: 4px;
            ModeMenu { width: 34px; }
            HorizontalLayout {
                alignment: center;
                spacing: 4px;
                padding-top: 6px;
                vertical-stretch: 1;
                StereoMeter { group: "[Channel1]"; }
                StereoMeter { group: "[Channel2]"; }
            }
        }
        PlayerChannel { deck: 1; info: decks[1]; spin: spin-2; }
    }
}

// A plain transport icon button for the Player bar: no box, the glyph
// brightens on hover and dims when there is nothing to do.
component BarButton inherits Rectangle {
    in property <bool> enabled: true;
    // Switched on (Repeat): drawn in the accent.
    in property <bool> lit: false;
    // Shown under the button on hover, e.g. "Turn on repeat".
    in property <string> tip;
    callback clicked();
    width: 36px;
    height: 36px;
    border-radius: 18px;
    background: enabled && ta.has-hover ? #ffffff14 : transparent;
    out property <color> ink: !enabled ? Theme.text-dim.with-alpha(0.5) : lit ? Theme.accent : ta.has-hover ? Theme.text : Theme.text.with-alpha(0.85);
    @children
    if tip != "" && ta.has-hover: Rectangle {
        // Above: the bar sits at the bottom of the window.
        x: (parent.width - self.width) / 2;
        y: -self.height - 4px;
        width: tip-text.preferred-width + 16px;
        height: 22px;
        border-radius: 5px;
        background: Theme.panel-raised;
        border-width: 1px;
        border-color: Theme.border;
        tip-text := Text { text: tip; color: Theme.text; font-size: 11px; }
    }
    ta := TouchArea {
        mouse-cursor: enabled ? pointer : default;
        clicked => {
            if enabled {
                root.clicked();
            }
        }
    }
}

// The Player layout's one bar (104 px), along the bottom of the window as
// in music players: what is playing on the left (album art, title, artist,
// BPM, the key in its colour and Automix's next track), the transport over
// a thin progress line in the middle, and the volume, mini player, lyrics and queue
// buttons on the right over the file's quality. Underneath, decks 1 and 2
// keep alternating and Automix mixes from one to the other, so a song never
// just stops and the next starts cold; the bar always shows the deck
// playing. Order and Repeat are in Up Next's header, with the rest of what
// acts on the queue.
export component PlayerBar inherits Rectangle {
    in property <[DeckInfo]> decks;
    // The deck to show: Automix's live deck, else the master deck.
    in property <int> live;
    // The deck Automix is mixing into, -1 when not mixing.
    in property <int> mixing-into: -1;
    in property <bool> automix-on;
    in property <string> automix-status;
    // The track Automix plays next, and the time before its mix starts.
    in property <string> automix-next;
    in property <string> automix-next-in;
    // The Automix list has tracks to play.
    in property <bool> queue-has-tracks;
    in property <bool> queue-shown;
    callback automix-toggle();
    callback automix-mix-now();
    callback toggle-queue();
    callback mini-player();
    property <int> d: live == 1 ? 1 : 0;
    property <DeckInfo> info: decks[d];
    property <string> group: "[Channel" + (d + 1) + "]";
    property <int> play-index: Controls.resolve(group, "play");
    property <bool> playing: Controls.value(play-index, Controls.tick) > 0;
    property <int> position-index: Controls.resolve(group, "playposition");
    property <int> hold-index: Controls.resolve(group, "seek_hold");
    property <length> press-x;
    property <bool> scrubbing;
    // While dragging, where the pointer is (0 to 1), drawn at once rather
    // than when the deck catches up.
    property <float> drag-at;
    property <float> shown-progress: scrubbing ? drag-at : clamp(info.progress, 0, 1);
    // Time played and the track's length, "1:23" and "4:12".
    property <int> elapsed-s: info.loaded ? floor(shown-progress * info.duration) : 0;
    property <int> total-s: info.loaded ? floor(info.duration) : 0;
    property <string> elapsed: floor(elapsed-s / 60) + ":" + (mod(elapsed-s, 60) < 10 ? "0" : "") + mod(elapsed-s, 60);
    property <string> total: floor(total-s / 60) + ":" + (mod(total-s, 60) < 10 ? "0" : "") + mod(total-s, 60);
    // The time under the pointer, for the tip over the line.
    property <int> hover-s: info.loaded ? floor(clamp(line-ta.mouse-x / line-ta.width, 0, 1) * info.duration) : 0;
    property <string> hover-time: floor(hover-s / 60) + ":" + (mod(hover-s, 60) < 10 ? "0" : "") + mod(hover-s, 60);
    // BPM to one decimal, without a trailing ".0".
    property <string> bpm: info.bpm.is-float() ? "" + round(info.bpm.to-float() * 10) / 10 : "";
    // Both sides of the transport are this wide, so it sits in the middle
    // of the window.
    property <length> side: clamp(root.width * 0.28, 340px, 480px);
    property <length> pad: 18px;
    property <length> gap: 28px;
    // Under the pointer the line turns lilac and shows its knob.
    property <bool> line-hot: info.loaded && (line-ta.has-hover || line-ta.pressed);
    // Sized by the window, not by what is in it: the sides follow the
    // bar's width.
    min-width: 0px;
    preferred-width: 0px;
    background: Theme.panel;

    HorizontalLayout {
        padding-left: pad;
        padding-right: pad;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: gap;

        // The album art, then title, artist, BPM and the key in its wheel
        // colour, and what Automix plays next.
        HorizontalLayout {
            width: side - pad - gap;
            spacing: 14px;
            VerticalLayout {
                alignment: center;
                // A click opens Now Playing over the library, or closes it.
                Cover {
                    deck: d;
                    tint: Theme.deck-color(d);
                    info: info;
                    size: 76px;
                    radius: 6px;
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { NowPlayingUi.toggle(); }
                    }
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                min-width: 0px;
                alignment: center;
                spacing: 3px;
                Text { text: info.loaded ? info.title : "Nothing playing"; color: Theme.text; font-size: 17px; font-weight: 700; overflow: elide; }
                HorizontalLayout {
                    alignment: start;
                    Text {
                        min-width: 0px;
                        text: info.loaded ? info.artist : queue-has-tracks ? "Press play to start Up Next" : "Add tracks to Up Next";
                        color: Theme.text-dim;
                        font-size: 14px;
                        overflow: elide;
                    }
                    if info.loaded && bpm != "": Text { text: " · " + bpm; color: Theme.text-dim; font-size: 14px; }
                    if info.loaded && info.key != "": Text { text: " · "; color: Theme.text-dim; font-size: 14px; }
                    if info.loaded && info.key != "": Text { text: info.key; color: Theme.key-wheel-color(info.key-wheel); font-size: 14px; font-weight: 700; }
                }
                // Automix's next step, as other players show where the
                // music comes from.
                Text {
                    property <string> what: automix-next != "" ? automix-next : automix-status;
                    text: mixing-into >= 0 ? "MIXING" + (what != "" ? " · " + what : "")
                        : automix-next-in != "" ? "NEXT IN " + automix-next-in + (what != "" ? " · " + what : "")
                        : automix-on ? (what != "" ? "NEXT · " + what : "AUTOMIX")
                        : "AUTOMIX OFF";
                    color: automix-on ? Theme.accent : Theme.text-dim;
                    font-size: 11px;
                    font-weight: 600;
                    overflow: elide;
                }
            }
            // ＋: the track playing goes into a crate or playlist, as the
            // heart or ＋ of other music players.
            if info.loaded && LibraryEdit.has-lists: VerticalLayout {
                alignment: center;
                add := BarButton {
                    tip: "Add to a crate or playlist";
                    clicked => {
                        list-find = "";
                        LibraryEdit.find-lists("");
                        list-popup.show();
                    }
                    Path {
                        width: 22px;
                        height: 22px;
                        viewbox-width: 20;
                        viewbox-height: 20;
                        stroke: add.ink;
                        stroke-width: 1.6px;
                        commands: "M 10 1.5 A 8.5 8.5 0 1 1 9.99 1.5 Z M 10 6 L 10 14 M 6 10 L 14 10";
                    }
                }
            }
        }

        // Previous, Play/Pause and Next over the progress line, between
        // the time played and the track's length.
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 8px;
            HorizontalLayout {
                alignment: center;
                spacing: 26px;
                // Previous: back to the start of the track.
                VerticalLayout {
                    alignment: center;
                    prev := BarButton {
                        enabled: info.loaded;
                        clicked => { Controls.set-value(Controls.resolve(group, "start"), 1); }
                        Path {
                            width: 18px;
                            height: 18px;
                            viewbox-width: 18;
                            viewbox-height: 18;
                            fill: prev.ink;
                            commands: "M 2 3 L 4 3 L 4 15 L 2 15 Z M 15 3 L 6 9 L 15 15 Z";
                        }
                    }
                }
                // Play or pause. Starting also switches Automix on, so the
                // next track in Up Next mixes in when this one ends.
                Rectangle {
                    width: 44px;
                    height: 44px;
                    border-radius: 22px;
                    background: pta.pressed ? Theme.text.darker(0.2) : Theme.text;
                    if playing: Path {
                        width: 18px;
                        height: 18px;
                        viewbox-width: 16;
                        viewbox-height: 16;
                        fill: Theme.background;
                        commands: "M 3 2 L 6.5 2 L 6.5 14 L 3 14 Z M 9.5 2 L 13 2 L 13 14 L 9.5 14 Z";
                    }
                    if !playing: Path {
                        x: 15px;
                        width: 18px;
                        height: 18px;
                        viewbox-width: 16;
                        viewbox-height: 16;
                        fill: Theme.background;
                        commands: "M 2 1 L 15 8 L 2 15 Z";
                    }
                    pta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            if playing {
                                Controls.set-value(play-index, 0);
                            } else {
                                if info.loaded {
                                    Controls.set-value(play-index, 1);
                                }
                                if !automix-on && (queue-has-tracks || !info.loaded) {
                                    automix-toggle();
                                }
                            }
                        }
                    }
                }
                // Next: mix into the next track now.
                VerticalLayout {
                    alignment: center;
                    next := BarButton {
                        enabled: automix-on && queue-has-tracks;
                        clicked => { automix-mix-now(); }
                        Path {
                            width: 18px;
                            height: 18px;
                            viewbox-width: 18;
                            viewbox-height: 18;
                            fill: next.ink;
                            commands: "M 14 3 L 16 3 L 16 15 L 14 15 Z M 3 3 L 12 9 L 3 15 Z";
                        }
                    }
                }
            }
            HorizontalLayout {
                height: 16px;
                spacing: 12px;
                Text { text: elapsed; color: Theme.text-dim; font-size: 12px; vertical-alignment: center; horizontal-alignment: right; min-width: 40px; }
                // The line: played in white (lilac under the pointer), the
                // rest grey, Automix's next mix a dim lilac. A click jumps
                // there; a drag holds the deck silent under the pointer and
                // carries on from where it is let go.
                line := Rectangle {
                    horizontal-stretch: 1;
                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        height: line-hot ? 5px : 4px;
                        border-radius: self.height / 2;
                        background: #ffffff2e;
                        clip: true;
                        if info.loaded && info.automix-to > info.automix-from: Rectangle {
                            x: parent.width * info.automix-from;
                            width: parent.width * (info.automix-to - info.automix-from);
                            background: Theme.accent.with-alpha(0.4);
                        }
                        Rectangle {
                            x: 0;
                            width: parent.width * shown-progress;
                            border-radius: parent.border-radius;
                            background: line-hot ? Theme.accent : #ffffff;
                        }
                    }
                    if line-hot: Rectangle {
                        x: parent.width * shown-progress - 6px;
                        y: (parent.height - 12px) / 2;
                        width: 12px;
                        height: 12px;
                        border-radius: 6px;
                        background: #ffffff;
                    }
                    if line-ta.has-hover && info.loaded: Rectangle {
                        x: clamp(line-ta.mouse-x, 0, parent.width) - self.width / 2;
                        y: -self.height - 8px;
                        width: hover-text.preferred-width + 14px;
                        height: 22px;
                        border-radius: 5px;
                        background: Theme.panel-raised;
                        border-width: 1px;
                        border-color: Theme.border;
                        hover-text := Text { text: scrubbing ? elapsed : hover-time; color: Theme.text; font-size: 12px; }
                    }
                    line-ta := TouchArea {
                        enabled: info.loaded;
                        mouse-cursor: pointer;
                        pointer-event(e) => {
                            if e.button != PointerEventButton.left && e.kind != PointerEventKind.cancel {
                                return;
                            }
                            if e.kind == PointerEventKind.down {
                                press-x = self.mouse-x;
                                scrubbing = false;
                                Controls.set-value(position-index, clamp(self.mouse-x / self.width, 0, 1));
                            } else if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                                if scrubbing {
                                    Controls.set-value(hold-index, 0);
                                }
                                scrubbing = false;
                            }
                        }
                        moved => {
                            if self.pressed {
                                if !scrubbing && abs(self.mouse-x - press-x) > 4px {
                                    scrubbing = true;
                                    Controls.set-value(hold-index, 1);
                                }
                                if scrubbing {
                                    drag-at = clamp(self.mouse-x / self.width, 0, 1);
                                    Controls.set-value(position-index, drag-at);
                                }
                            }
                        }
                    }
                }
                Text { text: info.loaded ? total : "0:00"; color: Theme.text-dim; font-size: 12px; vertical-alignment: center; min-width: 40px; }
            }
        }

        // The volume, mini player, lyrics and queue buttons, over the
        // file's quality.
        VerticalLayout {
            width: side - pad - gap;
            alignment: center;
            spacing: 6px;
            HorizontalLayout {
                spacing: 10px;
                alignment: end;
                // The master level, as in the MASTER panel.
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: 6px;
                        Path {
                            width: 20px;
                            height: 18px;
                            y: 4px;
                            viewbox-width: 16;
                            viewbox-height: 14;
                            fill: Theme.text-dim;
                            commands: "M 1 5 L 4 5 L 8 2 L 8 12 L 4 9 L 1 9 Z";
                        }
                        LevelSlider { group: "[Master]"; key: "gain"; width: 110px; horizontal-stretch: 0; tint: Theme.text; }
                    }
                }
                // The mini player: a small window on top of the others.
                VerticalLayout {
                    alignment: center;
                    mini := BarButton {
                        tip: "Mini player  (⇧⌘M)";
                        clicked => { mini-player(); }
                        Path {
                            width: 20px;
                            height: 20px;
                            viewbox-width: 20;
                            viewbox-height: 20;
                            stroke: mini.ink;
                            stroke-width: 1.6px;
                            commands: "M 2 4 L 18 4 L 18 16 L 2 16 Z M 10 10 L 16 10 L 16 14 L 10 14 Z";
                        }
                    }
                }
                // Opens Now Playing on its Lyrics, or closes it.
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 40px;
                        height: 36px;
                        border-radius: 9px;
                        property <bool> lit: NowPlayingUi.open && NowPlayingUi.tab == 0;
                        background: lit ? Theme.accent.with-alpha(0.18) : lyta.has-hover ? #3a3a3d : transparent;
                        border-width: lit ? 1px : 0px;
                        border-color: Theme.accent;
                        // A speech bubble with lines of words.
                        Path {
                            width: 22px;
                            height: 19px;
                            viewbox-width: 18;
                            viewbox-height: 16;
                            stroke: lit ? Theme.accent : Theme.text;
                            stroke-width: 1.6px;
                            commands: "M 2 1.5 L 16 1.5 L 16 11 L 7 11 L 3.5 14.5 L 3.5 11 L 2 11 Z M 5 5 L 13 5 M 5 8 L 10.5 8";
                        }
                        lyta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                if lit {
                                    NowPlayingUi.close();
                                } else {
                                    NowPlayingUi.show(0);
                                }
                            }
                        }
                    }
                }
                // Shows or hides Up Next (the Automix list) on the right.
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 40px;
                        height: 36px;
                        border-radius: 9px;
                        background: queue-shown ? Theme.accent.with-alpha(0.18) : qta.has-hover ? #3a3a3d : transparent;
                        border-width: queue-shown ? 1px : 0px;
                        border-color: Theme.accent;
                        Path {
                            width: 22px;
                            height: 19px;
                            viewbox-width: 18;
                            viewbox-height: 16;
                            stroke: queue-shown ? Theme.accent : Theme.text;
                            stroke-width: 1.7px;
                            commands: "M 1 2 L 13 2 M 1 7 L 13 7 M 1 12 L 8 12";
                        }
                        Path {
                            width: 22px;
                            height: 19px;
                            viewbox-width: 18;
                            viewbox-height: 16;
                            fill: queue-shown ? Theme.accent : Theme.text;
                            commands: "M 11 10 L 16 12.5 L 11 15 Z";
                        }
                        qta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { toggle-queue(); }
                        }
                    }
                }
            }
            // The file's quality, as music players tag theirs: lilac for
            // lossless, grey otherwise.
            if info.loaded && info.quality != "": HorizontalLayout {
                alignment: end;
                Rectangle {
                    height: 20px;
                    width: q-text.preferred-width + 14px;
                    border-radius: 4px;
                    background: info.lossless ? Theme.accent.with-alpha(0.16) : #ffffff12;
                    q-text := Text {
                        text: info.quality;
                        color: info.lossless ? Theme.accent : Theme.text-dim;
                        font-size: 10px;
                        font-weight: 700;
                        letter-spacing: 0.4px;
                    }
                }
            }
        }
    }

    property <string> list-find;
    // The lists to add the playing track to, opening upwards from the bar.
    list-popup := PopupWindow {
        x: min(root.width - 296px, side - 280px);
        y: -self.height - 6px;
        width: 290px;
        height: panel.preferred-height;
        close-policy: close-on-click-outside;
        panel := ListPanel {
            width: parent.width;
            mode: 1;
            deck: d;
            find <=> list-find;
            done => { list-popup.close(); }
        }
    }

    // A thin line along the top, between the bar and the library.
    Rectangle { y: 0; height: 1px; background: Theme.border; }

    // Tracks dragged from the list or Up Next onto any part of the bar: the
    // first plays now (mixed in by Automix), the rest straight after it.
    bar-drop := DropArea {
        can-drop(e) => { TrackDrag.accepts(e.data) ? DragAction.copy : DragAction.none }
        dropped(e) => {
            TrackDrag.drop-player(e.data);
            TrackDrag.active = false;
            DragAction.copy
        }
    }
    if TrackDrag.active || bar-drop.has-drag: Rectangle {
        border-radius: Theme.radius + 2px;
        border-width: bar-drop.has-drag ? 3px : 2px;
        border-color: bar-drop.has-drag ? Theme.accent : Theme.accent.transparentize(0.55);
        background: bar-drop.has-drag ? Theme.accent.transparentize(0.9) : transparent;
        if bar-drop.has-drag: Rectangle {
            // In the top right corner, clear of the transport.
            x: parent.width - self.width - 12px;
            y: 8px;
            height: 22px;
            width: drop-text.preferred-width + 20px;
            border-radius: 11px;
            background: Theme.accent;
            drop-text := Text { text: "Play now"; color: #ffffff; font-size: 13px; font-weight: 700; }
        }
    }
}

// One match in the top-bar search's dropdown.
export struct QuickRow {
    // A track's id, or (below -1) an artist or album row.
    id: int,
    // 0 a track, 1 an artist, 2 an album.
    kind: int,
    title: string,
    artist: string,
    // BPM, key and length, e.g. "121.0 · 9A · 4:44".
    detail: string,
    cover: image,
    has-cover: bool,
    initials: string,
}

// The Player layout's search box in the top bar (quick_search.rs).
export global QuickSearch {
    in-out property <string> text;
    in property <[QuickRow]> rows;
    // Matches in the whole collection; the dropdown shows the first few.
    in property <int> total;
    // The row the arrow keys are on.
    in-out property <int> current: 0;
    // What the last press did, e.g. "Golden Hour plays next".
    in-out property <string> note;
    // The dropdown shows: something typed and the box (or a row) in use.
    in-out property <bool> open;
    callback search(string);
    // mode 0 Play next, 1 Add to queue, 2 Play now.
    callback act(int, int);
    // Bumped to ask the box to take the keyboard (⌘F).
    in-out property <int> focus-asks;
    public function focus-box() {
        focus-asks += 1;
    }
    public function clear() {
        text = "";
        note = "";
        open = false;
        current = 0;
        search("");
    }
}

// The search box in the centre of the top bar. Typing opens the dropdown
// (QuickResults); ↑ ↓ move, ↵ plays the match next, ⇧↵ adds it to the
// end of Up Next, ⌘↵ plays it now, and Esc clears.
export component TopSearch inherits Rectangle {
    min-width: 180px;
    preferred-width: 560px;
    max-width: 560px;
    horizontal-stretch: 1;
    height: 34px;
    property <int> asks: QuickSearch.focus-asks;
    changed asks => { edit.focus(); }
    edit := LineEdit {
        width: parent.width;
        height: parent.height;
        placeholder-text: "Search songs, artists, albums  (⌘F)";
        text <=> QuickSearch.text;
        edited(t) => {
            QuickSearch.note = "";
            QuickSearch.current = 0;
            QuickSearch.open = t != "";
            QuickSearch.search(t);
        }
        accepted(t) => {
            if QuickSearch.rows.length > 0 {
                QuickSearch.act(QuickSearch.rows[QuickSearch.current].id, 0);
            }
        }
        key-pressed(e) => {
            if e.text == Key.Escape {
                if QuickSearch.text != "" {
                    QuickSearch.clear();
                    return accept;
                }
                return reject;
            }
            if e.text == Key.DownArrow && QuickSearch.rows.length > 0 {
                QuickSearch.open = true;
                QuickSearch.current = min(QuickSearch.current + 1, QuickSearch.rows.length - 1);
                return accept;
            }
            if e.text == Key.UpArrow && QuickSearch.rows.length > 0 {
                QuickSearch.current = max(QuickSearch.current - 1, 0);
                return accept;
            }
            // ⇧↵ and ⌘↵ (Ctrl+↵ on Linux and Windows); a plain ↵ is
            // `accepted` above.
            if e.text == Key.Return && QuickSearch.rows.length > 0 && (e.modifiers.shift || e.modifiers.control) {
                QuickSearch.act(QuickSearch.rows[QuickSearch.current].id, e.modifiers.control ? 2 : 1);
                return accept;
            }
            reject
        }
    }
}

// A small button on a dropdown row.
component RowAction inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    callback clicked();
    height: 24px;
    width: label.preferred-width + 16px;
    border-radius: 6px;
    background: primary ? (ta.has-hover ? Theme.accent.brighter(0.1) : Theme.accent) : ta.has-hover ? #ffffff26 : #ffffff14;
    label := Text {
        text: root.text;
        color: primary ? Theme.on-selection : Theme.text;
        font-size: 11px;
        font-weight: primary ? 600 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The dropdown under the top-bar search: the best matches, each with
// Play next, Add to queue and Play now on the row under the pointer or the
// arrow keys, and the keys in a line at the bottom.
export component QuickResults inherits Rectangle {
    width: 560px;
    height: list.preferred-height;
    background: Theme.panel-raised;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.border;
    drop-shadow-blur: 24px;
    drop-shadow-color: #000000c0;
    // Swallows clicks between the rows, so they don't reach the list below.
    TouchArea { }
    list := VerticalLayout {
        padding: 6px;
        spacing: 2px;
        for r[i] in QuickSearch.rows: VerticalLayout {
            // A heading where the kind of row changes: Artists, Albums,
            // Tracks.
            if i == 0 || QuickSearch.rows[i - 1].kind != r.kind: Text {
                height: 24px;
                x: 10px;
                text: r.kind == 1 ? "ARTISTS" : r.kind == 2 ? "ALBUMS" : "TRACKS";
                color: Theme.text-dim;
                font-size: 10px;
                font-weight: 700;
                letter-spacing: 0.6px;
                vertical-alignment: center;
            }
            Rectangle {
                height: 46px;
                border-radius: 8px;
                property <bool> lit: i == QuickSearch.current;
                background: lit ? #ffffff12 : transparent;
                rta := TouchArea {
                    mouse-cursor: pointer;
                    moved => { QuickSearch.current = i; }
                    changed has-hover => {
                        if self.has-hover {
                            QuickSearch.current = i;
                        }
                    }
                    // A double-click plays the track (or album) next, or
                    // shows the artist's tracks, like ↵.
                    double-clicked => { QuickSearch.act(r.id, 0); }
                }
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 34px;
                            height: 34px;
                            // Artists round, as other players show them.
                            border-radius: r.kind == 1 ? 17px : 5px;
                            clip: true;
                            background: @linear-gradient(135deg, Theme.accent 0%, Theme.accent.darker(0.6) 60%, #101012 100%);
                            if !r.has-cover: Text { text: r.initials; color: #ffffffe0; font-size: 12px; font-weight: 700; }
                            if r.has-cover: Image { width: parent.width; height: parent.height; source: r.cover; image-fit: cover; }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        min-width: 0px;
                        Text { text: r.title; color: Theme.text; font-size: 13px; overflow: elide; }
                        Text { text: r.artist + " · " + r.detail; color: Theme.text-dim; font-size: 12px; overflow: elide; }
                    }
                    if lit && r.kind == 1: HorizontalLayout {
                        alignment: end;
                        VerticalLayout { alignment: center; RowAction { text: "Show tracks"; primary: true; clicked => { QuickSearch.act(r.id, 0); } } }
                    }
                    if lit && r.kind != 1: HorizontalLayout {
                        alignment: end;
                        spacing: 6px;
                        VerticalLayout { alignment: center; RowAction { text: "Play next"; primary: true; clicked => { QuickSearch.act(r.id, 0); } } }
                        VerticalLayout { alignment: center; RowAction { text: "Add to queue"; clicked => { QuickSearch.act(r.id, 1); } } }
                        VerticalLayout { alignment: center; RowAction { text: "Play now"; clicked => { QuickSearch.act(r.id, 2); } } }
                    }
                }
            }
        }
        if QuickSearch.rows.length == 0: Text {
            height: 40px;
            x: 10px;
            text: "Nothing matches.";
            color: Theme.text-dim;
            font-size: 13px;
            vertical-alignment: center;
        }
        Rectangle { height: 1px; background: Theme.separator; }
        Text {
            height: 26px;
            x: 10px;
            width: parent.width - 20px;
            text: QuickSearch.note != "" ? QuickSearch.note
                : QuickSearch.rows.length == 0 ? "Esc clears"
                : (QuickSearch.total > QuickSearch.rows.length ? "First " + QuickSearch.rows.length + " of " + QuickSearch.total + " · " : "")
                    + "↵ play next · ⇧↵ add to queue · ⌘↵ play now · Esc clears";
            color: QuickSearch.note != "" ? Theme.accent : Theme.text-dim;
            font-size: 11px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}
