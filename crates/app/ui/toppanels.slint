// The top bar's dropdown panels: MASTER (output levels and Ableton Link)
// and MIC (the microphone and auxiliary inputs and the microphone's
// effects). Both close on a click outside them.
import { Theme, EdgeLine } from "theme.slint";
import { Caption, Controls, ControlButton, CueHeadphones, PickupGhost, VuMeter } from "controls.slint";
import { EffectList, FxSlot } from "deck.slint";
import { AudioSettings, Knob } from "mixer.slint";
import { Preferences } from "preferences.slint";

// A speaker, with one or two waves; for the ends of a level slider.
component SpeakerIcon inherits Path {
    in property <bool> loud;
    width: 14px;
    height: 12px;
    viewbox-width: 14;
    viewbox-height: 12;
    fill: transparent;
    stroke: Theme.text-dim;
    stroke-width: 1.2px;
    commands: loud
        ? "M 1 4 L 3.5 4 L 6.5 1.5 L 6.5 10.5 L 3.5 8 L 1 8 Z M 8.5 4 A 2.5 2.5 0 0 1 8.5 8 M 10.5 2 A 5 5 0 0 1 10.5 10"
        : "M 1 4 L 3.5 4 L 6.5 1.5 L 6.5 10.5 L 3.5 8 L 1 8 Z";
}

// A horizontal level slider in the style of macOS's volume slider: a thin
// track filled up to a round thumb. A click on the track jumps there, a
// drag moves it and a double click resets it. `detent` fills from the
// centre and catches the thumb there (the headphone cue/mix balance).
export component LevelSlider inherits Rectangle {
    in property <string> group;
    in property <string> key;
    in property <bool> detent: false;
    in property <color> tint: Theme.accent;
    property <int> index: Controls.resolve(group, key);
    property <float> pos: Controls.parameter(index, Controls.tick);
    property <float> hardware: Controls.hardware(index, Controls.tick);
    property <length> thumb: 18px;
    property <length> travel: self.width - thumb;
    property <float> origin: detent ? 0.5 : 0;
    property <float> drag-start;
    height: 20px;
    min-width: 80px;
    horizontal-stretch: 1;

    // Track, then the fill from the origin to the thumb.
    Rectangle {
        x: thumb / 2;
        width: travel;
        height: 4px;
        border-radius: 2px;
        background: #3a3a3e;
    }
    Rectangle {
        x: thumb / 2 + min(origin, pos) * travel;
        width: abs(pos - origin) * travel;
        height: 4px;
        border-radius: 2px;
        background: tint;
    }
    if detent: Rectangle {
        x: thumb / 2 + travel / 2 - 1px;
        y: 0px;
        width: 2px;
        height: 4px;
        border-radius: 1px;
        background: Theme.text-dim;
    }
    if hardware >= 0: PickupGhost {
        x: hardware * travel;
        width: thumb;
        height: 14px;
        border-radius: 7px;
        tint: tint;
        arrow: false;
    }
    Rectangle {
        x: pos * travel;
        width: thumb;
        height: 14px;
        border-radius: 7px;
        background: touch.pressed ? #d4d4d8 : #f2f2f4;
        drop-shadow-blur: 3px;
        drop-shadow-color: #00000080;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                let at = (self.mouse-x - thumb / 2) / travel;
                if abs(at - pos) * travel > thumb / 2 {
                    set(at);
                    drag-start = clamp(at, 0, 1);
                } else {
                    drag-start = pos;
                }
            }
        }
        moved => {
            if self.pressed {
                set(drag-start + (self.mouse-x - self.pressed-x) / travel);
            }
        }
        double-clicked => { Controls.reset(index); }
        scroll-event(e) => {
            let d = abs(e.delta-x / 1px) > abs(e.delta-y / 1px) ? -e.delta-x : e.delta-y;
            set(pos + max(-0.05, min(0.05, d / 400px)));
            accept
        }
    }

    function set(p: float) {
        let c = clamp(p, 0, 1);
        Controls.set-parameter(index, detent && abs(c - 0.5) < 0.03 ? 0.5 : c);
    }
}

// A named level: its name above, then the slider between a quiet and a
// loud speaker.
component LevelRow inherits VerticalLayout {
    in property <string> name;
    in property <string> group: "[Master]";
    in property <string> key;
    in property <color> tint: Theme.accent;
    spacing: 4px;
    Text { text: name; color: Theme.text; font-size: 12px; font-weight: 600; }
    HorizontalLayout {
        spacing: 8px;
        VerticalLayout { alignment: center; SpeakerIcon { } }
        LevelSlider { group: group; key: key; tint: tint; }
        VerticalLayout { alignment: center; SpeakerIcon { loud: true; } }
    }
}

// The panel's rounded, shadowed background.
component PanelBackground inherits Rectangle {
    background: Theme.panel-raised;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.border;
    drop-shadow-blur: 16px;
    drop-shadow-color: #000000b0;
}

// A small link-like button along the bottom of a panel.
component PanelLink inherits Text {
    callback clicked();
    color: ta.has-hover ? Theme.text : Theme.text-dim;
    font-size: 11px;
    horizontal-alignment: right;
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// An on/off switch for a toggle control, in a panel row.
component PanelSwitch inherits VerticalLayout {
    in property <int> index;
    in property <bool> on;
    alignment: center;
    Rectangle {
        width: 34px;
        height: 20px;
        border-radius: 10px;
        background: on ? Theme.accent : #48484c;
        Rectangle {
            x: on ? parent.width - self.width - 2px : 2px;
            width: 16px;
            height: 16px;
            border-radius: 8px;
            background: #ffffff;
            animate x { duration: 120ms; }
        }
        TouchArea { mouse-cursor: pointer; clicked => { Controls.toggle(index); } }
    }
}

// Ableton Link, in the MASTER panel: a switch, and while on the session's
// tempo, the deck it follows and how many other apps are in it.
component LinkRow inherits HorizontalLayout {
    property <int> enabled-index: Controls.resolve("[Link]", "enabled");
    property <bool> on: Controls.value(enabled-index, Controls.tick) > 0;
    property <int> peers: Controls.value(Controls.resolve("[Link]", "num_peers"), Controls.tick);
    property <float> bpm: Controls.value(Controls.resolve("[Link]", "bpm"), Controls.tick);
    property <int> master: Controls.value(Controls.resolve("[Link]", "master_deck"), Controls.tick);
    spacing: 8px;
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        spacing: 2px;
        Text { text: "Ableton Link"; color: Theme.text; font-size: 12px; font-weight: 600; }
        Text {
            text: !on ? "Off" : (bpm > 0 ? (round(bpm * 10) / 10) + " BPM  ·  " : "")
                + (master == 1 ? "Deck A  ·  " : master == 2 ? "Deck B  ·  " : "")
                + (peers == 1 ? "1 peer" : peers + " peers");
            color: on ? Theme.accent : Theme.text-dim;
            font-size: 11px;
            overflow: elide;
        }
    }
    PanelSwitch { index: enabled-index; on: on; }
}

// MIDI clock out, in the MASTER panel under Link: a switch, Restart on
// bar, and while on the tempo it sends and how many outputs are open. The
// outputs are picked in Settings › Controllers.
component ClockRow inherits HorizontalLayout {
    property <int> enabled-index: Controls.resolve("[MidiClock]", "enabled");
    property <int> restart-index: Controls.resolve("[MidiClock]", "restart");
    property <bool> on: Controls.value(enabled-index, Controls.tick) > 0;
    property <bool> running: Controls.value(Controls.resolve("[MidiClock]", "running"), Controls.tick) > 0;
    property <float> bpm: Controls.value(Controls.resolve("[MidiClock]", "bpm"), Controls.tick);
    property <int> outputs: Controls.value(Controls.resolve("[MidiClock]", "outputs"), Controls.tick);
    spacing: 8px;
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        spacing: 2px;
        Text { text: "MIDI Clock"; color: Theme.text; font-size: 12px; font-weight: 600; }
        Text {
            text: !on ? "Off" : outputs == 0 ? "No outputs: see Settings › Controllers"
                : (bpm > 0 ? (round(bpm * 10) / 10) + " BPM" + (running ? "" : ", stopped") : "Starts with a deck")
                + "  ·  " + (outputs == 1 ? "1 output" : outputs + " outputs");
            color: on ? Theme.accent : Theme.text-dim;
            font-size: 11px;
            overflow: elide;
        }
    }
    // Start again on the master deck's next downbeat, for gear that lost
    // the bar.
    if on: VerticalLayout {
        alignment: center;
        Rectangle {
            height: 20px;
            width: restart-text.preferred-width + 14px;
            border-radius: 10px;
            border-width: 1px;
            border-color: restart-ta.has-hover ? Theme.text-dim : Theme.border;
            background: restart-ta.pressed ? Theme.control-pressed : transparent;
            restart-text := Text {
                text: "RESTART ON BAR";
                color: Theme.text;
                font-size: 9px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            restart-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { Controls.set-value(restart-index, 1); }
            }
        }
    }
    PanelSwitch { index: enabled-index; on: on; }
}

// Loudness readings: text and colors for the [Master],loudness_* controls,
// which read -100 while there is nothing to measure.
export global Loudness {
    // "−15.8", or "—" with no reading.
    public pure function text(v: float) -> string {
        if (v <= -99) {
            return "—";
        }
        let tenths = round(abs(v) * 10);
        return (v <= -0.05 ? "−" : v >= 0.05 ? "+" : "") + floor(tenths / 10) + "." + mod(tenths, 10);
    }
    // Green within 1 LU of the target, amber within 3, red further off.
    public pure function tint(v: float, target: float) -> color {
        if (v <= -99) {
            return Theme.text-dim;
        }
        return abs(v - target) <= 1 ? #30d158 : abs(v - target) <= 3 ? #ffd60a : #ff453a;
    }
    // What the target is for, as chosen in Settings › Audio.
    public pure function target-name(target: float) -> string {
        return target == -16 ? "Internet radio" : target == -18 ? "Podcast or talk"
            : target == -14 ? "Livestream" : target == -23 ? "Broadcast (EBU R128)" : "Target";
    }
}

// dB marks under the master meter: where -40, -20, -10, -6, -3 and 0 dBFS
// sit on its scale (-40 dB at the left, 0 dB at the right).
component MeterScale inherits Rectangle {
    height: 12px;
    for mark in [
        { db: -40, label: "-40" }, { db: -20, label: "-20" }, { db: -10, label: "-10" },
        { db: -6, label: "-6" }, { db: -3, label: "-3" }, { db: 0, label: "0" },
    ]: Text {
        property <float> at: (mark.db + 40) / 40;
        x: clamp(root.width * at - self.width / 2, 0px, root.width - self.width);
        text: mark.label;
        color: Theme.text-dim;
        font-size: 9px;
    }
}

// One small reading in the loudness section: a name over a value.
component LoudnessReading inherits VerticalLayout {
    in property <string> name;
    in property <string> value;
    in property <color> tint: Theme.text;
    horizontal-stretch: 1;
    spacing: 1px;
    Caption { text: name; }
    Text { text: value; color: tint; font-size: 13px; font-weight: 600; }
}

// The master's loudness, as broadcasters measure it (EBU R128): short-term
// (3 s) large and colored against the target, with momentary (400 ms),
// integrated since the reset, the loudness range and the highest true peak.
component LoudnessSection inherits VerticalLayout {
    property <float> momentary: Controls.value(Controls.resolve("[Master]", "loudness_momentary"), Controls.tick);
    property <float> short-term: Controls.value(Controls.resolve("[Master]", "loudness_short_term"), Controls.tick);
    property <float> integrated: Controls.value(Controls.resolve("[Master]", "loudness_integrated"), Controls.tick);
    property <float> range: Controls.value(Controls.resolve("[Master]", "loudness_range"), Controls.tick);
    property <float> true-peak: Controls.value(Controls.resolve("[Master]", "true_peak"), Controls.tick);
    property <float> target: Controls.value(Controls.resolve("[Master]", "loudness_target"), Controls.tick);
    property <int> reset-index: Controls.resolve("[Master]", "loudness_reset");
    spacing: 8px;
    HorizontalLayout {
        Text { text: "Loudness"; color: Theme.text; font-size: 12px; font-weight: 600; horizontal-stretch: 1; }
        PanelLink {
            text: "Reset";
            clicked => {
                Controls.set-value(reset-index, 1);
                Controls.set-value(reset-index, 0);
            }
        }
    }
    HorizontalLayout {
        spacing: 6px;
        alignment: start;
        Text {
            text: Loudness.text(short-term);
            color: Loudness.tint(short-term, target);
            font-size: 26px;
            font-weight: 600;
        }
        VerticalLayout {
            alignment: end;
            padding-bottom: 4px;
            Text { text: "LUFS"; color: Theme.text-dim; font-size: 11px; font-weight: 600; }
        }
        VerticalLayout {
            alignment: end;
            padding-bottom: 4px;
            Text { text: "short-term"; color: Theme.text-dim; font-size: 11px; }
        }
    }
    HorizontalLayout {
        spacing: 8px;
        LoudnessReading { name: "MOMENTARY"; value: Loudness.text(momentary); tint: Loudness.tint(momentary, target); }
        LoudnessReading { name: "INTEGRATED"; value: Loudness.text(integrated); tint: Loudness.tint(integrated, target); }
        LoudnessReading { name: "RANGE"; value: range <= -99 ? "—" : (round(range * 10) / 10) + " LU"; }
        LoudnessReading {
            name: "TRUE PEAK";
            value: true-peak <= -99 ? "—" : Loudness.text(true-peak) + " dB";
            tint: true-peak > -1 ? #ff453a : Theme.text;
        }
    }
    Text {
        text: "Target: " + Loudness.target-name(target) + ", " + Loudness.text(target) + " LUFS";
        color: Theme.text-dim;
        font-size: 11px;
        overflow: elide;
    }
}

// MASTER: the main, headphone and booth (when a booth output is set up)
// levels, the headphones' cue/mix balance, and Ableton Link. Audio
// routing is in the settings.
export component MasterPanel inherits PopupWindow {
    width: 300px;
    close-policy: close-on-click-outside;
    PanelBackground { }
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        Text { text: "Master"; color: Theme.text; font-size: 17px; font-weight: 700; }
        VerticalLayout {
            spacing: 3px;
            VuMeter { group: "[Master]"; key: "VuMeterL"; height: 6px; vertical: false; segments: 32; }
            VuMeter { group: "[Master]"; key: "VuMeterR"; height: 6px; vertical: false; segments: 32; }
            MeterScale { }
        }
        HorizontalLayout {
            spacing: 8px;
            VerticalLayout { alignment: center; SpeakerIcon { } }
            LevelSlider { group: "[Master]"; key: "gain"; }
            VerticalLayout { alignment: center; SpeakerIcon { loud: true; } }
        }
        LevelRow { name: "Phones"; key: "headGain"; }
        if AudioSettings.booth: LevelRow { name: "Booth"; key: "booth_gain"; }
        VerticalLayout {
            spacing: 4px;
            Text { text: "Cue / Mix"; color: Theme.text; font-size: 12px; font-weight: 600; }
            HorizontalLayout {
                spacing: 8px;
                Caption { text: "CUE"; vertical-alignment: center; width: 22px; }
                LevelSlider { group: "[Master]"; key: "headMix"; detent: true; }
                Caption { text: "MIX"; vertical-alignment: center; width: 22px; }
            }
        }
        EdgeLine { line-color: Theme.border; }
        LinkRow { }
        ClockRow { }
        PanelLink {
            text: "Audio Settings…";
            clicked => {
                root.close();
                Preferences.show(0);
            }
        }
    }
}

// One input in the MIC panel: ON and headphone cue beside its name, its
// level slider with the meter over it, then gain and EQ. Dimmed with no
// device chosen for it in the settings.
component InputSection inherits VerticalLayout {
    in property <string> group;
    in property <string> name;
    // talkover for the microphone.
    in property <string> on-key;
    in property <color> tint;
    // Shown while nothing feeds it.
    in property <string> hint: "Choose an input in Audio Settings";
    property <string> eq: "[EqualizerRack1_" + group + "_Effect1]";
    property <bool> configured: Controls.value(Controls.resolve(group, "input_configured"), Controls.tick) > 0;
    spacing: 8px;
    HorizontalLayout {
        spacing: 6px;
        Text { text: name; color: Theme.text; font-size: 15px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
        ControlButton { group: group; key: on-key; text: "ON"; tint: tint; fill-when-lit: true; width: 40px; height: 22px; font-size: 10px; }
        CueHeadphones { group: group; tint: tint; width: 32px; }
    }
    if !configured: Text {
        text: hint;
        color: Theme.text-dim;
        font-size: 11px;
        wrap: word-wrap;
    }
    @children
    VerticalLayout {
        spacing: 8px;
        opacity: configured ? 1 : 0.4;
        VuMeter { group: group; key: "VuMeter"; height: 5px; vertical: false; segments: 32; }
        HorizontalLayout {
            spacing: 8px;
            VerticalLayout { alignment: center; SpeakerIcon { } }
            LevelSlider { group: group; key: "volume"; tint: tint; }
            VerticalLayout { alignment: center; SpeakerIcon { loud: true; } }
        }
        HorizontalLayout {
            alignment: space-around;
            Knob { group: group; key: "pregain"; label: "GAIN"; size: 22px; }
            Knob { group: eq; key: "parameter3"; label: "HIGH"; size: 22px; }
            Knob { group: eq; key: "parameter2"; label: "MID"; size: 22px; }
            Knob { group: eq; key: "parameter1"; label: "LOW"; size: 22px; }
        }
    }
}

// One of the microphone effect unit's slots, as a deck's FX row.
component MicFxSlot inherits HorizontalLayout {
    in property <int> slot;
    property <int> loaded: Controls.value(Controls.resolve("[EffectRack1_EffectUnit" + (EffectList.mic-unit + 1) + "_Effect" + (slot + 1) + "]", "loaded_effect"), Controls.tick);
    FxSlot {
        horizontal-stretch: 1;
        unit: EffectList.mic-unit;
        slot: slot;
        tint: Theme.mic;
        name: loaded > 0 && loaded <= EffectList.names.length ? EffectList.names[loaded - 1] : "";
    }
    // The plugin's own window.
    if loaded > EffectList.builtin-count && loaded <= EffectList.names.length: HorizontalLayout {
        padding-left: 4px;
        ControlButton { group: "[EffectRack1_EffectUnit" + (EffectList.mic-unit + 1) + "_Effect" + (slot + 1) + "]"; key: "show_editor"; text: "EDIT"; tint: Theme.mic; width: 34px; height: 22px; font-size: 9px; outline-when-lit: true; }
    }
}

// MIC: the microphone with its own effect unit (EffectList.mic-unit,
// which the decks' effects never touch), shown as one effect slot. The
// auxiliary and instrument inputs are played from the Instruments source.
export component MicPanel inherits PopupWindow {
    width: 320px;
    close-policy: close-on-click-outside;
    PanelBackground { }
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        InputSection { group: "[Microphone]"; name: "Mic"; on-key: "talkover"; tint: Theme.mic; }
        VerticalLayout {
            spacing: 3px;
            Caption { text: "MIC FX"; horizontal-alignment: left; }
            MicFxSlot { slot: 0; }
        }
        PanelLink {
            text: "Audio Settings…";
            clicked => {
                root.close();
                Preferences.show(0);
            }
        }
    }
}

// A station in the ON AIR panel. `state` is 0 off, 1 connecting, 2 on air,
// 3 failed; `listeners` -1 when the server doesn't say.
export struct BroadcastStation {
    name: string,
    state: int,
    message: string,
    listeners: int,
}

// Broadcasting, as the app shows it; filled in from broadcast.rs.
export global BroadcastState {
    // The stations streamed to, while on air.
    in property <[BroadcastStation]> stations;
    // Everyone listening, or -1 when no server says.
    in property <int> listeners: -1;
    // Why the last ON AIR didn't go on air.
    in property <string> error;
    // At least one station is switched on.
    in property <bool> ready;
    // Broadcasting is switched on in Settings › Broadcast and a station is
    // set up: the top bar shows ON AIR.
    in property <bool> shown;

    // On air: red. Connecting or some stations down: amber.
    public pure function light(state: int) -> color {
        return state == 2 ? #e5484d : state == 1 ? #f5a524 : state == 3 ? #7a7a80 : Theme.text-dim;
    }
}

// The time on air as h:mm:ss or m:ss.
export global AirTime {
    public pure function text(seconds: float) -> string {
        if seconds < 0 { return "0:00"; }
        return (seconds >= 3600 ? floor(seconds / 3600) + ":" : "")
            + (mod(floor(seconds / 60), 60) < 10 && seconds >= 3600 ? "0" : "")
            + mod(floor(seconds / 60), 60) + ":"
            + (mod(floor(seconds), 60) < 10 ? "0" : "") + mod(floor(seconds), 60);
    }
}

component StationRow inherits HorizontalLayout {
    in property <BroadcastStation> station;
    spacing: 8px;
    VerticalLayout {
        alignment: center;
        Rectangle {
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: BroadcastState.light(station.state);
        }
    }
    VerticalLayout {
        horizontal-stretch: 1;
        spacing: 1px;
        Text { text: station.name; color: Theme.text; font-size: 12px; font-weight: 600; overflow: elide; }
        Text {
            text: station.message != "" ? station.message
                : station.state == 2 ? "On air" : station.state == 1 ? "Connecting…" : station.state == 3 ? "Failed" : "Off";
            color: station.state == 3 ? #ff6b6b : Theme.text-dim;
            font-size: 11px;
            wrap: word-wrap;
        }
    }
    if station.listeners >= 0: VerticalLayout {
        alignment: center;
        Text {
            text: station.listeners + (station.listeners == 1 ? " listener" : " listeners");
            color: Theme.text-dim;
            font-size: 11px;
        }
    }
}

// ON AIR: goes on and off air to the stations switched on in Settings ›
// Broadcast, and shows each one's state, the listeners and the loudness.
export component OnAirPanel inherits PopupWindow {
    property <int> enabled-index: Controls.resolve("[Shoutcast]", "enabled");
    property <bool> on: Controls.value(enabled-index, Controls.tick) > 0;
    property <float> seconds: Controls.value(Controls.resolve("[Broadcast]", "on_air_seconds"), Controls.tick);
    width: 320px;
    close-policy: close-on-click-outside;
    PanelBackground { }
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        HorizontalLayout {
            Text { text: "Broadcast"; color: Theme.text; font-size: 17px; font-weight: 700; horizontal-stretch: 1; }
            if on: Text { text: AirTime.text(seconds); color: Theme.text; font-size: 15px; font-weight: 600; vertical-alignment: center; }
        }
        // The big switch.
        Rectangle {
            height: 40px;
            border-radius: 10px;
            background: go.pressed ? Theme.control-pressed : on ? #e5484d.with-alpha(go.has-hover ? 0.3 : 0.2) : !BroadcastState.ready ? Theme.well : go.has-hover ? #e5484d : #d13c41;
            border-width: 1px;
            border-color: on ? #e5484d : transparent;
            Text {
                text: on ? "Go off air" : "Go on air";
                color: !on && !BroadcastState.ready ? Theme.text-dim : Theme.text;
                font-size: 14px;
                font-weight: 700;
            }
            go := TouchArea {
                mouse-cursor: pointer;
                enabled: on || BroadcastState.ready;
                clicked => { Controls.set-value(enabled-index, on ? 0 : 1); }
            }
        }
        if !on && !BroadcastState.ready: Text {
            text: "Add a station in Settings › Broadcast and switch it on to go on air.";
            color: Theme.text-dim;
            font-size: 11px;
            wrap: word-wrap;
        }
        if !on && BroadcastState.error != "" && BroadcastState.ready: Text {
            text: BroadcastState.error;
            color: #ff6b6b;
            font-size: 11px;
            wrap: word-wrap;
        }
        if on: VerticalLayout {
            spacing: 8px;
            for s in BroadcastState.stations: StationRow { station: s; }
        }
        EdgeLine { line-color: Theme.border; }
        LoudnessSection { }
        PanelLink {
            text: "Broadcast Settings…";
            clicked => {
                root.close();
                Preferences.show(8);
            }
        }
    }
}
