// Colors and sizes for the default skin. A skin restyles the app by changing these.
// Two appearances, Dark and Light (`Theme.light`). Dark: near-black panels,
// flat dark controls with thin borders. Light: lilac-grey and white panels
// with the waveforms kept on black. Both: Electric Lilac as the accent, Apple
// system colors elsewhere and a SF-like typeface (Inter, bundled).
import "fonts/InterTabular-Regular.otf";
import "fonts/InterTabular-Medium.otf";
import "fonts/InterTabular-SemiBold.otf";
import "fonts/InterTabular-Bold.otf";
import "fonts/ZenDots-Regular.ttf";

export global Theme {
    // The bundled Inter Tabular, or the system font on macOS (see ui_font.rs).
    in-out property <string> font-family: "Inter Tabular";
    // The openDJ wordmark.
    out property <string> brand-font: "Zen Dots";
    // Light appearance (Settings › Appearance), set from Rust:
    // every colour below has a Light value beside its Dark one. The large
    // waveforms keep dark wells in both (see `wave-well`).
    in-out property <bool> light: false;
    // The Player layout is showing: in Light it takes the calm look of
    // music apps, with no striped rows.
    in-out property <bool> player: false;
    out property <color> background: root.light ? #e4e3ea : #0e0e10;
    out property <color> panel: root.light ? #f7f6fa : #1a1a1c;
    out property <color> panel-raised: root.light ? #ffffff : #232326;
    // The library browser's background, and its rows, which alternate
    // between two tones.
    out property <color> browser: root.light ? #ffffff : #101112;
    // Scrollbar thumbs, and while under the pointer or dragged.
    out property <color> scroll-thumb: root.light ? #00000052 : #ffffff59;
    out property <color> scroll-thumb-active: root.light ? #00000085 : #ffffff8c;
    out property <color> scroll-lane: root.light ? #00000010 : #ffffff12;
    out property <color> row: root.light ? #ffffff : #161819;
    out property <color> row-alt: root.light ? (root.player ? #ffffff : #f2f1f6) : #101112;
    out property <color> control: root.light ? #ffffff : #161618;
    out property <color> control-pressed: root.light ? #e2e0ea : #2c2c2f;
    out property <color> border: root.light ? #c9c7d3 : #353538;
    // Automix: its button while on, and the crossfader while Automix holds it.
    out property <color> automix: root.light ? #24a148 : #30c158;
    out property <color> separator: root.light ? #d8d6e0 : #28282b;
    out property <color> text: root.light ? #16151b : #f2f2f7;
    out property <color> text-dim: root.light ? #5d5b69 : #8e8e93;
    out property <color> label: root.light ? #5d5b69 : #98989d;
    out property <color> knob: root.light ? #ffffff : #1b1b1d;
    out property <color> knob-rim: root.light ? #b5b3c0 : #4a4a4f;
    // The lit part of the ring round mixer knobs.
    out property <color> knob-arc: root.light ? #0060df : #0a84ff;
    out property <color> knob-ring: root.light ? #d5d3de : #3a3a3e;
    out property <color> fader-handle: root.light ? #6e6c7a : #8e8e93;
    out property <color> tick: root.light ? #b5b3c0 : #3e3e42;
    // Electric Lilac, openDJ's own color: the logo, the accent and the
    // library highlight.
    out property <color> lilac: #b69cff;
    out property <color> accent: root.lilac;
    // Lilac used as text or a thin mark: the brand lilac on dark, a deeper
    // lilac on light, where #b69cff on white is too faint to read.
    out property <color> lilac-text: root.light ? #6a4bd4 : root.lilac;
    // The large waveforms' and overviews' background: dark in both
    // appearances, as the waveform colours are made for black.
    out property <color> wave-well: #0d0d0e;
    // Lines between panels: black on dark, a soft grey on light.
    out property <color> edge: root.light ? #c9c7d3 : #000000;
    // The library's key marks: a dimmer lilac for tracks one semitone from
    // mixing with the track playing, grey for two.
    out property <color> lilac-dim: root.light ? #6a4bd499 : #b69cff99;
    out property <color> key-far: root.light ? #7a7885 : #8e8e93;
    // The collection's prep stages, at the lilac's lightness and chroma
    // (OKLCH ~0.77 / 0.12) so they sit beside it: Wanted pink-red, Inbox
    // orange, In Prep yellow, Play Ready green.
    out property <color> stage-wanted: root.light ? #c8364f : #f2909f;
    out property <color> stage-inbox: root.light ? #c25e12 : #f2a26a;
    out property <color> stage-prep: root.light ? #9a7400 : #ead070;
    out property <color> stage-ready: root.light ? #1a7f37 : #83d494;
    // Collection labels in their stage's color too, not only the icons.
    out property <bool> stage-labels: false;
    // A sidebar node kind's stage color (Wanted 4, Inbox 10, In Prep 11,
    // Play Ready 19), or plain text for the rest.
    public pure function stage-tint(kind: int) -> color {
        kind == 4 ? root.stage-wanted
            : kind == 10 ? root.stage-inbox
            : kind == 11 ? root.stage-prep
            : kind == 19 ? root.stage-ready
            : root.text
    }
    // A Collection Health area's state: 0 clear, 1 to look at, 2 won't
    // play, 3 a goal.
    out property <color> health-clear: root.light ? #1a7f37 : #83d494;
    out property <color> health-check: root.light ? #9a7400 : #ead070;
    out property <color> health-problem: root.light ? #d70015 : #ff6961;
    public pure function health-state(state: int) -> color {
        state == 0 ? root.health-clear
            : state == 1 ? root.health-check
            : state == 2 ? root.health-problem
            : root.lilac
    }
    // A track's stage color, as `LibraryEdit.stage-of` numbers them
    // (1 Inbox, 2 In Prep, 3 Play Ready).
    public pure function stage-color(stage: int) -> color {
        stage == 1 ? root.stage-inbox : stage == 2 ? root.stage-prep : root.stage-ready
    }
    // The library highlight: a darker lilac so white text reads on it.
    out property <color> selection: root.light ? #7559cc : #8c72d9;
    // The highlight in whichever list (folders or tracks) doesn't have focus.
    out property <color> selection-idle: root.light ? #7a7885 : #4a4a4d;
    // Text on the lilac highlight: the logo's ink.
    out property <color> on-selection: #151329;
    out property <color> on-selection-dim: #151329b0;
    // Text on a lilac track row in the library browser.
    out property <color> on-row-selection: #ffffff;
    out property <color> on-row-selection-dim: #ffffffb0;
    out property <color> deck1: root.light ? #0060df : #0a84ff;
    out property <color> deck2: root.light ? #d70015 : #ff453a;
    out property <color> deck3: root.light ? #1a7f37 : #30d158;
    out property <color> deck4: root.light ? #b88a00 : #ffd60a;
    // The microphone while it is on: amber, apart from the red of REC.
    out property <color> mic: root.light ? #c05600 : #ff9f0a;
    out property <color> play: root.light ? #16151b : #f2f2f7;
    out property <color> cue: root.light ? #c05600 : #ff9f0a;
    out property <color> sync: root.light ? #5d5b69 : #8e8e93;
    out property <color> loop: root.lilac;
    out property <color> key: root.light ? #6a4bd4 : #8e7cff;
    out property <color> danger: root.light ? #d70015 : #ff453a;
    out property <color> well: root.light ? #eceaf1 : #0d0d0e;
    out property <length> radius: 6px;
    out property <length> font-small: 10px;
    out property <length> font-normal: 13px;
    out property <length> font-large: 17px;
    out property <length> font-xl: 24px;

    // Hotcue colors: blue, green, yellow, orange, red, pink, purple, teal.
    // Same order as the waveform shader.
    out property <[color]> hotcues: [#0064c8, #04bc00, #dcb800, #c45800, #c0002c, #c42874, #7838c4, #10bcbc];

    // Neutral greys, whites and blacks as written across the UI, named by
    // their Dark value: `n-` tones turn a dark surface light and light text
    // dark in Light, keeping alpha (so white hover overlays become black
    // ones); `s-` shades are black shadows and scrims, lighter in Light.
    // Generated from the literals they replaced; tune the Light side here.
    out property <color> n-000000: root.light ? #ffffff : #000000;
    out property <color> n-050506: root.light ? #d2d2fc : #050506;
    out property <color> n-0a0a0b: root.light ? #e3e3fa : #0a0a0b;
    out property <color> n-0b0b0c: root.light ? #e4e4f9 : #0b0b0c;
    out property <color> n-0c0c0e: root.light ? #d5d5f8 : #0c0c0e;
    out property <color> n-0e0e10: root.light ? #d8d8f7 : #0e0e10;
    out property <color> n-101012: root.light ? #dbdbf6 : #101012;
    out property <color> n-101112: root.light ? #dbe8f6 : #101112;
    out property <color> n-111114: root.light ? #d0d0f5 : #111114;
    out property <color> n-121214: root.light ? #dcdcf5 : #121214;
    out property <color> n-141416: root.light ? #dedef4 : #141416;
    out property <color> n-19191c: root.light ? #d7d7f1 : #19191c;
    out property <color> n-1a1a1c: root.light ? #e0e0f1 : #1a1a1c;
    out property <color> n-1c1c1e: root.light ? #e0e0f0 : #1c1c1e;
    out property <color> n-1c1c1f: root.light ? #d8d8f0 : #1c1c1f;
    out property <color> n-1d1d20: root.light ? #d9d9ef : #1d1d20;
    out property <color> n-1e1e21: root.light ? #d9d9ee : #1e1e21;
    out property <color> n-1e1f21: root.light ? #d9e0ee : #1e1f21;
    out property <color> n-1f1f22: root.light ? #d9d9ee : #1f1f22;
    out property <color> n-222225: root.light ? #d9d9ec : #222225;
    out property <color> n-232326: root.light ? #d9d9ec : #232326;
    out property <color> n-262629: root.light ? #d9d9ea : #262629;
    out property <color> n-26262a: root.light ? #d4d4ea : #26262a;
    out property <color> n-2a2a2d: root.light ? #d9d9e8 : #2a2a2d;
    out property <color> n-2a2a2e: root.light ? #d4d4e8 : #2a2a2e;
    out property <color> n-2a2b2e: root.light ? #d4d9e8 : #2a2b2e;
    out property <color> n-2c2c2f: root.light ? #d9d9e8 : #2c2c2f;
    out property <color> n-2c2c30: root.light ? #d4d4e7 : #2c2c30;
    out property <color> n-2d2d33: root.light ? #cacae6 : #2d2d33;
    out property <color> n-2e2e32: root.light ? #d4d4e6 : #2e2e32;
    out property <color> n-2e2e33: root.light ? #cfcfe6 : #2e2e33;
    out property <color> n-303034: root.light ? #d3d3e5 : #303034;
    out property <color> n-333336: root.light ? #d7d7e4 : #333336;
    out property <color> n-333337: root.light ? #d3d3e3 : #333337;
    out property <color> n-36363b: root.light ? #cecee2 : #36363b;
    out property <color> n-38383c: root.light ? #d2d2e1 : #38383c;
    out property <color> n-3a3a3d: root.light ? #d5d5e0 : #3a3a3d;
    out property <color> n-3a3a3e: root.light ? #d2d2e0 : #3a3a3e;
    out property <color> n-3a3a3f: root.light ? #cecee0 : #3a3a3f;
    out property <color> n-3c3c40: root.light ? #d1d1df : #3c3c40;
    out property <color> n-46464b: root.light ? #cbcbda : #46464b;
    out property <color> n-48484a: root.light ? #d4d4da : #48484a;
    out property <color> n-48484c: root.light ? #ceced9 : #48484c;
    out property <color> n-4a4a4d: root.light ? #d0d0d8 : #4a4a4d;
    out property <color> n-4a4a4f: root.light ? #cacad8 : #4a4a4f;
    out property <color> n-505055: root.light ? #c8c8d4 : #505055;
    out property <color> n-55555a: root.light ? #afafb9 : #55555a;
    out property <color> n-58585d: root.light ? #adadb6 : #58585d;
    out property <color> n-5a5a60: root.light ? #a8a8b3 : #5a5a60;
    out property <color> n-5d5d5e: root.light ? #b3b3b5 : #5d5d5e;
    out property <color> n-5f5f64: root.light ? #a7a7af : #5f5f64;
    out property <color> n-5f5f65: root.light ? #a4a4ae : #5f5f65;
    out property <color> n-6a6a70: root.light ? #9b9ba3 : #6a6a70;
    out property <color> n-6a6a72: root.light ? #9696a1 : #6a6a72;
    out property <color> n-6e6e73: root.light ? #9999a0 : #6e6e73;
    out property <color> n-77777d: root.light ? #8f8f96 : #77777d;
    out property <color> n-7a7a80: root.light ? #8c8c93 : #7a7a80;
    out property <color> n-7c7c81: root.light ? #8d8d92 : #7c7c81;
    out property <color> n-8a8a8f: root.light ? #808084 : #8a8a8f;
    out property <color> n-8e8e93: root.light ? #7c7c80 : #8e8e93;
    out property <color> n-98989d: root.light ? #737376 : #98989d;
    out property <color> n-9e9ea3: root.light ? #6d6d70 : #9e9ea3;
    out property <color> n-a0a0a8: root.light ? #66666b : #a0a0a8;
    out property <color> n-a1a1a6: root.light ? #6a6a6d : #a1a1a6;
    out property <color> n-a8a8ad: root.light ? #636366 : #a8a8ad;
    out property <color> n-a9aaab: root.light ? #676868 : #a9aaab;
    out property <color> n-b0b0b5: root.light ? #5c5c5e : #b0b0b5;
    out property <color> n-bbbbbb: root.light ? #585858 : #bbbbbb;
    out property <color> n-c8c8cc: root.light ? #464647 : #c8c8cc;
    out property <color> n-c8c8cd: root.light ? #454546 : #c8c8cd;
    out property <color> n-d0d0d4: root.light ? #3e3e3f : #d0d0d4;
    out property <color> n-d1d1d6: root.light ? #3c3c3d : #d1d1d6;
    out property <color> n-d4d4d8: root.light ? #3a3a3b : #d4d4d8;
    out property <color> n-d8d8dc: root.light ? #363637 : #d8d8dc;
    out property <color> n-dddddd: root.light ? #363636 : #dddddd;
    out property <color> n-e4e4e8: root.light ? #2b2b2b : #e4e4e8;
    out property <color> n-f2f2f4: root.light ? #1f1f1f : #f2f2f4;
    out property <color> n-f2f2f7: root.light ? #1c1c1c : #f2f2f7;
    out property <color> n-ffffff: root.light ? #141414 : #ffffff;
    out property <color> n-ffffff08: root.light ? #14141408 : #ffffff08;
    out property <color> n-ffffff0a: root.light ? #1414140a : #ffffff0a;
    out property <color> n-ffffff0c: root.light ? #1414140c : #ffffff0c;
    out property <color> n-ffffff0d: root.light ? #1414140d : #ffffff0d;
    out property <color> n-ffffff10: root.light ? #14141410 : #ffffff10;
    out property <color> n-ffffff12: root.light ? #14141412 : #ffffff12;
    out property <color> n-ffffff14: root.light ? #14141414 : #ffffff14;
    out property <color> n-ffffff18: root.light ? #14141418 : #ffffff18;
    out property <color> n-ffffff1a: root.light ? #1414141a : #ffffff1a;
    out property <color> n-ffffff1c: root.light ? #1414141c : #ffffff1c;
    out property <color> n-ffffff1e: root.light ? #1414141e : #ffffff1e;
    out property <color> n-ffffff20: root.light ? #14141420 : #ffffff20;
    out property <color> n-ffffff24: root.light ? #14141424 : #ffffff24;
    out property <color> n-ffffff26: root.light ? #14141426 : #ffffff26;
    out property <color> n-ffffff2e: root.light ? #1414142e : #ffffff2e;
    out property <color> n-ffffff30: root.light ? #14141430 : #ffffff30;
    out property <color> n-ffffff40: root.light ? #14141440 : #ffffff40;
    out property <color> n-ffffffa0: root.light ? #141414a0 : #ffffffa0;
    out property <color> n-ffffffc0: root.light ? #141414c0 : #ffffffc0;
    out property <color> n-ffffffd0: root.light ? #141414d0 : #ffffffd0;
    out property <color> n-ffffffd8: root.light ? #141414d8 : #ffffffd8;
    out property <color> n-ffffffe0: root.light ? #141414e0 : #ffffffe0;
    out property <color> s-00000000: root.light ? #00000000 : #00000000;
    out property <color> s-00000026: root.light ? #00000011 : #00000026;
    out property <color> s-0000002a: root.light ? #00000013 : #0000002a;
    out property <color> s-00000040: root.light ? #0000001d : #00000040;
    out property <color> s-00000060: root.light ? #0000002b : #00000060;
    out property <color> s-00000080: root.light ? #0000003a : #00000080;
    out property <color> s-00000090: root.light ? #00000041 : #00000090;
    out property <color> s-000000a0: root.light ? #00000048 : #000000a0;
    out property <color> s-000000a8: root.light ? #0000004c : #000000a8;
    out property <color> s-000000b0: root.light ? #0000004f : #000000b0;
    out property <color> s-000000c0: root.light ? #00000056 : #000000c0;

    // Coloured text and marks as written across the UI (warnings, errors,
    // stars, status), named by their Dark value, deeper in Light to read on white.
    out property <color> c-30d158: root.light ? #1a7f37 : #30d158;
    out property <color> c-4cd07d: root.light ? #1a7f37 : #4cd07d;
    out property <color> c-5e5ce6: root.light ? #4a48c8 : #5e5ce6;
    out property <color> c-64d2ff: root.light ? #0a7ab8 : #64d2ff;
    out property <color> c-bf5af2: root.light ? #9a2fc4 : #bf5af2;
    out property <color> c-cfc4ff: root.light ? #6a4bd4 : #cfc4ff;
    out property <color> c-e0b050: root.light ? #9a6a00 : #e0b050;
    out property <color> c-e5484d: root.light ? #c62828 : #e5484d;
    out property <color> c-ff375f: root.light ? #c8173f : #ff375f;
    out property <color> c-ff453a: root.light ? #d70015 : #ff453a;
    out property <color> c-ff6961: root.light ? #c62828 : #ff6961;
    out property <color> c-ff6b5e: root.light ? #c62828 : #ff6b5e;
    out property <color> c-ff6b6b: root.light ? #c62828 : #ff6b6b;
    out property <color> c-ff9f0a: root.light ? #b35900 : #ff9f0a;
    out property <color> c-ffd60a: root.light ? #a67c00 : #ffd60a;

    public pure function deck-color(deck: int) -> color {
        deck == 0 ? root.deck1 : deck == 1 ? root.deck2 : deck == 2 ? root.deck3 : root.deck4
    }

    // A key's colour by its Camelot number (1 to 12), round the wheel as
    // DJ key charts colour it, so keys that mix sit in neighbouring hues;
    // grey for no key.
    public pure function key-wheel-color(n: int) -> color {
        root.light ? (
            n == 1 ? #0f9e86 : n == 2 ? #1f9a4e : n == 3 ? #4f9a1c : n == 4 ? #7d8f00
            : n == 5 ? #9a7d00 : n == 6 ? #b36200 : n == 7 ? #c8432c : n == 8 ? #c42e63
            : n == 9 ? #a83a9f : n == 10 ? #7a47d6 : n == 11 ? #4560d6 : n == 12 ? #1a86b8
            : root.key-far
        )
        : n == 1 ? #4fe3c6 : n == 2 ? #5fe68e : n == 3 ? #93e85f : n == 4 ? #cde65c
        : n == 5 ? #f1d35e : n == 6 ? #f4a960 : n == 7 ? #f2806c : n == 8 ? #ef6f9a
        : n == 9 ? #dc72d4 : n == 10 ? #ad80f4 : n == 11 ? #7f95f6 : n == 12 ? #5cc3f0
        : root.key-far
    }
}

// How keys are written everywhere: Camelot ("8A") or notes ("Am").
// Clicking a deck's key switches it.
export global KeyNotation {
    in-out property <bool> camelot: true;
}

// Thin black dividers that run edge to edge across their panel: each is
// drawn past its own box by `left` and `right` (or `top` and `bottom`) to
// cover the panel's padding, so no line stops short.
export component EdgeLine inherits Rectangle {
    in property <length> left;
    in property <length> right;
    // Black between grey panels (soft grey in Light); grey inside a black box.
    in property <color> line-color: Theme.edge;
    height: 1px;
    Rectangle { x: -left; width: parent.width + left + right; height: 1px; background: root.line-color; }
}

export component EdgeVLine inherits Rectangle {
    in property <length> top;
    in property <length> bottom;
    in property <color> line-color: Theme.edge;
    width: 1px;
    Rectangle { y: -top; width: 1px; height: parent.height + top + bottom; background: root.line-color; }
}

// Close / clear cross. Drawn, as ✕ is missing from the app's fonts and the
// fallback glyph comes out as stacked lines.
export component CloseIcon inherits Path {
    in property <length> size: 10px;
    in property <color> color: Theme.text-dim;
    width: size;
    height: size;
    viewbox-width: 10;
    viewbox-height: 10;
    commands: "M 1 1 L 9 9 M 9 1 L 1 9";
    stroke: color;
    stroke-width: 1.5px;
    fill: transparent;
}
