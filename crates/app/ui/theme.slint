// Colors and sizes for the default skin. A skin restyles the app by changing these.
// Near-black panels, flat dark controls with thin
// borders, Electric Lilac as the accent, Apple system colors elsewhere and a SF-like typeface (Inter, bundled).
import "fonts/InterTabular-Regular.otf";
import "fonts/InterTabular-Medium.otf";
import "fonts/InterTabular-SemiBold.otf";
import "fonts/InterTabular-Bold.otf";
import "fonts/ZenDots-Regular.ttf";

export global Theme {
    // The bundled Inter Tabular, or the system font on macOS (see ui_font.rs).
    in-out property <string> font-family: "Inter Tabular";
    // The openDJ wordmark.
    out property <string> brand-font: "Zen Dots";
    out property <color> background: #0e0e10;
    out property <color> panel: #1a1a1c;
    out property <color> panel-raised: #232326;
    // The library browser's background, and its rows, which alternate
    // between two tones.
    out property <color> browser: #101112;
    // Scrollbar thumbs, and while under the pointer or dragged.
    out property <color> scroll-thumb: #ffffff59;
    out property <color> scroll-thumb-active: #ffffff8c;
    out property <color> scroll-lane: #ffffff12;
    out property <color> row: #161819;
    out property <color> row-alt: #101112;
    out property <color> control: #161618;
    out property <color> control-pressed: #2c2c2f;
    out property <color> border: #353538;
    // Automix: its button while on, and the crossfader while Automix holds it.
    out property <color> automix: #30c158;
    out property <color> separator: #28282b;
    out property <color> text: #f2f2f7;
    out property <color> text-dim: #8e8e93;
    out property <color> label: #98989d;
    out property <color> knob: #1b1b1d;
    out property <color> knob-rim: #4a4a4f;
    // The lit part of the ring round mixer knobs.
    out property <color> knob-arc: #0a84ff;
    out property <color> knob-ring: #3a3a3e;
    out property <color> fader-handle: #8e8e93;
    out property <color> tick: #3e3e42;
    // Electric Lilac, openDJ's own color: the logo, the accent and the
    // library highlight.
    out property <color> lilac: #b69cff;
    out property <color> accent: root.lilac;
    // The library's key marks: a dimmer lilac for tracks one semitone from
    // mixing with the track playing, grey for two.
    out property <color> lilac-dim: #b69cff99;
    out property <color> key-far: #8e8e93;
    // The collection's prep stages, at the lilac's lightness and chroma
    // (OKLCH ~0.77 / 0.12) so they sit beside it: Wanted pink-red, Inbox
    // orange, In Prep yellow, Play Ready green.
    out property <color> stage-wanted: #f2909f;
    out property <color> stage-inbox: #f2a26a;
    out property <color> stage-prep: #ead070;
    out property <color> stage-ready: #83d494;
    // Collection labels in their stage's color too, not only the icons.
    out property <bool> stage-labels: false;
    // A sidebar node kind's stage color (Wanted 4, Inbox 10, In Prep 11,
    // Play Ready 19), or plain text for the rest.
    public pure function stage-tint(kind: int) -> color {
        kind == 4 ? root.stage-wanted
            : kind == 10 ? root.stage-inbox
            : kind == 11 ? root.stage-prep
            : kind == 19 ? root.stage-ready
            : root.text
    }
    // A Collection Health area's state: 0 clear, 1 to look at, 2 won't
    // play, 3 a goal.
    out property <color> health-clear: #83d494;
    out property <color> health-check: #ead070;
    out property <color> health-problem: #ff6961;
    public pure function health-state(state: int) -> color {
        state == 0 ? root.health-clear
            : state == 1 ? root.health-check
            : state == 2 ? root.health-problem
            : root.lilac
    }
    // A track's stage color, as `LibraryEdit.stage-of` numbers them
    // (1 Inbox, 2 In Prep, 3 Play Ready).
    public pure function stage-color(stage: int) -> color {
        stage == 1 ? root.stage-inbox : stage == 2 ? root.stage-prep : root.stage-ready
    }
    // The library highlight: a darker lilac so white text reads on it.
    out property <color> selection: #8c72d9;
    // The highlight in whichever list (folders or tracks) doesn't have focus.
    out property <color> selection-idle: #4a4a4d;
    // Text on the lilac highlight: the logo's ink.
    out property <color> on-selection: #151329;
    out property <color> on-selection-dim: #151329b0;
    // Text on a lilac track row in the library browser.
    out property <color> on-row-selection: #ffffff;
    out property <color> on-row-selection-dim: #ffffffb0;
    out property <color> deck1: #0a84ff;
    out property <color> deck2: #ff453a;
    out property <color> deck3: #30d158;
    out property <color> deck4: #ffd60a;
    // The microphone while it is on: amber, apart from the red of REC.
    out property <color> mic: #ff9f0a;
    out property <color> play: #f2f2f7;
    out property <color> cue: #ff9f0a;
    out property <color> sync: #8e8e93;
    out property <color> loop: root.lilac;
    out property <color> key: #8e7cff;
    out property <color> danger: #ff453a;
    out property <color> well: #0d0d0e;
    out property <length> radius: 6px;
    out property <length> font-small: 10px;
    out property <length> font-normal: 13px;
    out property <length> font-large: 17px;
    out property <length> font-xl: 24px;

    // Hotcue colors: blue, green, yellow, orange, red, pink, purple, teal.
    // Same order as the waveform shader.
    out property <[color]> hotcues: [#0064c8, #04bc00, #dcb800, #c45800, #c0002c, #c42874, #7838c4, #10bcbc];

    public pure function deck-color(deck: int) -> color {
        deck == 0 ? root.deck1 : deck == 1 ? root.deck2 : deck == 2 ? root.deck3 : root.deck4
    }

    // A key's colour by its Camelot number (1 to 12), round the wheel as
    // DJ key charts colour it, so keys that mix sit in neighbouring hues;
    // grey for no key.
    public pure function key-wheel-color(n: int) -> color {
        n == 1 ? #4fe3c6 : n == 2 ? #5fe68e : n == 3 ? #93e85f : n == 4 ? #cde65c
        : n == 5 ? #f1d35e : n == 6 ? #f4a960 : n == 7 ? #f2806c : n == 8 ? #ef6f9a
        : n == 9 ? #dc72d4 : n == 10 ? #ad80f4 : n == 11 ? #7f95f6 : n == 12 ? #5cc3f0
        : root.key-far
    }
}

// How keys are written everywhere: Camelot ("8A") or notes ("Am").
// Clicking a deck's key switches it.
export global KeyNotation {
    in-out property <bool> camelot: true;
}

// Thin black dividers that run edge to edge across their panel: each is
// drawn past its own box by `left` and `right` (or `top` and `bottom`) to
// cover the panel's padding, so no line stops short.
export component EdgeLine inherits Rectangle {
    in property <length> left;
    in property <length> right;
    // Black between grey panels; grey inside a black box.
    in property <color> line-color: #000000;
    height: 1px;
    Rectangle { x: -left; width: parent.width + left + right; height: 1px; background: root.line-color; }
}

export component EdgeVLine inherits Rectangle {
    in property <length> top;
    in property <length> bottom;
    in property <color> line-color: #000000;
    width: 1px;
    Rectangle { y: -top; width: 1px; height: parent.height + top + bottom; background: root.line-color; }
}

// Close / clear cross. Drawn, as ✕ is missing from the app's fonts and the
// fallback glyph comes out as stacked lines.
export component CloseIcon inherits Path {
    in property <length> size: 10px;
    in property <color> color: Theme.text-dim;
    width: size;
    height: size;
    viewbox-width: 10;
    viewbox-height: 10;
    commands: "M 1 1 L 9 9 M 9 1 L 1 9";
    stroke: color;
    stroke-width: 1.5px;
    fill: transparent;
}
