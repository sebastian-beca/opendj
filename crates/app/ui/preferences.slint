// The settings window: a panel over the whole app, opened from the gear in
// the top bar or with ⌘,. Pages
// are listed down the left with icons, as in Mixxx; the search
// box above them finds an option on any page. Changes apply and are saved at
// once: there is no OK or Apply.
import { Theme, CloseIcon } from "theme.slint";
import { LayoutsPage } from "layouts.slint";
import { ControlKnob } from "controls.slint";
import { AudioSettings, MenuField, OutputsTable, ExternalOutputsTable, InputsTable } from "mixer.slint";

// One row of a settings page. The app builds the rows for the page shown,
// or for a search.
export struct PrefItem {
    // Names the setting when it changes.
    id: string,
    // 0 switch, 1 menu, 2 button, 3 file or folder with a Choose button,
    // 4 the output routes table, 5 headphone and booth level knobs, 6 a
    // note, 7 a heading, 8 segmented buttons, 9 a text field (hidden
    // typing when `on`, for a password), 10 a controller: its outline (Path
    // commands in `value`), its mapping menu, an on/off switch (`on`) and a
    // cog pressing id + "#edit" ("Edit" in `action`) or id + "#quick"
    // ("Map it"), and its Deck menu in `choices2`, 11 a keyboard shortcut: its key in `title` (none
    // for the row that adds one), its openDJscript line in `value`, the
    // verbs to pick from in `choices`, the button's label in `action`; `on`
    // shows `detail` as a mistake, 12 a tick box, 13 the inputs table, 14
    // a + adding a row (pressing id), 15 a row picking a controller to
    // add: a menu of `choices` and ×, pressing id + "#remove", 16 filter
    // chips (`choices`, on by bit in `chosen`; a click picks the chip's
    // index) and a search box (`value`, its hint in `detail`; each change
    // is typed), 17 a source on Settings › Sources: a fold arrow in
    // `action` (none when there's nothing to open; the row presses id +
    // "#fold"), a status dot (`chosen` 0 grey, 1 green, 2 orange), the
    // name, what it's doing in `detail`, and a switch putting it in the rail (`on`), 21
    // a list of folders by name (`choices`, their whole paths in `paths`)
    // with + and − under it and `detail` in an ⓘ beside the title; `on`
    // holds one folder only (+ replaces it), `action` "fixed" can't be changed. It presses
    // id + "#add", id + "#remove:" + index and id + "#reveal:" + path, 22
    // how track colors show: the title, then `choices` as segmented
    // buttons with a small preview of the `chosen` one beside them.
    // (18 is a tag group: ↑ (id + "#up", hidden when `action` is
    // "first"), its name to edit in `value` (typing sends id), Several or
    // One tag per track (`choices`, `chosen`), Tags (id + "#open"; `on`
    // while open) and × (id + "#remove"). 19 is one of its tags: a color
    // menu (`choices`, `chosen`), its name renamed on Return (typed sends
    // id) and × (id + "#remove").)
    kind: int,
    title: string,
    detail: string,
    on: bool,
    choices: [string],
    chosen: int,
    // The path, what a menu shows when it differs from the choice, or a
    // button row's label when it has no button.
    value: string,
    // A button's label.
    action: string,
    // A folder list's whole paths, one for each of `choices`.
    paths: [string],
    // A second menu: a controller's Deck menu (picking presses id + "#deck").
    choices2: [string],
    chosen2: int,
    // While searching: the page the row is on.
    page-name: string,
}

export global Preferences {
    in-out property <bool> open;
    in-out property <int> page;
    in-out property <string> query;
    // The page's tabs (Collection has General, Stages, Tags, Import,
    // Health and Storage); some pages have none.
    in property <[string]> tabs;
    in-out property <int> tab;
    in property <[PrefItem]> items;
    // The page list, filled by the app (PAGE_NAMES in prefs.rs).
    in-out property <[string]> pages;
    // Pages opened from elsewhere, by their number in `pages`.
    in property <int> audio-page;
    in property <int> plugins-page;
    in property <int> broadcast-page;
    // The page or the search changed: the app fills `items` again.
    callback changed();
    callback toggled(id: string, on: bool);
    callback picked(id: string, index: int);
    callback pressed(id: string);
    callback typed(id: string, text: string);
    // A key pressed on a shortcut's key button; true when it was taken
    // (a modifier alone isn't).
    callback key-captured(id: string, text: string, cmd: bool, alt: bool, shift: bool) -> bool;
    // Counts shortcut edits that fill the rows again (a key caught, an
    // action picked, a button), so the window takes focus back from the
    // row that's gone and Esc and ⌘, work again.
    in-out property <int> refocus;

    // Opens page `p` on its tab `t`.
    public function show-tab(p: int, t: int) {
        page = p;
        tab = t;
        query = "";
        open = true;
        changed();
    }

    public function show(p: int) {
        if p != page {
            tab = 0;
        }
        page = p;
        query = "";
        open = true;
        changed();
    }
}

// × taking a row away, as on the outputs table in Audio.
component RemoveCross inherits Rectangle {
    callback clicked();
    width: 20px;
    CloseIcon { size: 9px; color: xta.has-hover ? Theme.text : Theme.text-dim; }
    xta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Setting up an import from another DJ app, in a dialog over Settings. Its
// rows work like a settings page's, through Preferences' callbacks; its
// buttons press "import_wizard_next", "import_wizard_back" and
// "import_wizard_cancel".
export global ImportWizard {
    in property <bool> open;
    in property <string> title;
    // "Step 1 of 3 · Find your VirtualDJ library".
    in property <string> step;
    in property <[PrefItem]> items;
    in property <string> next-label: "Next";
    in property <bool> can-next: true;
    in property <bool> can-back;
}

// The plugins that couldn't be loaded, in a console-like window over
// Settings: each file's path and why, for whoever wants to look into it.
// Its buttons press "audio_plugin_retry_all" and "audio_plugin_errors_close".
export global PluginErrors {
    in-out property <bool> open;
    in property <string> title;
    in property <string> text;
}

// One part of the storage bar: what takes the room, how much, and its
// share of the disk (0 to 1).
export struct StoragePart {
    name: string,
    size: string,
    share: float,
    tint: color,
}

// Settings › Collection › Storage: how the disk with the music is
// used, and the Manage menu's clean-ups. Picking one asks first: `confirm`
// is its question, `warning` what it costs, `confirm-label` its button.
// The menu picks "storage_manage"; the buttons press "storage_confirm" and
// "storage_cancel".
export global StorageUi {
    in property <[StoragePart]> parts;
    // "120 GB free of 500 GB".
    in property <string> summary;
    // What is left: 1 minus the parts' shares.
    in property <float> free-share;
    in property <[string]> actions;
    in property <string> confirm;
    in property <string> warning;
    in property <string> confirm-label;
    // The last clean-up's result.
    in property <string> note;
}

// Line icons on a 24-unit grid.
component PageIcon inherits Path {
    in property <int> kind;
    in property <color> color;
    width: 20px;
    height: 20px;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: transparent;
    stroke: color;
    stroke-width: 1.7px;
    // Audio: a speaker. Controllers: a two-deck controller. Library: a
    // list with a note. Analysis: a waveform. Decks:
    // a platter. Mixer: three faders. Sources: stacked discs, as in the
    // rail. Plugins: a rack unit with a knob. Broadcast: a mast. Keyboard:
    // keys. Layouts: a window split in panes. Help: a speech bubble.
    commands: kind == 0 ? "M 3 9 L 7 9 L 12 5 L 12 19 L 7 15 L 3 15 Z M 15.5 9 Q 17.5 12 15.5 15 M 18 6.5 Q 21.5 12 18 17.5"
        : kind == 1 ? "M 2 7 L 22 7 L 22 17 L 2 17 Z M 4.5 12 A 2.5 2.5 0 1 0 9.5 12 A 2.5 2.5 0 1 0 4.5 12 M 14.5 12 A 2.5 2.5 0 1 0 19.5 12 A 2.5 2.5 0 1 0 14.5 12 M 12 9.5 L 12 14.5"
        : kind == 2 ? "M 3 5 L 15 5 M 3 10 L 15 10 M 3 15 L 10 15 M 18 18 L 18 7 L 22 8.5 M 18 18 A 2 2 0 1 1 17.99 18"
        : kind == 3 ? "M 3 10 L 3 14 M 6 7 L 6 17 M 9 4 L 9 20 M 12 8 L 12 16 M 15 5 L 15 19 M 18 9 L 18 15 M 21 11 L 21 13"
        : kind == 4 ? "M 3 12 A 9 9 0 1 0 21 12 A 9 9 0 1 0 3 12 M 9.5 12 A 2.5 2.5 0 1 0 14.5 12 A 2.5 2.5 0 1 0 9.5 12"
        : kind == 6 ? "M 3 7 A 9 3 0 1 0 21 7 A 9 3 0 1 0 3 7 M 3 7 L 3 12 A 9 3 0 0 0 21 12 L 21 7 M 3 12 L 3 17 A 9 3 0 0 0 21 17 L 21 12"
        : kind == 7 ? "M 3 4 L 21 4 L 21 20 L 3 20 Z M 3 9 L 21 9 M 7.5 13 A 2 2 0 1 0 11.5 13 A 2 2 0 1 0 7.5 13 M 9.5 15 L 9.5 17 M 14 13 L 18 13 M 14 16.5 L 18 16.5 M 6 6.5 L 6.5 6.5 M 9 6.5 L 9.5 6.5"
        : kind == 8 ? "M 10.5 9 A 1.5 1.5 0 1 0 13.5 9 A 1.5 1.5 0 1 0 10.5 9 M 12 10.5 L 12 21 M 8.5 5.5 A 5 5 0 0 0 8.5 12.5 M 15.5 5.5 A 5 5 0 0 1 15.5 12.5 M 5.5 3 A 8.5 8.5 0 0 0 5.5 15 M 18.5 3 A 8.5 8.5 0 0 1 18.5 15"
        : kind == 9 ? "M 2 6 L 22 6 L 22 18 L 2 18 Z M 6 10 L 6.5 10 M 10 10 L 10.5 10 M 14 10 L 14.5 10 M 18 10 L 18.5 10 M 7 14 L 17 14"
        : kind == 10 ? "M 3 4 L 21 4 L 21 20 L 3 20 Z M 3 9 L 21 9 M 12 9 L 12 14 M 3 14 L 21 14"
        : kind == 11 ? "M 4 5 L 20 5 L 20 16 L 11 16 L 6 20 L 6 16 L 4 16 Z M 8 9 L 16 9 M 8 12 L 13 12"
        : "M 6 3 L 6 12 M 6 16 L 6 21 M 12 3 L 12 6 M 12 10 L 12 21 M 18 3 L 18 9 M 18 13 L 18 21 M 4 12 L 8 12 L 8 16 L 4 16 Z M 10 6 L 14 6 L 14 10 L 10 10 Z M 16 9 L 20 9 L 20 13 L 16 13 Z";
}

// A switch.
export component Switch inherits Rectangle {
    in property <bool> on;
    callback toggled(on: bool);
    width: 38px;
    height: 22px;
    border-radius: 11px;
    background: on ? Theme.accent : Theme.n-3a3a3e;
    animate background { duration: 120ms; }
    Rectangle {
        x: on ? parent.width - self.width - 2px : 2px;
        y: 2px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: Theme.n-f2f2f7;
        drop-shadow-blur: 2px;
        drop-shadow-color: Theme.s-00000060;
        animate x { duration: 120ms; easing: ease-out; }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(!on); }
    }
}

export component Button inherits Rectangle {
    in property <string> text;
    // The step a dialog's Next or Import takes, in the accent color.
    in property <bool> primary;
    callback clicked();
    height: 26px;
    min-width: 72px;
    border-radius: Theme.radius;
    background: primary ? (ta.pressed ? Theme.accent.darker(0.3) : Theme.accent)
        : ta.pressed ? Theme.control-pressed : ta.has-hover ? Theme.n-2e2e32 : Theme.panel-raised;
    border-width: 1px;
    border-color: primary ? Theme.accent : Theme.border;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        Text { text: root.text; color: primary ? #000000 : Theme.text; font-size: 12px; font-weight: primary ? 600 : 500; vertical-alignment: center; horizontal-alignment: center; }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A few choices side by side, the chosen one lit.
component Segmented inherits Rectangle {
    in property <[string]> choices;
    in property <int> chosen;
    callback picked(index: int);
    height: 26px;
    border-radius: Theme.radius;
    background: Theme.control;
    border-width: 1px;
    border-color: Theme.border;
    HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        for c[i] in choices: Rectangle {
            border-radius: Theme.radius - 2px;
            background: i == chosen ? Theme.n-3a3a3d : sta.has-hover ? Theme.n-222225 : transparent;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                Text { text: c; color: i == chosen ? Theme.text : Theme.text-dim; font-size: 12px; font-weight: i == chosen ? 600 : 400; vertical-alignment: center; horizontal-alignment: center; }
            }
            sta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.picked(i); }
            }
        }
    }
}

// A line of text the DJ types, such as a user name or a password; each
// change is saved at once.
component TextField inherits Rectangle {
    in property <PrefItem> item;
    width: 260px;
    height: 28px;
    border-radius: Theme.radius;
    background: Theme.well;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.separator;
    input := TextInput {
        x: 8px;
        width: parent.width - 16px;
        text: item.value;
        input-type: item.on ? InputType.password : InputType.text;
        color: Theme.text;
        font-size: 13px;
        vertical-alignment: center;
        single-line: true;
        edited => { Preferences.typed(item.id, self.text); }
    }
}

// A tag's name, renamed on Return (not while typing, as a name the group
// has already merges the two).
component TagNameField inherits Rectangle {
    in property <PrefItem> item;
    width: 180px;
    height: 28px;
    border-radius: Theme.radius;
    background: Theme.well;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.separator;
    input := TextInput {
        x: 8px;
        width: parent.width - 16px;
        text: item.value;
        color: Theme.text;
        font-size: 13px;
        vertical-alignment: center;
        single-line: true;
        accepted => { Preferences.typed(item.id, self.text); }
    }
}

// A shortcut's key: click it, then press the new key (Esc to leave it).
component KeyButton inherits Rectangle {
    in property <string> id;
    in property <string> text;
    property <bool> listening: keys.has-focus;
    width: 130px;
    height: 28px;
    border-radius: Theme.radius;
    background: listening ? #2a2440 : ta.has-hover ? Theme.n-222225 : Theme.well;
    border-width: 1px;
    border-color: listening ? Theme.accent : Theme.separator;
    Text {
        text: listening ? "Press a key…" : root.text == "" ? "Add a key…" : root.text;
        color: listening ? Theme.lilac-text : root.text == "" ? Theme.text-dim : Theme.text;
        font-size: 13px;
        font-weight: root.text == "" ? 400 : 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    keys := FocusScope {
        key-pressed(e) => {
            if e.text == Key.Escape {
                Preferences.refocus += 1;
                return accept;
            }
            if Preferences.key-captured(id, e.text, e.modifiers.control, e.modifiers.alt, e.modifiers.shift) {
                Preferences.refocus += 1;
            }
            accept
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { keys.focus(); }
    }
}

// A shortcut's openDJscript line; each change is saved at once.
component ScriptField inherits Rectangle {
    in property <PrefItem> item;
    horizontal-stretch: 1;
    height: 28px;
    border-radius: Theme.radius;
    background: Theme.well;
    border-width: 1px;
    border-color: item.on ? #ff6b6b : input.has-focus ? Theme.accent : Theme.separator;
    if input.text == "": Text {
        x: 8px;
        text: "Type an action…";
        color: Theme.n-5a5a60;
        font-size: 13px;
        vertical-alignment: center;
        height: parent.height;
    }
    input := TextInput {
        x: 8px;
        width: parent.width - 16px;
        text: item.value;
        color: Theme.text;
        font-size: 13px;
        vertical-alignment: center;
        single-line: true;
        edited => { Preferences.typed(item.id, self.text); }
    }
}

// A chip that narrows a list, lit when on.
component FilterChipButton inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    callback clicked();
    height: 26px;
    width: label.preferred-width + 24px;
    border-radius: 13px;
    background: on ? Theme.accent : cta.has-hover ? Theme.n-2c2c2f : Theme.control;
    border-width: 1px;
    border-color: on ? Theme.accent : Theme.border;
    label := Text {
        text: root.text;
        color: on ? #000000 : Theme.text;
        font-size: 12px;
        font-weight: 600;
        vertical-alignment: center;
    }
    cta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export component SearchField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder: "Search";
    callback edited();
    height: 30px;
    border-radius: 8px;
    background: Theme.well;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.separator;
    Path {
        x: 9px;
        width: 14px;
        height: 14px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M 3 10 A 7 7 0 1 0 17 10 A 7 7 0 1 0 3 10 M 15 15 L 21 21";
        stroke: Theme.text-dim;
        stroke-width: 2.2px;
        fill: transparent;
    }
    Text {
        x: 30px;
        text: root.text == "" ? root.placeholder : "";
        color: Theme.text-dim;
        font-size: 13px;
    }
    input := TextInput {
        x: 30px;
        width: parent.width - 38px;
        text <=> root.text;
        color: Theme.text;
        font-size: 13px;
        vertical-alignment: center;
        single-line: true;
        edited => { root.edited(); }
    }
    public function focus-input() {
        input.focus();
    }
}

// One setting: its name and a line on what it does on the left, the
// control on the right.
// An ⓘ beside a setting's name: a click shows what it means.
component InfoButton inherits Rectangle {
    in property <string> text;
    width: 16px;
    height: 16px;
    border-radius: 8px;
    border-width: 1px;
    border-color: ita.has-hover ? Theme.text : Theme.text-dim;
    Text {
        text: "i";
        color: ita.has-hover ? Theme.text : Theme.text-dim;
        font-size: 11px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ita := TouchArea { mouse-cursor: pointer; clicked => { tip.show(); } }
    tip := PopupWindow {
        x: 0;
        y: root.height + 6px;
        width: 300px;
        Rectangle {
            background: Theme.panel-raised;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 10px;
            drop-shadow-color: Theme.s-00000090;
        }
        VerticalLayout {
            padding: 10px;
            Text { text: root.text; color: Theme.text; font-size: 12px; wrap: word-wrap; }
        }
    }
}

// A folder, filled, as in Finder's lists.
component FolderIcon inherits Path {
    width: 16px;
    height: 14px;
    viewbox-width: 16;
    viewbox-height: 14;
    fill: Theme.accent;
    commands: "M 1 2.5 Q 1 1 2.5 1 L 6 1 L 7.5 2.5 L 13.5 2.5 Q 15 2.5 15 4 L 15 11.5 Q 15 13 13.5 13 L 2.5 13 Q 1 13 1 11.5 Z";
}

// The icon beside a folder list's title: the sidebar's icon for a stage (its
// node kind: Inbox 10, In Prep 11, Play Ready 19) in the stage's color.
component StageIcon inherits Rectangle {
    in property <int> kind;
    width: 16px;
    height: 16px;
    if kind != 10 && kind != 11 && kind != 19: FolderIcon { }
    if kind == 10 || kind == 19: Text {
        text: kind == 10 ? "↓" : "♫";
        color: Theme.stage-tint(kind);
        font-size: 14px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if kind == 11: Rectangle {
        Path {
            width: 16px;
            height: 16px;
            viewbox-width: 18;
            viewbox-height: 18;
            fill: Theme.stage-prep;
            commands: "M 9 3 A 6 6 0 0 0 9 15 Z";
        }
        Path {
            width: 16px;
            height: 16px;
            viewbox-width: 18;
            viewbox-height: 18;
            stroke: Theme.stage-prep;
            stroke-width: 1.5px;
            fill: transparent;
            commands: "M 9 3 A 6 6 0 1 1 8.99 3 Z";
        }
    }
}

// A cog: a controller's mapping settings.
component CogIcon inherits Path {
    in property <color> color: Theme.text-dim;
    width: 16px;
    height: 16px;
    viewbox-width: 16;
    viewbox-height: 16;
    stroke: color;
    stroke-width: 1.4px;
    fill: transparent;
    commands: "M 8 5.5 A 2.5 2.5 0 1 1 7.99 5.5 Z M 8 1.5 L 8 3.5 M 8 12.5 L 8 14.5 M 1.5 8 L 3.5 8 M 12.5 8 L 14.5 8 M 3.4 3.4 L 4.8 4.8 M 11.2 11.2 L 12.6 12.6 M 3.4 12.6 L 4.8 11.2 M 11.2 4.8 L 12.6 3.4 M 8 3.5 A 4.5 4.5 0 1 1 7.99 3.5 Z";
}

// + or − under a folder list.
component ListButton inherits Rectangle {
    in property <bool> minus;
    in property <bool> enabled: true;
    callback clicked();
    width: 26px;
    height: 22px;
    background: lta.pressed && enabled ? Theme.control-pressed : lta.has-hover && enabled ? Theme.n-2a2a2e : Theme.control;
    border-width: 1px;
    border-color: Theme.border;
    Path {
        width: 10px;
        height: 10px;
        viewbox-width: 10;
        viewbox-height: 10;
        stroke: enabled ? Theme.text : Theme.n-55555a;
        stroke-width: 1.4px;
        commands: minus ? "M 0 5 L 10 5" : "M 0 5 L 10 5 M 5 0 L 5 10";
    }
    lta := TouchArea { mouse-cursor: enabled ? pointer : default; clicked => { if enabled { root.clicked(); } } }
}

// Folders shown by name in a box, picked with + (the system's folder
// picker) and taken off with − (the selected one). A folder's whole path
// shows under the box while it is pointed at or selected; its arrow shows
// it in Finder or the file manager.
component FolderList inherits VerticalLayout {
    in property <PrefItem> item;
    in property <bool> bright;
    property <int> selected: -1;
    property <int> hovered: -1;
    property <bool> fixed: item.action == "fixed";
    property <int> shown: hovered >= 0 && hovered < item.paths.length ? hovered
        : selected >= 0 && selected < item.paths.length ? selected : -1;
    spacing: 6px;
    HorizontalLayout {
        alignment: start;
        spacing: 6px;
        // A stage's sidebar icon beside its name.
        if item.chosen != 0: VerticalLayout { alignment: center; StageIcon { kind: item.chosen; } }
        Text { text: item.title; color: Theme.text; font-size: bright ? 15px : 14px; font-weight: 500; vertical-alignment: center; }
        if item.detail != "": VerticalLayout {
            alignment: center;
            InfoButton { text: item.detail; }
        }
    }
    Rectangle {
        // One line for a single folder, room for a few otherwise.
        height: item.on ? 32px : max(3, item.choices.length) * 26px + 6px;
        border-radius: Theme.radius;
        background: Theme.well;
        border-width: 1px;
        border-color: Theme.separator;
        clip: true;
        if item.choices.length == 0: Text {
            x: 10px;
            height: 30px;
            y: 1px;
            text: item.on ? "No folder chosen" : "No folders yet";
            color: Theme.text-dim;
            font-size: 12px;
            vertical-alignment: center;
        }
        VerticalLayout {
            padding: 3px;
            alignment: start;
            for name[i] in item.choices: Rectangle {
                property <bool> hover: rta.has-hover;
                changed hover => {
                    if hover {
                        root.hovered = i;
                    } else if root.hovered == i {
                        root.hovered = -1;
                    }
                }
                height: 26px;
                border-radius: 4px;
                background: i == root.selected ? Theme.selection-idle : rta.has-hover ? Theme.n-232326 : transparent;
                rta := TouchArea {
                    clicked => { root.selected = i; }
                    double-clicked => { Preferences.pressed(item.id + "#reveal:" + item.paths[i]); }
                }
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 6px;
                    spacing: 8px;
                    VerticalLayout { alignment: center; FolderIcon { } }
                    Text { text: name; color: Theme.text; font-size: 13px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                    // Show in Finder, as djay's arrow does.
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 16px;
                            height: 16px;
                            Path {
                                width: 16px;
                                height: 16px;
                                viewbox-width: 16;
                                viewbox-height: 16;
                                stroke: ata.has-hover ? Theme.text : Theme.text-dim;
                                stroke-width: 1.2px;
                                fill: transparent;
                                commands: "M 8 1.5 A 6.5 6.5 0 1 1 7.99 1.5 Z M 4.5 8 L 11 8 M 8.5 5.5 L 11 8 L 8.5 10.5";
                            }
                            ata := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { Preferences.pressed(item.id + "#reveal:" + item.paths[i]); }
                            }
                        }
                    }
                }
            }
        }
    }
    HorizontalLayout {
        spacing: 10px;
        HorizontalLayout {
            spacing: -1px;
            ListButton {
                // On a single folder, + picks another in its place.
                enabled: !fixed;
                clicked => { Preferences.pressed(item.id + "#add"); }
            }
            ListButton {
                minus: true;
                enabled: !fixed && root.selected >= 0 && root.selected < item.choices.length;
                clicked => {
                    Preferences.pressed(item.id + "#remove:" + root.selected);
                    root.selected = -1;
                }
            }
        }
        Text {
            text: shown >= 0 ? item.paths[shown] : "";
            color: Theme.text-dim;
            font-size: 11px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
}

component StorageButton inherits Rectangle {
    in property <string> text;
    in property <bool> warn;
    callback clicked();
    width: max(64px, label.preferred-width + 20px);
    height: 24px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: warn ? #ff9f0a : Theme.border;
    background: ta.pressed ? Theme.control-pressed : ta.has-hover ? Theme.n-2a2a2e : Theme.control;
    label := Text { text: root.text; color: warn ? Theme.c-ff9f0a : Theme.text; font-size: 12px; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// The storage bar, as macOS draws it: a part for each kind of file, in
// the disk's free room, with a legend under it.
component StorageView inherits VerticalLayout {
    in property <PrefItem> item;
    in property <bool> searching;
    spacing: 8px;
    if searching: Text { text: item.page-name; color: Theme.lilac-text; font-size: 10px; font-weight: 600; letter-spacing: 0.4px; }
    HorizontalLayout {
        spacing: 10px;
        Text { text: item.title; color: Theme.text; font-size: 14px; font-weight: 500; vertical-alignment: center; }
        Text { text: StorageUi.summary; color: Theme.text-dim; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
        manage := Rectangle {
            width: 86px;
            height: 24px;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.border;
            background: mta.has-hover ? Theme.n-2a2a2e : Theme.control;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 8px;
                spacing: 6px;
                Text { text: "Manage"; color: Theme.text; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
                Path {
                    width: 8px;
                    height: 5px;
                    y: (parent.height - self.height) / 2;
                    commands: "M 0 0 L 4 4.5 L 8 0";
                    stroke: Theme.text-dim;
                    stroke-width: 1.5px;
                    fill: transparent;
                }
            }
            mta := TouchArea { mouse-cursor: pointer; clicked => { menu.show(); } }
            menu := PopupWindow {
                x: parent.width - 240px;
                y: parent.height + 2px;
                width: 240px;
                height: StorageUi.actions.length * 26px + 12px;
                close-policy: close-on-click-outside;
                Rectangle {
                    background: Theme.panel-raised;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: Theme.border;
                    drop-shadow-blur: 12px;
                    drop-shadow-color: Theme.s-000000a0;
                }
                VerticalLayout {
                    padding: 6px;
                    for a[i] in StorageUi.actions: Rectangle {
                        height: 26px;
                        border-radius: 4px;
                        background: ata.has-hover ? Theme.n-3a3a3d : transparent;
                        Text { x: 8px; text: a; color: Theme.text; font-size: 12px; vertical-alignment: center; height: parent.height; }
                        ata := TouchArea { mouse-cursor: pointer; clicked => { Preferences.picked(item.id, i); menu.close(); } }
                    }
                }
            }
        }
    }
    Rectangle {
        height: 18px;
        border-radius: 5px;
        clip: true;
        background: Theme.control;
        border-width: 1px;
        border-color: Theme.border;
        // Each part's width is its share of the room, by stretch, so the
        // bar never measures itself.
        HorizontalLayout {
            padding: 1px;
            for p in StorageUi.parts: Rectangle {
                horizontal-stretch: p.share;
                min-width: p.share > 0 ? 2px : 0px;
                background: p.tint;
            }
            Rectangle { horizontal-stretch: StorageUi.free-share; }
        }
    }
    HorizontalLayout {
        spacing: 16px;
        alignment: start;
        for p in StorageUi.parts: HorizontalLayout {
            spacing: 5px;
            Rectangle {
                width: 8px;
                height: 8px;
                y: (parent.height - self.height) / 2;
                border-radius: 4px;
                background: p.tint;
            }
            Text { text: p.name; color: Theme.text; font-size: 11px; vertical-alignment: center; }
            Text { text: p.size; color: Theme.text-dim; font-size: 11px; vertical-alignment: center; }
        }
    }
    if StorageUi.note != "" && StorageUi.confirm == "": Text { text: StorageUi.note; color: Theme.text-dim; font-size: 12px; }
    // The clean-up picked, waiting for a yes.
    if StorageUi.confirm != "": Rectangle {
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: #ff9f0a80;
        background: #ff9f0a14;
        HorizontalLayout {
            padding: 10px;
            spacing: 10px;
            VerticalLayout {
                spacing: 2px;
                horizontal-stretch: 1;
                Text { text: StorageUi.confirm; color: Theme.text; font-size: 13px; font-weight: 500; }
                Text { text: StorageUi.warning; color: Theme.text-dim; font-size: 12px; wrap: word-wrap; }
            }
            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    spacing: 6px;
                    StorageButton { text: "Cancel"; clicked => { Preferences.pressed("storage_cancel"); } }
                    StorageButton { text: StorageUi.confirm-label; warn: true; clicked => { Preferences.pressed("storage_confirm"); } }
                }
            }
        }
    }
}

// Two made-up track rows showing how track colors look in the list: 0 a
// dot in the Color column, 1 a strip at the row's edge, 2 the row tinted,
// 3 off.
component TrackColorPreview inherits Rectangle {
    in property <int> mode;
    property <[{title: string, artist: string, tint: color}]> rows: [
        { title: "Sunrise", artist: "Artist", tint: #ff9f0a },
        { title: "Night Drive", artist: "Artist", tint: #b69cff },
    ];
    width: 240px;
    height: 52px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.separator;
    clip: true;
    VerticalLayout {
        padding: 1px;
        for r[i] in rows: Rectangle {
            height: 25px;
            background: mode == 2 ? (mod(i, 2) == 1 ? Theme.row-alt : Theme.row).mix(r.tint, 0.86)
                : mod(i, 2) == 1 ? Theme.row-alt : Theme.row;
            if mode == 1: Rectangle {
                x: 0px;
                width: 3px;
                height: parent.height - 8px;
                border-radius: 1.5px;
                background: r.tint;
            }
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 10px;
                Rectangle {
                    width: 10px;
                    if mode == 0: Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: r.tint;
                    }
                }
                Text { text: r.title; color: Theme.text; font-size: 11px; vertical-alignment: center; width: 90px; overflow: elide; }
                Text { text: r.artist; color: Theme.text-dim; font-size: 11px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
            }
        }
    }
}

export component PrefRow inherits Rectangle {
    in property <PrefItem> item;
    in property <bool> searching;
    // Larger, lighter words, for the tour's setup dialog.
    in property <bool> bright;
    min-height: item.kind == 7 ? 34px : item.kind == 12 ? 30px : item.kind == 16 || item.kind == 17 ? 44px : 52px;
    // A source with settings opens and closes with a click on its row;
    // its switch, drawn over this, still works.
    if item.kind == 17 && item.action != "": TouchArea {
        mouse-cursor: pointer;
        clicked => { Preferences.pressed(item.id + "#fold"); }
    }
    if item.kind == 7 && item.action != "": TouchArea {
        mouse-cursor: pointer;
        clicked => { Preferences.pressed(item.id); }
    }
    VerticalLayout {
        padding-top: item.kind == 7 ? 14px : item.kind == 12 ? 4px : 10px;
        padding-bottom: item.kind == 7 ? 4px : item.kind == 12 ? 4px : 10px;
        spacing: 8px;
        // A heading; one with `action` "open" or "closed" folds what's
        // under it, pressing id.
        if item.kind == 7: HorizontalLayout {
            spacing: 6px;
            if item.action != "": Path {
                width: 10px;
                height: 10px;
                y: 2px;
                viewbox-width: 10;
                viewbox-height: 10;
                stroke: Theme.text-dim;
                stroke-width: 1.4px;
                fill: transparent;
                commands: item.action == "open" ? "M 1.5 3.5 L 5 7 L 8.5 3.5" : "M 3.5 1.5 L 7 5 L 3.5 8.5";
            }
            Text {
                text: item.title;
                color: Theme.text-dim;
                font-size: 11px;
                font-weight: 600;
                letter-spacing: 0.6px;
                horizontal-stretch: 1;
            }
        }
        if item.kind == 11: HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                alignment: start;
                KeyButton { id: item.id; text: item.title; }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 4px;
                if item.title != "": ScriptField { item: item; }
                Text {
                    text: item.detail;
                    color: item.on ? Theme.c-ff6b6b : Theme.text-dim;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }
            if item.title != "": VerticalLayout {
                alignment: start;
                MenuField {
                    width: 96px;
                    text: "Actions";
                    choices: item.choices;
                    chosen: -1;
                    menu-width: 200px;
                    picked(i) => {
                        Preferences.picked(item.id, i);
                        Preferences.refocus += 1;
                    }
                }
            }
            if item.action != "": VerticalLayout {
                alignment: start;
                Button {
                    text: item.action;
                    clicked => {
                        Preferences.pressed(item.id);
                        Preferences.refocus += 1;
                    }
                }
            }
        }
        // A tick box in a tree: the arrow opens a folder, the box ticks it
        // and everything in it.
        if item.kind == 12: HorizontalLayout {
            spacing: 6px;
            Rectangle { width: item.chosen * 18px; }
            Rectangle {
                width: 16px;
                if item.action != "": Text {
                    text: item.action;
                    color: Theme.text-dim;
                    font-size: 11px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                if item.action != "": TouchArea {
                    mouse-cursor: pointer;
                    clicked => { Preferences.pressed(item.id + "#fold"); }
                }
            }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 16px;
                    height: 16px;
                    border-radius: 4px;
                    border-width: 1.5px;
                    border-color: item.on || item.value == "some" ? Theme.accent : Theme.text-dim;
                    background: item.on || item.value == "some" ? Theme.accent : transparent;
                    Text {
                        text: item.on ? "✓" : item.value == "some" ? "–" : "";
                        color: #000000;
                        font-size: 11px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { Preferences.toggled(item.id, !item.on); }
                    }
                }
            }
            Text {
                text: item.title;
                color: Theme.text;
                font-size: 13px;
                font-weight: item.chosen <= 1 ? 600 : 400;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
                TouchArea {
                    clicked => {
                        if item.action != "" {
                            Preferences.pressed(item.id + "#fold");
                        } else {
                            Preferences.toggled(item.id, !item.on);
                        }
                    }
                }
            }
            Text {
                text: item.detail;
                color: Theme.text-dim;
                font-size: 12px;
                vertical-alignment: center;
            }
        }
        if item.kind == 16: HorizontalLayout {
            spacing: 6px;
            for label[i] in item.choices: FilterChipButton {
                text: label;
                on: Math.mod(Math.floor(item.chosen / Math.pow(2, i)), 2) == 1;
                clicked => { Preferences.picked(item.id, i); }
            }
            Rectangle { horizontal-stretch: 1; }
            SearchField {
                width: 240px;
                text: item.value;
                placeholder: item.detail;
                edited => { Preferences.typed(item.id, self.text); }
            }
        }
        if item.kind == 17: HorizontalLayout {
            spacing: 10px;
            Rectangle {
                width: 12px;
                Text {
                    text: item.action;
                    color: Theme.text-dim;
                    font-size: 11px;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: item.chosen == 1 ? #30c158 : item.chosen == 2 ? #ff9f0a : Theme.n-4a4a4f;
                }
            }
            Text {
                text: item.title;
                width: 150px;
                color: Theme.text;
                font-size: 14px;
                font-weight: 500;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                text: item.detail;
                color: Theme.text-dim;
                font-size: 12px;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            VerticalLayout {
                alignment: center;
                Switch { on: item.on; toggled(on) => { Preferences.toggled(item.id, on); } }
            }
        }
        if item.kind == 21: FolderList { item: item; bright: bright; }
        // Settings › Appearance › Layouts (layouts.slint).
        if item.kind == 24: LayoutsPage {}
        if item.kind == 23: StorageView { item: item; searching: searching; }
        if item.kind == 22: VerticalLayout {
            spacing: 8px;
            if searching: Text { text: item.page-name; color: Theme.lilac-text; font-size: 10px; font-weight: 600; letter-spacing: 0.4px; }
            Text { text: item.title; color: Theme.text; font-size: 14px; font-weight: 500; }
            HorizontalLayout {
                alignment: start;
                spacing: 16px;
                VerticalLayout {
                    alignment: center;
                    Segmented { choices: item.choices; chosen: item.chosen; picked(i) => { Preferences.picked(item.id, i); } }
                }
                TrackColorPreview { mode: item.chosen; }
            }
        }
        if item.kind != 7 && item.kind != 11 && item.kind != 12 && item.kind != 16 && item.kind != 17 && item.kind != 21 && item.kind != 22 && item.kind != 23 && item.kind != 24: HorizontalLayout {
            spacing: 16px;
            // A controller's outline, drawn from its picture when openDJ
            // has one.
            if item.kind == 10: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 56px;
                    height: 34px;
                    Path {
                        width: 56px;
                        height: 34px;
                        viewbox-width: 100;
                        viewbox-height: 60;
                        stroke: Theme.text-dim;
                        stroke-width: 1px;
                        fill: transparent;
                        commands: item.value;
                    }
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 3px;
                if searching: Text { text: item.page-name; color: Theme.lilac-text; font-size: 10px; font-weight: 600; letter-spacing: 0.4px; }
                if item.title != "": Text { text: item.title; color: Theme.text; font-size: 14px; font-weight: 500; overflow: elide; }
                // Add-on pages (notes and text fields) wrap: their help is longer.
                if item.detail != "" && item.kind != 6 && item.kind != 9: Text { text: item.detail; color: bright ? Theme.n-c8c8cd : Theme.text-dim; font-size: bright ? 13px : 12px; overflow: elide; }
                if item.detail != "" && (item.kind == 6 || item.kind == 9): Text { text: item.detail; color: bright ? Theme.n-c8c8cd : Theme.text-dim; font-size: bright ? 13px : 12px; wrap: word-wrap; }
            }
            if item.kind == 0: VerticalLayout {
                alignment: center;
                Switch { on: item.on; toggled(on) => { Preferences.toggled(item.id, on); } }
            }
            if item.kind == 1: VerticalLayout {
                alignment: center;
                MenuField {
                    width: 260px;
                    text: item.value != "" ? item.value : item.choices[item.chosen];
                    choices: item.choices;
                    chosen: item.chosen;
                    menu-width: 300px;
                    picked(i) => { Preferences.picked(item.id, i); }
                }
            }
            if item.kind == 2 && item.action != "": VerticalLayout {
                alignment: center;
                Button { text: item.action; clicked => { Preferences.pressed(item.id); } }
            }
            // A button row with no button: what's in `value` (such as
            // "Coming soon"), dimmed.
            if item.kind == 2 && item.action == "" && item.value != "": VerticalLayout {
                alignment: center;
                Rectangle {
                    height: 22px;
                    width: soon.preferred-width + 16px;
                    border-radius: 11px;
                    border-width: 1px;
                    border-color: Theme.separator;
                    soon := Text { x: 8px; text: item.value; color: Theme.text-dim; font-size: 11px; vertical-alignment: center; }
                }
            }
            // A controller: its mapping menu (dimmed while off), its
            // on/off switch and a cog opening its mapping in the Controller
            // Editor (or the mapping wizard when it has none).
            if item.kind == 10: HorizontalLayout {
                spacing: 12px;
                // Which deck it plays: Follow, as mapped or a deck.
                if item.choices2.length > 0: VerticalLayout {
                    alignment: center;
                    MenuField {
                        width: 128px;
                        opacity: item.on ? 1 : 0.4;
                        text: item.choices2[item.chosen2];
                        choices: item.choices2;
                        chosen: item.chosen2;
                        menu-width: 190px;
                        picked(i) => { Preferences.picked(item.id + "#deck", i); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    MenuField {
                        width: 240px;
                        opacity: item.on ? 1 : 0.4;
                        text: item.choices[item.chosen];
                        choices: item.choices;
                        chosen: item.chosen;
                        menu-width: 300px;
                        picked(i) => { Preferences.picked(item.id, i); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Switch { on: item.on; toggled(on) => { Preferences.toggled(item.id, on); } }
                }
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 26px;
                        height: 26px;
                        border-radius: Theme.radius;
                        background: cta.has-hover && item.action != "" ? Theme.n-2a2a2e : transparent;
                        opacity: item.action != "" ? 1 : 0.3;
                        CogIcon { color: cta.has-hover ? Theme.text : Theme.text-dim; }
                        cta := TouchArea {
                            mouse-cursor: item.action != "" ? pointer : default;
                            clicked => {
                                if item.action == "Map it" {
                                    Preferences.pressed(item.id + "#quick");
                                } else if item.action != "" {
                                    Preferences.pressed(item.id + "#edit");
                                }
                            }
                        }
                    }
                }
            }
            if item.kind == 18: HorizontalLayout {
                spacing: 8px;
                // Up, unless it's the first group (`action` "first").
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 22px;
                        height: 22px;
                        border-radius: Theme.radius;
                        opacity: item.action == "first" ? 0.3 : 1;
                        background: up-ta.has-hover && item.action != "first" ? Theme.n-2a2a2e : transparent;
                        Text { text: "↑"; color: Theme.text-dim; font-size: 13px; }
                        up-ta := TouchArea {
                            enabled: item.action != "first";
                            mouse-cursor: self.enabled ? pointer : default;
                            clicked => { Preferences.pressed(item.id + "#up"); }
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    TextField { item: item; width: 160px; }
                }
                VerticalLayout {
                    alignment: center;
                    Segmented { choices: item.choices; chosen: item.chosen; picked(i) => { Preferences.picked(item.id, i); } }
                }
                // Its tags, opened below the row (`on` when open).
                VerticalLayout {
                    alignment: center;
                    Button { text: item.on ? "Hide tags" : "Tags"; width: 84px; clicked => { Preferences.pressed(item.id + "#open"); } }
                }
                RemoveCross { clicked => { Preferences.pressed(item.id + "#remove"); } }
            }
            if item.kind == 19: HorizontalLayout {
                spacing: 8px;
                VerticalLayout {
                    alignment: center;
                    MenuField {
                        width: 110px;
                        text: item.choices[item.chosen];
                        choices: item.choices;
                        chosen: item.chosen;
                        menu-width: 140px;
                        picked(i) => { Preferences.picked(item.id, i); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    TagNameField { item: item; }
                }
                RemoveCross { clicked => { Preferences.pressed(item.id + "#remove"); } }
            }
            if item.kind == 15: HorizontalLayout {
                spacing: 8px;
                VerticalLayout {
                    alignment: center;
                    MenuField {
                        width: 260px;
                        text: item.choices[item.chosen];
                        choices: item.choices;
                        chosen: item.chosen;
                        menu-width: 300px;
                        picked(i) => { Preferences.picked(item.id, i); }
                    }
                }
                // Lines up with Edit on the rows above.
                Rectangle { width: 80px; }
                RemoveCross { clicked => { Preferences.pressed(item.id + "#remove"); } }
            }
            if item.kind == 14: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 26px;
                    height: 22px;
                    border-radius: Theme.radius;
                    background: pta.has-hover ? Theme.n-2a2a2e : Theme.control;
                    border-width: 1px;
                    border-color: Theme.border;
                    Text { text: "+"; color: Theme.text; font-size: 15px; }
                    pta := TouchArea { mouse-cursor: pointer; clicked => { Preferences.pressed(item.id); } }
                }
            }
            if item.kind == 9: VerticalLayout {
                alignment: center;
                TextField { item: item; }
            }
            if item.kind == 8: VerticalLayout {
                alignment: center;
                Segmented { choices: item.choices; chosen: item.chosen; picked(i) => { Preferences.picked(item.id, i); } }
            }
        }
        // A path on its own line under the title, with Choose beside it
        // (none when it can't be changed here).
        if item.kind == 3: HorizontalLayout {
            spacing: 8px;
            Rectangle {
                horizontal-stretch: 1;
                height: 26px;
                border-radius: Theme.radius;
                background: Theme.well;
                border-width: 1px;
                border-color: Theme.separator;
                Text {
                    x: 8px;
                    width: parent.width - 16px;
                    text: item.value;
                    color: Theme.text;
                    font-size: 12px;
                    overflow: elide;
                    vertical-alignment: center;
                }
            }
            if item.action != "": Button { text: item.action; clicked => { Preferences.pressed(item.id); } }
        }
        if item.kind == 4 && !AudioSettings.external: OutputsTable { roomy: true; bright: bright; }
        if item.kind == 4 && AudioSettings.external: ExternalOutputsTable { bright: bright; }
        if item.kind == 13: InputsTable { }
        if item.kind == 5: HorizontalLayout {
            alignment: start;
            spacing: 36px;
            padding-top: 4px;
            ControlKnob { group: "[Master]"; key: "headMix"; label: "CUE MIX"; bipolar: true; size: 36px; }
            ControlKnob { group: "[Master]"; key: "headGain"; label: "CUE LEVEL"; size: 36px; }
            ControlKnob { group: "[Master]"; key: "booth_gain"; label: "BOOTH"; size: 36px; }
        }
    }
    // A thin line under each row, as between rows of a settings list.
    if item.kind != 7: Rectangle { y: parent.height - 1px; height: 1px; background: Theme.separator; }
}

// Close button, top right of the window.
export component CloseButton inherits Rectangle {
    callback clicked();
    width: 26px;
    height: 26px;
    border-radius: 13px;
    background: ta.has-hover ? Theme.n-3a3a3d : transparent;
    Path {
        width: 10px;
        height: 10px;
        viewbox-width: 10;
        viewbox-height: 10;
        commands: "M 1 1 L 9 9 M 9 1 L 1 9";
        stroke: ta.has-hover ? Theme.text : Theme.text-dim;
        stroke-width: 1.6px;
        fill: transparent;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The import wizard: a dialog over Settings, with its steps' rows and
// Back, Cancel and Next along the bottom.
export component ImportWizardDialog inherits Rectangle {
    background: Theme.s-00000080;
    // Clicks outside the dialog do nothing, as it waits on an answer.
    TouchArea { }
    Rectangle {
        width: min(560px, root.width - 64px);
        height: min(440px, root.height - 64px);
        border-radius: 12px;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 40px;
        drop-shadow-color: Theme.s-000000c0;
        clip: true;
        VerticalLayout {
            padding: 22px;
            padding-bottom: 18px;
            spacing: 6px;
            HorizontalLayout {
                Text {
                    text: ImportWizard.title;
                    color: Theme.text;
                    font-size: 18px;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                VerticalLayout {
                    alignment: center;
                    CloseButton { clicked => { Preferences.pressed("import_wizard_cancel"); } }
                }
            }
            Text { text: ImportWizard.step; color: Theme.text-dim; font-size: 12px; }
            Rectangle { height: 6px; }
            Flickable {
                vertical-stretch: 1;
                content-height: rows.preferred-height;
                rows := VerticalLayout {
                    width: parent.width;
                    alignment: start;
                    for item in ImportWizard.items: PrefRow { item: item; }
                }
            }
            HorizontalLayout {
                padding-top: 12px;
                spacing: 8px;
                if ImportWizard.can-back: Button {
                    text: "Back";
                    clicked => { Preferences.pressed("import_wizard_back"); }
                }
                Rectangle { horizontal-stretch: 1; }
                Button {
                    text: "Cancel";
                    clicked => { Preferences.pressed("import_wizard_cancel"); }
                }
                Button {
                    text: ImportWizard.next-label;
                    primary: true;
                    opacity: ImportWizard.can-next ? 1 : 0.4;
                    clicked => {
                        if ImportWizard.can-next {
                            Preferences.pressed("import_wizard_next");
                        }
                    }
                }
            }
        }
    }
}

export component PluginErrorsDialog inherits Rectangle {
    background: Theme.s-00000080;
    TouchArea { clicked => { Preferences.pressed("audio_plugin_errors_close"); } }
    Rectangle {
        width: min(760px, root.width - 64px);
        height: min(520px, root.height - 64px);
        border-radius: 12px;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 40px;
        drop-shadow-color: Theme.s-000000c0;
        clip: true;
        TouchArea { }
        VerticalLayout {
            padding: 18px;
            spacing: 10px;
            HorizontalLayout {
                Text {
                    text: PluginErrors.title;
                    color: Theme.text;
                    font-size: 16px;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                VerticalLayout {
                    alignment: center;
                    CloseButton { clicked => { Preferences.pressed("audio_plugin_errors_close"); } }
                }
            }
            Rectangle {
                vertical-stretch: 1;
                border-radius: Theme.radius;
                background: Theme.well;
                border-width: 1px;
                border-color: Theme.separator;
                clip: true;
                Flickable {
                    x: 10px;
                    y: 8px;
                    width: parent.width - 20px;
                    height: parent.height - 16px;
                    content-height: log.preferred-height;
                    // Selectable, so it can be copied into a bug report.
                    log := TextInput {
                        width: parent.width;
                        text: PluginErrors.text;
                        read-only: true;
                        single-line: false;
                        wrap: word-wrap;
                        color: Theme.n-c8c8cd;
                        font-family: "Menlo";
                        font-size: 11px;
                        selection-background-color: Theme.selection;
                    }
                }
            }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                Button { text: "Retry all"; clicked => { Preferences.pressed("audio_plugin_retry_all"); } }
                Button { text: "Close"; primary: true; clicked => { Preferences.pressed("audio_plugin_errors_close"); } }
            }
        }
    }
}

export component PreferencesOverlay inherits Rectangle {
    property <bool> searching: Preferences.query != "";
    // Where focus goes after a shortcut edit (Preferences.refocus).
    idle := FocusScope { width: 0; height: 0; }
    property <int> refocus: Preferences.refocus;
    changed refocus => { idle.focus(); }
    // The dimmed app behind; a click there closes settings.
    background: Theme.s-000000a0;
    TouchArea {
        clicked => { Preferences.open = false; }
    }
    panel := Rectangle {
        width: min(1000px, root.width - 96px);
        height: min(700px, root.height - 96px);
        border-radius: 12px;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 40px;
        drop-shadow-color: Theme.s-000000c0;
        clip: true;
        // Clicks inside the window stay there.
        TouchArea { }
        HorizontalLayout {
            // The page list, with the search box above.
            Rectangle {
                width: 220px;
                background: Theme.n-141416;
                VerticalLayout {
                    padding: 14px;
                    padding-top: 18px;
                    spacing: 4px;
                    Text { text: "Settings"; color: Theme.text; font-size: 20px; font-weight: 700; }
                    Rectangle { height: 10px; }
                    search := SearchField {
                        text <=> Preferences.query;
                        edited => { Preferences.changed(); }
                    }
                    Rectangle { height: 10px; }
                    for name[i] in Preferences.pages: Rectangle {
                        property <bool> selected: !searching && i == Preferences.page;
                        height: 36px;
                        border-radius: 8px;
                        background: selected ? Theme.n-3a3a3d : pta.has-hover ? Theme.n-222225 : transparent;
                        HorizontalLayout {
                            padding-left: 10px;
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                PageIcon { kind: i; color: selected ? Theme.lilac-text : Theme.text-dim; }
                            }
                            Text { text: name; color: selected ? Theme.lilac-text : Theme.text; font-size: 14px; font-weight: selected ? 600 : 400; vertical-alignment: center; }
                        }
                        pta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { Preferences.show(i); }
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                }
            }
            Rectangle { width: 1px; background: Theme.separator; }
            // The page.
            VerticalLayout {
                horizontal-stretch: 1;
                padding-left: 28px;
                padding-right: 16px;
                padding-top: 16px;
                HorizontalLayout {
                    height: 34px;
                    Text {
                        text: searching ? "Results for “" + Preferences.query + "”" : Preferences.pages[Preferences.page];
                        color: Theme.text;
                        font-size: 20px;
                        font-weight: 700;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    VerticalLayout {
                        alignment: center;
                        CloseButton { clicked => { Preferences.open = false; } }
                    }
                }
                if !searching && Preferences.tabs.length > 0: HorizontalLayout {
                    alignment: start;
                    padding-top: 6px;
                    padding-bottom: 4px;
                    Segmented {
                        choices: Preferences.tabs;
                        chosen: Preferences.tab;
                        picked(i) => {
                            Preferences.tab = i;
                            Preferences.changed();
                        }
                    }
                }
                Flickable {
                    vertical-stretch: 1;
                    content-height: rows.preferred-height;
                    rows := VerticalLayout {
                        width: parent.width;
                        padding-right: 12px;
                        padding-bottom: 20px;
                        alignment: start;
                        for item in Preferences.items: PrefRow { item: item; searching: searching; }
                        if searching && Preferences.items.length == 0: Text {
                            text: "No settings match.";
                            color: Theme.text-dim;
                            font-size: 13px;
                        }
                    }
                }
            }
        }
    }
    if ImportWizard.open: ImportWizardDialog { }
    if PluginErrors.open: PluginErrorsDialog { }
    public function focus-search() {
        search.focus-input();
    }
}
