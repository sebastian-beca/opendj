// Centre mixer: EQ columns on the outside (kills are on
// controllers only), gain and channel
// faders in the middle with the main meter between them, crossfader below.
// Dark knobs with white pointers, ticked faders.
import { Theme, EdgeLine, CloseIcon } from "theme.slint";
import { Caption, Controls, ControlButton, ControlFader, ControlKnob, Crossfader, CueHeadphones, StereoMeter } from "controls.slint";
import { EffectList } from "deck.slint";

// One output route in the settings table.
export struct OutputRow {
    // 0 master, 1 headphones, 2 booth
    role: int,
    // Index into AudioSettings.devices (0 is the system default), or -1
    // for a device that isn't connected now.
    device: int,
    device-name: string,
    // Channel pair: 0 is ch 1 & 2.
    pair: int,
    pairs: [string],
    status: string,
    ok: bool,
}

// The audio settings: the output routes table, and
// the connected controllers.
export global AudioSettings {
    in property <[OutputRow]> rows;
    in property <[string]> devices;
    in property <string> controllers: "None";
    // A booth output is set up: the MASTER panel shows its level.
    in property <bool> booth;
    callback refresh();
    callback set-role(row: int, role: int);
    callback set-device(row: int, device: int);
    callback set-pair(row: int, pair: int);
    callback add();
    callback remove(row: int);
}

// A small field that shows a choice and opens a list to change it. Long
// lists scroll.
export component MenuField inherits Rectangle {
    in property <string> text;
    in property <[string]> choices;
    in property <int> chosen;
    in property <length> menu-width: 220px;
    callback opening();
    callback picked(index: int);
    height: 26px;
    background: ta.has-hover ? #2a2a2e : Theme.control;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 6px;
        spacing: 4px;
        Text { text: root.text; color: Theme.text; font-size: 12px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
        Path {
            width: 8px;
            height: 5px;
            y: (parent.height - self.height) / 2;
            commands: "M 0 0 L 4 4.5 L 8 0";
            stroke: Theme.text-dim;
            stroke-width: 1.5px;
            fill: transparent;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.opening();
            menu.show();
        }
    }
    menu := PopupWindow {
        x: 0px;
        y: root.height + 2px;
        width: menu-width;
        height: min(choices.length * 26px, 390px) + 12px;
        close-policy: close-on-click-outside;
        Rectangle {
            background: Theme.panel-raised;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 12px;
            drop-shadow-color: #000000a0;
        }
        Flickable {
            x: 6px;
            y: 6px;
            width: parent.width - 12px;
            height: parent.height - 12px;
            content-height: choices.length * 26px;
            // Opens with the chosen item in view.
            content-y: max(min(0px, self.height / 2 - (chosen + 0.5) * 26px), self.height - self.content-height);
            VerticalLayout {
                spacing: 0px;
                for c[i] in choices: Rectangle {
                    height: 26px;
                    border-radius: 4px;
                    background: i == chosen ? Theme.accent.with-alpha(0.35) : ita.has-hover ? #3a3a3d : transparent;
                    Text { x: 8px; width: parent.width - 16px; text: c; color: Theme.text; font-size: 13px; font-weight: i == chosen ? 600 : 400; overflow: elide; }
                    ita := TouchArea {
                        clicked => {
                            root.picked(i);
                            menu.close();
                        }
                    }
                }
            }
        }
    }
}

// The output routes table: a row per mix with
// its device and channel pair, and + to add one.
export component OutputsTable inherits VerticalLayout {
    // Wider fields, for the settings window.
    in property <bool> roomy;
    spacing: roomy ? 8px : 6px;
    for row[r] in AudioSettings.rows: VerticalLayout {
        spacing: 2px;
        HorizontalLayout {
            spacing: 3px;
            MenuField {
                width: roomy ? 120px : 78px;
                text: ["Master", "Phones", "Booth"][row.role];
                choices: ["Master", "Headphones", "Booth"];
                chosen: row.role;
                menu-width: 140px;
                picked(i) => { AudioSettings.set-role(r, i); }
            }
            MenuField {
                horizontal-stretch: 1;
                text: row.device-name;
                choices: AudioSettings.devices;
                chosen: row.device;
                menu-width: 260px;
                opening => { AudioSettings.refresh(); }
                picked(i) => { AudioSettings.set-device(r, i); }
            }
            MenuField {
                width: roomy ? 90px : 62px;
                text: row.pairs[row.pair];
                choices: row.pairs;
                chosen: row.pair;
                menu-width: 110px;
                picked(i) => { AudioSettings.set-pair(r, i); }
            }
            Rectangle {
                width: 20px;
                CloseIcon { size: 9px; color: xta.has-hover ? Theme.text : Theme.text-dim; }
                xta := TouchArea { mouse-cursor: pointer; clicked => { AudioSettings.remove(r); } }
            }
        }
        Text { text: row.status; color: row.ok ? Theme.text-dim : #ff9f0a; font-size: 10px; overflow: elide; x: 4px; }
    }
    HorizontalLayout {
        alignment: end;
        Rectangle {
            width: 26px;
            height: 22px;
            border-radius: Theme.radius;
            background: ata.has-hover ? #2a2a2e : Theme.control;
            border-width: 1px;
            border-color: Theme.border;
            Text { text: "+"; color: Theme.text; font-size: 15px; }
            ata := TouchArea { mouse-cursor: pointer; clicked => { AudioSettings.add(); } }
        }
    }
}

// The Color FX picker, over the meters above the knob mode menu: the chosen one's name, opening the list. Every deck's filter knob
// plays it (one for all, as on a Pioneer mixer); SHIFT + SMART CFX on the
// DDJ-FLX4 steps through them.
component ColorFxMenu inherits Rectangle {
    property <int> index: Controls.resolve("[QuickEffectRack1_[Channel1]]", "loaded_chain_preset");
    property <int> cfx: Controls.value(index, Controls.tick);
    height: 24px;
    HorizontalLayout {
        alignment: center;
        spacing: 3px;
        Text {
            text: cfx >= 1 && cfx <= EffectList.color-fx.length ? EffectList.color-fx[cfx - 1].to-uppercase() : "NO CFX";
            color: ta.has-hover ? Theme.text : Theme.label;
            font-size: 9px;
            font-weight: 700;
            vertical-alignment: center;
        }
        Path {
            width: 6px;
            height: 4px;
            y: (parent.height - self.height) / 2;
            commands: "M 0 0 L 3 3.5 L 6 0";
            stroke: ta.has-hover ? Theme.text : Theme.text-dim;
            stroke-width: 1.2px;
            fill: transparent;
        }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { menu.show(); } }
    menu := PopupWindow {
        x: 0px;
        y: root.height + 2px;
        width: 120px;
        close-policy: close-on-click-outside;
        Rectangle {
            background: Theme.panel-raised;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 12px;
            drop-shadow-color: #000000a0;
        }
        VerticalLayout {
            padding: 5px;
            Text { text: "COLOR FX"; color: Theme.text-dim; font-size: 9px; font-weight: 700; letter-spacing: 0.5px; height: 20px; vertical-alignment: center; x: 8px; }
            for name[i] in EffectList.color-fx: Rectangle {
                property <bool> current: cfx == i + 1;
                height: 24px;
                border-radius: 4px;
                background: current ? Theme.accent.with-alpha(0.35) : ita.has-hover ? #3a3a3d : transparent;
                Text { x: 8px; text: name; color: Theme.text; font-size: 12px; font-weight: current ? 700 : 500; vertical-alignment: center; height: parent.height; }
                ita := TouchArea {
                    clicked => {
                        Controls.set-value(index, i + 1);
                        menu.close();
                    }
                }
            }
        }
    }
}

// What the four knobs down each side of the mixer control, picked from the
// menu over the meters.
export global MixerMode {
    // 0 EQ (high, mid, low, filter), 1 stem volumes, 2 sculpt as on
    // PlayDifferently's Model 1 (low-pass, sculpt frequency and cut/boost,
    // high-pass).
    in-out property <int> mode: 0;
    out property <[string]> names: ["EQ", "STEMS", "SCULPT"];
}

// A mixer knob, centred in its grid cell.
export component Knob inherits HorizontalLayout {
    in property <string> group;
    in property <string> key;
    in property <string> label;
    in property <color> tint: Theme.text;
    // Where the knob's arc starts: the centre for EQs, an end for filters
    // and volumes.
    in property <float> origin: 0.5;
    in property <int> look: 0;
    in property <length> size: 30px;
    alignment: center;
    ControlKnob { group: group; key: key; label: label; bipolar: true; origin: origin; look: look; size: size; tint: tint; }
}

// One of the four knobs down a side of the mixer (`place` 0 is the top), as
// MixerMode says.
export component SideKnob inherits Rectangle {
    in property <int> deck;
    in property <int> place;
    in property <length> size: 27px;
    property <string> ch: "[Channel" + (deck + 1) + "]";
    property <string> eq: "[EqualizerRack1_" + ch + "_Effect1]";
    property <string> sculpt: "[Sculpt_" + ch + "]";
    property <int> cfx: Controls.value(Controls.resolve("[QuickEffectRack1_" + ch + "]", "loaded_chain_preset"), Controls.tick);
    // Stems top to bottom: hi-hats (stem 5, split
    // from the drums), vocals, kick (the rest of the drums) and bass. The
    // melody stem has no knob here; its pad is on the STEMS page.
    property <string> stem: "[Channel" + (deck + 1) + "_Stem" + [5, 4, 1, 2][place] + "]";
    property <int> stem-count-index: Controls.resolve(ch, "stem_count");
    property <bool> has-stems: Controls.value(stem-count-index, Controls.tick) > 0;
    property <int> mode: MixerMode.mode;
    // Dimmed in stems mode while the track has no stems.
    opacity: mode == 1 && !has-stems ? 0.4 : 1;
    HorizontalLayout {
        alignment: center;
        if mode == 0: Knob {
            size: size;
            group: place == 3 ? "[QuickEffectRack1_" + ch + "]" : eq;
            key: ["parameter3", "parameter2", "parameter1", "super1"][place];
            // The filter knob plays the chosen Color FX, and says which.
            label: place == 3 ? (cfx >= 1 && cfx <= EffectList.color-fx.length ? EffectList.color-fx[cfx - 1].to-uppercase() : "CFX") : ["HIGH", "MID", "LOW"][place];
        }
        if mode == 1: Knob {
            size: size;
            group: stem;
            key: "volume";
            label: ["HIHAT", "VOCAL", "KICK", "BASS"][place];
        }
        if mode == 2: Knob {
            size: size;
            group: sculpt;
            key: ["lpf", "freq", "gain", "hpf"][place];
            label: ["LPF", "FREQ", "CUT/BOOST", "HPF"][place];
            origin: [1, 0.5, 0.5, 0][place];
            look: place == 1 || place == 2 ? 1 : 2;
        }
    }
}

// The knob mode menu, over the mixer's meters.
export component ModeMenu inherits Rectangle {
    height: 24px;
    // Just the name and an arrow, with no box round them.
    HorizontalLayout {
        alignment: center;
        spacing: 3px;
        Text { text: MixerMode.names[MixerMode.mode]; color: ta.has-hover ? Theme.text : Theme.label; font-size: 9px; font-weight: 700; vertical-alignment: center; }
        Path {
            width: 6px;
            height: 4px;
            y: (parent.height - self.height) / 2;
            commands: "M 0 0 L 3 3.5 L 6 0";
            stroke: ta.has-hover ? Theme.text : Theme.text-dim;
            stroke-width: 1.2px;
            fill: transparent;
        }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { menu.show(); } }
    menu := PopupWindow {
        x: (root.width - 96px) / 2;
        y: root.height + 2px;
        width: 96px;
        close-policy: close-on-click-outside;
        Rectangle {
            background: Theme.panel-raised;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 12px;
            drop-shadow-color: #000000a0;
        }
        VerticalLayout {
            padding: 5px;
            for name[i] in MixerMode.names: Rectangle {
                height: 24px;
                border-radius: 4px;
                background: i == MixerMode.mode ? Theme.accent.with-alpha(0.35) : ita.has-hover ? #3a3a3d : transparent;
                Text { x: 8px; text: name; color: Theme.text; font-size: 12px; font-weight: i == MixerMode.mode ? 700 : 500; vertical-alignment: center; height: parent.height; }
                ita := TouchArea {
                    clicked => {
                        MixerMode.mode = i;
                        // Controllers' EQ knobs follow the mode.
                        Controls.set-value(Controls.resolve("[Mixer]", "knob_mode"), i);
                        menu.close();
                    }
                }
            }
        }
    }
}

// A channel down the middle of the mixer: gain (smaller than the EQs, as
// on most mixers), the fader, and headphone cue under it.
component Channel inherits VerticalLayout {
    in property <string> group;
    in property <color> tint;
    spacing: 6px;
    Knob { group: group; key: "pregain"; label: "GAIN"; size: 24px; }
    HorizontalLayout {
        alignment: center;
        vertical-stretch: 1;
        ControlFader { group: group; key: "volume"; tint: tint; ticks: 11; width: 36px; }
    }
    HorizontalLayout { alignment: center; CueHeadphones { group: group; tint: tint; } }
}

// The four knobs down one side, spread over the mixer's height.
component SideColumn inherits VerticalLayout {
    in property <int> deck;
    width: 48px;
    alignment: space-around;
    for place in 4: SideKnob { deck: deck; place: place; }
}

// The channels: four knobs down the outsides (EQ, stems or
// sculpt; see MixerMode), and between them gain, the channel faders with
// the meters between them, and headphone cue.
component ChannelGrid inherits HorizontalLayout {
    SideColumn { deck: 0; }
    HorizontalLayout {
        horizontal-stretch: 1;
        alignment: space-around;
        Channel { group: "[Channel1]"; tint: Theme.deck1; }
        // The Color FX and knob mode menus over the meters, which are
        // level with the faders: below the gain knobs, above the cue buttons.
        VerticalLayout {
            padding-bottom: 34px;
            ColorFxMenu { width: 48px; }
            ModeMenu { width: 48px; }
            HorizontalLayout {
                alignment: center;
                spacing: 4px;
                padding-top: 8px;
                vertical-stretch: 1;
                StereoMeter { group: "[Channel1]"; }
                StereoMeter { group: "[Channel2]"; }
            }
        }
        Channel { group: "[Channel2]"; tint: Theme.deck2; }
    }
    SideColumn { deck: 1; }
}

export component Mixer inherits Rectangle {
    background: Theme.panel;
    width: 282px;
    VerticalLayout {
        padding: 8px;
        spacing: 4px;
        ChannelGrid { vertical-stretch: 1; }
        // Along the bottom edge, as on a hardware mixer: the crossfader.
        // The levels are in the top bar's MASTER panel.
        HorizontalLayout {
            padding-left: 48px;
            padding-right: 48px;
            Rectangle {
                horizontal-stretch: 1;
                height: 28px;
                Crossfader { x: 8px; width: parent.width - 16px; }
            }
        }
    }
}
