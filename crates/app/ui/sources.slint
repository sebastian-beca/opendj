// Sources that come from add-ons (see sources.rs): saved searches on the
// left, a search box over the list, and results with a download for each.
import { LineEdit } from "std-widgets.slint";
import { ListView } from "scroll.slint";
import { Theme, EdgeLine, CloseIcon } from "theme.slint";

// A plugin source in the rail.
export struct SourceTab {
    name: string,
    icon: image,
    // What its search box suggests.
    hint: string,
}

// A saved search in the panel.
export struct SearchItem {
    name: string,
    // "Searching… 7 so far", "24 tracks · 6 albums".
    sub: string,
    // 0 = auto, 1 = track, 2 = album, 3 = artist, 4 = playlist link
    kind: int,
    busy: bool,
}

// A row of results.
export struct FoundRow {
    // 0 = a heading ("Albums", or a playlist's song), 1 = a folder, 2 = a file
    kind: int,
    // 1 for a file shown inside its folder.
    depth: int,
    checked: bool,
    // A folder whose files are shown.
    open: bool,
    title: string,
    // A file's artist; a folder's artist, year and track count.
    artist: string,
    number: string,
    length: string,
    format: string,
    quality: string,
    size: string,
    from: string,
    // 0 = not downloaded, 1 = queued, 2 = downloading, 3 = done, 4 = failed
    state: int,
    progress: float,
    // Why a download failed.
    note: string,
    // A folder's cover, once fetched.
    cover: image,
    has-cover: bool,
    // From a source that plays (a music server): the file is in the cache,
    // or on its way there and how far.
    cached: bool,
    caching: bool,
    cache-progress: float,
    // On the Downloads list: a download into the cache.
    to-cache: bool,
    // On the Downloads list: how a download goes, from its source: its
    // place in line while queued ("4th in line"), its speed while coming.
    going: string,
    // Heard before it's downloaded: 0 = not, 1 = waiting for the other
    // user, 2 = playing, 3 = couldn't (why is in from).
    preview: int,
}

// A line of a source's own page (Sharing): a section's heading, or a
// figure and its value.
export struct StatusLine {
    heading: bool,
    label: string,
    value: string,
}

export struct QueueLine {
    text: string,
    progress: float,
}

// A field of a source's set-up form, shown in its panel until it is set
// up.
export struct SetupField {
    // Names the setting.
    key: string,
    title: string,
    detail: string,
    // Typed hidden: a password or token.
    secret: bool,
    // What was typed so far.
    value: string,
}

export global SourceUi {
    in property <[SourceTab]> sources;
    // The shown source's set-up form, empty once it is set up; what it is,
    // and what the last Connect did.
    in property <[SetupField]> setup;
    in property <string> setup-intro;
    in property <string> setup-status;
    callback setup-typed(key: string, text: string);
    callback setup-connect();
    // Opens Settings › Sources.
    callback open-settings();
    in property <[SearchItem]> searches;
    // The search shown; -1 is the Downloads list, -2 the source's own page.
    in property <int> current-search: -1;
    // Under Downloads in the panel: "3 active".
    in property <string> downloads-line;
    // The source's own page, after Downloads in the panel (Sharing): its
    // name, a line under it, a sentence over its figures, and the figures.
    in property <bool> status-shown;
    in property <string> status-title;
    in property <string> status-line;
    in property <string> status-note;
    in property <[StatusLine]> status-lines;
    in property <[FoundRow]> rows;
    in property <string> title;
    in property <string> summary;
    // Shown instead of rows: "Searching…", "Nothing found.", an error.
    in property <string> notice;
    // 0 = everything, 1 = tracks, 2 = albums.
    in property <int> filter;
    in property <bool> lossless-only;
    in property <int> selected-count;
    in property <string> selected-summary;
    // What's downloading now, first few: under Downloads in the panel.
    in property <[QueueLine]> queue;
    // The search is a playlist's: its results come in a group per song.
    in property <bool> grouped;
    // Downloads queued or running, finished or failed, and failed.
    in property <int> active-count;
    in property <int> finished-count;
    in property <int> failed-count;
    // The source shown is the DJ's own music server: files play from a
    // cache, and Download keeps them there; Add to Collection keeps them.
    in property <bool> plays;
    // The source shown lets the DJ hear a file before downloading it.
    in property <bool> previews;
    // The search bar's options, kept while the app runs: what to search
    // for (Auto, Track, Album, Artist, Playlist), the kind of copy preferred
    // (Lossless, MP3 320, Any) and whether a playlist's songs download
    // right away.
    in-out property <int> kind;
    in-out property <int> prefer;
    in-out property <bool> auto-download;
    // auto: download each playlist entry's best copy right away.
    callback search(text: string, kind: int, prefer: int, auto: bool);
    callback select-search(index: int);
    callback remove-search(index: int);
    callback clear-searches();
    callback search-again(index: int);
    callback check(row: int, shift: bool);
    callback toggle-open(row: int);
    // A row's button: download it, or try a failed one again.
    callback download(row: int);
    callback download-selected();
    // A source that plays: load a file onto a free deck (through the
    // cache), keep a row in the cache, or the ticked rows.
    callback play(row: int);
    // Hear a file before downloading it, or stop hearing it.
    callback preview-row(row: int);
    callback cache(row: int);
    callback cache-selected();
    // The Downloads list: take a row off (stopping it), try the failed
    // again, clear what's finished, stop everything going.
    callback remove-download(row: int);
    callback retry-failed();
    callback clear-finished();
    callback cancel-downloads();
    callback clear-selection();
    // Ticks the best copy of each song of a playlist.
    callback pick-best();
    callback set-filter(filter: int);
    callback set-lossless-only(on: bool);
}

component Line inherits Rectangle {
    in property <string> text;
    in property <color> text-color: Theme.text;
    callback clicked();
    height: 30px;
    border-radius: 5px;
    background: ta.has-hover ? Theme.n-3a3a3d : transparent;
    Text { x: 10px; text: root.text; color: root.text-color; font-size: 13px; vertical-alignment: center; }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component Menu inherits Rectangle {
    background: Theme.n-2a2a2d;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.border;
    drop-shadow-blur: 12px;
    drop-shadow-color: Theme.s-00000080;
}

// What a search looks for, drawn: a magnifier, a record, or a list.
component KindIcon inherits Path {
    in property <int> kind;
    in property <color> color: Theme.text-dim;
    width: 16px;
    height: 16px;
    viewbox-width: 16;
    viewbox-height: 16;
    stroke: color;
    stroke-width: 1.5px;
    stroke-line-cap: round;
    fill: transparent;
    commands: kind == 2 ? "M 8 2 A 6 6 0 1 1 7.99 2 Z M 8 6.5 A 1.5 1.5 0 1 1 7.99 6.5 Z"
        : kind == 4 ? "M 2.5 4 L 13.5 4 M 2.5 8 L 13.5 8 M 2.5 12 L 9.5 12"
        : "M 7 2.5 A 4.5 4.5 0 1 1 6.99 2.5 Z M 10.3 10.3 L 14 14";
}

// A pill to pick one of a few.
component Pill inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    callback clicked();
    height: 24px;
    width: label.preferred-width + 20px;
    border-radius: 12px;
    background: on ? Theme.accent : (ta.has-hover ? Theme.n-333336 : Theme.n-2a2a2d);
    label := Text { text: root.text; color: on ? Theme.on-selection : Theme.text-dim; font-size: 12px; font-weight: on ? 600 : 400; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component Bar inherits Rectangle {
    in property <float> progress;
    height: 4px;
    border-radius: 2px;
    background: Theme.n-3a3a3d;
    Rectangle {
        x: 0;
        width: parent.width * clamp(progress, 0, 1);
        height: parent.height;
        border-radius: 2px;
        background: Theme.accent;
    }
}

// A place in the panel below the searches: Downloads, or the source's own
// page. Its icon goes inside.
component NavRow inherits Rectangle {
    in property <string> title;
    in property <string> sub;
    in property <bool> selected;
    // 0..1 while something is going; below 0 for no bar.
    in property <float> progress: -1;
    callback clicked();
    height: 46px;
    border-radius: Theme.radius;
    background: selected ? Theme.n-3a3a3d : (ta.has-hover ? Theme.n-232326 : transparent);
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 10px;
        Rectangle {
            width: 16px;
            @children
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text { text: root.title; color: Theme.text; font-size: 14px; font-weight: 600; overflow: elide; }
            if root.sub != "": Text { text: root.sub; color: Theme.text-dim; font-size: 11px; overflow: elide; }
            if root.progress >= 0: Bar { progress: root.progress; }
        }
    }
}

// An arrow into a tray.
component DownloadIcon inherits Path {
    width: 16px;
    height: 16px;
    viewbox-width: 16;
    viewbox-height: 16;
    stroke: Theme.text-dim;
    stroke-width: 1.5px;
    stroke-line-cap: round;
    fill: transparent;
    commands: "M 8 2 L 8 10 M 4.5 6.5 L 8 10 L 11.5 6.5 M 2.5 11 L 2.5 13.5 L 13.5 13.5 L 13.5 11";
}

// An arrow out of a tray: sharing.
component ShareIcon inherits Path {
    width: 16px;
    height: 16px;
    viewbox-width: 16;
    viewbox-height: 16;
    stroke: Theme.text-dim;
    stroke-width: 1.5px;
    stroke-line-cap: round;
    fill: transparent;
    commands: "M 8 10 L 8 2 M 4.5 5.5 L 8 2 L 11.5 5.5 M 2.5 11 L 2.5 13.5 L 13.5 13.5 L 13.5 11";
}

// Left of the results: the source's saved searches, a + for a new one,
// then Downloads and the source's own page (Sharing).
export component SearchesPanel inherits Rectangle {
    in property <string> source-name;
    property <int> menu-index;
    property <length> menu-y;
    width: 270px;
    background: Theme.panel;
    search-menu := PopupWindow {
        x: 40px;
        y: menu-y;
        width: 170px;
        close-policy: close-on-click-outside;
        Menu {}
        VerticalLayout {
            padding: 6px;
            Line {
                text: "Search again";
                clicked => {
                    SourceUi.search-again(menu-index);
                    search-menu.close();
                }
            }
            Line {
                text: "Remove";
                text-color: #ff6b5e;
                clicked => {
                    SourceUi.remove-search(menu-index);
                    search-menu.close();
                }
            }
            Line {
                text: "Clear all searches";
                text-color: #ff6b5e;
                clicked => {
                    SourceUi.clear-searches();
                    search-menu.close();
                }
            }
        }
    }
    VerticalLayout {
        padding: 8px;
        padding-top: 0px;
        spacing: 6px;
        HorizontalLayout {
            height: 38px;
            padding-left: 8px;
            Text { text: source-name; color: Theme.text-dim; font-size: 13px; font-weight: 600; vertical-alignment: center; }
        }
        EdgeLine { left: 8px; right: 8px; }
        HorizontalLayout {
            padding-left: 8px;
            height: 26px;
            Text { text: "Searches"; color: Theme.text; font-size: 15px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
            if SourceUi.searches.length > 0: Rectangle {
                width: clear-text.preferred-width + 12px;
                border-radius: 5px;
                background: cta.has-hover ? Theme.n-232326 : transparent;
                clear-text := Text { text: "Clear all"; color: cta.has-hover ? #ff6b5e : Theme.text-dim; font-size: 12px; vertical-alignment: center; }
                cta := TouchArea { mouse-cursor: pointer; clicked => { SourceUi.clear-searches(); } }
            }
        }
        if SourceUi.searches.length == 0: Text {
            text: "Type in the search bar to search.";
            color: Theme.text-dim;
            font-size: 13px;
            horizontal-alignment: center;
        }
        ListView {
            vertical-stretch: 1;
            gutter: true;
            for s[i] in SourceUi.searches: Rectangle {
                height: 46px;
                border-radius: Theme.radius;
                background: i == SourceUi.current-search ? Theme.n-3a3a3d : (ta.has-hover ? Theme.n-232326 : transparent);
                ta := TouchArea {
                    clicked => { SourceUi.select-search(i); }
                    pointer-event(e) => {
                        if e.button == PointerEventButton.right && e.kind == PointerEventKind.down {
                            menu-index = i;
                            menu-y = self.absolute-position.y - root.absolute-position.y + self.height;
                            search-menu.show();
                        }
                    }
                }
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 8px;
                    spacing: 10px;
                    Rectangle {
                        width: 16px;
                        // A search still going pulses.
                        if s.busy: Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: Theme.accent;
                            opacity: 0.35 + 0.65 * abs(sin(animation-tick() / 1ms * 0.25deg));
                        }
                        if !s.busy: KindIcon { kind: s.kind; }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        Text { text: s.name; color: Theme.text; font-size: 14px; overflow: elide; }
                        Text { text: s.sub; color: Theme.text-dim; font-size: 11px; overflow: elide; }
                    }
                }
            }
        }
        EdgeLine { left: 8px; right: 8px; }
        // Downloads, then the source's own page (Sharing), each a place of
        // its own like a search.
        NavRow {
            title: "Downloads";
            sub: SourceUi.queue.length > 0
                ? SourceUi.downloads-line + " · " + SourceUi.queue[0].text
                : SourceUi.downloads-line;
            selected: SourceUi.current-search == -1;
            progress: SourceUi.queue.length > 0 ? SourceUi.queue[0].progress : -1;
            clicked => { SourceUi.select-search(-1); }
            DownloadIcon {}
        }
        if SourceUi.status-shown: NavRow {
            title: SourceUi.status-title;
            sub: SourceUi.status-line;
            selected: SourceUi.current-search == -2;
            clicked => { SourceUi.select-search(-2); }
            ShareIcon {}
        }
    }
}

// A result's button: download, how far it's got, or try again.
component RowButton inherits Rectangle {
    in property <FoundRow> r;
    callback clicked();
    width: 96px;
    VerticalLayout {
        alignment: center;
        if r.state == 2: VerticalLayout {
            spacing: 3px;
            Text { text: round(r.progress * 100) + "%" + (r.going != "" ? " · " + r.going : ""); color: Theme.text-dim; font-size: 11px; horizontal-alignment: right; }
            Bar { progress: r.progress; }
        }
        if r.state != 2: HorizontalLayout {
            alignment: end;
            Rectangle {
                height: 22px;
                width: label.preferred-width + 20px;
                border-radius: 11px;
                border-width: r.state == 0 ? 0px : 1px;
                border-color: r.state == 3 ? #2d6a43 : r.state == 4 ? #6a2d2d : Theme.n-48484c;
                background: r.state == 0 ? (ta.has-hover ? Theme.accent.brighter(0.15) : Theme.accent) : transparent;
                label := Text {
                    text: r.state == 0 ? (SourceUi.plays ? (r.kind == 1 ? "+ Album" : "+ Collection") : r.kind == 1 ? "↓ Album" : "↓")
                        : r.state == 1 ? (r.going != "" ? r.going : "Queued") : r.state == 3 ? (r.to-cache ? "✓ Cached" : "✓ Added") : "Retry";
                    color: r.state == 0 ? Theme.on-selection : r.state == 3 ? #30d158 : r.state == 4 ? #ff6b5e : Theme.text-dim;
                    font-size: 11px;
                    font-weight: 700;
                }
                ta := TouchArea {
                    mouse-cursor: r.state == 0 || r.state == 4 ? pointer : default;
                    clicked => { clicked(); }
                }
            }
        }
    }
}

// A cloud: filled when the file is in the cache.
component Cloud inherits Path {
    in property <bool> filled;
    width: 16px;
    height: 12px;
    viewbox-width: 16;
    viewbox-height: 12;
    stroke-width: 1.3px;
    stroke: filled ? Theme.accent : Theme.text-dim;
    fill: filled ? Theme.accent : transparent;
    commands: "M 4.5 11 L 12 11 A 3 3 0 0 0 12.3 5 A 4.2 4.2 0 0 0 4.3 4.6 A 3.2 3.2 0 0 0 4.5 11 Z";
}

// On a file a source can let the DJ hear before downloading: play it in
// the headphones, or stop; dots while the other user starts sending.
component PreviewButton inherits Rectangle {
    in property <int> state;
    callback clicked();
    width: 26px;
    height: 22px;
    border-radius: 11px;
    background: ta.has-hover ? Theme.n-3a3a3d : transparent;
    property <color> ink: state == 1 || state == 2 ? Theme.accent : ta.has-hover ? Theme.text : Theme.text-dim;
    if state == 0 || state == 3: Path {
        width: 9px;
        height: 10px;
        viewbox-width: 9;
        viewbox-height: 10;
        fill: ink;
        commands: "M 0 0 L 9 5 L 0 10 Z";
    }
    if state == 1: Text { text: "···"; color: ink; font-size: 13px; font-weight: 800; }
    if state == 2: Rectangle { width: 9px; height: 9px; background: ink; border-radius: 1px; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { clicked(); } }
}

// On a music server's results: play a file, and keep it in the cache
// (the cloud), with how far that's got.
component CacheButtons inherits HorizontalLayout {
    in property <FoundRow> r;
    callback play();
    callback cache();
    width: 58px;
    spacing: 2px;
    alignment: end;
    if r.kind == 2: Rectangle {
        width: 26px;
        height: 22px;
        y: (parent.height - self.height) / 2;
        border-radius: 11px;
        background: pta.has-hover ? Theme.n-3a3a3d : transparent;
        Path {
            width: 9px;
            height: 10px;
            viewbox-width: 9;
            viewbox-height: 10;
            fill: pta.has-hover ? Theme.text : Theme.text-dim;
            commands: "M 0 0 L 9 5 L 0 10 Z";
        }
        pta := TouchArea { mouse-cursor: pointer; clicked => { play(); } }
    }
    Rectangle {
        width: 28px;
        height: 22px;
        y: (parent.height - self.height) / 2;
        border-radius: 11px;
        background: cta.has-hover && !r.cached && !r.caching ? Theme.n-3a3a3d : transparent;
        if r.caching: Text { text: round(r.cache-progress * 100) + "%"; color: Theme.text-dim; font-size: 10px; }
        if !r.caching: Cloud { filled: r.cached; }
        cta := TouchArea {
            mouse-cursor: r.cached || r.caching ? default : pointer;
            clicked => {
                if !r.cached && !r.caching { cache(); }
            }
        }
    }
}

component Check inherits Rectangle {
    in property <bool> on;
    callback toggled(shift: bool);
    width: 22px;
    property <bool> shift;
    Rectangle {
        width: 15px;
        height: 15px;
        border-radius: 3px;
        border-width: 1.5px;
        border-color: on ? Theme.accent : Theme.n-6a6a72;
        background: on ? Theme.accent : transparent;
        if on: Text { text: "✓"; color: Theme.on-selection; font-size: 11px; font-weight: 800; }
    }
    TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                shift = e.modifiers.shift;
            }
        }
        clicked => { toggled(shift); }
    }
}

// The results of the search picked on the left, or every download.
export component SourceResults inherits Rectangle {
    in property <string> hint;
    background: Theme.panel;
    function go() {
        if bar.text != "" {
            // Only playlists download song by song.
            SourceUi.search(bar.text, SourceUi.kind, SourceUi.prefer, (SourceUi.kind == 0 || SourceUi.kind == 4) && SourceUi.auto-download);
            bar.text = "";
        }
    }
    // The search bar's options, under the cog.
    options := PopupWindow {
        x: root.width - self.width - 8px;
        y: 44px;
        width: 340px;
        close-policy: close-on-click-outside;
        Menu {}
        VerticalLayout {
            padding: 12px;
            spacing: 10px;
            // Auto reads a link as a playlist. On a music server Playlist
            // lists its playlists and Artist that artist's albums.
            Text { text: "Search for"; color: Theme.text-dim; font-size: 12px; font-weight: 600; }
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                for k[i] in ["Auto", "Track", "Album", "Artist", "Playlist"]: Pill {
                    text: k;
                    on: i == SourceUi.kind;
                    clicked => { SourceUi.kind = i; }
                }
            }
            Text { text: "Prefer"; color: Theme.text-dim; font-size: 12px; font-weight: 600; }
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                for p[i] in ["Lossless", "MP3 320", "Any"]: Pill {
                    text: p;
                    on: i == SourceUi.prefer;
                    clicked => { SourceUi.prefer = i; }
                }
            }
            HorizontalLayout {
                spacing: 6px;
                Check {
                    y: 2px;
                    on: SourceUi.auto-download;
                    toggled => { SourceUi.auto-download = !SourceUi.auto-download; }
                }
                VerticalLayout {
                    spacing: 3px;
                    Text {
                        text: "Auto-download playlists";
                        color: Theme.text;
                        font-size: 13px;
                        TouchArea { mouse-cursor: pointer; clicked => { SourceUi.auto-download = !SourceUi.auto-download; } }
                    }
                    Text { text: "The best copy of each song, then the next if one fails."; color: Theme.text-dim; font-size: 11px; wrap: word-wrap; }
                }
            }
        }
    }
    property <length> w-artist: 170px;
    property <length> w-length: 50px;
    property <length> w-format: 54px;
    property <length> w-quality: 74px;
    property <length> w-size: 62px;
    property <length> w-from: 110px;
    VerticalLayout {
        padding: 6px;
        spacing: 4px;
        // Type and press Return: a new search, as set under the cog.
        HorizontalLayout {
            spacing: 6px;
            height: 34px;
            padding-left: 6px;
            padding-right: 6px;
            bar := LineEdit {
                horizontal-stretch: 1;
                font-size: 14px;
                placeholder-text: SourceUi.kind == 1 ? "Search tracks"
                    : SourceUi.kind == 2 ? "Search albums"
                    : SourceUi.kind == 3 ? "Search artists"
                    : SourceUi.kind == 4 ? "Search playlists, or paste a playlist link"
                    : hint != "" ? hint : "Search";
                accepted => { go(); }
                key-pressed(e) => {
                    if e.text == Key.Escape && self.text != "" {
                        self.text = "";
                        return accept;
                    }
                    reject
                }
            }
            Rectangle {
                width: 34px;
                border-radius: 6px;
                background: cog.has-hover ? Theme.n-333336 : Theme.n-2a2a2d;
                Path {
                    width: 16px;
                    height: 16px;
                    viewbox-width: 16;
                    viewbox-height: 16;
                    // Lilac while an option is off its default.
                    stroke: SourceUi.auto-download || SourceUi.kind != 0 ? Theme.accent : cog.has-hover ? Theme.text : Theme.text-dim;
                    stroke-width: 1.4px;
                    fill: transparent;
                    commands: "M 8 5.5 A 2.5 2.5 0 1 1 7.99 5.5 Z M 8 1.5 L 8 3.5 M 8 12.5 L 8 14.5 M 1.5 8 L 3.5 8 M 12.5 8 L 14.5 8 M 3.4 3.4 L 4.8 4.8 M 11.2 11.2 L 12.6 12.6 M 3.4 12.6 L 4.8 11.2 M 11.2 4.8 L 12.6 3.4 M 8 3.5 A 4.5 4.5 0 1 1 7.99 3.5 Z";
                }
                cog := TouchArea { mouse-cursor: pointer; clicked => { options.show(); } }
            }
        }
        HorizontalLayout {
            spacing: 10px;
            height: 32px;
            padding-left: 6px;
            Text { text: SourceUi.title; color: Theme.text; font-size: 15px; font-weight: 600; vertical-alignment: center; overflow: elide; }
            Text { text: SourceUi.summary; color: Theme.text-dim; font-size: 14px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
            if SourceUi.current-search >= 0: HorizontalLayout {
                spacing: 6px;
                if SourceUi.grouped: VerticalLayout {
                    alignment: center;
                    Pill { text: "Tick best of each"; clicked => { SourceUi.pick-best(); } }
                }
                if !SourceUi.grouped: HorizontalLayout {
                    spacing: 6px;
                    for f[i] in ["All", "Tracks", "Albums"]: VerticalLayout {
                    alignment: center;
                        Pill { text: f; on: i == SourceUi.filter; clicked => { SourceUi.set-filter(i); } }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Pill { text: "Lossless only"; on: SourceUi.lossless-only; clicked => { SourceUi.set-lossless-only(!SourceUi.lossless-only); } }
                }
                VerticalLayout {
                    alignment: center;
                    Pill { text: "Search again"; clicked => { SourceUi.search-again(SourceUi.current-search); } }
                }
            }
            if SourceUi.current-search == -1: HorizontalLayout {
                spacing: 6px;
                if SourceUi.failed-count > 0: VerticalLayout {
                    alignment: center;
                    Pill { text: "Retry failed"; clicked => { SourceUi.retry-failed(); } }
                }
                if SourceUi.finished-count > 0: VerticalLayout {
                    alignment: center;
                    Pill { text: "Clear finished"; clicked => { SourceUi.clear-finished(); } }
                }
                if SourceUi.active-count > 0: VerticalLayout {
                    alignment: center;
                    Pill { text: "Cancel all"; clicked => { SourceUi.cancel-downloads(); } }
                }
            }
        }
        if SourceUi.current-search != -2: HorizontalLayout {
            height: 24px;
            spacing: 8px;
            padding-left: 6px;
            padding-right: 14px;
            Rectangle { width: 22px; }
            Rectangle { width: 16px; }
            Text { horizontal-stretch: 1; text: "Title"; color: Theme.text; font-size: 13px; font-weight: 500; }
            Text { width: w-artist; text: "Artist"; color: Theme.text; font-size: 13px; font-weight: 500; }
            Text { width: w-length; text: "Length"; color: Theme.text; font-size: 13px; font-weight: 500; horizontal-alignment: right; }
            Text { width: w-format; text: "Format"; color: Theme.text; font-size: 13px; font-weight: 500; }
            Text { width: w-quality; text: "Quality"; color: Theme.text; font-size: 13px; font-weight: 500; }
            Text { width: w-size; text: "Size"; color: Theme.text; font-size: 13px; font-weight: 500; horizontal-alignment: right; }
            Text { width: w-from; text: "From"; color: Theme.text; font-size: 13px; font-weight: 500; }
            Rectangle { width: SourceUi.current-search == -1 ? 126px : SourceUi.plays ? 162px : 96px; }
        }
        EdgeLine { left: 6px; right: 6px; }
        if SourceUi.notice != "": Rectangle {
            vertical-stretch: 1;
            Text { text: SourceUi.notice; color: Theme.text-dim; font-size: 14px; wrap: word-wrap; horizontal-alignment: center; width: min(parent.width - 40px, 460px); }
        }
        // The source's own page: a sentence, then its figures.
        if SourceUi.current-search == -2 && SourceUi.status-note != "": HorizontalLayout {
            padding: 12px;
            Text { text: SourceUi.status-note; color: Theme.text-dim; font-size: 14px; wrap: word-wrap; }
        }
        if SourceUi.current-search == -2: ListView {
            vertical-stretch: 1;
            for l[i] in SourceUi.status-lines: Rectangle {
                height: l.heading ? 40px : 32px;
                border-radius: 4px;
                background: l.heading ? transparent : mod(i, 2) == 1 ? Theme.row-alt : Theme.row;
                if l.heading: Text {
                    x: 12px;
                    y: parent.height - self.height - 6px;
                    text: l.label;
                    color: Theme.text-dim;
                    font-size: 12px;
                    font-weight: 600;
                    letter-spacing: 0.5px;
                }
                if !l.heading: HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 12px;
                    Text { width: 220px; text: l.label; color: Theme.text-dim; font-size: 14px; vertical-alignment: center; overflow: elide; }
                    Text { horizontal-stretch: 1; text: l.value; color: Theme.text; font-size: 14px; vertical-alignment: center; overflow: elide; }
                }
            }
        }
        if SourceUi.current-search != -2: ListView {
            vertical-stretch: SourceUi.notice != "" ? 0 : 1;
            visible: SourceUi.notice == "";
            for r[i] in SourceUi.rows: Rectangle {
                height: r.kind == 0 ? 30px : r.kind == 1 ? 48px : 32px;
                border-radius: 4px;
                background: r.kind == 1 ? (ta.has-hover ? Theme.n-2e2e33 : Theme.n-26262a)
                    : r.kind == 0 ? transparent
                    : r.checked ? #4a3f6e
                    : ta.has-hover ? Theme.n-2a2a2e : mod(i, 2) == 1 ? Theme.row-alt : Theme.row;
                ta := TouchArea {
                    clicked => {
                        if r.kind == 1 || (r.kind == 0 && r.note != "") { SourceUi.toggle-open(i); }
                    }
                    double-clicked => {
                        if r.kind == 2 && SourceUi.plays && SourceUi.current-search >= 0 {
                            SourceUi.play(i);
                        } else if r.kind == 2 && r.state == 0 {
                            SourceUi.download(i);
                        }
                    }
                }
                // A playlist entry with other copies: an arrow and how many.
                if r.kind == 0 && r.note != "": HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 12px;
                    spacing: 8px;
                    Path {
                        width: 10px;
                        height: 10px;
                        y: (parent.height - self.height) / 2;
                        viewbox-width: 10;
                        viewbox-height: 10;
                        stroke: Theme.text-dim;
                        stroke-width: 1.6px;
                        stroke-line-cap: round;
                        fill: transparent;
                        commands: r.open ? "M 2 3.5 L 5 6.5 L 8 3.5" : "M 3.5 2 L 6.5 5 L 3.5 8";
                    }
                    Text { text: r.title; color: Theme.text-dim; font-size: 12px; font-weight: 600; letter-spacing: 0.5px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    Text { text: r.note; color: ta.has-hover ? Theme.text : Theme.text-dim; font-size: 12px; vertical-alignment: center; }
                }
                if r.kind == 0 && r.note == "": Text {
                    x: 8px;
                    text: r.title;
                    color: Theme.text-dim;
                    font-size: 12px;
                    font-weight: 600;
                    letter-spacing: 0.5px;
                    vertical-alignment: center;
                }
                if r.kind != 0: HorizontalLayout {
                    spacing: 8px;
                    padding-left: 6px;
                    padding-right: 6px;
                    // Only a search's results can be ticked, not the Downloads list.
                    Check {
                        visible: SourceUi.current-search >= 0;
                        on: r.checked;
                        toggled(shift) => { SourceUi.check(i, shift); }
                    }
                    Rectangle {
                        width: 16px;
                        // A folder's disclosure arrow; a file's number in its folder.
                        if r.kind == 1: Path {
                            width: 10px;
                            height: 10px;
                            viewbox-width: 10;
                            viewbox-height: 10;
                            stroke: Theme.text-dim;
                            stroke-width: 1.6px;
                            stroke-line-cap: round;
                            fill: transparent;
                            commands: r.open ? "M 2 3.5 L 5 6.5 L 8 3.5" : "M 3.5 2 L 6.5 5 L 3.5 8";
                        }
                        if r.kind == 2: Text { text: r.depth > 0 ? r.number : "♪"; color: Theme.text-dim; font-size: 12px; }
                    }
                    if r.kind == 1 && r.has-cover: Rectangle {
                        width: 40px;
                        height: 40px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 3px;
                        clip: true;
                        Image { width: 100%; height: 100%; source: r.cover; image-fit: cover; }
                    }
                    if r.kind == 1: VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        Text { text: r.title; color: Theme.text; font-size: 15px; font-weight: 600; overflow: elide; }
                        Text { text: r.artist; color: Theme.text-dim; font-size: 12px; overflow: elide; }
                    }
                    if r.kind == 2: Text {
                        horizontal-stretch: 1;
                        text: r.title;
                        color: Theme.text;
                        font-size: 15px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Text { width: w-artist; text: r.kind == 2 ? r.artist : ""; color: Theme.text; font-size: 15px; vertical-alignment: center; overflow: elide; }
                    Text { width: w-length; text: r.length; color: Theme.text; font-size: 15px; vertical-alignment: center; horizontal-alignment: right; }
                    Rectangle {
                        width: w-format;
                        if r.format != "": Rectangle {
                            x: 0;
                            width: ft.preferred-width + 12px;
                            height: 18px;
                            border-radius: 4px;
                            background: Theme.n-2d2d33;
                            ft := Text { text: r.format; color: r.format == "FLAC" || r.format == "WAV" || r.format == "AIFF" || r.format == "ALAC" ? #cfc4ff : Theme.n-bbbbbb; font-size: 11px; font-weight: 700; }
                        }
                    }
                    Text { width: w-quality; text: r.quality; color: Theme.text-dim; font-size: 14px; vertical-alignment: center; overflow: elide; }
                    Text { width: w-size; text: r.size; color: Theme.text-dim; font-size: 14px; vertical-alignment: center; horizontal-alignment: right; }
                    // Who shares it, or why its download failed.
                    Text { width: w-from; text: r.state == 4 && r.note != "" ? r.note : r.from; color: r.state == 4 || r.preview == 3 ? #ff6b5e : Theme.text-dim; font-size: 14px; vertical-alignment: center; overflow: elide; }
                    if SourceUi.plays && SourceUi.current-search >= 0: CacheButtons {
                        r: r;
                        play => { SourceUi.play(i); }
                        cache => { SourceUi.cache(i); }
                    }
                    if SourceUi.previews && SourceUi.current-search >= 0: Rectangle {
                        width: 26px;
                        if r.kind == 2: PreviewButton {
                            y: (parent.height - self.height) / 2;
                            state: r.preview;
                            clicked => { SourceUi.preview-row(i); }
                        }
                    }
                    RowButton { r: r; clicked => { SourceUi.download(i); } }
                    // On the Downloads list: take it off, stopping it if it's going.
                    if SourceUi.current-search == -1: Rectangle {
                        width: 22px;
                        height: 22px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 11px;
                        background: xta.has-hover ? Theme.n-3a3a3d : transparent;
                        CloseIcon { size: 9px; color: xta.has-hover ? #ff6b5e : Theme.text-dim; }
                        xta := TouchArea { mouse-cursor: pointer; clicked => { SourceUi.remove-download(i); } }
                    }
                }
            }
        }
        // Ticked rows download together.
        if SourceUi.selected-count > 0: Rectangle {
            height: 44px;
            border-radius: 6px;
            background: #2a2533;
            border-width: 1px;
            border-color: #4a3f6e;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 10px;
                spacing: 12px;
                Text { text: SourceUi.selected-count + " selected"; color: Theme.text; font-size: 14px; font-weight: 600; vertical-alignment: center; }
                Text { text: SourceUi.selected-summary; color: Theme.text-dim; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; }
                if SourceUi.plays: VerticalLayout {
                    alignment: center;
                    Pill { text: "Download"; clicked => { SourceUi.cache-selected(); } }
                }
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: 28px;
                        width: dl.preferred-width + 28px;
                        border-radius: 14px;
                        background: dta.has-hover ? Theme.accent.brighter(0.15) : Theme.accent;
                        dl := Text { text: SourceUi.plays ? "+ Add to Collection" : "↓ Download selected"; color: Theme.on-selection; font-size: 13px; font-weight: 700; }
                        dta := TouchArea { mouse-cursor: pointer; clicked => { SourceUi.download-selected(); } }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Pill { text: "Clear"; clicked => { SourceUi.clear-selection(); } }
                }
            }
        }
    }
}

// A source that isn't set up yet: its settings, as on Settings › Sources,
// in the middle of its panel, like the streaming services' sign-in card.
export component SourceSetup inherits Rectangle {
    in property <string> source-name;
    background: Theme.panel;
    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                width: 420px;
                spacing: 10px;
                Text { text: "Set up " + source-name; color: Theme.text; font-size: 15px; font-weight: 600; horizontal-alignment: center; }
                if SourceUi.setup-intro != "": Text { text: SourceUi.setup-intro; color: Theme.text-dim; font-size: 13px; horizontal-alignment: center; wrap: word-wrap; }
                for field in SourceUi.setup: VerticalLayout {
                    spacing: 4px;
                    Text { text: field.title; color: Theme.text-dim; font-size: 12px; }
                    LineEdit {
                        text: field.value;
                        input-type: field.secret ? InputType.password : InputType.text;
                        edited(text) => { SourceUi.setup-typed(field.key, text); }
                    }
                    if field.detail != "": Text { text: field.detail; color: Theme.text-dim; font-size: 11px; wrap: word-wrap; }
                }
                Rectangle {
                    height: 32px;
                    border-radius: 16px;
                    background: connect.pressed ? Theme.lilac-dim : Theme.lilac;
                    Text { text: "Connect"; color: #000000; font-size: 13px; font-weight: 700; }
                    connect := TouchArea { mouse-cursor: pointer; clicked => { SourceUi.setup-connect(); } }
                }
                if SourceUi.setup-status != "": Text { text: SourceUi.setup-status; color: Theme.text; font-size: 13px; horizontal-alignment: center; wrap: word-wrap; }
                Text {
                    text: "Download folder and cache: Settings › Sources";
                    color: more.has-hover ? Theme.text : Theme.text-dim;
                    font-size: 12px;
                    horizontal-alignment: center;
                    more := TouchArea { mouse-cursor: pointer; clicked => { SourceUi.open-settings(); } }
                }
            }
        }
    }
}
