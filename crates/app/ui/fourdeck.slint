// The 4-Deck layout, after djay Pro's Four Decks: four strips side by side,
// decks 3, 1, 2 and 4 from the left, each with its header, a small mixer
// channel, PLAY, CUE, the loop and pads. Under them a bar with each deck's
// crossfader side, SYNC and tempo either side of the crossfader; the FX
// are in the FX bar under that.
// A two-deck controller (the DDJ-FLX4) plays decks 1 and 2 until a strip's
// deck number is clicked: then that side plays deck 3 or 4.
import { TrackDrag } from "library.slint";
import { Theme } from "theme.slint";
import { ControlButton, ControlFader, Controls, Crossfader, CueHeadphones, StereoMeter, SyncButton } from "controls.slint";
import { DeckInfo, Header, LoopStepper, Pads, PlayButton, TempoStep } from "deck.slint";
import { AudioSettings, Knob, ModeMenu, SideKnob } from "mixer.slint";

// Which side of the crossfader a deck is on, as Mixxx's `orientation`:
// 0 left, 1 thru (not faded), 2 right. Click to pick, as in djay.
component CrossfaderAssign inherits Rectangle {
    in property <int> deck;
    property <string> group: "[Channel" + (deck + 1) + "]";
    property <int> index: Controls.resolve(group, "orientation");
    property <int> side: Controls.value(index, Controls.tick);
    property <[string]> names: ["LEFT", "THRU", "RIGHT"];
    // Dimmed while the crossfader is switched off; the choice stays.
    property <int> enabled-index: Controls.resolve("[Mixer]", "crossfader_enabled");
    width: 64px;
    opacity: Controls.value(enabled-index, Controls.tick) > 0 ? 1 : 0.35;
    HorizontalLayout {
        alignment: start;
        spacing: 3px;
        Text {
            text: names[side];
            color: side == 0 ? Theme.cue : side == 2 ? Theme.lilac : Theme.text-dim;
            font-size: 12px;
            font-weight: 700;
            vertical-alignment: center;
        }
        Path {
            width: 8px;
            height: 5px;
            y: (parent.height - self.height) / 2;
            commands: "M 0 0 L 4 4 L 8 0";
            stroke: ta.has-hover ? Theme.text : Theme.text-dim;
            stroke-width: 1.4px;
            fill: transparent;
        }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { menu.show(); } }
    menu := PopupWindow {
        x: 0px;
        y: root.height + 4px;
        width: 220px;
        close-policy: close-on-click-outside;
        Rectangle {
            background: Theme.panel-raised;
            border-radius: Theme.radius + 4px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 12px;
            drop-shadow-color: #000000a0;
        }
        VerticalLayout {
            padding: 12px;
            spacing: 8px;
            Text { text: "Deck " + (deck + 1); color: Theme.text; font-size: 15px; font-weight: 700; }
            Text { text: "Crossfader Assignment"; color: Theme.text-dim; font-size: 12px; }
            HorizontalLayout {
                height: 28px;
                spacing: 1px;
                for name[i] in ["Left", "Thru", "Right"]: Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 4px;
                    background: i == side ? Theme.accent : ita.has-hover ? #3a3a3d : Theme.control;
                    Text { text: name; color: i == side ? Theme.on-selection : Theme.text; font-size: 12px; font-weight: 600; }
                    ita := TouchArea {
                        clicked => {
                            Controls.set-value(index, i);
                            menu.close();
                        }
                    }
                }
            }
        }
    }
}

// One deck's strip.
export component DeckStrip inherits Rectangle {
    in property <int> deck;
    in property <DeckInfo> info;
    in property <image> overview;
    out property <length> overview-width: header.overview-width;
    out property <length> overview-height: header.overview-height;
    property <string> group: "[Channel" + (deck + 1) + "]";
    property <color> tint: Theme.deck-color(deck);
    // A two-deck controller's left side plays deck 1 or 3, its right side
    // deck 2 or 4, as `[Controller],deck3` and `deck4` say. Clicking a deck's
    // number moves that side to it; the number is lit on the deck the side
    // plays while a controller is connected.
    property <int> layer-index: Controls.resolve("[Controller]", Math.mod(deck, 2) == 0 ? "deck3" : "deck4");
    property <bool> layer-on: Controls.value(layer-index, Controls.tick) > 0;
    property <bool> controller-here: AudioSettings.controllers != "None" && (deck >= 2) == layer-on;
    // Tracks dragged from the browser load here, as on the other layouts.
    // First, so the sampler pads' own drop areas sit above it.
    drop := DropArea {
        can-drop(e) => { TrackDrag.accepts(e.data) ? DragAction.copy : DragAction.none }
        dropped(e) => {
            TrackDrag.drop(deck, e.data);
            TrackDrag.active = false;
            DragAction.copy
        }
    }
    VerticalLayout {
        spacing: 1px;
        header := Header {
            deck: deck;
            info: info;
            overview: overview;
            group: group;
            compact: true;
            number-lit: controller-here;
            number-clicked => { Controls.set-value(layer-index, deck >= 2 ? 1 : 0); }
        }
        Rectangle {
            background: Theme.panel;
            vertical-stretch: 1;
            VerticalLayout {
                padding: 6px;
                spacing: 6px;
                // The channel: the knob mode and headphone cue, the EQs (or
                // stems or sculpt), the fader, and gain over the meter.
                HorizontalLayout {
                    height: 74px;
                    spacing: 4px;
                    VerticalLayout {
                        width: 44px;
                        alignment: space-around;
                        Rectangle {
                            height: 22px;
                            border-radius: 6px;
                            background: #2a2a2d;
                            ModeMenu { width: parent.width; height: parent.height; }
                        }
                        HorizontalLayout { alignment: center; CueHeadphones { group: group; tint: tint; width: 30px; } }
                    }
                    for place in 4: SideKnob { deck: deck; place: [2, 1, 0, 3][place]; size: 32px; cfx-arrow-left: false; horizontal-stretch: 1; min-width: 40px; }
                    ControlFader { group: group; key: "volume"; tint: tint; ticks: 5; width: 40px; }
                    VerticalLayout {
                        spacing: 4px;
                        Knob { group: group; key: "pregain"; size: 20px; }
                        HorizontalLayout { alignment: center; vertical-stretch: 1; StereoMeter { group: group; } }
                    }
                }
                // PLAY, CUE and the loop.
                HorizontalLayout {
                    spacing: 6px;
                    PlayButton { group: group; tint: tint; width: 52px; height: 32px; }
                    ControlButton { group: group; key: "cue_default"; text: "CUE"; momentary: true; tint: tint; outline-when-lit: true; font-size: 13px; horizontal-stretch: 1; height: 32px; }
                    VerticalLayout {
                        spacing: 2px;
                        horizontal-stretch: 1;
                        LoopStepper { group: group; info: info; height: 32px; }
                        Text { text: "LOOP"; color: Theme.text-dim; font-size: 9px; font-weight: 600; letter-spacing: 0.5px; horizontal-alignment: center; }
                    }
                }
                Pads { deck: deck; group: group; info: info; vertical-stretch: 1; min-height: 77px; }
            }
        }
    }

    if TrackDrag.active || drop.has-drag: Rectangle {
        border-radius: Theme.radius + 2px;
        border-width: drop.has-drag ? 3px : 2px;
        border-color: drop.has-drag ? tint : tint.transparentize(0.55);
        background: drop.has-drag ? tint.transparentize(0.9) : transparent;
    }
}

// The tempo under its BPM: a click opens key lock, quantize and a reset.
component TempoMenu inherits Rectangle {
    in property <string> group;
    in property <string> rate;
    in property <color> tint;
    property <int> rate-index: Controls.resolve(group, "rate");
    height: 14px;
    HorizontalLayout {
        alignment: center;
        spacing: 3px;
        Text { text: rate; color: ta.has-hover ? Theme.text : Theme.text-dim; font-size: 10px; vertical-alignment: center; }
        Path {
            width: 6px;
            height: 4px;
            y: (parent.height - self.height) / 2;
            commands: "M 0 0 L 3 3.5 L 6 0";
            stroke: ta.has-hover ? Theme.text : Theme.text-dim;
            stroke-width: 1.2px;
            fill: transparent;
        }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { menu.show(); } }
    menu := PopupWindow {
        x: (root.width - 130px) / 2;
        y: root.height + 4px;
        width: 130px;
        close-policy: close-on-click-outside;
        Rectangle {
            background: Theme.panel-raised;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 12px;
            drop-shadow-color: #000000a0;
        }
        VerticalLayout {
            padding: 8px;
            spacing: 6px;
            ControlButton { group: group; key: "keylock"; text: "KEY LOCK"; tint: tint; fill-when-lit: true; font-size: 11px; height: 26px; }
            ControlButton { group: group; key: "quantize"; text: "QUANTIZE"; tint: tint; fill-when-lit: true; font-size: 11px; height: 26px; }
            Rectangle {
                height: 26px;
                border-radius: Theme.radius;
                background: rta.pressed ? Theme.control-pressed : rta.has-hover ? #1d1d20 : Theme.control;
                border-width: 1px;
                border-color: Theme.border;
                Text { text: "RESET TEMPO"; color: Theme.text; font-size: 11px; font-weight: 700; }
                rta := TouchArea {
                    clicked => {
                        Controls.set-value(rate-index, 0);
                        menu.close();
                    }
                }
            }
        }
    }
}

// One deck's part of the bar under the strips: which side of the
// crossfader it is on, SYNC, the BPM and tempo, and fine + and −. Decks 2
// and 4 have the crossfader side last, towards the outside.
component DeckBarSection inherits Rectangle {
    in property <int> deck;
    in property <DeckInfo> info;
    property <string> group: "[Channel" + (deck + 1) + "]";
    property <color> tint: Theme.deck-color(deck);
    property <bool> right: Math.mod(deck, 2) == 1;
    background: Theme.panel;
    horizontal-stretch: 1;
    min-width: 0px;
    preferred-width: 0px;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 22px;
        alignment: start;
        if !right: CrossfaderAssign { deck: deck; }
        SyncButton { group: group; tint: tint; menu-right-aligned: right; font-size: 12px; width: 60px; height: 28px; y: (parent.height - self.height) / 2; }
        VerticalLayout {
            width: 52px;
            alignment: center;
            Text { text: info.loaded ? info.bpm : "--"; color: Theme.text; font-size: 14px; font-weight: 600; horizontal-alignment: center; }
            TempoMenu { group: group; rate: info.rate; tint: tint; }
        }
        VerticalLayout {
            alignment: center;
            TempoStep { group: group; key: "rate_perm_up_small"; text: "+"; tint: tint; height: 18px; }
            TempoStep { group: group; key: "rate_perm_down_small"; text: "−"; tint: tint; height: 18px; }
        }
        if right: CrossfaderAssign { deck: deck; }
    }
}

// 4-Deck: the bar under the strips, decks 3, 1 | the crossfader | 2, 4,
// the middle as wide as the Beat FX under it. The crossfader's ▾ (or a
// right-click) switches it off and on.
export component FourDeckBar inherits Rectangle {
    in property <[DeckInfo]> decks;
    property <int> enabled-index: Controls.resolve("[Mixer]", "crossfader_enabled");
    property <bool> on: Controls.value(enabled-index, Controls.tick) > 0;
    background: #000000;
    height: 48px;
    HorizontalLayout {
        spacing: 1px;
        DeckBarSection { deck: 2; info: decks[2]; }
        DeckBarSection { deck: 0; info: decks[0]; }
        Rectangle {
            background: Theme.panel;
            width: 282px;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 10px;
                spacing: 10px;
                VerticalLayout { alignment: center; horizontal-stretch: 1; Crossfader { } }
                Rectangle {
                    width: 22px;
                    height: 22px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 11px;
                    background: xta.has-hover ? #48484c : #3a3a3d;
                    Path {
                        width: 8px;
                        height: 5px;
                        commands: "M 0 0 L 4 4 L 8 0";
                        stroke: Theme.text;
                        stroke-width: 1.4px;
                        fill: transparent;
                    }
                    xta := TouchArea { mouse-cursor: pointer; clicked => { xmenu.show(); } }
                    xmenu := PopupWindow {
                        x: parent.width - 150px;
                        y: parent.height + 4px;
                        width: 150px;
                        close-policy: close-on-click-outside;
                        Rectangle {
                            background: Theme.panel-raised;
                            border-radius: Theme.radius;
                            border-width: 1px;
                            border-color: Theme.border;
                            drop-shadow-blur: 12px;
                            drop-shadow-color: #000000a0;
                        }
                        VerticalLayout {
                            padding: 5px;
                            Rectangle {
                                height: 26px;
                                border-radius: 4px;
                                background: ita.has-hover ? #3a3a3d : transparent;
                                Text { x: 8px; text: on ? "Turn crossfader off" : "Turn crossfader on"; color: Theme.text; font-size: 12px; vertical-alignment: center; height: parent.height; }
                                ita := TouchArea {
                                    clicked => {
                                        Controls.toggle(enabled-index);
                                        xmenu.close();
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        DeckBarSection { deck: 1; info: decks[1]; }
        DeckBarSection { deck: 3; info: decks[3]; }
    }
}
