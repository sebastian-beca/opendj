// The guided tour: the setup dialog (audio, controller, library), the
// tips a lesson shows over the app, and the offer of the tour to a DJ who
// had openDJ before it. The app (tour.rs) runs it through Tour and
// TourSetup; the settings rows in the dialog are the Settings pages' own,
// so they work as they do there.
import { Theme } from "theme.slint";
import { Tour } from "tourmark.slint";
import { PrefItem, PrefRow, Button, CloseButton, ImportWizard, ImportWizardDialog } from "preferences.slint";

export { Tour }

export global TourSetup {
    // The parts down the dialog's left, and the one showing.
    in property <[string]> parts;
    in property <int> part;
    in property <string> title;
    in property <string> body;
    in property <[PrefItem]> items;
    // A quieter way on beside Next, such as "Not now"; none when "".
    in property <string> skip-label;
}

// A part's place down the left: a dot, a tick once passed.
component PartRow inherits Rectangle {
    in property <string> name;
    in property <bool> current;
    in property <bool> passed;
    height: 32px;
    HorizontalLayout {
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 18px;
                height: 18px;
                border-radius: 9px;
                border-width: current || passed ? 0px : 1.5px;
                border-color: Theme.text-dim;
                background: current ? Theme.lilac : passed ? Theme.lilac.with-alpha(0.35) : transparent;
                if passed: Path {
                    width: 10px;
                    height: 8px;
                    viewbox-width: 10;
                    viewbox-height: 8;
                    commands: "M 1 4 L 4 7 L 9 1";
                    stroke: Theme.text;
                    stroke-width: 1.6px;
                    fill: transparent;
                }
            }
        }
        Text {
            text: name;
            color: current ? Theme.text : Theme.text-dim;
            font-size: 13px;
            font-weight: current ? 600 : 400;
            vertical-alignment: center;
        }
    }
}

// The setup dialog: the parts down the left, the part's words and settings
// rows on the right, Back, Skip and Next along the bottom.
export component TourSetupDialog inherits Rectangle {
    background: #000000a0;
    // The app behind waits; clicks there do nothing.
    TouchArea { }
    Rectangle {
        width: min(820px, root.width - 64px);
        height: min(580px, root.height - 64px);
        border-radius: 12px;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 40px;
        drop-shadow-color: #000000c0;
        clip: true;
        HorizontalLayout {
            Rectangle {
                width: 200px;
                background: #141416;
                VerticalLayout {
                    padding: 20px;
                    spacing: 4px;
                    HorizontalLayout {
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            Image { source: @image-url("icons/opendj-mark.svg"); width: 26px; height: 16px; }
                        }
                        Text { text: "openDJ"; color: Theme.text; font-family: Theme.brand-font; font-size: 17px; vertical-alignment: center; }
                    }
                    Rectangle { height: 18px; }
                    for name[i] in TourSetup.parts: PartRow {
                        name: name;
                        current: i == TourSetup.part;
                        passed: i < TourSetup.part;
                    }
                    Rectangle { vertical-stretch: 1; }
                }
            }
            Rectangle { width: 1px; background: Theme.separator; }
            VerticalLayout {
                horizontal-stretch: 1;
                padding: 24px;
                padding-bottom: 18px;
                spacing: 8px;
                HorizontalLayout {
                    Text {
                        text: TourSetup.title;
                        color: Theme.text;
                        font-size: 22px;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    VerticalLayout {
                        alignment: center;
                        CloseButton { clicked => { Tour.end(); } }
                    }
                }
                if TourSetup.body != "": Text {
                    text: TourSetup.body;
                    color: Theme.text-dim;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                Rectangle { height: 4px; }
                Flickable {
                    vertical-stretch: 1;
                    content-height: rows.preferred-height;
                    rows := VerticalLayout {
                        width: parent.width;
                        padding-right: 8px;
                        alignment: start;
                        for item in TourSetup.items: PrefRow { item: item; }
                    }
                }
                HorizontalLayout {
                    padding-top: 12px;
                    spacing: 8px;
                    if Tour.can-back: Button {
                        text: "Back";
                        clicked => { Tour.back(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    if TourSetup.skip-label != "": Button {
                        text: TourSetup.skip-label;
                        clicked => { Tour.skip(); }
                    }
                    Button {
                        text: Tour.next-label;
                        primary: true;
                        clicked => { Tour.next(); }
                    }
                }
            }
        }
    }
    // Set up… on a library to import opens the import's own steps.
    if ImportWizard.open: ImportWizardDialog { }
}

// A small text button, for the tip's quieter choices.
component LinkButton inherits Rectangle {
    in property <string> text;
    callback clicked();
    height: 26px;
    width: label.preferred-width + 12px;
    border-radius: 4px;
    background: ta.has-hover ? #ffffff10 : transparent;
    label := Text {
        text: root.text;
        color: ta.has-hover ? Theme.text : Theme.text-dim;
        font-size: 12px;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A lesson's tip, beside the control it points at (under it when there is
// room, else over it), or near the top in the middle when it points at
// nothing. Only the tip takes clicks: the app stays in reach.
export component TourTip inherits Rectangle {
    property <length> gap: 14px;
    property <length> tip-width: 320px;
    property <bool> pointing: Tour.target != "" && Tour.placed;
    property <length> below: Tour.target-y + Tour.target-height + gap - root.absolute-position.y;
    property <length> above: Tour.target-y - gap - card.height - root.absolute-position.y;
    property <bool> fits-below: below + card.height < root.height - 12px;
    card := Rectangle {
        width: tip-width;
        height: content.preferred-height;
        x: pointing
            ? clamp(Tour.target-x + Tour.target-width / 2 - self.width / 2 - root.absolute-position.x, 12px, root.width - self.width - 12px)
            : (root.width - self.width) / 2;
        y: pointing ? (fits-below ? below : max(12px, above)) : 96px;
        background: Theme.panel-raised;
        border-radius: 10px;
        border-width: 1px;
        border-color: Tour.done ? #4cd07d : Theme.lilac;
        drop-shadow-blur: 20px;
        drop-shadow-color: #000000c0;
        TouchArea { }
        content := VerticalLayout {
            padding: 16px;
            padding-bottom: 12px;
            spacing: 6px;
            HorizontalLayout {
                Text { text: Tour.step; color: Theme.lilac; font-size: 11px; font-weight: 600; letter-spacing: 0.4px; vertical-alignment: center; horizontal-stretch: 1; }
                CloseButton { clicked => { Tour.end(); } }
            }
            Text { text: Tour.title; color: Theme.text; font-size: 16px; font-weight: 700; wrap: word-wrap; }
            Text { text: Tour.body; color: Theme.text-dim; font-size: 13px; wrap: word-wrap; }
            if Tour.action != "": HorizontalLayout {
                alignment: start;
                padding-top: 4px;
                Button { text: Tour.action; clicked => { Tour.action-pressed(); } }
            }
            HorizontalLayout {
                padding-top: 8px;
                spacing: 6px;
                if Tour.can-back: LinkButton { text: "Back"; clicked => { Tour.back(); } }
                Rectangle { horizontal-stretch: 1; }
                if Tour.done: Text { text: "✓ Nice"; color: #4cd07d; font-size: 12px; font-weight: 600; vertical-alignment: center; }
                if Tour.waiting && !Tour.done: Text { text: "Your turn"; color: Theme.text-dim; font-size: 12px; vertical-alignment: center; }
                if Tour.waiting && !Tour.done: LinkButton { text: "Skip"; clicked => { Tour.next(); } }
                if !Tour.waiting: Button { text: Tour.next-label; primary: true; clicked => { Tour.next(); } }
            }
        }
    }
}

// The tour offered once, under the top bar, to a DJ who used openDJ before
// it came: take it, or ✕ for never.
export component TourOffer inherits Rectangle {
    width: row.preferred-width;
    height: 40px;
    background: Theme.panel-raised;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.lilac;
    drop-shadow-blur: 12px;
    drop-shadow-color: #000000a0;
    row := HorizontalLayout {
        padding-left: 14px;
        padding-right: 6px;
        spacing: 12px;
        Text {
            text: "New: a guided tour of openDJ";
            color: Theme.text;
            font-size: 13px;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: take-text.preferred-width + 22px;
                height: 26px;
                background: take.has-hover ? Theme.lilac.brighter(0.15) : Theme.lilac;
                border-radius: 13px;
                take-text := Text { text: "Take the tour"; color: #000000; font-size: 12px; font-weight: 600; }
                take := TouchArea { mouse-cursor: pointer; clicked => { Tour.start(-1); } }
            }
        }
        VerticalLayout {
            alignment: center;
            CloseButton { clicked => { Tour.dismiss-offer(); } }
        }
    }
}
