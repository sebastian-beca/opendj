// Browser: folder tree, track list and a side panel (Automix / Sidelist).
// Plain rows, lilac selection, rounded sidebar items.
import { LineEdit } from "std-widgets.slint";
import { ListView, ScrollView } from "scroll.slint";
import { Theme, EdgeLine, CloseIcon } from "theme.slint";
import { HoverTip } from "controls.slint";
import { SourceUi, SearchesPanel, SourceResults, SourceSetup } from "sources.slint";
import { InstrumentsPanel } from "instruments.slint";
import { InfoPanel, TrackInfo } from "info.slint";
import { CuesPanel, CueList } from "cues.slint";
import { ChecklistPanel } from "checklist.slint";
import { LyricsPanel } from "lyrics.slint";
import { NowPlayingView } from "nowplaying.slint";
import { PageView, PageUi } from "pages.slint";
import { FilterBar, FilterUi, SuggestionList } from "filters.slint";
import { CrateIcon, CrateColors } from "crate_icon.slint";
import { TourMark } from "tourmark.slint";

export struct Folder {
    name: string,
    depth: int,
    // 0 = leaf, 1 = collapsed, 2 = expanded
    children: int,
    // 0 = collection, 1 = list folder, 2 = playlist, 3 = smart list, 4 = liked songs
    // or Wanted, 5 = history session, 6 = Bandcamp (in the stores list),
    // 17 = crate, 18 = the Crates or Playlists heading, 19 = a history day, and in Files
    // 1 = folder, 7 = drive, 8 = pinned folder, 9 = cloud drive
    kind: int,
    // Drawn with a line above it.
    separator: bool,
    // One of the DJ's own lists or folders: it can be renamed, deleted and
    // (a list) have tracks dropped on it.
    editable: bool,
    // 10 = inbox, 11 = triage (the collection stage is 0).
    // A stage (Inbox, Triage, Collection, or a crate in one): tracks
    // dropped on it move there.
    stage: bool,
    // How many tracks a stage has, shown after its name; -1 for none.
    count: int,
    // Holds library tracks, so its menu offers Analyze All.
    analysable: bool,
    // A crate's color, an index into LibraryEdit.list-colors; -1 for none.
    color: int,
    // A crate's icon: 0 = crate, then star, heart, flame, bolt, moon, sun,
    // leaf (LIST_ICONS in the library).
    icon: int,
    // Shown dimmed: a history set of a single song.
    dim: bool,
    // Another app's imported list or folder (or the Imported heading):
    // read-only, since its next import makes it again.
    locked: bool,
    // A list or folder of an import: its menu offers Make These Lists Mine.
    adoptable: bool,
    // An album downloaded into the Inbox: its menu offers Move to Albums.
    bundle: bool,
}

export struct TrackRow {
    title: string,
    artist: string,
    album: string,
    genre: string,
    length: string,
    bpm: string,
    key: string,
    rating: int,
    // -1 = not loaded, else the deck it is loaded on (0 is deck 1)
    deck: int,
    // False for a streaming track that isn't in the collection, so can't play.
    available: bool,
    // In the library, but its file is not on disk (moved or deleted).
    missing: bool,
    // Album art thumbnail, once found.
    cover: image,
    has-cover: bool,
    // The color the DJ gave the track: a dot in the Color column, a strip
    // at the row's edge or a tint, as `ColumnUi.color-mode` says.
    color: color,
    has-color: bool,
    // A store result rather than a track: what activating it does, shown
    // as a button ("Buy", "Search", "Get"). Empty for tracks.
    action: string,
    // What each column in `ColumnUi.columns` shows, in the same order.
    cells: [string],
    // Its key mixes harmonically with the track playing now.
    key-match: bool,
    // Or would, shifted by this many semitones (0: no shift within reach).
    key-shift: int,
    // Its mini waveform, a white image colored by the list: only rows in
    // view have one, and only once the track is analysed.
    wave: image,
    has-wave: bool,
    // Queued for analysis: 1 waiting, 2 being analysed; 0 neither.
    analysing: int,
    // Shown dimmed: a duplicate copy that a fix would merge away.
    fade: bool,
    // A streaming service's track (in a streaming playlist, or standing in
    // an imported list): which collection track it is can be changed.
    streamed: bool,
    // Where a new set starts in a day of history: a line above it.
    set-start: bool,
}

// One of the track list's columns. kind: 0 text, 1 the title (takes the
// room left), 2 rating stars, 3 key, 4 quieter text, 5 tag words, 6 the
// mini waveform.
export struct ListColumn {
    id: int,
    label: string,
    width: length,
    right: bool,
    kind: int,
}

// The track list's columns: right-click the header to pick them, drag a
// column's right edge to resize it, drag its heading to move it.
export global ColumnUi {
    in property <[ListColumn]> columns;
    // How wide the columns need the list to be, with room for the title.
    in property <length> min-width;
    // Every column the header's menu offers, and which are shown.
    in property <[string]> all;
    in property <[bool]> all-shown;
    callback toggle(index: int);
    callback reset();
    // `column` is an index into `columns`.
    callback resize(column: int, width: length);
    // A resize finished: keep the widths.
    callback resized();
    // A heading dropped at `x` along a header `header` wide.
    callback move(column: int, x: length, header: length);
    // A heading is being dragged: Rust sets `drop-x` to where it would land
    // along the header, or below zero when it would stay put.
    callback drag(column: int, x: length, header: length);
    in-out property <length> drop-x: -1px;
    // The rows in view, so Rust gives just those their mini waveforms.
    in-out property <int> first-shown;
    in-out property <int> shown-count;
    // How track colors show (Settings › Appearance › Track color): 0 a dot
    // in the Color column, 1 a strip at the row's left edge, 2 the row
    // tinted, 3 not at all.
    in property <int> color-mode;
    // Settings picked a way to show them.
    callback set-color-mode(mode: int);
}

// The order of the rail's sources after Collection, by source number:
// openDJ's own, then the services and add-ons. Dragged in the "•••" menu.
export global RailOrder {
    in property <[int]> built-in: [1, 9, 10, 12];
    in property <[int]> external: [2, 3, 4, 8, 11];
    // Moves source `source` this many places along its section.
    callback moved(source: int, steps: int);
}

// One side panel tab in the chooser that its titles' right-click opens.
export struct SideTab {
    name: string,
    // The tab's number, as SidePanel's `tab` has it (Lyrics is 6).
    i: int,
    on: bool,
    // Its row in the chooser in the Prep layout, and out of it (-1: not
    // listed there, as Cues and Checklist outside Prep).
    pos: int,
    pos-plain: int,
}

// Which side panel tabs show, and in what order; kept in settings.json.
export global SideTabs {
    // Every tab, in the order the DJ put them.
    in property <[SideTab]> tabs;
    // How many tabs the chooser lists in Prep and out of it, and how many
    // of those are on: the last one on can't be switched off.
    in property <int> listed;
    in property <int> listed-plain;
    in property <int> on-count;
    in property <int> on-count-plain;
    callback toggled(tab: int);
    // Moves tab `tab` this many rows down the chooser (up when negative).
    callback moved(tab: int, steps: int);
    callback reset();
}

export struct SideRow {
    // A section heading in the Linked tab ("Linked", "Played with")
    // instead of a track, when not empty.
    heading: string,
    title: string,
    artist: string,
    bpm: string,
    key: string,
    length: string,
    cover: image,
    has-cover: bool,
    // Its key mixes harmonically with the track playing now.
    key-match: bool,
    // Or would, shifted by this many semitones (0: no shift within reach).
    key-shift: int,
    // One of Keep going's next picks, shown greyed after Up Next's tracks.
    suggested: bool,
    // The mix into this track when picked on its row ("32 bars · Cut"),
    // empty when it follows the panel's LENGTH and STYLE; the picks as
    // 0 for the panel's, else 1 + the index into the panel's menus.
    mix: string,
    mix-length: int,
    mix-style: int,
}

// Up Next in Player mode (browser/up_next.rs, now_playing_view.rs): the
// track playing on top, and the mix into each row.
export global UpNextUi {
    in property <bool> now-loaded;
    in property <string> now-title;
    in property <string> now-artist;
    in property <image> now-cover;
    in property <bool> now-has-cover;
    in property <string> now-initials;
    in property <color> now-tint: #5b3fd1;
    // Picks the mix into Up Next's row: 0 for the panel's, else 1 + the index.
    callback set-mix(row: int, length: int, style: int);
}

// Keep going in Player mode (browser/keep_going.rs): Up Next tops itself
// up with tracks that mix, from a pool; Start Radio sets the pool.
export global KeepGoingUi {
    in property <bool> on;
    // Player mode, where Keep going and Start Radio are offered.
    in property <bool> player;
    // What picks come from: "Everything", a list's or an artist's name.
    in property <string> pool;
    // The list the browser shows, offered as a pool; empty for none.
    in property <string> list-name;
    callback set-on(bool);
    // 0 everything, 1 the list the browser shows.
    callback pick-pool(int);
    // From the track menu: the row's track, or its artist.
    callback start-radio(row: int, artist: bool);
    // From the list menu: a crate or playlist, by its place in the tree.
    callback start-list-radio(node: int);
}

// Dragging tracks between the list, the side panel, the decks and the
// DJ's lists. The payload names the rows dragged, `first` to `last` (a deck
// takes the first), or the deck whose cover was picked up; files dragged in
// from Finder or a file manager are accepted too.
export global TrackDrag {
    // True while a track from the list is being dragged, so every deck can
    // show that it accepts drops.
    in-out property <bool> active;
    pure callback payload(first: int, last: int) -> data-transfer;
    // Rows of the side panel's tab `tab`.
    pure callback side-payload(tab: int, first: int, last: int) -> data-transfer;
    // The track on a deck, picked up by its cover.
    pure callback deck-payload(deck: int) -> data-transfer;
    pure callback accepts(data: data-transfer) -> bool;
    callback drop(deck: int, data: data-transfer);
    // Dropped on the Player bar: the first track plays now, the rest
    // straight after it.
    callback drop-player(data: data-transfer);
    // Dropped on the side panel's list, to go in before `index`.
    callback drop-side(index: int, data: data-transfer);
    // Files dragged in from Finder or a file manager. The system tells the
    // window where the cursor is (in window coordinates) rather than handing
    // the files to a drop area, so each deck checks `files-x` and `files-y`
    // itself: it lights up while `files-over`, and the one under the cursor
    // asks for the files with `drop-files` when `files-dropped` counts up.
    in property <bool> files-over;
    in property <length> files-x: -1px;
    in property <length> files-y: -1px;
    in property <int> files-dropped;
    callback drop-files(deck: int);
}

// One of the DJ's lists in the track menu's side panel.
export struct MenuListRow {
    // Its place in the app's list of lists, passed back when picked.
    index: int,
    name: string,
    // The folders it is in; empty at the top.
    folder: string,
    is-crate: bool,
}

// Editing the library: lists and folders, and ratings.
// A tag the track menu's Add Tag offers: the tag, the tag field it goes
// in (its id, "tag1", and the name the DJ gave it).
export struct MenuTag {
    tag: string,
    id: string,
    field: string,
}

export global LibraryEdit {
    // Colors a crate can have (see CrateColors).
    out property <[color]> list-colors: CrateColors.colors;
    // Gives the crate at a sidebar row a color (-1 for none) or an icon.
    callback set-list-color(index: int, color: int);
    callback set-list-icon(index: int, icon: int);
    // The circling arrows over the Collection sidebar: look for new and
    // changed tracks in the music folders now.
    callback update-collection();
    // The DJ has lists a track can be added to.
    in property <bool> has-lists;
    // The lists the track menu's side panel shows: found by `find-lists`
    // (most recently added to first) or `lists-with` (the lists a track is in).
    in property <[MenuListRow]> list-picks;
    callback find-lists(text: string);
    // The tags Add Tag offers: added lately, then most used; those that
    // match `find-tags`.
    in property <[MenuTag]> tag-picks;
    callback find-tags(text: string);
    // Puts tag `tag` in tag field `id` of the rows `first` to `last`.
    callback add-tag(first: int, last: int, id: string, tag: string);
    callback lists-with(row: int);
    // Shows the menu's list `list` (a `MenuListRow.index`) in the tree.
    callback show-list(list: int);
    // Makes a crate named `name` (or "New crate", named in the tree) with
    // the rows `first` to `last` in it.
    callback new-list-with(first: int, last: int, name: string);
    // The same for the track on deck `deck` (the Player bar's ＋).
    callback add-deck-to-list(deck: int, list: int);
    callback new-list-with-deck(deck: int, name: string);
    // The Player bar's heart: whether the track on each deck is in
    // Favorites, and putting it in or taking it out.
    in property <[bool]> deck-favorites: [false, false, false, false];
    callback favorite-deck(deck: int);
    // The collection narrowed to the row's artist (or album) with the filter bar.
    callback go-to(row: int, album: bool);
    // The row's main artist and its album, for the menu's "Go to" lines.
    pure callback go-to-text(row: int) -> [string];
    callback load-on-deck(row: int, deck: int);
    // Opens the side panel's Info tab on the row's track.
    callback show-info(row: int);
    // The key that runs this openDJscript line (⌘I), for a menu line's hint.
    pure callback key-for(script: string) -> string;
    // How many decks are shown, for "Load on Deck".
    in property <int> decks: 2;
    // The window's height, so the track menu can fit in it.
    in-out property <length> window-height;
    // The window's width, so the library search can sit in its middle.
    in-out property <length> window-width;
    // The top bar's search box (Player) filters the list, so the list's
    // own box is hidden.
    in-out property <bool> top-search;
    // The sidebar shows the history; set when the app goes back to the library.
    in-out property <bool> history-tab;
    // The selected node is one of the DJ's lists, so a track can be taken out.
    in property <bool> in-list;
    // Makes a crate (0), a folder (1), a playlist (2) or a folder at the top
    // of Crates (3) and returns its row in the tree. Crates, folders and
    // playlists go in the folder at tree row `at`, or (-1) at the top of
    // Crates (a crate) or Playlists.
    callback create(kind: int, at: int) -> int;
    callback rename(index: int, name: string);
    callback delete(index: int);
    // Makes the import whose top folder is at tree row `index` the DJ's own.
    callback adopt-import(index: int);
    // Moves the Inbox album at tree row `index` into the Albums folder.
    callback move-node-album(index: int);
    // Whether the track at a row of the list is in an album downloaded
    // into the Inbox, and moving that album into the Albums folder.
    pure callback in-inbox-album(row: int) -> bool;
    callback move-row-album(row: int);
    // Turns the list at tree row `index` into a crate (true) or a playlist.
    callback set-crate(index: int, crate: bool);
    pure callback accepts-drop(index: int, data: data-transfer) -> bool;
    // A list or folder picked up at tree row `index`, and whether one
    // dragged can go on (into) tree row `index`.
    pure callback list-payload(index: int) -> data-transfer;
    pure callback accepts-list-move(index: int, data: data-transfer) -> bool;
    callback drop(index: int, data: data-transfer);
    // Tracks from the side panel or a deck dropped on the open list (empty
    // or not) in the track list join it.
    pure callback accepts-list-drop(data: data-transfer) -> bool;
    callback drop-on-list(data: data-transfer);
    callback set-rating(row: int, rating: int);
    // Gives the row (or all the picked rows) color `color`: one of the
    // colors searched as color:red and so on, in their order, or -1 for
    // none.
    callback set-color(row: int, color: int);
    // The total time of the picked tracks, when several are picked.
    in property <string> picked-time;
    // Which rows of the track list are picked, one flag per row, and how
    // many. Click picks a row, shift-click the rows from `from` to `to`
    // (added to the picks before it with `add`, for Cmd-shift-click), and
    // Cmd-click (Ctrl-click on Windows and Linux) adds or drops one.
    in property <[bool]> picks;
    in property <int> picked-count;
    callback pick-rows(from: int, to: int, add: bool);
    callback toggle-row(row: int);
    // The rows `first` to `last`; when `first` is one of several picked
    // rows, every picked row. The same for the callbacks below.
    callback add-to-list(first: int, last: int, list: int);
    callback remove-from-list(row: int);
    callback add-to-automix(first: int, last: int);
    // The album of the track at a list row goes on the Automix list, after
    // what is there (`add`) or instead of it, to play through gaplessly.
    callback play-album(row: int, add: bool);
    // The same for the album at a row of the tree.
    callback play-album-folder(index: int);
    // Analyses the rows `first` to `last` again, in the background.
    callback analyze(first: int, last: int);
    // Analyses every track of the tree's row `row`.
    callback analyze-all(row: int);
    // Opens Export to USB for the tree's row `row` (a list or folder).
    callback export-usb(row: int);
    // Sends the tree's row `row` (a list or history session) to Spotify as
    // a new playlist, in its order.
    callback export-spotify(row: int);
    // Saves the list, folder, history session, album or mixed set at a
    // sidebar row as M3U8 files; asks where first.
    callback export-m3u(row: int);
    // Saves the Collection (every track and list) or a list or folder at a
    // sidebar row as a rekordbox XML file; asks where first.
    callback export-rekordbox(row: int);
    // Makes a playlist from an M3U, M3U8, PLS or XSPF file the DJ picks.
    callback import-playlist-file();
    // Prepares high-quality stems for the rows `first` to `last`, one
    // track after another in the background.
    callback prepare-hq-stems(first: int, last: int);
    // "Analyzing 3 of 12" while tracks are queued, for the footer; empty otherwise.
    in property <string> analysis-status;
    callback cancel-analysis();
    // The sidebar switched between the library and the history.
    callback show-history(history: bool);
    // A search can be saved as a smart list (the collection is the saved library).
    in property <bool> can-save-search;
    // Nothing matched the search exactly, so the list shows near misses
    // (a letter off), and the count says "Close Matches".
    in property <bool> close-matches;
    // The selected smart list's search, shown above the list; empty otherwise.
    in property <string> rule;
    // Saves a search as a smart list, selects it and returns its row in the tree.
    callback save-search(text: string) -> int;
    // Set to a row of the tree to have the tree ask for that list's name.
    in-out property <int> name-row: -1;
    // The search of the smart list at a row of the tree, and changing it.
    // The + on Playlists asked for a smart playlist: the whole collection
    // shows with the filter bar, and Save turns the filters into the list.
    callback start-smart-list();
    in-out property <bool> making-smart;
    pure callback rule-at(index: int) -> string;
    callback set-rule(index: int, text: string);
    // The stage folders are set up, so tracks can move between stages.
    in property <bool> stages;
    // The In Prep folder's subfolders, offered as "Send to In Prep › Yoga STG".
    in property <[string]> triage-crates;
    // The stage of the track at a row of the list: 0 = none, 1 = inbox,
    // 2 = triage, 3 = collection, 4 = passed over.
    pure callback stage-of(row: int) -> int;
    // Moves the rows `first` to `last` to a stage (as `stage-of` numbers
    // them), into the triage crate at `crate` (-1 for none).
    callback set-stage(first: int, last: int, stage: int, crate: int);
    // "Undo: Send to In Prep (3 tracks)", or empty when there is nothing to undo.
    in property <string> undo-text;
    callback undo-stage();
}

// The Files source: folders on the computer.
// One album in the Albums source's covers view.
export struct AlbumTile {
    name: string,
    artist: string,
    // The line under the name: "2024 · Artist", or the year under an artist.
    detail: string,
    cover: image,
    has-cover: bool,
}

// The Albums source: its list / covers switch and the covers view.
export global AlbumsUi {
    // The Albums source is shown, so the switch is offered.
    in property <bool> offered;
    // Covers rather than a list; remembered.
    in property <bool> covers;
    // The covers view is shown instead of the list (an artist or All
    // Albums is selected).
    in property <bool> grid;
    // An album is open: "‹ Albums" (or "‹ Artist") goes back to covers.
    in property <bool> opened;
    // Where back goes: the album's artist, or "Albums".
    in property <string> back-to: "Albums";
    in property <[AlbumTile]> tiles;
    callback set-covers(on: bool);
    // Opens the album at `index` of `tiles`: its tracks in the list.
    callback open(index: int);
    callback back();
    // Plays the album at `index`, or adds it to Automix (`add`).
    callback play(index: int, add: bool);
}

export global FilesUi {
    // Listings include the files in subfolders.
    in-out property <bool> recursive;
    // "Finder" on macOS, "file manager" elsewhere.
    in property <string> file-manager: "Finder";
    // What adding a folder to the collection is doing.
    in property <string> status;
    callback set-recursive(on: bool);
    // Pins the folder at a row of the tree, or unpins it.
    callback pin(index: int);
    callback add-folder(index: int);
    callback reveal-folder(index: int);
    callback add-track(row: int);
    callback reveal-track(row: int);
    // The track at a row of the list is in the collection (not only in Files).
    pure callback in-collection(row: int) -> bool;
    // The track at a row of the list is a file on disk.
    pure callback has-file(row: int) -> bool;
    // Makes the mixed set at a row of the list into an MP3 for Mixcloud,
    // its tracklist as chapters (File › Export › Mixcloud…).
    callback export-mixcloud(row: int);
    // Signs in to Mixcloud if need be and uploads the mixed set at a row,
    // with its tracklist, as a private show.
    callback upload-mixcloud(row: int);
    in property <bool> mixcloud-signed-in;
    callback mixcloud-sign-out();
    // What making it is doing, under the Mixed Sets folders.
    in property <string> mix-status;
}

// The stores source: switching to it from elsewhere, its search box, and
// the purchase inbox.
// One check on the Collection Health page.
export struct HealthCard {
    title: string,
    about: string,
    // Tracks it finds; -1 while it is still looking.
    count: int,
    // More on what it found, e.g. "29 without artist or title".
    detail: string,
    fixes: [string],
    // How many things the bar's fix buttons count, in the same order:
    // groups of copies, say. Empty: the tracks listed.
    counts: [int],
    // The fixes the track menu offers (indices into `fixes`): those its
    // stage lines don't already.
    menu-fixes: [int],
}

// A stage on the Health Overview: its tracks, how many are clean, and the
// check finding most of the rest.
export struct HealthStage {
    title: string,
    count: int,
    percent: int,
    note: string,
}

// One check on an area's tile, with its index in `HealthUi.cards`.
export struct HealthLine {
    title: string,
    count: int,
    check: int,
}

// One of the five areas on the Health Overview.
export struct HealthArea {
    title: string,
    question: string,
    count: int,
    // 0 clear, 1 something to look at, 2 something won't play, 3 a goal.
    state: int,
    // The first area to work on.
    start: bool,
    lines: [HealthLine],
}

// A chip over an area's tracks: a check, or a case of copies.
export struct HealthChip {
    title: string,
    count: int,
}

// The review card: one listed track at a time.
export struct HealthReview {
    // Which listed track (from 1) of how many.
    at: int,
    of: int,
    check: string,
    title: string,
    artist: string,
    problem: string,
    fix: string,
    // What Return does, or "" when the check has no fix for one track.
    action: string,
    // Every listed track was seen; `next` names the area after, if any.
    done: bool,
    next: string,
}

// Collection Health: the checks' page and the bar over a check's tracks.
export global HealthUi {
    // The Overview: tracks, how many are clean, by stage and by area.
    in property <int> total;
    in property <int> clean;
    in property <int> clean-percent: 100;
    in property <[HealthStage]> stages;
    in property <[HealthArea]> areas;
    // An area's chips and the one shown, or -1 outside an area.
    in property <[HealthChip]> chips;
    in property <int> chip: -1;
    // The area's progress since it was first opened: tracks fixed, of how
    // many it found then.
    in property <int> fixed;
    in property <int> fixed-of;
    callback open-area(area: int);
    callback pick-chip(chip: int);
    // How many of the area's tracks have one clear fix, and making those.
    in property <int> sure;
    // The review card, while it's open.
    in property <bool> reviewing;
    in property <HealthReview> card;
    // start, use, skip, ignore, edit, close, next.
    callback review-key(key: string);
    in property <string> sure-label: "Auto-fix";
    callback fix-sure();
    // The tree shows Collection Health's checks, picked in the rail.
    in property <bool> view;
    // Collection Health has a button in the rail; it can be hidden under
    // the rail's "..." like the sources.
    in-out property <bool> rail-shown: true;
    // Shows the checks (true) or the collection again.
    callback show(on: bool);
    // Collection Health's Overview is selected: its page shows instead of the list.
    in property <bool> overview;
    // The check whose tracks are listed (an index into `cards`), or -1.
    in property <int> check: -1;
    in property <[HealthCard]> cards;
    // What the last fix did.
    in property <string> status;
    // Tracks taken out of the library, which can be brought back.
    in property <int> removed;
    // Shows a check's tracks.
    callback review(check: int);
    // Runs fix `action` of the listed check on rows `first` to `last`, or on
    // every listed track when `first` is -1.
    callback fix(action: int, first: int, last: int);
    // The listed check leaves these rows alone from now on.
    callback ignore(first: int, last: int);
    // Brings back every track taken out of the library.
    callback restore();
    // Copies of the same track are listed: the track menu offers to keep
    // the copy at a row and merge the rest of its group into it.
    in property <bool> copies;
    callback keep-this(row: int);
    // Merged copies' files in the quarantine folder, or waiting to go
    // there, and a button to show the folder.
    in property <int> quarantined;
    in property <bool> quarantine-exists;
    callback show-quarantine();
    // The track menu offers to move tracks to the quarantine folder: there
    // is a Collection folder for it to sit beside.
    in property <bool> can-quarantine;
    // Takes rows `first` to `last` out of the library and moves their files
    // to the quarantine folder (or queues the moves while Move files is off).
    callback quarantine(first: int, last: int);
    // What is wrong in the DJ's lists ("2 empty crates, ..."); empty when
    // they're fine.
    in property <string> lists;
    callback tidy-lists();
}

// One change the clean-up would make: a field of a track, before and after.
export struct CleanupRow {
    track: string,
    field: string,
    old: string,
    new: string,
    on: bool,
}

// Fix Names: one tool run on the names of many tracks, with a preview,
// whose changes go to the review table.
export global FixNamesUi {
    in property <bool> open;
    // How many tracks it is for.
    in property <int> count;
    // 0 find and replace, 1 change case, 2 remove brackets, 3 swap artist
    // and title.
    in-out property <int> tool;
    // 0 all names (track, artist, remix, album), then each field: 1 track,
    // 2 artist, 3 remix, 4 album, 5 genre, 6 comment, 7 grouping.
    in-out property <int> field;
    in-out property <string> find;
    in-out property <string> with;
    in-out property <bool> match-case;
    in-out property <bool> whole-words;
    in-out property <bool> pattern;
    // 0 Title Case, 1 Sentence case, 2 UPPER, 3 lower.
    in-out property <int> case;
    // The first changes it would make, how many tracks change, and why it
    // can't run.
    in property <[CleanupRow]> preview;
    in property <int> changing;
    in property <string> error;
    callback start(first: int, last: int);
    callback update();
    callback review();
    callback cancel();
}

// A genre in the library, with how many tracks have it.
export struct GenreRow {
    name: string,
    count: int,
    picked: bool,
    // Spelled like another genre but for case, spaces or punctuation.
    alike: bool,
}

// Clean-up: the review table of changes to names, and the genres page.
export global CleanupUi {
    // The review table shows in place of the list.
    in property <bool> open;
    in property <string> heading;
    in property <[CleanupRow]> rows;
    // Rows ticked.
    in property <int> picked;
    callback toggle(row: int);
    callback all(on: bool);
    callback apply();
    callback cancel();
    // The genres page shows in place of the list.
    in property <bool> genres-open;
    in property <[GenreRow]> genres;
    // How many genres there are, and how many look like another.
    in property <int> genre-count;
    in property <int> alike;
    // The name picked genres are merged into.
    in-out property <string> into;
    in property <int> genres-picked;
    callback open-genres();
    callback toggle-genre(row: int);
    callback merge-genres();
    callback close-genres();
}

// The Wanted list: tracks the DJ means to get. Only the DJ puts tracks on
// it (Buy, Copy to openDJ, Add to Wanted).
export global WantedUi {
    // Whether the track list shows the Wanted list.
    in property <bool> shown;
    // Streamed tracks the collection hasn't got, in rows first to last (every
    // picked row, when first is one of several), go on the Wanted list.
    callback add-tracks(first: int, last: int);
    // A streaming playlist, or a list with streamed tracks standing in it,
    // by its row in the tree: its tracks the collection hasn't got.
    callback add-list(index: int);
    // Whether Add to Wanted fits the tree's row.
    pure callback list-streamed(index: int) -> bool;
    // A streaming playlist kept in sync with the Wanted list: tracks
    // added to it later that the collection hasn't got go on it too.
    pure callback list-synced(index: int) -> bool;
    callback toggle-sync(index: int);
    // Rows of the Wanted list come off it.
    callback remove(first: int, last: int);
    // A row of the Wanted list: its page on the store or service.
    callback open(row: int);
}

// A store on the Buy sheet, with the tracks chosen to buy there.
export struct BuyGroup {
    store: string,
    count: int,
    // The store has these tracks; false when it's only a search to try.
    found: bool,
    // How many of its pages were opened.
    opened: int,
}

// A track on the Buy sheet: the store chosen for it, and how many other
// stores it could be bought on.
export struct BuyRow {
    name: string,
    store: string,
    found: bool,
    others: int,
    // What the chosen store asks for the track ("$1.29"); empty when it
    // doesn't say.
    price: string,
    // Every store it can be bought on, best first ("Bandcamp · €1.00",
    // "Try Beatport" for a search), and which one is chosen.
    stores: [string],
    chosen: int,
}

// Buy on Wanted rows: each track's best store, artist-direct first,
// grouped so each store's own cart collects them for one checkout. openDJ
// never takes payment.
export global BuyUi {
    in property <bool> open;
    in property <int> count;
    // Tracks looked up so far, of count.
    in property <int> looked;
    in property <[BuyGroup]> groups;
    in property <[BuyRow]> rows;
    // The purchase inbox: what arrives in Downloads goes to Inbox.
    in property <bool> inbox-on;
    in property <string> inbox-note;
    // The Music app's folder is there to watch (macOS).
    in property <bool> music-app-offered;
    in property <bool> music-app-on;
    callback start(first: int, last: int);
    callback open-group(index: int);
    // A track's page on the store chosen for it.
    callback open-track(row: int);
    // Buys a track on another of its stores (an index into its stores).
    callback pick-store(row: int, store: int);
    callback set-inbox(on: bool);
    callback set-music-app(on: bool);
    callback close();
}

// Fixing which collection track a streaming track is, by hand.
export global StreamMatch {
    // What the DJ typed to find the track, and what it found.
    in-out property <string> query;
    in property <[string]> candidates;
    // A match set by hand, which "Match automatically" undoes.
    in property <bool> manual;
    // Fills in the query and candidates for the row's track.
    callback open(row: int);
    callback search(text: string);
    callback pick(row: int, candidate: int);
    // It's none of the collection's tracks.
    callback none(row: int);
    // Back to matching by ISRC, title and artist.
    callback auto(row: int);
}

export global StoreUi {
    // The source picked in the rail, so the app can switch to the stores.
    in-out property <int> source;
    // Whether the built streaming services (Spotify, TIDAL) can be browsed, and
    // whether the stores and purchase inbox can be used. A source that
    // can't shows "Coming soon".
    in property <bool> streaming;
    in property <bool> stores;
    // Whether a rail source is a streaming service: Spotify, TIDAL, Apple
    // Music, SoundCloud, Mixcloud.
    pure public function stream(source: int) -> bool {
        return source == 2 || source == 3 || source == 4 || source == 8 || source == 11;
    }
    // The text in the list's search box, so the app can fill it in.
    in-out property <string> search-text;
    in property <bool> inbox-on;
    // 0 = move into Purchased, 1 = copy there, 2 = leave where it downloaded.
    in property <int> inbox-mode;
    in property <string> inbox-status;
    callback set-inbox(on: bool);
    callback set-inbox-mode(mode: int);
    // "Find in stores" on a track's menu.
    callback find(row: int);
    // The add-on source that downloads Spotify playlists and tracks
    // ("Add to Downloads", "Download Track"), by name; empty when none is installed.
    in property <string> downloads-to;
    // A Spotify playlist in the tree, by its row: its page, or downloading it.
    callback open-playlist(index: int);
    callback download-playlist(index: int);
    // The Spotify tracks in rows first to last.
    callback download-tracks(first: int, last: int);
}

// A line drawing for the track menu, 16 px, by name.
component MenuIcon inherits Path {
    in property <string> icon;
    in property <color> color: Theme.text;
    width: 16px;
    height: 16px;
    viewbox-width: 16;
    viewbox-height: 16;
    stroke: color;
    stroke-width: 1.4px;
    fill: transparent;
    commands: icon == "plus" ? "M 8 3 L 8 13 M 3 8 L 13 8"
        : icon == "automix" ? "M 2 4 L 11 4 M 2 8 L 8 8 M 2 12 L 8 12 M 10.5 7.5 L 14.5 10.5 L 10.5 13.5 Z"
        : icon == "minus" ? "M 8 2 A 6 6 0 1 1 7.99 2 Z M 5 8 L 11 8"
        : icon == "artist" ? "M 8 2.5 A 2.8 2.8 0 1 1 7.99 2.5 Z M 2.5 14.5 Q 8 6.5 13.5 14.5"
        : icon == "album" ? "M 8 2 A 6 6 0 1 1 7.99 2 Z M 8 6.5 A 1.5 1.5 0 1 1 7.99 6.5 Z"
        : icon == "list" ? "M 2 4 L 14 4 M 2 8 L 14 8 M 2 12 L 9 12"
        : icon == "crate" ? "M 2 5 L 14 5 L 14 14 L 2 14 Z M 2 9.5 L 14 9.5 M 6 5 L 6 3 L 10 3 L 10 5"
        : icon == "info" ? "M 8 2 A 6 6 0 1 1 7.99 2 Z M 8 7 L 8 11.5 M 8 4.5 L 8 5.2"
        : icon == "deck" ? "M 8 2 A 6 6 0 1 1 7.99 2 Z M 8 7 A 1 1 0 1 1 7.99 7 Z M 8 8 L 11.5 4.5"
        : icon == "back" ? "M 13 8 L 3.5 8 M 7.5 4 L 3.5 8 L 7.5 12"
        : icon == "forward" ? "M 3 8 L 12.5 8 M 8.5 4 L 12.5 8 L 8.5 12"
        : icon == "hide" ? "M 1.5 8 Q 8 1.5 14.5 8 Q 8 14.5 1.5 8 Z M 8 6.2 A 1.8 1.8 0 1 1 7.99 6.2 Z M 3 13.5 L 13 2.5"
        : icon == "analyze" ? "M 2 7 L 2 9 M 5 4 L 5 12 M 8 6 L 8 10 M 11 2.5 L 11 13.5 M 14 6.5 L 14 9.5"
        : icon == "stems" ? "M 8 2 L 14 5 L 8 8 L 2 5 Z M 2 8 L 8 11 L 14 8 M 2 11 L 8 14 L 14 11"
        : icon == "folder" ? "M 2 4 L 6 4 L 7.5 5.5 L 14 5.5 L 14 13 L 2 13 Z"
        : icon == "quarantine" ? "M 8 1.8 L 14 4 L 14 8 Q 14 12.5 8 14.5 Q 2 12.5 2 8 L 2 4 Z M 6 6 L 10 10 M 10 6 L 6 10"
        : icon == "download" ? "M 8 2 L 8 10.5 M 4.5 7 L 8 10.5 L 11.5 7 M 3 14 L 13 14"
        : icon == "store" ? "M 3 5.5 L 13 5.5 L 12 14 L 4 14 Z M 6 5.5 Q 6 2 8 2 Q 10 2 10 5.5"
        : icon == "search" ? "M 7 2.5 A 4.5 4.5 0 1 1 6.99 2.5 Z M 10.3 10.3 L 14 14"
        : icon == "play" ? "M 4.5 3 L 12.5 8 L 4.5 13 Z"
        : icon == "fix" ? "M 3 8.5 L 6.5 12 L 13 4.5"
        : icon == "link" ? "M 7 9 L 9 7 M 5.5 7.5 L 3.8 9.2 A 2.2 2.2 0 0 0 6.8 12.2 L 8.5 10.5 M 10.5 8.5 L 12.2 6.8 A 2.2 2.2 0 0 0 9.2 3.8 L 7.5 5.5"
        : icon == "chevron" ? "M 6 4 L 10 8 L 6 12"
        : "";
}

// A line of a popup menu, with an icon (or the room for one) when `icon`
// is set, a dim `hint` on the right, and a › when it opens a side panel.
export component MenuLine inherits Rectangle {
    in property <string> text;
    // Greyed out, and does nothing when clicked.
    in property <bool> enabled: true;
    in property <color> text-color: enabled ? Theme.text : Theme.text-dim;
    in property <string> icon;
    in property <string> hint;
    in property <bool> submenu;
    // Its side panel is open.
    in property <bool> open;
    callback clicked();
    // The pointer came onto the line.
    callback entered();
    property <bool> hover: ta.has-hover;
    changed hover => {
        if hover {
            entered();
        }
    }
    height: 26px;
    border-radius: 4px;
    background: (ta.has-hover && enabled) || open ? Theme.n-3a3a3d : transparent;
    property <length> text-x: icon != "" ? 34px : 10px;
    if icon != "": MenuIcon {
        x: 10px;
        icon: root.icon;
        color: root.text-color == Theme.text ? Theme.n-d0d0d4 : root.text-color;
    }
    Text {
        x: text-x;
        width: parent.width - text-x - (submenu ? 26px : 10px) - (hint != "" ? hint-text.width + 8px : 0px);
        text: root.text;
        color: root.text-color;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }
    hint-text := Text {
        x: parent.width - self.width - (submenu ? 26px : 10px);
        width: min(self.preferred-width, parent.width * 0.42);
        text: root.hint;
        color: Theme.text-dim;
        font-size: 12px;
        vertical-alignment: center;
        overflow: elide;
    }
    if submenu: MenuIcon {
        x: parent.width - 22px;
        icon: "chevron";
        color: Theme.text-dim;
    }
    ta := TouchArea {
        clicked => {
            if root.enabled {
                root.clicked();
            }
        }
    }
}

export component MenuBackground inherits Rectangle {
    background: Theme.panel-raised;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;
    drop-shadow-blur: 12px;
    drop-shadow-color: Theme.s-000000a0;
}

export component MenuSeparator inherits Rectangle {
    height: 9px;
    Rectangle { height: 1px; background: Theme.border; }
}

// One stage on the track menu's stage strip, in its color: filled where
// the track is, outlined elsewhere.
component StageStep inherits Rectangle {
    in property <string> text;
    in property <bool> here;
    in property <color> tint;
    callback clicked();
    height: 22px;
    width: label.preferred-width + 16px;
    border-radius: 11px;
    background: here ? tint : ta.has-hover ? tint.transparentize(0.8) : transparent;
    border-width: here ? 0px : 1px;
    border-color: tint.transparentize(0.5);
    label := Text {
        text: root.text;
        color: here ? Theme.on-selection : tint;
        font-size: 11px;
        font-weight: here ? 600 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        enabled: !here;
        mouse-cursor: here ? default : pointer;
        clicked => { root.clicked(); }
    }
}

// The top of the track menu, for a track at `stage` (as
// `LibraryEdit.stage-of` numbers them): Inbox → In Prep → Play Ready, the
// track's stage filled; a click on another moves it there.
component StageStrip inherits HorizontalLayout {
    in property <int> stage;
    callback picked(stage: int);
    height: 28px;
    padding-left: 10px;
    padding-right: 8px;
    spacing: 3px;
    alignment: start;
    StageStep { y: 3px; text: "Inbox"; tint: Theme.stage-inbox; here: stage == 1; clicked => { picked(1); } }
    MenuIcon { y: 9px; width: 10px; height: 10px; icon: "chevron"; color: Theme.text-dim; }
    StageStep { y: 3px; text: "In Prep"; tint: Theme.stage-prep; here: stage == 2; clicked => { picked(2); } }
    MenuIcon { y: 9px; width: 10px; height: 10px; icon: "chevron"; color: Theme.text-dim; }
    StageStep { y: 3px; text: "Play Ready"; tint: Theme.stage-ready; here: stage == 3; clicked => { picked(3); } }
}

// What the stage strip can't say: which prep crate to send a track into.
component StageLines inherits VerticalLayout {
    in property <int> stage;
    callback picked(stage: int, crate: int);
    callback entered();
    spacing: 2px;
    if stage != 2 && stage != 3 && LibraryEdit.triage-crates.length > 0: MenuSeparator {}
    if stage != 2 && stage != 3: VerticalLayout {
        spacing: 2px;
        for c[i] in LibraryEdit.triage-crates: MenuLine {
            icon: "forward";
            text: "Send to In Prep › " + c;
            entered => { root.entered(); }
            clicked => { picked(2, i); }
        }
    }
}

// Right-click menu on a track: rating, stages and lists.
// Picks the collection track a streaming track is.
component MatchMenu inherits PopupWindow {
    in property <int> track-row;
    in property <bool> matched;
    // How many rows the menu's actions take (the picked ones).
    in property <int> count: 1;
    // SoundCloud tracks and Mixcloud shows play on the service's own page.
    property <string> plays-on: StoreUi.source == 8 ? "SoundCloud" : StoreUi.source == 11 ? "Mixcloud" : "";
    callback play();
    width: 320px;
    close-policy: close-on-click-outside;
    MenuBackground {}
    VerticalLayout {
        padding: 8px;
        spacing: 4px;
        if plays-on != "": MenuLine {
            text: "Play on " + plays-on;
            clicked => {
                root.close();
                root.play();
            }
        }
        if plays-on != "": MenuSeparator {}
        // Tracks the collection hasn't got: on the Wanted list, or (with a
        // download source installed) downloaded. A store's cart joins here
        // later.
        MenuLine {
            text: count > 1 ? "Add " + count + " Tracks to Wanted" : "Add to Wanted";
            clicked => {
                WantedUi.add-tracks(track-row, track-row);
                root.close();
            }
        }
        if StoreUi.downloads-to != "": MenuLine {
            text: count > 1 ? "Add " + count + " Tracks to Downloads" : "Add to Downloads";
            clicked => {
                StoreUi.download-tracks(track-row, track-row);
                root.close();
            }
        }
        MenuSeparator {}
        Text { text: "Match to a track in your collection"; color: Theme.text-dim; font-size: 12px; }
        LineEdit {
            text <=> StreamMatch.query;
            placeholder-text: "Artist or title";
            edited(t) => { StreamMatch.search(t); }
        }
        for c[i] in StreamMatch.candidates: MenuLine {
            text: c;
            clicked => {
                StreamMatch.pick(track-row, i);
                root.close();
            }
        }
        if StreamMatch.candidates.length == 0: Text {
            text: "Nothing in your collection matches.";
            color: Theme.text-dim;
            font-size: 12px;
            height: 26px;
            vertical-alignment: center;
        }
        MenuSeparator {}
        if matched: MenuLine {
            text: "Not in my collection";
            clicked => {
                StreamMatch.none(track-row);
                root.close();
            }
        }
        if StreamMatch.manual: MenuLine {
            text: "Match automatically";
            clicked => {
                StreamMatch.auto(track-row);
                root.close();
            }
        }
    }
}

// The track menu's side panel: the lists to add the tracks to (found by
// typing, most recently added to first, with a new crate at the top), or
// the lists the track is in.
export component ListPanel inherits Rectangle {
    // 1 = add to a list, 2 = the lists the track is in.
    in property <int> mode;
    in property <int> track-row;
    in property <int> track-last;
    // Adds the track on this deck instead of the rows (mode 1 only).
    in property <int> deck: -1;
    function add(index: int) {
        if deck >= 0 {
            LibraryEdit.add-deck-to-list(deck, index);
        } else {
            LibraryEdit.add-to-list(track-row, track-last, index);
        }
    }
    in-out property <string> find;
    callback done();
    // Typing finds a list straight away, as in Spotify.
    init => {
        if mode == 1 {
            find-edit.focus();
        }
    }
    MenuBackground {}
    VerticalLayout {
        padding: 6px;
        spacing: 2px;
        Rectangle {
            height: mode == 1 ? 32px : 0px;
            visible: mode == 1;
            border-radius: 4px;
            background: Theme.n-2c2c30;
            MenuIcon { x: 9px; icon: "search"; color: Theme.text-dim; }
            find-edit := TextInput {
                x: 32px;
                width: parent.width - 40px;
                height: parent.height;
                text <=> root.find;
                color: Theme.text;
                font-size: 13px;
                vertical-alignment: center;
                single-line: true;
                edited => { LibraryEdit.find-lists(self.text); }
                accepted => {
                    if LibraryEdit.list-picks.length > 0 {
                        root.add(LibraryEdit.list-picks[0].index);
                        root.done();
                    }
                }
            }
            if root.find == "": Text {
                x: 32px;
                text: "Find a list";
                color: Theme.text-dim;
                font-size: 13px;
                vertical-alignment: center;
            }
        }
        if mode == 1: MenuLine {
            icon: "plus";
            text: root.find.is-empty ? "New crate" : "New crate “" + root.find + "”";
            clicked => {
                if deck >= 0 {
                    LibraryEdit.new-list-with-deck(deck, root.find);
                } else {
                    LibraryEdit.new-list-with(track-row, track-last, root.find);
                }
                root.done();
            }
        }
        if mode == 1: MenuSeparator {}
        if mode == 2: Text {
            x: 10px;
            height: 22px;
            text: "In your lists";
            color: Theme.text-dim;
            font-size: 12px;
            vertical-alignment: center;
        }
        if LibraryEdit.list-picks.length == 0: Text {
            x: 10px;
            height: 26px;
            text: mode == 2 ? "Not in any of your lists." : root.find != "" ? "No list matches." : "No lists yet.";
            color: Theme.text-dim;
            font-size: 12px;
            vertical-alignment: center;
        }
        if LibraryEdit.list-picks.length > 0: ScrollView {
            height: min(LibraryEdit.list-picks.length * 28px, 10 * 28px);
            VerticalLayout {
                spacing: 2px;
                for l in LibraryEdit.list-picks: MenuLine {
                    icon: l.is-crate ? "crate" : "list";
                    text: l.name;
                    hint: l.folder;
                    clicked => {
                        if mode == 1 {
                            root.add(l.index);
                        } else {
                            LibraryEdit.show-list(l.index);
                        }
                        root.done();
                    }
                }
            }
        }
    }
}

// The track menu's Add Tag panel: tags added lately and the collection's
// most used, a box to find one or type a new one.
component TagPanel inherits Rectangle {
    in property <int> track-row;
    in property <int> track-last;
    property <string> find;
    callback done();
    init => {
        LibraryEdit.find-tags("");
        find-edit.focus();
    }
    MenuBackground {}
    VerticalLayout {
        padding: 6px;
        spacing: 2px;
        Rectangle {
            height: 32px;
            border-radius: 4px;
            background: Theme.n-2c2c30;
            MenuIcon { x: 9px; icon: "search"; color: Theme.text-dim; }
            find-edit := TextInput {
                x: 32px;
                width: parent.width - 40px;
                height: parent.height;
                text <=> root.find;
                color: Theme.text;
                font-size: 13px;
                vertical-alignment: center;
                single-line: true;
                edited => { LibraryEdit.find-tags(self.text); }
                accepted => {
                    if LibraryEdit.tag-picks.length > 0 {
                        LibraryEdit.add-tag(track-row, track-last, LibraryEdit.tag-picks[0].id, LibraryEdit.tag-picks[0].tag);
                    } else if self.text != "" {
                        LibraryEdit.add-tag(track-row, track-last, "tag1", self.text);
                    }
                    root.done();
                }
            }
            if root.find == "": Text {
                x: 32px;
                text: "Find or type a tag";
                color: Theme.text-dim;
                font-size: 13px;
                vertical-alignment: center;
            }
        }
        if root.find != "": MenuLine {
            icon: "plus";
            text: "New tag “" + root.find + "”";
            clicked => {
                LibraryEdit.add-tag(track-row, track-last, "tag1", root.find);
                root.done();
            }
        }
        if LibraryEdit.tag-picks.length == 0 && root.find == "": Text {
            x: 10px;
            height: 26px;
            text: "No tags yet. Type one to add it.";
            color: Theme.text-dim;
            font-size: 12px;
            vertical-alignment: center;
        }
        if LibraryEdit.tag-picks.length > 0: ScrollView {
            height: min(LibraryEdit.tag-picks.length * 28px, 10 * 28px);
            VerticalLayout {
                spacing: 2px;
                for t in LibraryEdit.tag-picks: MenuLine {
                    text: t.tag;
                    hint: t.field;
                    clicked => {
                        LibraryEdit.add-tag(track-row, track-last, t.id, t.tag);
                        root.done();
                    }
                }
            }
        }
    }
}

// Right-click menu on a track, in sections by how often they're wanted:
// the rating; playing and lists; going to the artist, album, lists and
// info; the stages; analysis; then the file. Adding to a list opens a
// panel at the side, as Spotify does.
component TrackMenu inherits PopupWindow {
    callback change-match();
    in property <int> track-row;
    // The last row of a shift-click range, when the menu is for several.
    in property <int> track-last: track-row;
    // How many tracks the menu is for.
    in property <int> count: 1;
    in property <int> rating;
    // The row is a streaming service's track, matched to the collection.
    in property <bool> streamed;
    // The side panel opens on the left, as the menu is near the right edge.
    in property <bool> panel-left;
    // The side panel shown: 0 none, 1 add to a list, 2 the lists it's in,
    // 3 add a tag.
    property <int> panel;
    property <string> find;
    property <bool> one: count <= 1;
    property <[string]> go-text: LibraryEdit.go-to-text(track-row);
    property <length> menu-width: 250px;
    property <length> panel-width: 280px;
    function open-panel(p: int) {
        if panel != p {
            panel = p;
            if p == 1 {
                find = "";
                LibraryEdit.find-lists("");
            } else {
                LibraryEdit.lists-with(track-row);
            }
        }
    }
    function pick() {
        root.close();
    }
    // Where it was opened, from the top of the popup, which covers the
    // window's height so the menu can move up to fit under the pointer.
    in property <length> anchor-y;
    property <length> menu-y: max(4px, min(anchor-y, root.height - col.preferred-height - 4px));
    width: menu-width + 6px + panel-width;
    close-policy: close-on-click-outside;
    // The room for the side panel, when it's shut, closes the menu as
    // outside it would.
    TouchArea { clicked => { root.close(); } }
    if panel == 1: ListPanel {
        x: panel-left ? 0px : menu-width + 6px;
        y: max(4px, min(menu-y, root.height - self.preferred-height - 4px));
        width: panel-width;
        height: self.preferred-height;
        mode: 1;
        track-row: track-row;
        track-last: track-last;
        find <=> root.find;
        done => { root.close(); }
    }
    if panel == 3: TagPanel {
        x: panel-left ? 0px : menu-width + 6px;
        y: max(4px, min(menu-y, root.height - self.preferred-height - 4px));
        width: panel-width;
        height: self.preferred-height;
        track-row: track-row;
        track-last: track-last;
        done => { root.close(); }
    }
    if panel == 2: ListPanel {
        x: panel-left ? 0px : menu-width + 6px;
        y: max(4px, min(menu-y, root.height - self.preferred-height - 4px));
        width: panel-width;
        height: self.preferred-height;
        mode: 2;
        track-row: track-row;
        track-last: track-last;
        done => { root.close(); }
    }
    Rectangle {
        x: panel-left ? panel-width + 6px : 0px;
        y: menu-y;
        width: menu-width;
        height: col.preferred-height;
        MenuBackground {}
        col := VerticalLayout {
            padding: 6px;
            spacing: 2px;
            // The stage first: moving a track along is what the menu is
            // opened for most.
            if LibraryEdit.stages: StageStrip {
                stage: LibraryEdit.stage-of(track-row);
                picked(stage) => {
                    LibraryEdit.set-stage(track-row, track-last, stage, -1);
                    root.close();
                }
            }
            if LibraryEdit.stages: MenuSeparator {}
            HorizontalLayout {
                height: 28px;
                padding-left: 10px;
                spacing: 2px;
                Text { text: "Rating"; color: Theme.text-dim; font-size: 12px; vertical-alignment: center; width: 48px; }
                for n in [1, 2, 3, 4, 5]: Rectangle {
                    width: 22px;
                    Text { text: n <= rating ? "★" : "☆"; color: Theme.c-ffd60a; font-size: 16px; }
                    TouchArea {
                        clicked => {
                            LibraryEdit.set-rating(track-row, n == rating ? 0 : n);
                            root.close();
                        }
                    }
                }
            }
            // Red, orange, yellow, green, cyan, blue, purple, pink, as
            // color: searches name them; then none.
            HorizontalLayout {
                height: 26px;
                padding-left: 10px;
                // Eight swatches and none fit in the menu's width.
                spacing: 2px;
                Text { text: "Color"; color: Theme.text-dim; font-size: 12px; vertical-alignment: center; width: 48px; }
                for c[i] in [#ff3b30, #ff9500, #ffcc00, #34c759, #5ac8fa, #007aff, #af52de, #ff2d55]: Rectangle {
                    width: 17px;
                    Rectangle {
                        width: sw.has-hover ? 16px : 14px;
                        height: self.width;
                        border-radius: self.width / 2;
                        background: c;
                    }
                    sw := TouchArea {
                        clicked => {
                            LibraryEdit.set-color(track-row, i);
                            root.close();
                        }
                    }
                }
                Rectangle {
                    width: 17px;
                    Rectangle {
                        width: 14px;
                        height: 14px;
                        border-radius: 7px;
                        border-width: 1px;
                        border-color: none-ta.has-hover ? Theme.text : Theme.text-dim;
                    }
                    Text { text: "×"; color: none-ta.has-hover ? Theme.text : Theme.text-dim; font-size: 11px; }
                    none-ta := TouchArea {
                        clicked => {
                            LibraryEdit.set-color(track-row, -1);
                            root.close();
                        }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            MenuSeparator {}
            // Playing it, and the lists.
            if one: HorizontalLayout {
                height: 26px;
                padding-left: 10px;
                spacing: 6px;
                MenuIcon { y: 5px; icon: "deck"; color: Theme.n-d0d0d4; }
                Text { text: "Load on Deck"; color: Theme.text; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; }
                for d[i] in LibraryEdit.decks >= 4 ? [1, 2, 3, 4] : [1, 2]: Rectangle {
                    y: 2px;
                    width: 26px;
                    height: 22px;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Theme.deck-color(i);
                    background: dta.has-hover ? Theme.deck-color(i).with-alpha(0.35) : transparent;
                    Text { text: d; color: Theme.text; font-size: 12px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                    dta := TouchArea {
                        clicked => {
                            LibraryEdit.load-on-deck(track-row, i);
                            root.close();
                        }
                    }
                }
                Rectangle { width: 2px; }
            }
            MenuLine {
                icon: "automix";
                text: "Add to Automix";
                entered => { panel = 0; }
                clicked => {
                    LibraryEdit.add-to-automix(track-row, track-last);
                    root.close();
                }
            }
            if one && KeepGoingUi.player && StoreUi.source == 0: MenuLine {
                icon: "automix";
                text: "Start Radio";
                entered => { panel = 0; }
                clicked => {
                    KeepGoingUi.start-radio(track-row, false);
                    root.close();
                }
            }
            if one && KeepGoingUi.player && StoreUi.source == 0 && go-text[0] != "": MenuLine {
                icon: "artist";
                text: "Start Artist Radio";
                hint: go-text[0];
                entered => { panel = 0; }
                clicked => {
                    KeepGoingUi.start-radio(track-row, true);
                    root.close();
                }
            }
            if LibraryEdit.has-lists: MenuLine {
                icon: "plus";
                text: "Add to playlist";
                submenu: true;
                open: panel == 1;
                entered => { open-panel(1); }
                clicked => { open-panel(1); }
            }
            if StoreUi.source == 0: MenuLine {
                icon: "fix";
                text: one ? "Fix Names…" : "Fix Names of " + count + " Tracks…";
                entered => { panel = 0; }
                clicked => {
                    FixNamesUi.start(track-row, track-last);
                    root.close();
                }
            }
            if StoreUi.source == 0: MenuLine {
                icon: "plus";
                text: one ? "Add Tag" : "Add Tag to " + count + " Tracks";
                submenu: true;
                open: panel == 3;
                entered => { panel = 3; }
                clicked => { panel = 3; }
            }
            if !LibraryEdit.has-lists && StoreUi.source == 0: MenuLine {
                icon: "plus";
                text: "Add to new crate";
                entered => { panel = 0; }
                clicked => {
                    LibraryEdit.new-list-with(track-row, track-last, "");
                    root.close();
                }
            }
            if LibraryEdit.in-list: MenuLine {
                icon: "minus";
                text: "Remove from this list";
                entered => { panel = 0; }
                clicked => {
                    LibraryEdit.remove-from-list(track-row);
                    root.close();
                }
            }
            if StoreUi.source == 1 && !FilesUi.in-collection(track-row): MenuLine {
                icon: "plus";
                text: "Add to Collection";
                entered => { panel = 0; }
                clicked => {
                    FilesUi.add-track(track-row);
                    root.close();
                }
            }
            if StoreUi.source == 10 && one: MenuLine {
                icon: "link";
                text: "Upload to Mixcloud";
                entered => { panel = 0; }
                clicked => {
                    FilesUi.upload-mixcloud(track-row);
                    root.close();
                }
            }
            if StoreUi.source == 10 && FilesUi.mixcloud-signed-in: MenuLine {
                icon: "minus";
                text: "Sign Out of Mixcloud";
                entered => { panel = 0; }
                clicked => {
                    FilesUi.mixcloud-sign-out();
                    root.close();
                }
            }
            if StoreUi.source == 9: MenuLine {
                icon: "play";
                text: "Play Album";
                entered => { panel = 0; }
                clicked => {
                    LibraryEdit.play-album(track-row, false);
                    root.close();
                }
            }
            if StoreUi.source == 9: MenuLine {
                icon: "automix";
                text: "Add Album to Automix";
                entered => { panel = 0; }
                clicked => {
                    LibraryEdit.play-album(track-row, true);
                    root.close();
                }
            }
            MenuSeparator {}
            // Going to what's around it.
            if one && go-text[0] != "": MenuLine {
                icon: "artist";
                text: "Go to Artist";
                hint: go-text[0];
                entered => { panel = 0; }
                clicked => {
                    LibraryEdit.go-to(track-row, false);
                    root.close();
                }
            }
            if one && go-text[1] != "": MenuLine {
                icon: "album";
                text: "Go to Album";
                hint: go-text[1];
                entered => { panel = 0; }
                clicked => {
                    LibraryEdit.go-to(track-row, true);
                    root.close();
                }
            }
            if one && LibraryEdit.has-lists: MenuLine {
                icon: "list";
                text: "Show in playlist";
                submenu: true;
                open: panel == 2;
                entered => { open-panel(2); }
                clicked => { open-panel(2); }
            }
            if one: MenuLine {
                icon: "info";
                text: "Show Info";
                hint: LibraryEdit.key-for("show_info");
                entered => { panel = 0; }
                clicked => {
                    LibraryEdit.show-info(track-row);
                    root.close();
                }
            }
            if LibraryEdit.stages: StageLines {
                stage: LibraryEdit.stage-of(track-row);
                entered => { panel = 0; }
                picked(stage, crate) => {
                    LibraryEdit.set-stage(track-row, track-last, stage, crate);
                    root.close();
                }
            }
            // A track of an album downloaded whole: the album moves as one.
            if LibraryEdit.in-inbox-album(track-row): MenuLine {
                icon: "forward";
                text: "Move Album to Albums";
                entered => { panel = 0; }
                clicked => {
                    LibraryEdit.move-row-album(track-row);
                    root.close();
                }
            }
            MenuSeparator {}
            // Analysis, and the stores.
            MenuLine {
                icon: "analyze";
                text: count > 1 ? "Analyze " + count + " Tracks" : "Analyze Track";
                entered => { panel = 0; }
                clicked => {
                    LibraryEdit.analyze(track-row, track-last);
                    root.close();
                }
            }
            MenuLine {
                icon: "stems";
                text: "Prepare HQ Stems";
                entered => { panel = 0; }
                clicked => {
                    LibraryEdit.prepare-hq-stems(track-row, track-last);
                    root.close();
                }
            }
            if streamed && one: MenuLine {
                icon: "link";
                text: "Change Match…";
                entered => { panel = 0; }
                clicked => {
                    root.close();
                    root.change-match();
                }
            }
            if StoreUi.source == 2 && StoreUi.downloads-to != "": MenuLine {
                icon: "download";
                text: count > 1 ? "Download " + count + " Tracks" : "Download Track";
                entered => { panel = 0; }
                clicked => {
                    StoreUi.download-tracks(track-row, track-last);
                    root.close();
                }
            }
            if StoreUi.stores: MenuLine {
                icon: "store";
                text: "Find in stores";
                entered => { panel = 0; }
                clicked => {
                    StoreUi.find(track-row);
                    root.close();
                }
            }
            if HealthUi.check >= 0 && HealthUi.check < HealthUi.cards.length: VerticalLayout {
                spacing: 2px;
                MenuSeparator {}
                for j in HealthUi.cards[HealthUi.check].menu-fixes: MenuLine {
                    icon: "fix";
                    text: HealthUi.cards[HealthUi.check].fixes[j];
                    entered => { panel = 0; }
                    clicked => {
                        HealthUi.fix(j, track-row, track-last);
                        root.close();
                    }
                }
                if HealthUi.copies && one: MenuLine {
                    icon: "fix";
                    text: "Keep this copy";
                    entered => { panel = 0; }
                    clicked => {
                        HealthUi.keep-this(track-row);
                        root.close();
                    }
                }
                MenuLine {
                    icon: "hide";
                    text: "Ignore for " + HealthUi.cards[HealthUi.check].title;
                    entered => { panel = 0; }
                    clicked => {
                        HealthUi.ignore(track-row, track-last);
                        root.close();
                    }
                }
            }
            // The file.
            if FilesUi.has-file(track-row) || (StoreUi.source == 0 && HealthUi.can-quarantine): MenuSeparator {}
            if FilesUi.has-file(track-row): MenuLine {
                icon: "folder";
                text: "Show in " + FilesUi.file-manager;
                entered => { panel = 0; }
                clicked => {
                    FilesUi.reveal-track(track-row);
                    root.close();
                }
            }
            if StoreUi.source == 0 && HealthUi.can-quarantine: MenuLine {
                icon: "quarantine";
                text: count > 1 ? "Move " + count + " Tracks to Quarantine" : "Move to Quarantine";
                entered => { panel = 0; }
                clicked => {
                    HealthUi.quarantine(track-row, track-last);
                    root.close();
                }
            }
        }
    }
}

// Glyph per node kind, the collection's stages in their colors.
component FolderIcon inherits Rectangle {
    in property <int> kind;
    // A crate's color (-1 for none) and icon; see Folder.
    in property <int> tint: -1;
    in property <int> icon;
    width: 18px;
    height: 18px;
    // Folder: tab and body; a set's in lilac.
    if kind == 1 || kind == 14: Rectangle {
        Rectangle { x: 1px; y: 3px; width: 7px; height: 3px; border-radius: 1px; background: kind == 14 ? Theme.accent : Theme.text; }
        Rectangle { x: 1px; y: 5px; width: 16px; height: 11px; border-radius: 2px; background: kind == 14 ? Theme.accent : Theme.text; }
    }
    // Drive: a flat box with a light.
    if kind == 7: Rectangle {
        Rectangle { x: 1px; y: 5px; width: 16px; height: 9px; border-radius: 2px; border-width: 1.5px; border-color: Theme.text; }
        Rectangle { x: 12px; y: 8.5px; width: 2.5px; height: 2.5px; border-radius: 1.25px; background: Theme.text; }
    }
    // Bandcamp, in the stores list.
    if kind == 6: Image { width: 18px; height: 18px; source: @image-url("icons/bandcamp.png"); }
    // Cloud drive: a cloud outline.
    if kind == 9: Path {
        width: 18px;
        height: 18px;
        viewbox-width: 18;
        viewbox-height: 18;
        stroke: Theme.text;
        stroke-width: 1.5px;
        fill: transparent;
        commands: "M 5 14 A 3 3 0 0 1 4.6 8 A 4.5 4.5 0 0 1 13 6.8 A 3.6 3.6 0 0 1 13.6 14 Z";
    }
    // Artist: a head and shoulders.
    if kind == 20: Path {
        width: 18px;
        height: 18px;
        viewbox-width: 18;
        viewbox-height: 18;
        stroke: Theme.text;
        stroke-width: 1.5px;
        fill: transparent;
        commands: "M 9 2.5 A 3.2 3.2 0 1 1 8.99 2.5 Z M 2.5 16 A 6.5 5.5 0 0 1 15.5 16";
    }
    // Album: a record.
    if kind == 15: Path {
        width: 18px;
        height: 18px;
        viewbox-width: 18;
        viewbox-height: 18;
        stroke: Theme.text;
        stroke-width: 1.5px;
        fill: transparent;
        commands: "M 9 2 A 7 7 0 1 1 8.99 2 Z M 9 7.5 A 1.5 1.5 0 1 1 8.99 7.5 Z";
    }
    // Mixed sets: a long waveform.
    if kind == 16: Path {
        width: 18px;
        height: 18px;
        viewbox-width: 18;
        viewbox-height: 18;
        stroke: Theme.text;
        stroke-width: 1.5px;
        fill: transparent;
        commands: "M 2 8 L 2 10 M 5 5 L 5 13 M 8 7 L 8 11 M 11 3 L 11 15 M 14 6 L 14 12 M 17 8 L 17 10";
    }
    // Crate: an open box seen from the front, with its slats, or the icon
    // the DJ picked for it, in its color.
    if kind == 17: CrateIcon { icon: icon; tint: tint; }
    // Playlist: lines of a running order with a note, so it reads apart
    // from a folder and from a crate's slatted box. Always this icon.
    if kind == 2: Rectangle {
        Path {
            width: 18px;
            height: 18px;
            viewbox-width: 18;
            viewbox-height: 18;
            stroke: Theme.text;
            stroke-width: 1.6px;
            stroke-line-cap: round;
            fill: transparent;
            commands: "M 2 4 L 11 4 M 2 8.5 L 11 8.5 M 2 13 L 7.5 13 M 14.5 13.5 L 14.5 3.5 L 17 5";
        }
        Rectangle {
            x: 10.6px;
            y: 11.7px;
            width: 4.6px;
            height: 4.2px;
            border-radius: 2.1px;
            background: Theme.text;
        }
    }
    // Collection Health's Overview: the rail's Health icon.
    if kind == 12: Image {
        width: 18px;
        height: 18px;
        source: @image-url("icons/rail-health.svg");
    }
    // Collection Health's Ignored: a hollow dot.
    if kind == 22: Rectangle {
        x: 5px;
        y: 5px;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        border-width: 1.5px;
        border-color: Theme.text-dim;
    }
    // A Health area: a dot in its state's colour (`icon`).
    if kind == 21: Rectangle {
        x: 5px;
        y: 5px;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: Theme.health-state(icon);
    }
    // In Prep: a half-filled circle, drawn, as fonts' ◐ differ (macOS
    // falls back to one that shows stacked bars).
    if kind == 11: Rectangle {
        Path {
            width: 18px;
            height: 18px;
            viewbox-width: 18;
            viewbox-height: 18;
            fill: Theme.stage-prep;
            commands: "M 9 3 A 6 6 0 0 0 9 15 Z";
        }
        Path {
            width: 18px;
            height: 18px;
            viewbox-width: 18;
            viewbox-height: 18;
            stroke: Theme.stage-prep;
            stroke-width: 1.5px;
            fill: transparent;
            commands: "M 9 3 A 6 6 0 1 1 8.99 3 Z";
        }
    }
    if kind != 1 && kind != 2 && kind != 6 && kind != 7 && kind != 9 && kind != 11 && kind != 12 && kind != 21 && kind != 14 && kind != 15 && kind != 16 && kind != 17 && kind != 18 && kind != 20: Text {
        text: kind == 0 || kind == 19 ? "♫" : kind == 3 ? "✦" : kind == 4 ? "♥" : kind == 5 ? "◷" : kind == 8 ? "★" : kind == 10 ? "↓" : kind == 12 ? "✚" : kind == 13 ? "◦" : "≡";
        // The collection's stages in their own colors.
        color: Theme.stage-tint(kind);
        font-size: kind == 2 ? 18px : 14px;
        font-weight: 700;
    }
}

// A short centred note where content will go.
component Placeholder inherits Rectangle {
    in property <string> title;
    in property <string> text;
    VerticalLayout {
        alignment: center;
        spacing: 6px;
        padding: 16px;
        Text { text: title; color: Theme.text; font-size: 15px; font-weight: 600; horizontal-alignment: center; }
        Text { text: text; color: Theme.text-dim; font-size: 13px; horizontal-alignment: center; wrap: word-wrap; }
    }
}

// Icon for a music source in the rail: the collection,
// files, and the streaming services.
component SourceIcon inherits Rectangle {
    // 0 = collection, 1 = files, 2 = Spotify, 3 = TIDAL, 4 = Apple Music,
    // 5 = Bandcamp, 6 = Beatport, 7 = OneLibrary, 8 = SoundCloud,
    // 9 = albums, 10 = mixed sets, 11 = Mixcloud, 12 = instruments
    in property <int> kind;
    // Every icon fills the same 30 px; openDJ's own sit on a tile tinted
    // with their colour.
    width: 30px;
    height: 30px;
    border-radius: kind == 2 ? 15px : 7px;
    clip: kind == 3 || kind == 4 || kind == 6 || kind == 8;
    background: kind == 0 ? transparent
        : kind == 1 ? #B59AFF1F
        : kind == 9 ? #F3BD671F
        : kind == 10 ? #FF686F1F
        : kind == 12 ? #62D6CD1F
        : kind == 11 ? #314359
        : kind == 2 ? transparent
        : kind == 3 ? Theme.n-000000
        : kind == 5 || kind == 6 ? transparent
        : kind == 7 ? Theme.n-000000
        : kind == 8 ? #ff5500
        : @linear-gradient(180deg, #fc5c7d 0%, #fa2d48 100%);
    border-width: kind == 3 || kind == 7 ? 1px : 0px;
    border-color: Theme.border;
    // Collection: openDJ's own logo.
    if kind == 0: Image { width: 30px; height: 30px; source: @image-url("icons/opendj.svg"); }
    // Files: an open folder, in lilac.
    if kind == 1: Image { width: 22px; height: 22px; source: @image-url("icons/rail-files.svg"); }
    // Spotify: its own logo, unaltered as its brand rules ask.
    if kind == 2: Image { width: 30px; height: 30px; source: @image-url("icons/spotify.png"); }
    // TIDAL: its own logo.
    if kind == 3: Image { width: 30px; height: 30px; source: @image-url("icons/tidal.png"); }
    // Apple Music: its own logo, cropped to the button.
    if kind == 4: Image { width: 30px; height: 30px; source: @image-url("icons/applemusic.png"); }
    // Bandcamp: its logo.
    if kind == 5: Image { width: 30px; height: 30px; source: @image-url("icons/bandcamp.png"); }
    // Beatport: its own logo.
    if kind == 6: Image { width: 30px; height: 30px; source: @image-url("icons/beatport.png"); }
    // OneLibrary: its white logo on black.
    if kind == 7: Image { width: 22px; height: 22px; source: @image-url("icons/onelibrary.svg"); }
    // SoundCloud: its own logo.
    if kind == 8: Image { width: 30px; height: 30px; source: @image-url("icons/soundcloud.png"); }
    // Albums: a record, in amber.
    if kind == 9: Image { width: 22px; height: 22px; source: @image-url("icons/rail-albums.svg"); }
    // Mixcloud: a cloud on its navy.
    if kind == 11: Path {
        width: 30px;
        height: 30px;
        viewbox-width: 30;
        viewbox-height: 30;
        fill: Theme.n-ffffff;
        commands: "M 9.5 20 A 3.5 3.5 0 0 1 9.2 13 A 6 6 0 0 1 20.6 11.8 A 4.1 4.1 0 0 1 21 20 Z";
    }
    // Mixed sets, where recordings go too: a record button, in red.
    if kind == 10: Image { width: 22px; height: 22px; source: @image-url("icons/rail-recordings.svg"); }
    // Jam: a grid of pads, in teal.
    if kind == 12: Image { width: 22px; height: 22px; source: @image-url("icons/rail-instruments.svg"); }
}

// Collection Health in the rail: a first-aid cross, in pink.
component HealthIcon inherits Rectangle {
    width: 30px;
    height: 30px;
    border-radius: 7px;
    background: #F577A81F;
    Image { width: 22px; height: 22px; source: @image-url("icons/rail-health.svg"); }
}

// A button in the source rail, named in a tooltip beside it after a
// moment's hover.
component RailButton inherits Rectangle {
    in property <bool> selected;
    in property <string> tip;
    in property <string> tip-body;
    property <bool> tip-mine;
    callback clicked();
    height: 42px;
    border-radius: 8px;
    background: selected ? Theme.n-3a3a3d : (ta.has-hover ? Theme.n-262629 : transparent);
    @children
    ta := TouchArea {
        clicked => {
            if tip-mine {
                tip-mine = false;
                HoverTip.shown = false;
            }
            root.clicked();
        }
        changed has-hover => {
            if !self.has-hover && tip-mine {
                tip-mine = false;
                HoverTip.shown = false;
            }
        }
    }
    Timer {
        interval: 600ms;
        running: tip != "" && ta.has-hover && !tip-mine;
        triggered => {
            tip-mine = true;
            HoverTip.title = tip;
            HoverTip.body = tip-body;
            HoverTip.right-aligned = false;
            HoverTip.x = root.absolute-position.x + root.width + 8px;
            HoverTip.y = root.absolute-position.y + 6px;
            HoverTip.shown = true;
        }
    }
}

// Circling arrows at the top right of the Collection sidebar: looks for
// new and changed tracks in the music folders now. Turns once when clicked.
// The round-arrow refresh button at the top right of the side panel: Update
// collection under Library, reload playlists under a streaming service.
component RefreshButton inherits Rectangle {
    in property <string> tip-title;
    in property <string> tip-body;
    callback activated();
    property <int> turns;
    property <bool> tip-mine;
    width: 22px;
    height: 22px;
    border-radius: 5px;
    background: uta.has-hover ? Theme.n-2a2a2e : transparent;
    Path {
        width: 14px;
        height: 14px;
        viewbox-width: 16;
        viewbox-height: 16;
        stroke: uta.has-hover ? Theme.text : Theme.text-dim;
        stroke-width: 1.5px;
        fill: transparent;
        transform-rotation: turns * 360deg;
        animate transform-rotation { duration: 700ms; easing: ease-in-out; }
        commands: "M 13.5 6.5 A 5.8 5.8 0 0 0 2.6 6 M 2.5 9.5 A 5.8 5.8 0 0 0 13.4 10 M 13.6 2.5 L 13.6 6.5 L 9.6 6.5 M 2.4 13.5 L 2.4 9.5 L 6.4 9.5";
    }
    uta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            turns += 1;
            activated();
        }
        changed has-hover => {
            if !self.has-hover && tip-mine {
                tip-mine = false;
                HoverTip.shown = false;
            }
        }
    }
    Timer {
        interval: 600ms;
        running: uta.has-hover && !tip-mine;
        triggered => {
            tip-mine = true;
            HoverTip.title = tip-title;
            HoverTip.body = tip-body;
            HoverTip.right-aligned = true;
            HoverTip.x = root.absolute-position.x + root.width;
            HoverTip.y = root.absolute-position.y + root.height + 6px;
            HoverTip.shown = true;
        }
    }
}

// A drag handle: two columns of three dots, as in macOS lists.
export component DragGrip inherits Rectangle {
    in property <color> dot-color: Theme.text-dim;
    width: 8px;
    height: 13px;
    for k in 6: Rectangle {
        x: mod(k, 2) * 5px;
        y: floor(k / 2) * 5px;
        width: 3px;
        height: 3px;
        border-radius: 1.5px;
        background: root.dot-color;
    }
}

// An on/off switch, as in macOS.
component Switch inherits Rectangle {
    in property <bool> on;
    callback toggled();
    width: 34px;
    height: 20px;
    border-radius: 10px;
    background: on ? Theme.accent : Theme.n-48484a;
    Rectangle {
        x: on ? 16px : 2px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        // The knob stays white in Light too, as macOS draws it.
        background: #ffffff;
    }
    TouchArea { mouse-cursor: pointer; clicked => { toggled(); } }
}

// A section title in the rail's "..." menu.
component SourceMenuTitle inherits Rectangle {
    in property <string> text;
    height: 28px;
    Text {
        x: 6px;
        y: parent.height - self.height - 4px;
        text: root.text;
        color: Theme.text-dim;
        font-size: 11px;
        font-weight: 600;
    }
}

// A source's icon in the rail and its menu: openDJ's own drawing, or an
// add-on's picture (sources numbered from `built-ins`).
component RailIcon inherits Rectangle {
    in property <int> kind;
    in property <int> built-ins;
    width: 30px;
    height: 30px;
    if kind < built-ins: SourceIcon { kind: root.kind; }
    if kind >= built-ins: Image { width: 30px; height: 30px; source: SourceUi.sources[root.kind - root.built-ins].icon; }
}

// One section of the rail's "•••" menu: a row per source with a grip to
// drag it up or down and a switch to show it.
component SourceDragList inherits Rectangle {
    in property <[int]> items;
    in property <[string]> names;
    in property <[bool]> shown;
    callback toggled(source: int);
    property <length> row-h: 40px;
    property <int> drag-from: -1;
    property <length> drag-dy;
    property <length> drag-start;
    property <int> drag-to: drag-from < 0 ? -1 : max(0, min(items.length - 1, drag-from + round(drag-dy / row-h)));
    property <int> drag-kind;
    function name-of(i: int) -> string {
        i < names.length ? names[i] : SourceUi.sources[i - names.length].name
    }
    height: items.length * row-h;
    for i[pos] in items: Rectangle {
        // Rows between where the dragged one was and where it would go
        // step aside for it.
        property <length> shift: drag-from < 0 || pos == drag-from ? 0px
            : drag-from < drag-to && pos > drag-from && pos <= drag-to ? -row-h
            : drag-from > drag-to && pos < drag-from && pos >= drag-to ? row-h : 0px;
        // The dragged row stays put, unseen, so its grip keeps the mouse.
        opacity: pos == drag-from ? 0 : 1;
        x: 0;
        y: pos * row-h + shift;
        width: parent.width;
        height: row-h;
        animate y { duration: 100ms; }
        HorizontalLayout {
            padding-left: 2px;
            padding-right: 6px;
            spacing: 8px;
            Rectangle {
                width: 14px;
                DragGrip { dot-color: grip.has-hover ? Theme.text : Theme.text-dim; }
                grip := TouchArea {
                    mouse-cursor: drag-from >= 0 ? MouseCursor.grabbing : MouseCursor.grab;
                    pointer-event(e) => {
                        if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                            drag-from = pos;
                            drag-kind = i;
                            drag-start = self.absolute-position.y + self.mouse-y;
                            drag-dy = 0px;
                        }
                        if e.button == PointerEventButton.left && e.kind == PointerEventKind.up && drag-from >= 0 {
                            if drag-to != drag-from {
                                RailOrder.moved(i, drag-to - drag-from);
                            }
                            drag-from = -1;
                            drag-dy = 0px;
                        }
                    }
                    moved => {
                        if drag-from >= 0 {
                            drag-dy = self.absolute-position.y + self.mouse-y - drag-start;
                        }
                    }
                }
            }
            VerticalLayout { alignment: center; RailIcon { kind: i; built-ins: names.length; } }
            Text { text: name-of(i); color: Theme.text; font-size: 15px; vertical-alignment: center; horizontal-stretch: 1; }
            VerticalLayout {
                alignment: center;
                Switch {
                    on: shown[i];
                    toggled => { root.toggled(i); }
                }
            }
        }
    }
    // The row being dragged, over the others.
    if drag-from >= 0: Rectangle {
        y: max(0px, min(parent.height - row-h, drag-from * row-h + drag-dy));
        width: parent.width;
        height: row-h;
        border-radius: 8px;
        background: Theme.n-36363b;
        drop-shadow-blur: 10px;
        drop-shadow-color: Theme.s-00000080;
        HorizontalLayout {
            padding-left: 2px;
            padding-right: 6px;
            spacing: 8px;
            Rectangle { width: 14px; DragGrip { dot-color: Theme.text; } }
            VerticalLayout { alignment: center; RailIcon { kind: drag-kind; built-ins: names.length; } }
            Text { text: name-of(drag-kind); color: Theme.text; font-size: 15px; vertical-alignment: center; horizontal-stretch: 1; }
            VerticalLayout { alignment: center; Switch { on: shown[drag-kind]; } }
        }
    }
}

// The column of music sources down the left edge. The "..."
// under them picks which sources are shown; the collection always is.
component SourceRail inherits Rectangle {
    in-out property <int> source;
    in-out property <[bool]> shown;
    callback picked(source: int);
    callback health-picked();
    callback shown-changed(source: int, on: bool);
    property <[string]> names: ["Collection", "Files", "Spotify", "TIDAL", "Apple Music", "Bandcamp", "Beatport", "OneLibrary", "SoundCloud", "Albums", "Recordings", "Mixcloud", "Jam"];
    // The rail shows Collection, then RailOrder's sections in the DJ's
    // order. OneLibrary (7) isn't a source: openDJ writes it when exporting
    // to a USB stick. Bandcamp (5) and Beatport (6) wait for the stores.

    // What each source is, for its tooltip.
    property <[string]> tips: [
        "Every track in your library.",
        "Browse the folders on your computer.",
        "Search and browse Spotify.",
        "Search and browse TIDAL.",
        "Search and browse Apple Music.",
        "Bandcamp and the other stores you buy from.",
        "Search and browse Beatport.",
        "Browse a OneLibrary collection.",
        "Search and browse SoundCloud.",
        "The albums in your Albums folder.",
        "Your own recordings and the long mixes in your Recordings folder.",
        "Search and browse Mixcloud.",
        "The Groove Box, instrument plugins and inputs, to drag onto a deck."
    ];
    width: 52px;
    background: Theme.browser;
    // On a short window the sources scroll under the "•••", which stays in
    // view; they would otherwise set how short the whole window can be.
    column := VerticalLayout {
        alignment: start;
        padding: 5px;
        rail-scroll := Flickable {
            min-height: 0px;
            preferred-height: rail.preferred-height;
            max-height: rail.preferred-height;
            content-height: rail.preferred-height;
            interactive: self.content-height > self.height;
            rail := VerticalLayout {
                width: rail-scroll.width;
                alignment: start;
                // Hidden sources fold to nothing; each shown one carries its own gap.
                // Collection Health sits under the collection, with how many checks
                // find something.
                // Collection, always first, with Collection Health under it.
                Rectangle {
                    height: HealthUi.rail-shown ? 96px : 48px;
                    RailButton {
                        y: 0;
                        selected: 0 == source && !HealthUi.view;
                        tip: names[0];
                        tip-body: tips[0];
                        SourceIcon { kind: 0; }
                        clicked => { source = 0; picked(0); }
                    }
                    if HealthUi.rail-shown: RailButton {
                        y: 48px;
                        selected: source == 0 && HealthUi.view;
                        tip: "Collection Health";
                        tip-body: "Checks your collection for duplicates, missing files and poor tags.";
                        HealthIcon {}
                        clicked => { source = 0; health-picked(); }
                    }
                }
                // The rest in the DJ's order; add-ons' sources are numbered
                // on from the built-in ones.
                for i in RailOrder.built-in: Rectangle {
                    height: shown[i] ? 48px : 0px;
                    visible: shown[i];
                    RailButton {
                        y: 0;
                        selected: i == source;
                        tip: i < names.length ? names[i] : SourceUi.sources[i - names.length].name;
                        tip-body: i < names.length ? tips[i] : "From an add-on.";
                        RailIcon { kind: i; built-ins: names.length; }
                        clicked => { source = i; picked(i); }
                    }
                }
                for i in RailOrder.external: Rectangle {
                    height: shown[i] ? 48px : 0px;
                    visible: shown[i];
                    RailButton {
                        y: 0;
                        selected: i == source;
                        tip: i < names.length ? names[i] : SourceUi.sources[i - names.length].name;
                        tip-body: i < names.length ? tips[i] : "From an add-on.";
                        RailIcon { kind: i; built-ins: names.length; }
                        clicked => { source = i; picked(i); }
                    }
                }
            }
        }
        more := Rectangle {
            height: 30px;
            border-radius: 8px;
            background: mta.has-hover ? Theme.n-262629 : transparent;
            Text { text: "•••"; color: mta.has-hover ? Theme.text : Theme.text-dim; font-size: 11px; letter-spacing: 1px; }
            mta := TouchArea { mouse-cursor: pointer; clicked => { menu.show(); } }
        }
    }
    menu := PopupWindow {
        x: root.width + 4px;
        y: max(4px, column.y + more.y + more.height - self.height);
        width: 264px;
        height: list.preferred-height;
        close-policy: close-on-click-outside;
        Rectangle {
            background: Theme.n-2a2a2d;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 16px;
            drop-shadow-color: Theme.s-00000080;
        }
        list := VerticalLayout {
            padding: 8px;
            spacing: 2px;
            SourceMenuTitle { text: "Built-in"; }
            // Collection Health, which sits under the collection and stays
            // there: no grip, its icon lined up with the rows below.
            HorizontalLayout {
                height: 40px;
                padding-left: 24px;
                padding-right: 6px;
                spacing: 8px;
                VerticalLayout { alignment: center; HealthIcon {} }
                Text { text: "Collection Health"; color: Theme.text; font-size: 15px; vertical-alignment: center; horizontal-stretch: 1; }
                VerticalLayout {
                    alignment: center;
                    Switch {
                        on: HealthUi.rail-shown;
                        toggled => {
                            HealthUi.rail-shown = !HealthUi.rail-shown;
                            shown-changed(-1, HealthUi.rail-shown);
                        }
                    }
                }
            }
            SourceDragList {
                items: RailOrder.built-in;
                names: names;
                shown: shown;
                toggled(i) => {
                    shown[i] = !shown[i];
                    shown-changed(i, shown[i]);
                }
            }
            SourceMenuTitle { text: "External"; }
            SourceDragList {
                items: RailOrder.external;
                names: names;
                shown: shown;
                toggled(i) => {
                    shown[i] = !shown[i];
                    shown-changed(i, shown[i]);
                }
            }
        }
    }
}

// The purchase inbox, under the stores: what it's doing, on or off, and
// what it does with what arrives.
component InboxPanel inherits Rectangle {
    property <[string]> modes: ["Move", "Copy", "Leave"];
    border-radius: Theme.radius;
    background: Theme.n-232326;
    height: layout.preferred-height;
    layout := VerticalLayout {
        padding: 10px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 8px;
            Text { text: "Purchase inbox"; color: Theme.text; font-size: 13px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
            // On/off switch.
            Rectangle {
                width: 34px;
                height: 20px;
                border-radius: 10px;
                background: StoreUi.inbox-on ? #30c158 : Theme.n-48484a;
                Rectangle {
                    x: StoreUi.inbox-on ? 16px : 2px;
                    width: 16px;
                    height: 16px;
                    border-radius: 8px;
                    background: Theme.n-ffffff;
                }
                TouchArea { mouse-cursor: pointer; clicked => { StoreUi.set-inbox(!StoreUi.inbox-on); } }
            }
        }
        Text { text: StoreUi.inbox-status; color: Theme.text-dim; font-size: 11px; wrap: word-wrap; }
        HorizontalLayout {
            spacing: 4px;
            for m[i] in modes: Rectangle {
                height: 22px;
                border-radius: 5px;
                background: i == StoreUi.inbox-mode ? Theme.n-3a3a3d : (mta.has-hover ? Theme.n-2c2c2f : transparent);
                border-width: 1px;
                border-color: Theme.border;
                Text { text: m; color: i == StoreUi.inbox-mode ? Theme.text : Theme.text-dim; font-size: 11px; }
                mta := TouchArea { mouse-cursor: pointer; clicked => { StoreUi.set-inbox-mode(i); } }
            }
        }
        Text {
            text: StoreUi.inbox-mode == 0 ? "Purchases move into Purchased in your music folder."
                : StoreUi.inbox-mode == 1 ? "Purchases are copied into Purchased; downloads stay put."
                : "Purchases are added where they downloaded.";
            color: Theme.text-dim;
            font-size: 11px;
            wrap: word-wrap;
        }
    }
}

// Signing in to a streaming service (2 = Spotify, 3 = TIDAL, 4 = Apple
// Music, 8 = SoundCloud, 11 = Mixcloud), shown in the sidebar until connected.
component SpotifyConnect inherits Rectangle {
    in property <int> source: 2;
    property <bool> tidal: source == 3;
    // Apple Music signs with the DJ's MusicKit key: Team ID, Key ID and the
    // .p8 file.
    property <bool> apple: source == 4;
    // SoundCloud's sign-in needs the app's secret as well.
    property <bool> soundcloud: source == 8;
    // Mixcloud needs only the DJ's username.
    property <bool> mixcloud: source == 11;
    property <string> service: tidal ? "TIDAL" : apple ? "Apple Music" : soundcloud ? "SoundCloud" : mixcloud ? "Mixcloud" : "Spotify";
    in-out property <string> client-id;
    property <string> secret;
    property <string> key-id;
    in property <string> status;
    callback connect(client-id: string);
    VerticalLayout {
        alignment: center;
        spacing: 10px;
        padding: 14px;
        HorizontalLayout { alignment: center; SourceIcon { kind: source; } }
        Text { text: "Connect " + service; color: Theme.text; font-size: 15px; font-weight: 600; horizontal-alignment: center; }
        Text {
            text: mixcloud ? "See your shows, favourites, listening history and playlists here. Shows play on mixcloud.com."
                : soundcloud ? "See your likes, tracks and playlists here. Tracks that are also in your collection can be played; others open on soundcloud.com."
                : apple ? "See your library's playlists and songs here. Songs that are also in your collection can be played."
                : tidal ? "See your playlists and favourite tracks here. Tracks that are also in your collection can be played."
                : "See your playlists and liked songs here. Tracks that are also in your collection can be played.";
            color: Theme.text-dim; font-size: 13px; horizontal-alignment: center; wrap: word-wrap;
        }
        LineEdit { text <=> client-id; placeholder-text: mixcloud ? "Your Mixcloud username" : apple ? "Your Team ID" : "Client ID of your " + service + " app"; }
        if apple: LineEdit { text <=> key-id; placeholder-text: "MusicKit Key ID (kept from last time if empty)"; }
        if apple: LineEdit { text <=> secret; placeholder-text: "Path to the key's .p8 file (kept if empty)"; }
        if soundcloud: LineEdit { text <=> secret; input-type: password; placeholder-text: "Client secret (kept from last time if empty)"; }
        Rectangle {
            height: 32px;
            border-radius: 16px;
            background: tidal || mixcloud ? (cta.pressed ? #dddddd : #ffffff) : apple ? (cta.pressed ? #d9263d : #fa2d48) : soundcloud ? (cta.pressed ? #e64d00 : #ff5500) : cta.pressed ? #1db954 : #1ed760;
            Text { text: mixcloud ? "Connect" : "Sign in with " + service; color: soundcloud || apple ? #ffffff : #000000; font-size: 13px; font-weight: 700; }
            cta := TouchArea { clicked => { connect(soundcloud ? client-id + " " + secret : apple ? client-id + "\n" + key-id + "\n" + secret : client-id); } }
        }
        if status != "": Text { text: status; color: Theme.text; font-size: 13px; horizontal-alignment: center; wrap: word-wrap; }
        if !mixcloud: Text {
            text: soundcloud ? "First time? Register an app at soundcloud.com/you/apps with the redirect URI http://127.0.0.1:8898/callback, then paste its client ID and secret above."
                : apple ? "Needs an Apple Developer account. First time? Under Certificates, Identifiers & Profiles › Keys, create a key with MusicKit, download its .p8 file, and enter its Key ID, your Team ID and the file's path above."
                : tidal ? "First time? Create an app at developer.tidal.com with the redirect URI http://127.0.0.1:8898/callback and the scopes user.read, playlists.read and collection.read, then paste its client ID above."
                : "First time? Create an app at developer.spotify.com with the redirect URI http://127.0.0.1:8898/callback, then paste its client ID above.";
            color: Theme.text-dim; font-size: 12px; horizontal-alignment: center; wrap: word-wrap;
        }
    }
}

// Under the Files tree: whether listings include subfolders, and what
// adding a folder to the collection did.
component FilesOptions inherits VerticalLayout {
    padding-left: 8px;
    spacing: 4px;
    Rectangle {
        height: 28px;
        HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 16px;
                    height: 16px;
                    border-radius: 4px;
                    border-width: 1.5px;
                    border-color: FilesUi.recursive ? Theme.accent : Theme.text-dim;
                    background: FilesUi.recursive ? Theme.accent : transparent;
                    if FilesUi.recursive: Text { text: "✓"; color: #000000; font-size: 11px; font-weight: 700; }
                }
            }
            Text { text: "Include subfolders"; color: Theme.text; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; }
        }
        TouchArea {
            mouse-cursor: pointer;
            clicked => {
                FilesUi.recursive = !FilesUi.recursive;
                FilesUi.set-recursive(FilesUi.recursive);
            }
        }
    }
    if FilesUi.status != "": Text { text: FilesUi.status; color: Theme.text-dim; font-size: 12px; wrap: word-wrap; }
}

// A small closed padlock, for read-only rows.
component Padlock inherits Rectangle {
    in property <color> tint;
    width: 10px;
    height: 12px;
    Path {
        x: 1.5px;
        y: 0px;
        width: 7px;
        height: 6px;
        viewbox-width: 7;
        viewbox-height: 6;
        stroke: tint;
        stroke-width: 1.4px;
        fill: transparent;
        commands: "M 0.7 6 L 0.7 3.5 A 2.8 2.8 0 0 1 6.3 3.5 L 6.3 6";
    }
    Rectangle {
        y: 5px;
        height: 7px;
        border-radius: 1.5px;
        background: tint;
    }
}

component FolderTree inherits Rectangle {
    in property <[Folder]> folders;
    in property <int> current;
    // A controller's browse knob is moving through folders, not tracks.
    in property <bool> focused;
    // Which source the rail has selected; only the collection has lists yet.
    in property <int> source;
    in-out property <int> tab;
    in property <bool> spotify-connected;
    in property <string> spotify-user;
    in property <string> spotify-status;
    in-out property <string> spotify-client-id;
    callback select(index: int);
    callback toggle(index: int);
    callback spotify-connect(client-id: string);
    callback spotify-disconnect();
    callback spotify-refresh();
    // The smart list whose search the popup is editing, and the search.
    property <int> rename-index: -1;
    property <string> rename-text;
    // The row being named in place, as in Finder, and the name typed so far.
    property <int> naming-row: -1;
    property <string> naming-text;
    // Opens the name editor on a row with its name selected, so typing
    // replaces it and Esc keeps it.
    function name-in-place(row: int) {
        if row >= 0 && row < folders.length {
            naming-text = folders[row].name;
            naming-row = row;
        }
    }
    // Enter or a click elsewhere keeps what was typed; Esc keeps the old name.
    function finish-naming(keep: bool) {
        if naming-row >= 0 {
            let row = naming-row;
            naming-row = -1;
            if keep && naming-text != folders[row].name {
                LibraryEdit.rename(row, naming-text);
            }
        }
    }
    // A search just saved as a smart list: name it in place.
    property <int> name-row: LibraryEdit.name-row;
    changed name-row => {
        if name-row >= 0 {
            let row = name-row;
            LibraryEdit.name-row = -1;
            name-in-place(row);
        }
    }
    // The node the right-click menu is for, and where it opens.
    property <int> menu-index;
    property <string> menu-name;
    property <int> menu-kind;
    property <bool> menu-editable;
    property <bool> menu-analysable;
    property <bool> menu-locked;
    property <bool> menu-adoptable;
    property <bool> menu-bundle;
    property <int> menu-color;
    property <int> menu-icon;
    property <length> menu-y;
    // The + on Playlists: a playlist, a smart playlist or a folder.
    property <length> add-y;
    // The streaming account under "Signed in as": Sign out.
    property <length> account-y;
    account-menu := PopupWindow {
        x: 8px;
        y: account-y;
        width: 140px;
        close-policy: close-on-click-outside;
        MenuBackground {}
        VerticalLayout {
            padding: 6px;
            MenuLine {
                text: "Sign out";
                clicked => {
                    account-menu.close();
                    spotify-disconnect();
                }
            }
        }
    }
    // + on Crates: a crate or a folder for crates.
    crate-menu := PopupWindow {
        x: 130px;
        y: add-y;
        width: 180px;
        close-policy: close-on-click-outside;
        MenuBackground {}
        VerticalLayout {
            padding: 6px;
            MenuLine {
                text: "Crate";
                clicked => {
                    name-in-place(LibraryEdit.create(0, -1));
                    crate-menu.close();
                }
            }
            MenuLine {
                text: "Crate Folder";
                clicked => {
                    name-in-place(LibraryEdit.create(3, -1));
                    crate-menu.close();
                }
            }
        }
    }
    add-menu := PopupWindow {
        x: 130px;
        y: add-y;
        width: 180px;
        close-policy: close-on-click-outside;
        MenuBackground {}
        VerticalLayout {
            padding: 6px;
            MenuLine {
                text: "Playlist";
                clicked => {
                    add-menu.close();
                    name-in-place(LibraryEdit.create(2, -1));
                }
            }
            MenuLine {
                text: "Smart Playlist";
                clicked => {
                    add-menu.close();
                    LibraryEdit.start-smart-list();
                    LibraryEdit.making-smart = true;
                    FilterUi.open-add = true;
                }
            }
            MenuLine {
                text: "Playlist Folder";
                clicked => {
                    add-menu.close();
                    name-in-place(LibraryEdit.create(1, -1));
                }
            }
            MenuSeparator {}
            MenuLine {
                text: "Import Playlist File…";
                clicked => {
                    add-menu.close();
                    LibraryEdit.import-playlist-file();
                }
            }
        }
    }
    // A line shown with `if` lives in its own part of the popup, which
    // close() frees at once: anything after close() in its handler that
    // reaches outside the popup (menu-index, name-in-place, another popup)
    // silently does nothing. So each line acts first and closes last.
    folder-menu := PopupWindow {
        x: 40px;
        y: menu-y;
        // Wider for a crate's color and icon rows.
        width: (menu-editable && menu-kind == 17) || (source == 0 && menu-locked) ? 230px : 170px;
        close-policy: close-on-click-outside;
        MenuBackground {}
        VerticalLayout {
            padding: 6px;
            if StoreUi.source == 9 && menu-kind == 15: MenuLine {
                text: "Play Album";
                clicked => {
                    LibraryEdit.play-album-folder(menu-index);
                    folder-menu.close();
                }
            }
            // A Spotify playlist; Liked Songs (kind 4) has no link to download.
            if StoreUi.source == 2: MenuLine {
                text: "Open in Browser";
                clicked => {
                    StoreUi.open-playlist(menu-index);
                    folder-menu.close();
                }
            }
            // A list with streamed tracks standing in it: the tracks the
            // collection hasn't got. A store's cart joins these later.
            if !StoreUi.stream(StoreUi.source) && WantedUi.list-streamed(menu-index): MenuLine {
                text: "Add to Wanted";
                clicked => {
                    WantedUi.add-list(menu-index);
                    folder-menu.close();
                }
            }
            // A streaming playlist: its missing tracks go on the Wanted list,
            // and so do ones added to it later.
            if StoreUi.stream(StoreUi.source): MenuLine {
                text: WantedUi.list-synced(menu-index) ? "Stop Adding to Wanted" : "Add to Wanted";
                clicked => {
                    WantedUi.toggle-sync(menu-index);
                    folder-menu.close();
                }
            }
            if StoreUi.downloads-to != "" && ((StoreUi.source == 2 && menu-kind != 4) || (StoreUi.source != 2 && WantedUi.list-streamed(menu-index))): MenuLine {
                text: "Add to Downloads";
                clicked => {
                    StoreUi.download-playlist(menu-index);
                    folder-menu.close();
                }
            }
            // Another app's lists: say why they can't be changed, and offer
            // to keep them as the DJ's own.
            if source == 0 && menu-locked: Text {
                x: 10px;
                height: 24px;
                text: "Read-only: the import updates it";
                color: Theme.text-dim;
                font-size: 12px;
                vertical-alignment: center;
            }
            if source == 0 && menu-bundle: MenuLine {
                text: "Move to Albums";
                clicked => {
                    LibraryEdit.move-node-album(menu-index);
                    folder-menu.close();
                }
            }
            if source == 0 && menu-adoptable: MenuLine {
                text: "Make These Lists Mine";
                clicked => {
                    LibraryEdit.adopt-import(menu-index);
                    folder-menu.close();
                }
            }
            if source == 0 && menu-locked: MenuSeparator {}
            if source == 0 && KeepGoingUi.player && (menu-kind == 17 || menu-kind == 2): MenuLine {
                text: "Start Radio";
                clicked => {
                    KeepGoingUi.start-list-radio(menu-index);
                    folder-menu.close();
                }
            }
            if menu-analysable: MenuLine {
                text: "Analyze All";
                clicked => {
                    LibraryEdit.analyze-all(menu-index);
                    folder-menu.close();
                }
            }
            if menu-editable && menu-kind == 1: MenuLine {
                text: "New Crate";
                clicked => {
                    name-in-place(LibraryEdit.create(0, menu-index));
                    folder-menu.close();
                }
            }
            if menu-editable && menu-kind == 1: MenuLine {
                text: "New Playlist";
                clicked => {
                    name-in-place(LibraryEdit.create(2, menu-index));
                    folder-menu.close();
                }
            }
            if menu-editable && menu-kind == 1: MenuLine {
                text: "New Folder";
                clicked => {
                    name-in-place(LibraryEdit.create(1, menu-index));
                    folder-menu.close();
                }
            }
            if (menu-analysable || menu-kind == 1) && menu-editable: MenuSeparator {}
            // A crate's color and icon.
            if menu-editable && menu-kind == 17: HorizontalLayout {
                height: 26px;
                padding-left: 10px;
                spacing: 2px;
                Text { text: "Color"; color: Theme.text-dim; font-size: 12px; vertical-alignment: center; width: 44px; }
                for c[i] in LibraryEdit.list-colors: Rectangle {
                    width: 18px;
                    Rectangle {
                        width: 18px;
                        height: 18px;
                        border-radius: 9px;
                        border-width: i == menu-color ? 1.5px : 0;
                        border-color: Theme.text;
                    }
                    Rectangle {
                        width: csw.has-hover || i == menu-color ? 12px : 11px;
                        height: self.width;
                        border-radius: self.width / 2;
                        background: c;
                    }
                    csw := TouchArea {
                        clicked => {
                            LibraryEdit.set-list-color(menu-index, i);
                            folder-menu.close();
                        }
                    }
                }
                Rectangle {
                    width: 18px;
                    Rectangle {
                        width: 12px;
                        height: 12px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: cnone.has-hover || menu-color < 0 ? Theme.text : Theme.text-dim;
                    }
                    Text { text: "×"; color: cnone.has-hover || menu-color < 0 ? Theme.text : Theme.text-dim; font-size: 10px; }
                    cnone := TouchArea {
                        clicked => {
                            LibraryEdit.set-list-color(menu-index, -1);
                            folder-menu.close();
                        }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            if menu-editable && menu-kind == 17: HorizontalLayout {
                height: 26px;
                padding-left: 10px;
                spacing: 2px;
                Text { text: "Icon"; color: Theme.text-dim; font-size: 12px; vertical-alignment: center; width: 44px; }
                for n in 8: Rectangle {
                    width: 18px;
                    Rectangle {
                        width: 20px;
                        height: 20px;
                        border-radius: 4px;
                        background: n == menu-icon ? Theme.text.transparentize(0.8) : isw.has-hover ? Theme.text.transparentize(0.9) : transparent;
                    }
                    FolderIcon { kind: 17; icon: n; tint: menu-color; }
                    isw := TouchArea {
                        clicked => {
                            LibraryEdit.set-list-icon(menu-index, n);
                            folder-menu.close();
                        }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            if menu-editable && menu-kind == 17: MenuSeparator {}
            // A crate keeps no order and each track once; a playlist keeps
            // an order. (Playlists no longer offer the way back.)
            if menu-editable && menu-kind == 17: MenuLine {
                text: "Make It a Playlist";
                clicked => {
                    LibraryEdit.set-crate(menu-index, false);
                    folder-menu.close();
                }
            }
            if menu-editable: MenuLine {
                text: "Rename…";
                clicked => {
                    name-in-place(menu-index);
                    folder-menu.close();
                }
            }
            if menu-editable && menu-kind == 3: MenuLine {
                text: "Edit search…";
                clicked => {
                    rename-index = menu-index;
                    rename-text = LibraryEdit.rule-at(menu-index);
                    rename-popup.show();
                    folder-menu.close();
                }
            }
            if menu-editable: MenuLine {
                text: menu-kind == 1 ? "Delete folder and its lists" : menu-kind == 17 ? "Delete crate" : "Delete list";
                text-color: Theme.c-ff6b5e;
                clicked => {
                    LibraryEdit.delete(menu-index);
                    folder-menu.close();
                }
            }
        }
    }

    // Right-click menu on a folder in Files.
    files-menu := PopupWindow {
        x: 40px;
        y: menu-y;
        width: 200px;
        close-policy: close-on-click-outside;
        MenuBackground {}
        VerticalLayout {
            padding: 6px;
            MenuLine {
                text: menu-kind == 8 ? "Unpin" : "Pin to top";
                clicked => {
                    FilesUi.pin(menu-index);
                    files-menu.close();
                }
            }
            MenuLine {
                text: "Add to Collection";
                clicked => {
                    FilesUi.add-folder(menu-index);
                    files-menu.close();
                }
            }
            MenuLine {
                text: "Show in " + FilesUi.file-manager;
                clicked => {
                    FilesUi.reveal-folder(menu-index);
                    files-menu.close();
                }
            }
        }
    }

    background: Theme.browser;
    width: 270px;
    rename-popup := PopupWindow {
        x: 8px;
        y: 76px;
        width: parent.width - 16px;
        close-policy: close-on-click-outside;
        MenuBackground {}
        VerticalLayout {
            padding: 8px;
            spacing: 6px;
            Text { text: "Search"; color: Theme.text-dim; font-size: 12px; }
            LineEdit {
                text <=> rename-text;
                placeholder-text: "bpm:120-128 ~key:8A";
                accepted(t) => {
                    LibraryEdit.set-rule(rename-index, t);
                    rename-popup.close();
                }
                init => { self.focus(); }
            }
            HorizontalLayout {
                alignment: end;
                spacing: 6px;
                MenuLine {
                    width: 70px;
                    text: "Cancel";
                    clicked => { rename-popup.close(); }
                }
                MenuLine {
                    width: 60px;
                    text: "OK";
                    text-color: Theme.lilac-text;
                    clicked => {
                        LibraryEdit.set-rule(rename-index, rename-text);
                        rename-popup.close();
                    }
                }
            }
        }
    }
    VerticalLayout {
        padding: 8px;
        padding-top: 0px;
        spacing: 6px;
        // Lists and History tabs, in words like the side panel's and
        // underlined in the accent when selected. Only over the collection:
        // the history is the collection's, not Files', a store's or
        // Collection Health's.
        if !HealthUi.view && source == 0: HorizontalLayout {
            height: 38px;
            for name[i] in ["Lists", "History"]: Rectangle {
                property <bool> on: i == tab;
                background: lta.has-hover && !on ? Theme.n-ffffff08 : transparent;
                Text {
                    text: name;
                    color: on ? Theme.lilac-text : lta.has-hover ? Theme.text : Theme.text-dim;
                    font-size: 13px;
                    font-weight: on ? 600 : 500;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                Rectangle {
                    y: parent.height - 2px;
                    height: 2px;
                    background: on ? Theme.accent : transparent;
                }
                lta := TouchArea {
                    clicked => {
                        if tab != i {
                            tab = i;
                            LibraryEdit.history-tab = i == 1;
                            LibraryEdit.show-history(i == 1);
                        }
                    }
                }
            }
        }
        if !HealthUi.view && source == 0: EdgeLine { left: 8px; right: 8px; }
        if HealthUi.view || source != 0: Rectangle { height: 8px; }
        if tab == 1 && folders.length == 0: Placeholder {
            vertical-stretch: 1;
            title: "History";
            text: "Tracks you play will be listed here, one list per session.";
        }
        if tab == 0 && StoreUi.stream(source) && StoreUi.streaming && !spotify-connected: SpotifyConnect {
            source: source;
            vertical-stretch: 1;
            client-id <=> spotify-client-id;
            status: spotify-status;
            connect(id) => { spotify-connect(id); }
        }
        if tab == 0 && source >= 2 && source != 9 && source != 10 && source < 12 && !(StoreUi.streaming && StoreUi.stream(source)) && !(StoreUi.stores && source == 5): Placeholder {
            vertical-stretch: 1;
            title: ["", "", "Spotify", "TIDAL", "Apple Music", "Bandcamp", "Beatport", "OneLibrary", "SoundCloud", "Albums", "Recordings", "Mixcloud"][source];
            text: "Coming soon.";
        }
        if (tab == 0 && (source == 0 || source == 1 || source == 9 || source == 10 || (StoreUi.stores && source == 5) || (StoreUi.streaming && StoreUi.stream(source) && spotify-connected))) || (tab == 1 && folders.length > 0): VerticalLayout {
            spacing: 6px;
            HorizontalLayout {
                padding-left: 8px;
                height: 26px;
                Text { text: tab == 1 ? "Sessions" : source == 1 ? "Folders" : source == 0 ? (HealthUi.view ? "Collection Health" : "Library") : ["", "", "Spotify", "TIDAL", "Apple Music", "Bandcamp", "Beatport", "OneLibrary", "SoundCloud", "Albums", "Recordings", "Mixcloud"][source]; color: Theme.text; font-size: 15px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                if tab == 0 && source == 0 && !HealthUi.view: VerticalLayout {
                    alignment: center;
                    RefreshButton {
                        tip-title: "Update collection";
                        tip-body: "Looks for new and changed tracks in your music folders.";
                        activated => { LibraryEdit.update-collection(); }
                    }
                }
                if tab == 0 && StoreUi.streaming && StoreUi.stream(source) && spotify-connected: VerticalLayout {
                    alignment: center;
                    RefreshButton {
                        tip-title: "Refresh";
                        tip-body: "Reloads your playlists from the service.";
                        activated => { spotify-refresh(); }
                    }
                }
            }
            ListView {
                gutter: true;
                for f[i] in folders: Rectangle {
                    // A line sets the Crates heading apart from the collection.
                    height: f.separator ? 45px : 34px;
                    if f.separator: Rectangle {
                        x: 8px;
                        y: 5px;
                        width: parent.width - 16px;
                        height: 1px;
                        background: Theme.border;
                    }
                    Rectangle {
                    y: parent.height - 34px;
                    height: 34px;
                    border-radius: Theme.radius;
                    background: drop.has-drag ? Theme.selection.transparentize(0.4) : i == current ? (focused ? Theme.selection : Theme.selection-idle) : (ta.has-hover ? Theme.n-232326 : transparent);
                    // The DJ's own lists and folders drag onto a folder, or a
                    // heading, to move there.
                    DragArea {
                        enabled: f.editable && tab == 0 && source == 0;
                        data: LibraryEdit.list-payload(i);
                        allow-copy: true;
                        ta := TouchArea {
                            clicked => { select(i); }
                            double-clicked => { toggle(i); }
                            pointer-event(e) => {
                                if (((f.editable || f.analysable || f.adoptable || f.bundle || source == 1 || StoreUi.stream(source)) && tab == 0) || (tab == 1 && f.kind == 5)) && e.button == PointerEventButton.right && e.kind == PointerEventKind.down {
                                    menu-index = i;
                                    menu-name = f.name;
                                    menu-kind = f.kind;
                                    menu-editable = f.editable;
                                    menu-locked = f.locked;
                                    menu-adoptable = f.adoptable;
                                    menu-bundle = f.bundle;
                                    menu-color = f.color;
                                    menu-icon = f.icon;
                                    menu-analysable = f.analysable && (source == 0 || source == 9 || source == 10);
                                    menu-y = self.absolute-position.y - root.absolute-position.y + self.height;
                                    if source == 1 { files-menu.show(); } else { folder-menu.show(); }
                                }
                            }
                        }
                    }
                    // Tracks dragged from the list onto one of the DJ's lists or
                    // crates join it; dropped on a stage, they move there.
                    drop := DropArea {
                        can-drop(e) => { (((f.editable && (f.kind == 2 || f.kind == 17)) || f.stage) && LibraryEdit.accepts-drop(i, e.data)) || ((f.kind == 1 || f.kind == 18) && LibraryEdit.accepts-list-move(i, e.data)) ? DragAction.copy : DragAction.none }
                        dropped(e) => {
                            LibraryEdit.drop(i, e.data);
                            TrackDrag.active = false;
                            DragAction.copy
                        }
                    }
                    HorizontalLayout {
                        padding-left: 4px + f.depth * 16px;
                        spacing: 8px;
                        Rectangle {
                            width: 12px;
                            // Disclosure arrow, drawn so every font shows it the same:
                            // right when closed, down when open, as in Finder.
                            if f.children > 0: Path {
                                width: 10px;
                                height: 10px;
                                viewbox-width: 10;
                                viewbox-height: 10;
                                stroke: Theme.text-dim;
                                stroke-width: 1.6px;
                                stroke-line-cap: round;
                                fill: transparent;
                                commands: f.children == 2 ? "M 2 3.5 L 5 6.5 L 8 3.5" : "M 3.5 2 L 6.5 5 L 3.5 8";
                            }
                            TouchArea { clicked => { toggle(i); } }
                        }
                        // The Crates and Playlists headings have no icon.
                        // Nor do the history tab's days.
                        if f.kind != 18 && f.kind != 23: VerticalLayout { alignment: center; FolderIcon { kind: f.kind; tint: f.color; icon: f.icon; } }
                        // A new or renamed list is named right here.
                        if i == naming-row: VerticalLayout {
                            alignment: center;
                            padding-right: 4px;
                            horizontal-stretch: 1;
                            Rectangle {
                                height: 26px;
                                border-radius: 4px;
                                background: Theme.well;
                                name-input := TextInput {
                                    x: 6px;
                                    width: parent.width - 12px;
                                    text <=> naming-text;
                                    color: Theme.text;
                                    selection-background-color: Theme.accent;
                                    selection-foreground-color: #ffffff;
                                    font-size: 15px;
                                    vertical-alignment: center;
                                    single-line: true;
                                    accepted => { finish-naming(true); }
                                    key-pressed(e) => {
                                        if e.text == Key.Escape {
                                            finish-naming(false);
                                            return accept;
                                        }
                                        reject
                                    }
                                    changed has-focus => {
                                        if !self.has-focus { finish-naming(true); }
                                    }
                                    init => {
                                        self.focus();
                                        self.select-all();
                                    }
                                }
                            }
                        }
                        if i != naming-row: Text {
                            text: f.name;
                            color: i == current ? Theme.on-row-selection : f.kind == 18 || f.dim ? Theme.text-dim : Theme.stage-labels ? Theme.stage-tint(f.kind) : Theme.text;
                            font-size: f.kind == 18 ? 13px : 15px;
                            font-weight: f.kind == 18 ? 700 : f.kind == 23 ? 600 : 400;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        if f.count >= 0: Text {
                            text: f.count;
                            color: i == current ? Theme.on-row-selection : Theme.text-dim;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                        if f.count >= 0: Rectangle { width: 2px; }
                        // An imported list: read-only until made the DJ's own.
                        if f.locked && i != naming-row: VerticalLayout {
                            alignment: center;
                            Padlock { tint: i == current ? Theme.on-row-selection : Theme.text-dim; }
                        }
                        if f.locked && i != naming-row: Rectangle { width: 4px; }
                        // New crate, or a new folder in Playlists.
                        if f.kind == 18 && tab == 0 && !f.locked: Rectangle {
                            width: 26px;
                            Text { text: "+"; color: pta.has-hover ? Theme.lilac-text : (i == current ? Theme.on-row-selection : Theme.text); font-size: 20px; vertical-alignment: center; }
                            pta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    // Playlists asks what to make.
                                    add-y = self.absolute-position.y - root.absolute-position.y + self.height;
                                    if f.name != "Crates" {
                                        add-menu.show();
                                    } else {
                                        crate-menu.show();
                                    }
                                }
                            }
                        }
                    }
                    }
                }
            }
            if StoreUi.stores && source == 5: InboxPanel {}
            if source == 1 && tab == 0: FilesOptions {}
            if source == 10 && tab == 0 && FilesUi.mix-status != "": Text {
                text: FilesUi.mix-status; color: Theme.text-dim; font-size: 12px;
                wrap: word-wrap;
                x: 8px;
                width: parent.width - 16px;
            }
            // What copying a playlist did.
            if StoreUi.streaming && StoreUi.stream(source) && spotify-status != "": Text {
                text: spotify-status; color: Theme.text-dim; font-size: 12px;
                wrap: word-wrap;
                x: 8px;
                width: parent.width - 16px;
            }
            // Who's signed in; a click offers Sign out.
            if StoreUi.streaming && StoreUi.stream(source): Rectangle {
                height: 28px;
                account-label := Text {
                    x: 8px;
                    width: min(self.preferred-width, parent.width - 16px);
                    text: "Signed in as " + spotify-user;
                    color: ata.has-hover ? Theme.text : Theme.text-dim;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                }
                ata := TouchArea {
                    x: account-label.x;
                    width: account-label.width;
                    mouse-cursor: pointer;
                    clicked => {
                        account-y = self.absolute-position.y - root.absolute-position.y - 40px;
                        account-menu.show();
                    }
                }
            }
        }
    }
}

component HeaderCell inherits Rectangle {
    in property <string> text;
    in property <int> column;
    in property <int> sort-column;
    in property <bool> ascending;
    in property <TextHorizontalAlignment> align: left;
    in property <bool> resizable: true;
    // Where this heading is in `ColumnUi.columns`.
    in property <int> index;
    // The whole header, for working out where a heading is dropped.
    in property <length> header-x;
    in property <length> header-width;
    callback sort(column: int);
    callback menu(x: length, y: length);
    property <bool> moving;
    // A click sorts only when it started on this heading and didn't resize it.
    property <bool> armed;
    property <length> press-width;
    Text {
        width: 100%;
        text: root.text + (column == sort-column ? (ascending ? " ▲" : " ▼") : "");
        color: moving ? Theme.lilac-text : Theme.text;
        font-size: 13px;
        font-weight: column == sort-column ? 600 : 500;
        horizontal-alignment: align;
        overflow: elide;
    }
    // Column separator in the list header.
    Rectangle { x: -5px; width: 1px; height: 14px; background: Theme.border; }
    // Click to sort, drag to move, right-click for the column menu.
    ta := TouchArea {
        mouse-cursor: moving ? MouseCursor.grabbing : MouseCursor.default;
        moved => {
            if self.pressed && abs(self.mouse-x - self.pressed-x) > 8px {
                moving = true;
            }
            if moving {
                ColumnUi.drag(index, self.absolute-position.x - header-x + self.mouse-x, header-width);
            }
        }
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                menu(self.absolute-position.x - header-x + self.mouse-x, self.mouse-y);
            }
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                armed = true;
                press-width = root.width;
            }
            if e.kind == PointerEventKind.up && e.button == PointerEventButton.left {
                if moving {
                    moving = false;
                    ColumnUi.drop-x = -1px;
                    ColumnUi.move(index, self.absolute-position.x - header-x + self.mouse-x, header-width);
                } else if armed && self.has-hover && root.width == press-width {
                    sort(column);
                }
                armed = false;
            }
        }
    }
    // Drag the right edge to resize. The handle spans the gap to the next
    // heading, and a lilac line shows while it's hovered or dragged.
    if resizable: Rectangle {
        x: parent.width - 4px;
        width: 12px;
        property <length> start-width;
        property <length> start-x;
        Rectangle {
            x: 3px;
            width: 2px;
            background: rta.has-hover || rta.pressed ? Theme.accent : transparent;
        }
        rta := TouchArea {
            mouse-cursor: col-resize;
            pointer-event(e) => {
                if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                    start-width = root.width;
                    start-x = self.absolute-position.x + self.mouse-x;
                }
                if e.kind == PointerEventKind.up && e.button == PointerEventButton.left {
                    ColumnUi.resized();
                }
            }
            moved => {
                if self.pressed {
                    ColumnUi.resize(index, start-width + (self.absolute-position.x + self.mouse-x - start-x));
                }
            }
        }
    }
}

component HealthButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    callback clicked();
    width: label.preferred-width + 20px;
    height: 26px;
    border-radius: 13px;
    background: primary
        ? (ta.has-hover ? Theme.accent.brighter(0.15) : Theme.accent)
        : (ta.pressed ? Theme.control-pressed : ta.has-hover ? Theme.panel-raised.brighter(0.3) : Theme.panel-raised);
    label := Text {
        text: root.text;
        color: primary ? #000000 : Theme.text;
        font-size: 12px;
        font-weight: 600;
        vertical-alignment: center;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The share of clean tracks as a ring: a track, then an arc from twelve
// o'clock.
component HealthRing inherits Rectangle {
    in property <int> percent;
    width: 120px;
    height: 120px;
    property <float> r: 44;
    property <angle> to: min(percent, 99.9) * 3.6deg;
    property <angle> step: to / 3;
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 100;
        viewbox-height: 100;
        fill: transparent;
        stroke: Theme.panel-raised.brighter(0.2);
        stroke-width: 10px;
        MoveTo { x: 50; y: 50 - r; }
        ArcTo { radius-x: r; radius-y: r; sweep: true; x: 50; y: 50 + r; }
        ArcTo { radius-x: r; radius-y: r; sweep: true; x: 50; y: 50 - r; }
    }
    if percent > 0: Path {
        width: 100%;
        height: 100%;
        viewbox-width: 100;
        viewbox-height: 100;
        fill: transparent;
        stroke: Theme.accent;
        stroke-width: 10px;
        stroke-line-cap: round;
        MoveTo { x: 50; y: 50 - r; }
        ArcTo { radius-x: r; radius-y: r; sweep: true; x: 50 + r * sin(step); y: 50 - r * cos(step); }
        ArcTo { radius-x: r; radius-y: r; sweep: true; x: 50 + r * sin(2 * step); y: 50 - r * cos(2 * step); }
        ArcTo { radius-x: r; radius-y: r; sweep: true; x: 50 + r * sin(to); y: 50 - r * cos(to); }
    }
    VerticalLayout {
        alignment: center;
        Text { text: percent + "%"; color: Theme.text; font-size: 28px; font-weight: 700; horizontal-alignment: center; }
        Text { text: "clean"; color: Theme.text-dim; font-size: 12px; horizontal-alignment: center; }
    }
}

// A thin bar filled to `percent`.
component HealthMeter inherits Rectangle {
    in property <int> percent;
    height: 6px;
    border-radius: 3px;
    background: Theme.panel-raised.brighter(0.2);
    Rectangle {
        x: 0;
        width: parent.width * clamp(percent, 0, 100) / 100;
        height: 100%;
        border-radius: 3px;
        background: Theme.accent;
    }
}

// A state's word on an area tile, in its colour.
component HealthPill inherits Rectangle {
    in property <int> state;
    width: pill.preferred-width + 14px;
    height: 18px;
    border-radius: 9px;
    background: Theme.health-state(state).with-alpha(0.16);
    pill := Text {
        text: ["Clear", "Check", "Problem", "Goal"][state];
        color: Theme.health-state(state);
        font-size: 11px;
        font-weight: 600;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

// A line of the Overview's footer: what it is, and one button.
component HealthFooterLine inherits HorizontalLayout {
    in property <string> text;
    in property <string> action;
    in property <bool> primary;
    callback clicked();
    spacing: 10px;
    height: 30px;
    Text { horizontal-stretch: 1; text: root.text; color: Theme.text-dim; font-size: 12px; vertical-alignment: center; overflow: elide; }
    if action != "": VerticalLayout {
        alignment: center;
        HealthButton { text: action; primary: primary; clicked => { root.clicked(); } }
    }
}

// The Collection Health Overview: how much of the collection is clean,
// stage by stage, then the five areas in the order they're best fixed,
// then housekeeping that isn't a problem.
component HealthPanel inherits Rectangle {
    background: Theme.browser;
    ScrollView {
        VerticalLayout {
            padding: 16px;
            spacing: 12px;
            alignment: start;
            Text { text: "Collection Health"; color: Theme.text; font-size: 18px; font-weight: 700; }
            if HealthUi.status != "": Text { text: HealthUi.status; color: Theme.lilac-text; font-size: 13px; wrap: word-wrap; }
            Rectangle {
                border-radius: 10px;
                background: Theme.panel;
                HorizontalLayout {
                    padding: 16px;
                    spacing: 24px;
                    VerticalLayout { alignment: center; HealthRing { percent: HealthUi.clean-percent; } }
                    VerticalLayout {
                        alignment: center;
                        spacing: 10px;
                        horizontal-stretch: 1;
                        Text {
                            text: HealthUi.total + " track" + (HealthUi.total == 1 ? "" : "s") + ", " + HealthUi.clean + " clean";
                            color: Theme.text;
                            font-size: 15px;
                            font-weight: 600;
                        }
                        Text {
                            text: "Clean means nothing to fix in Files, Out of place, Duplicates or Info. Prep doesn't count against it.";
                            color: Theme.text-dim;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        if HealthUi.stages.length > 0: HorizontalLayout {
                            spacing: 10px;
                            for st in HealthUi.stages: Rectangle {
                                horizontal-stretch: 1;
                                preferred-width: 1px;
                                min-width: 0;
                                border-radius: 8px;
                                background: Theme.panel-raised;
                                VerticalLayout {
                                    padding: 12px;
                                    spacing: 6px;
                                    HorizontalLayout {
                                        Text { text: st.title; color: Theme.text-dim; font-size: 12px; horizontal-stretch: 1; overflow: elide; }
                                        Text { text: st.count; color: Theme.text; font-size: 12px; font-weight: 600; }
                                    }
                                    Text { text: st.percent + "%"; color: Theme.text; font-size: 20px; font-weight: 700; }
                                    HealthMeter { percent: st.percent; }
                                    Text {
                                        text: st.count == 0 ? "Empty" : st.note != "" ? st.note : "All clean";
                                        color: st.note != "" ? Theme.text-dim : Theme.health-clear;
                                        font-size: 11px;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                        if HealthUi.stages.length == 0: Text {
                            text: "Set your stage folders in Settings › Collection to see Inbox, In Prep and Play Ready here.";
                            color: Theme.text-dim;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: 10px;
                for a[i] in HealthUi.areas: Rectangle {
                    // Equal tiles, whatever their text: the page's width
                    // less its padding, the gaps and the scroll bar.
                    width: (root.width - 32px - 12px - (HealthUi.areas.length - 1) * 10px) / max(1, HealthUi.areas.length);
                    border-radius: 10px;
                    background: Theme.panel;
                    border-width: a.start ? 1.5px : 0;
                    border-color: Theme.selection;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 6px;
                        HorizontalLayout {
                            spacing: 6px;
                            Text { text: i + 1; color: Theme.text-dim; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                            Text { text: a.title; color: Theme.text; font-size: 14px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                            VerticalLayout { alignment: center; HealthPill { state: a.state; } }
                        }
                        Text { text: a.question; color: Theme.text-dim; font-size: 12px; overflow: elide; }
                        Text { text: a.count; color: a.count == 0 ? Theme.health-clear : Theme.text; font-size: 22px; font-weight: 700; }
                        for l in a.lines: Rectangle {
                            height: 20px;
                            HorizontalLayout {
                                spacing: 6px;
                                Text { text: l.title; color: lt.has-hover ? Theme.text : Theme.text-dim; font-size: 12px; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; }
                                Text { text: l.count; color: l.count > 0 ? Theme.text : Theme.text-dim; font-size: 12px; vertical-alignment: center; }
                            }
                            lt := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { HealthUi.review(l.check); }
                            }
                        }
                        Rectangle { vertical-stretch: 1; }
                        HorizontalLayout {
                            spacing: 8px;
                            HealthButton {
                                text: a.count > 0 ? "Review" : "Show";
                                primary: a.start;
                                clicked => { HealthUi.open-area(i); }
                            }
                            if a.start: Text { text: "Start here"; color: Theme.lilac-text; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                        }
                    }
                }
            }
            if HealthUi.removed > 0 || HealthUi.lists != "" || HealthUi.quarantined > 0 || CleanupUi.genre-count > 0: EdgeLine { line-color: Theme.separator; }
            if HealthUi.removed > 0: HealthFooterLine {
                text: HealthUi.removed + " removed from your collection, merged copies included.";
                action: "Bring back";
                clicked => { HealthUi.restore(); }
            }
            if HealthUi.quarantined > 0: HealthFooterLine {
                text: HealthUi.quarantined + " files of merged copies in _Quarantine. openDJ never deletes them: empty the folder yourself once you're sure.";
                action: HealthUi.quarantine-exists ? "Show folder" : "";
                clicked => { HealthUi.show-quarantine(); }
            }
            if HealthUi.lists != "": HealthFooterLine {
                text: "Lists: " + HealthUi.lists + ".";
                action: "Tidy up";
                clicked => { HealthUi.tidy-lists(); }
            }
            if CleanupUi.genre-count > 0: HealthFooterLine {
                text: CleanupUi.genre-count + " genres" + (CleanupUi.alike > 0 ? ", " + CleanupUi.alike + " spelled like another." : ".");
                action: "Genres…";
                primary: CleanupUi.alike > 0;
                clicked => { CleanupUi.open-genres(); }
            }
        }
    }
}

// A tick box.
component Tick inherits Rectangle {
    in property <bool> on;
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border-width: 1.5px;
    border-color: on ? Theme.accent : Theme.text-dim;
    background: on ? Theme.accent : transparent;
    if on: Text {
        text: "✓";
        color: #000000;
        font-size: 11px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// The clean-up's review table: one row per change, ticked to be made.
component CleanupPanel inherits Rectangle {
    background: Theme.browser;
    // The before and after columns share what the others leave.
    property <length> value-width: max(80px, (self.width - 32px - 20px - 16px - 220px - 64px - 4 * 12px) / 2);
    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                Text { text: CleanupUi.heading; color: Theme.text; font-size: 18px; font-weight: 700; }
                Text {
                    text: "Untick a change to leave it as it is. Apply writes the ticked ones to your collection and to the files' tags; Undo takes them back.";
                    color: Theme.text-dim;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }
            VerticalLayout {
                alignment: center;
                HealthButton { text: "All"; clicked => { CleanupUi.all(true); } }
            }
            VerticalLayout {
                alignment: center;
                HealthButton { text: "None"; clicked => { CleanupUi.all(false); } }
            }
            VerticalLayout {
                alignment: center;
                HealthButton {
                    text: "Apply" + (CleanupUi.picked > 0 ? " (" + CleanupUi.picked + ")" : "");
                    primary: CleanupUi.picked > 0;
                    clicked => { CleanupUi.apply(); }
                }
            }
            VerticalLayout {
                alignment: center;
                HealthButton { text: "Cancel"; clicked => { CleanupUi.cancel(); } }
            }
        }
        HorizontalLayout {
            height: 22px;
            padding-left: 34px;
            spacing: 12px;
            Text { width: 220px; text: "TRACK"; color: Theme.text-dim; font-size: 11px; font-weight: 600; vertical-alignment: center; }
            Text { width: 64px; text: "FIELD"; color: Theme.text-dim; font-size: 11px; font-weight: 600; vertical-alignment: center; }
            Text { width: value-width; text: "NOW"; color: Theme.text-dim; font-size: 11px; font-weight: 600; vertical-alignment: center; }
            Text { width: value-width; text: "BECOMES"; color: Theme.text-dim; font-size: 11px; font-weight: 600; vertical-alignment: center; }
        }
        ListView {
            vertical-stretch: 1;
            for r[i] in CleanupUi.rows: Rectangle {
                height: 30px;
                background: Math.mod(i, 2) == 0 ? Theme.row : Theme.row-alt;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 12px;
                    VerticalLayout { alignment: center; Tick { on: r.on; } }
                    Text { width: 220px; text: r.track; color: Theme.text-dim; font-size: 12px; vertical-alignment: center; overflow: elide; }
                    Text { width: 64px; text: r.field; color: Theme.text-dim; font-size: 12px; vertical-alignment: center; }
                    Text { width: value-width; text: r.old == "" ? "(empty)" : r.old; color: Theme.text-dim; font-size: 13px; vertical-alignment: center; overflow: elide; }
                    Text { width: value-width; text: r.new == "" ? "(empty)" : r.new; color: r.on ? Theme.text : Theme.text-dim; font-size: 13px; vertical-alignment: center; overflow: elide; }
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { CleanupUi.toggle(i); }
                }
            }
        }
    }
}

// Every genre with its count: tick the ones that mean the same and merge
// them into one name.
component GenrePanel inherits Rectangle {
    background: Theme.browser;
    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                Text { text: "Genres"; color: Theme.text; font-size: 18px; font-weight: 700; }
                if HealthUi.status != "": Text { text: HealthUi.status; color: Theme.lilac-text; font-size: 13px; wrap: word-wrap; }
                Text {
                    text: "Tick genres that mean the same, then merge them into one name. Lilac ones are spelled like another. The new genre is written to the files' tags too.";
                    color: Theme.text-dim;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }
            VerticalLayout {
                alignment: center;
                HealthButton { text: "Done"; clicked => { CleanupUi.close-genres(); } }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            height: 32px;
            LineEdit {
                horizontal-stretch: 1;
                placeholder-text: "Merge into…";
                text <=> CleanupUi.into;
                accepted => { CleanupUi.merge-genres(); }
            }
            VerticalLayout {
                alignment: center;
                HealthButton {
                    text: "Merge" + (CleanupUi.genres-picked > 1 ? " " + CleanupUi.genres-picked : "");
                    primary: CleanupUi.genres-picked > 0 && CleanupUi.into != "";
                    clicked => { CleanupUi.merge-genres(); }
                }
            }
        }
        ListView {
            vertical-stretch: 1;
            for g[i] in CleanupUi.genres: Rectangle {
                height: 30px;
                background: Math.mod(i, 2) == 0 ? Theme.row : Theme.row-alt;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 12px;
                    VerticalLayout { alignment: center; Tick { on: g.picked; } }
                    Text { horizontal-stretch: 1; text: g.name; color: g.alike ? Theme.lilac-text : Theme.text; font-size: 13px; vertical-alignment: center; overflow: elide; }
                    Text { width: 60px; text: g.count; color: Theme.text-dim; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; }
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { CleanupUi.toggle-genre(i); }
                }
            }
        }
    }
}

// Over a check's tracks: what it looks for, and its fixes for every track
// listed (right-click for only some).
component HealthBar inherits Rectangle {
    in property <HealthCard> card;
    in property <int> listed;
    height: HealthUi.chips.length > 0 ? 80px : 44px;
    background: Theme.panel;
    // An area's checks, one chip each, and how far it has come.
    if HealthUi.chips.length > 0: HorizontalLayout {
        y: 0;
        height: 36px;
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 8px;
        spacing: 6px;
        for c[i] in HealthUi.chips: Rectangle {
            width: chip.preferred-width + 22px;
            height: 26px;
            border-radius: 13px;
            background: i == HealthUi.chip ? Theme.selection : (ct.has-hover ? Theme.panel-raised.brighter(0.3) : Theme.panel-raised);
            chip := Text {
                text: c.title + "  " + c.count;
                color: i == HealthUi.chip ? Theme.on-row-selection : Theme.text;
                font-size: 12px;
                font-weight: i == HealthUi.chip ? 600 : 400;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
            ct := TouchArea {
                mouse-cursor: pointer;
                clicked => { HealthUi.pick-chip(i); }
            }
        }
        Rectangle { horizontal-stretch: 1; }
        if HealthUi.fixed-of > 0: HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                HealthMeter { width: 120px; percent: HealthUi.fixed * 100 / HealthUi.fixed-of; }
            }
            Text {
                text: HealthUi.fixed + " of " + HealthUi.fixed-of + " fixed";
                color: HealthUi.fixed >= HealthUi.fixed-of ? Theme.health-clear : Theme.text-dim;
                font-size: 12px;
                vertical-alignment: center;
            }
        }
    }
    HorizontalLayout {
        y: HealthUi.chips.length > 0 ? 36px : 0;
        height: 44px;
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        Text {
            horizontal-stretch: 1;
            text: HealthUi.status != "" ? HealthUi.status : card.about;
            color: HealthUi.status != "" ? Theme.lilac-text : Theme.text-dim;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
        }
        if HealthUi.sure > 0: VerticalLayout {
            alignment: center;
            HealthButton {
                text: HealthUi.sure-label + " " + HealthUi.sure;
                primary: true;
                clicked => { HealthUi.fix-sure(); }
            }
        }
        if HealthUi.chips.length > 0 && listed > 0 && !HealthUi.reviewing: VerticalLayout {
            alignment: center;
            HealthButton {
                text: "Review " + listed;
                primary: HealthUi.sure == 0;
                clicked => { HealthUi.review-key("start"); }
            }
        }
        if listed > 0: HorizontalLayout {
            spacing: 8px;
            for f[j] in card.fixes: VerticalLayout {
                alignment: center;
                HealthButton {
                    property <int> n: j < card.counts.length ? card.counts[j] : listed;
                    text: f + (n > 1 ? " (" + n + ")" : "");
                    primary: false;
                    clicked => { HealthUi.fix(j, -1, -1); }
                }
            }
        }
        if LibraryEdit.undo-text != "": VerticalLayout {
            alignment: center;
            HealthButton {
                text: "Undo";
                clicked => { LibraryEdit.undo-stage(); }
            }
        }
        VerticalLayout {
            alignment: center;
            HealthButton {
                text: "Overview";
                clicked => { HealthUi.review(-1); }
            }
        }
    }
}

// A key hint on the review card: the key, then what it does.
component ReviewKey inherits Rectangle {
    in property <string> key;
    in property <string> text;
    in property <bool> primary;
    callback clicked();
    height: 34px;
    border-radius: 17px;
    background: primary
        ? (ta.has-hover ? Theme.accent.brighter(0.15) : Theme.accent)
        : (ta.has-hover ? Theme.panel-raised.brighter(0.3) : Theme.panel-raised);
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 14px;
        spacing: 8px;
        alignment: center;
        VerticalLayout {
            alignment: center;
            Rectangle {
            width: k.preferred-width + 10px;
            height: 20px;
            border-radius: 4px;
            background: primary ? Theme.s-00000026 : Theme.n-ffffff14;
            k := Text {
                text: key;
                color: primary ? #000000 : Theme.text-dim;
                font-size: 11px;
                font-weight: 600;
                vertical-alignment: center;
            }
            }
        }
        Text {
            text: root.text;
            color: primary ? #000000 : Theme.text;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// One listed track at a time with what's wrong and what the fix does.
// Return uses the fix, → skips, I ignores, E shows the track's info,
// Space plays it in the headphones, Cmd+Z undoes, Esc goes back to the list.
component ReviewCard inherits Rectangle {
    background: Theme.panel;
    keys := FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            if e.text == Key.Escape { HealthUi.review-key("close"); return accept; }
            if (e.modifiers.control || e.modifiers.meta) && (e.text == "z" || e.text == "Z") {
                LibraryEdit.undo-stage();
                return accept;
            }
            if HealthUi.card.done {
                if e.text == Key.Return && HealthUi.card.next != "" { HealthUi.review-key("next"); return accept; }
                return reject;
            }
            if e.text == Key.Return && HealthUi.card.action != "" { HealthUi.review-key("use"); return accept; }
            if e.text == Key.RightArrow { HealthUi.review-key("skip"); return accept; }
            if e.text == "i" || e.text == "I" { HealthUi.review-key("ignore"); return accept; }
            if e.text == "e" || e.text == "E" { HealthUi.review-key("edit"); return accept; }
            if e.text == " " { TrackInfo.preview-toggle(); return accept; }
            reject
        }
    }
    TouchArea {
        clicked => { keys.focus(); }
    }
    if !HealthUi.card.done: VerticalLayout {
        alignment: center;
        padding: 24px;
        spacing: 18px;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: min(560px, root.width - 48px);
                height: card.preferred-height;
                border-radius: 10px;
                background: Theme.panel-raised;
                card := VerticalLayout {
                    padding: 22px;
                    spacing: 10px;
                    HorizontalLayout {
                        Text {
                            text: HealthUi.card.check;
                            color: Theme.lilac-text;
                            font-size: 12px;
                            font-weight: 600;
                        }
                        Text {
                            horizontal-stretch: 1;
                            horizontal-alignment: right;
                            text: HealthUi.card.at + " / " + HealthUi.card.of;
                            color: Theme.text-dim;
                            font-size: 12px;
                        }
                    }
                    Text {
                        text: HealthUi.card.title;
                        color: Theme.text;
                        font-size: 20px;
                        font-weight: 600;
                        overflow: elide;
                    }
                    Text {
                        text: HealthUi.card.artist;
                        color: Theme.text-dim;
                        font-size: 14px;
                        overflow: elide;
                    }
                    Rectangle { height: 6px; }
                    HorizontalLayout {
                        spacing: 10px;
                        Text { width: 70px; text: "Problem"; color: Theme.text-dim; font-size: 13px; }
                        Text { horizontal-stretch: 1; text: HealthUi.card.problem; color: Theme.text; font-size: 13px; wrap: word-wrap; }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        Text { width: 70px; text: "Fix"; color: Theme.text-dim; font-size: 13px; }
                        Text { horizontal-stretch: 1; text: HealthUi.card.fix; color: Theme.text; font-size: 13px; wrap: word-wrap; }
                    }
                }
            }
        }
        HorizontalLayout {
            alignment: center;
            spacing: 8px;
            if HealthUi.card.action != "": ReviewKey {
                key: "↵";
                text: HealthUi.card.action;
                primary: true;
                clicked => { HealthUi.review-key("use"); keys.focus(); }
            }
            ReviewKey { key: "→"; text: "Skip"; clicked => { HealthUi.review-key("skip"); keys.focus(); } }
            ReviewKey { key: "I"; text: "Ignore"; clicked => { HealthUi.review-key("ignore"); keys.focus(); } }
            ReviewKey { key: "E"; text: "Edit"; clicked => { HealthUi.review-key("edit"); keys.focus(); } }
            ReviewKey { key: "Space"; text: "Play"; clicked => { TrackInfo.preview-toggle(); keys.focus(); } }
        }
        Text {
            horizontal-alignment: center;
            text: "⌘Z undoes the last fix · Esc goes back to the list";
            color: Theme.text-dim;
            font-size: 12px;
        }
    }
    if HealthUi.card.done: VerticalLayout {
        alignment: center;
        spacing: 14px;
        Text {
            horizontal-alignment: center;
            text: HealthUi.card.of == 0 ? "This area is clear" : "Reviewed every track here";
            color: Theme.health-clear;
            font-size: 20px;
            font-weight: 600;
        }
        HorizontalLayout {
            alignment: center;
            spacing: 8px;
            if HealthUi.card.next != "": ReviewKey {
                key: "↵";
                text: "Next: " + HealthUi.card.next;
                primary: true;
                clicked => { HealthUi.review-key("next"); }
            }
            ReviewKey { key: "Esc"; text: "Back to the list"; clicked => { HealthUi.review-key("close"); } }
        }
    }
}

// List or covers, at the top right of the Albums source's list.
component ViewSwitch inherits HorizontalLayout {
    spacing: 4px;
    alignment: center;
    for covers in [false, true]: Rectangle {
        width: 26px;
        height: 26px;
        border-radius: 4px;
        background: vta.has-hover ? Theme.n-ffffff14 : transparent;
        Path {
            width: 16px;
            height: 16px;
            viewbox-width: 16;
            viewbox-height: 16;
            property <color> c: covers == AlbumsUi.covers ? Theme.accent : Theme.text-dim;
            stroke: covers ? transparent : c;
            stroke-width: 1.8px;
            stroke-line-cap: round;
            fill: covers ? c : transparent;
            // Three lines, or four squares.
            commands: covers
                ? "M 1 1 L 6.5 1 L 6.5 6.5 L 1 6.5 Z M 9.5 1 L 15 1 L 15 6.5 L 9.5 6.5 Z M 1 9.5 L 6.5 9.5 L 6.5 15 L 1 15 Z M 9.5 9.5 L 15 9.5 L 15 15 L 9.5 15 Z"
                : "M 1.5 3 L 14.5 3 M 1.5 8 L 14.5 8 M 1.5 13 L 14.5 13";
        }
        vta := TouchArea {
            mouse-cursor: pointer;
            clicked => { AlbumsUi.set-covers(covers); }
        }
    }
}

// The Albums source's covers: each album's art, name and artist. A click
// opens its tracks; a right-click plays it.
component AlbumGrid inherits Rectangle {
    property <length> gap: 14px;
    property <int> columns: max(1, floor((sv.visible-width - gap) / (170px + gap)));
    property <length> tile-width: (sv.visible-width - gap * (columns + 1)) / columns;
    property <length> tile-height: tile-width + 50px;
    property <int> menu-index;
    property <length> menu-x;
    property <length> menu-y;
    sv := ScrollView {
        content-width: self.visible-width;
        content-height: ceil(AlbumsUi.tiles.length / columns) * (tile-height + gap) + gap;
        for t[i] in AlbumsUi.tiles: Rectangle {
            x: gap + mod(i, columns) * (tile-width + gap);
            y: gap + floor(i / columns) * (tile-height + gap);
            width: tile-width;
            height: tile-height;
            border-radius: 6px;
            background: ta.has-hover ? Theme.n-2a2a2e : Theme.row-alt;
            Rectangle {
                x: 8px;
                y: 8px;
                width: parent.width - 16px;
                height: self.width;
                border-radius: 4px;
                clip: true;
                background: Theme.n-2a2a2d;
                if t.has-cover: Image {
                    width: 100%;
                    height: 100%;
                    source: t.cover;
                    image-fit: cover;
                }
                if !t.has-cover: Text {
                    text: "♪";
                    color: Theme.n-4a4a4d;
                    font-size: parent.width * 0.4;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Text {
                x: 8px;
                y: tile-width + 2px;
                width: parent.width - 16px;
                text: t.name;
                color: Theme.text;
                font-size: 14px;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                x: 8px;
                y: tile-width + 21px;
                width: parent.width - 16px;
                text: t.detail;
                color: Theme.text-dim;
                font-size: 13px;
                overflow: elide;
            }
            ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { AlbumsUi.open(i); }
                pointer-event(e) => {
                    if e.button == PointerEventButton.right && e.kind == PointerEventKind.down {
                        menu-index = i;
                        menu-x = parent.x + sv.content-x + self.mouse-x;
                        menu-y = parent.y + sv.content-y + self.mouse-y;
                        menu.show();
                    }
                }
            }
        }
    }
    menu := PopupWindow {
        x: min(menu-x, root.width - 220px);
        y: min(menu-y, root.height - 90px);
        width: 210px;
        close-policy: close-on-click-outside;
        MenuBackground {}
        VerticalLayout {
            padding: 6px;
            MenuLine {
                text: "Play Album";
                clicked => {
                    AlbumsUi.play(menu-index, false);
                    menu.close();
                }
            }
            MenuLine {
                text: "Add Album to Automix";
                clicked => {
                    AlbumsUi.play(menu-index, true);
                    menu.close();
                }
            }
        }
    }
}

component TrackList inherits Rectangle {
    in property <[TrackRow]> rows;
    // Its selection is lilac while it has focus, gray while the folders do.
    in property <bool> focused: true;
    in property <int> sort-column;
    in property <bool> ascending;
    in-out property <int> current: -1;
    in property <string> folder-name;
    // Total length of the listed tracks, e.g. "3h 56m".
    in property <string> duration;
    // A signed-in streaming service: the refresh button fetches its
    // playlists again.
    // Shown instead of the list when a source has nothing to list yet.
    in property <string> empty-title;
    // The list is store results, not songs.
    in property <bool> results;
    in property <string> empty-text;
    callback sort(column: int);
    callback search(text: string);
    callback activate(row: int);
    // Clicked, so its selection turns lilac and the folders' gray.
    callback took-focus();

    // Text in the search box; the filter button lights while there is some.
    property <string> search-text <=> StoreUi.search-text;
    // The row the track menu was opened on, and where.
    property <int> menu-row;
    property <int> menu-last;
    property <int> menu-count: 1;
    property <int> menu-rating;
    property <length> menu-x;
    property <length> menu-y;
    // Near the right edge, the menu's side panel opens on its left.
    property <bool> menu-flip: menu-x + 540px > root.width;
    track-menu := TrackMenu {
        x: menu-flip ? max(0px, min(menu-x, root.width - 252px) - 286px) : menu-x;
        y: -root.absolute-position.y;
        height: LibraryEdit.window-height;
        anchor-y: menu-y + root.absolute-position.y;
        panel-left: menu-flip;
        track-row: menu-row;
        track-last: menu-last;
        count: menu-count;
        rating: menu-rating;
        streamed: menu-row >= 0 && menu-row < rows.length && rows[menu-row].streamed;
        change-match => {
            menu-matched = true;
            StreamMatch.open(menu-row);
            match-menu.show();
        }
    }
    property <bool> menu-matched;
    match-menu := MatchMenu {
        x: min(menu-x, root.width - 330px);
        y: min(menu-y, root.height - 380px);
        track-row: menu-row;
        matched: menu-matched;
        count: menu-count;
        play => { activate(menu-row); }
    }
    // Right-click on the Wanted list: open the page, download, or take the
    // picked tracks off the list.
    wanted-menu := PopupWindow {
        x: min(menu-x, root.width - 230px);
        y: min(menu-y, root.height - 140px);
        width: 220px;
        close-policy: close-on-click-outside;
        MenuBackground {}
        VerticalLayout {
            padding: 6px;
            MenuLine {
                text: menu-count > 1 ? "Buy " + menu-count + " Tracks…" : "Buy…";
                clicked => {
                    BuyUi.start(menu-row, menu-row);
                    wanted-menu.close();
                }
            }
            if menu-count == 1: MenuLine {
                text: "Open Page";
                clicked => {
                    WantedUi.open(menu-row);
                    wanted-menu.close();
                }
            }
            if StoreUi.downloads-to != "": MenuLine {
                text: menu-count > 1 ? "Add " + menu-count + " Tracks to Downloads" : "Add to Downloads";
                clicked => {
                    StoreUi.download-tracks(menu-row, menu-row);
                    wanted-menu.close();
                }
            }
            MenuLine {
                text: menu-count > 1 ? "Remove " + menu-count + " from Wanted" : "Remove from Wanted";
                text-color: Theme.c-ff6b5e;
                clicked => {
                    WantedUi.remove(menu-row, menu-row);
                    wanted-menu.close();
                }
            }
        }
    }
    property <length> row-height: 32px;
    // Which rows are in view, for their mini waveforms.
    property <int> first-shown: max(0, floor(-lv.content-y / row-height));
    property <int> shown-count: ceil(lv.visible-height / row-height) + 1;
    changed first-shown => { ColumnUi.first-shown = first-shown; }
    changed shown-count => { ColumnUi.shown-count = shown-count; }
    init => {
        ColumnUi.first-shown = first-shown;
        ColumnUi.shown-count = shown-count;
    }
    // Click picks a row, shift-click every row from `anchor` to the one
    // clicked, and Cmd-click (Ctrl-click on Windows and Linux) adds or
    // drops one. The browser keeps the picks (`LibraryEdit.picks`), so they
    // last through a re-sort; `current` is the row the keyboard and
    // controllers move from.
    property <int> anchor: -1;
    out property <int> first-picked: current;
    out property <int> last-picked: current;
    property <bool> shift-held;
    property <bool> cmd-held;
    function pick(i: int) {
        anchor = i;
        LibraryEdit.pick-rows(i, i, false);
        current = i;
        took-focus();
    }
    function extend(i: int, add: bool) {
        if anchor < 0 {
            anchor = current;
        }
        LibraryEdit.pick-rows(anchor, i, add);
        current = i;
        took-focus();
    }
    function toggle(i: int) {
        anchor = i;
        LibraryEdit.toggle-row(i);
        current = i;
        took-focus();
    }
    // ⌘F (Ctrl+F on Linux and Windows): into the search box, its text
    // picked so typing replaces it.
    public function focus-search() {
        search-edit.focus();
        search-edit.select-all();
    }
    // ⌘A (Ctrl+A on Linux and Windows): every row, the first one current.
    public function select-all() {
        if rows.length > 0 {
            anchor = 0;
            LibraryEdit.pick-rows(0, rows.length - 1, false);
            current = 0;
            took-focus();
        }
    }
    // How far the list is scrolled, for coming back to it later.
    out property <length> scroll-y: -lv.content-y;
    // Back on a list seen before: `row` current (or none, -1) at `offset`
    // from the top of the view, or else the list scrolled down `y`, kept
    // within the list. The browser picks the row itself.
    public function show-at(row: int, offset: length, y: length) {
        lv.content-y = max(min(0px, lv.visible-height - rows.length * row-height), min(0px, row >= 0 ? offset - row * row-height : -y));
        anchor = row;
        current = row;
    }
    // Keep the selection in view when a controller moves it.
    changed current => {
        // Moved some other way than a click (arrows, a controller, a new
        // list) to a row not picked: just that row is picked. A click has
        // made `current` the anchor or picked it already.
        if current < 0 || (current != anchor && !LibraryEdit.picks[current]) {
            anchor = current;
            LibraryEdit.pick-rows(current, current, false);
        }
        if current >= 0 {
            if current * row-height + lv.content-y < 0 {
                lv.content-y = -current * row-height;
            } else if (current + 1) * row-height + lv.content-y > lv.visible-height {
                lv.content-y = lv.visible-height - (current + 1) * row-height;
            }
        }
    }

    // The album art and deck badge before the columns, and a store
    // result's button.
    property <length> w-art: 26px;
    property <length> w-deck: 22px;
    property <length> w-action: 58px;
    // The list's width: the panel's, or more when the columns need it
    // (then it scrolls sideways).
    property <length> list-width: max(lv.visible-width, ColumnUi.min-width + (results ? w-action + 8px : 0px));
    // Right-click on the header: which columns to show.
    property <length> column-menu-x;
    column-menu := PopupWindow {
        x: min(column-menu-x, root.width - 220px);
        y: 66px;
        width: 210px;
        close-policy: close-on-click-outside;
        MenuBackground {}
        VerticalLayout {
            padding: 6px;
            spacing: 1px;
            Text { x: 10px; height: 24px; text: "Columns"; color: Theme.text-dim; font-size: 12px; vertical-alignment: center; }
            ScrollView {
                height: min(ColumnUi.all.length * 26px, 420px);
                VerticalLayout {
                    for name[i] in ColumnUi.all: Rectangle {
                        height: 26px;
                        border-radius: 4px;
                        background: cta.has-hover ? Theme.n-3a3a3d : transparent;
                        Text { x: 10px; width: 18px; text: i < ColumnUi.all-shown.length && ColumnUi.all-shown[i] ? "✓" : ""; color: Theme.lilac-text; font-size: 13px; vertical-alignment: center; }
                        Text { x: 30px; text: name; color: name == "Title" ? Theme.text-dim : Theme.text; font-size: 13px; vertical-alignment: center; }
                        cta := TouchArea { clicked => { ColumnUi.toggle(i); } }
                    }
                }
            }
            MenuSeparator {}
            MenuLine {
                text: "Reset columns";
                clicked => {
                    ColumnUi.reset();
                    column-menu.close();
                }
            }
        }
    }

    background: Theme.browser;
    VerticalLayout {
        padding: 6px;
        spacing: 4px;
        // The list's name on the left, the search in the middle of the
        // window, in line with the mixer and the FX bar (moved over when
        // the panel is too narrow, or the buttons on the right need the
        // room), Save and Filter on the right.
        Rectangle {
            height: 32px;
            property <length> search-w: clamp(self.width * 0.4, 240px, 520px);
            property <length> centred: LibraryEdit.window-width / 2 - self.absolute-position.x - search-w / 2;
            property <length> search-x: max(0px, min(centred, self.width - buttons.preferred-width - 10px - search-w));
            // Clipped, so on a narrow panel nothing runs in under the
            // search box.
            Rectangle {
                x: 0;
                width: max(0px, search-x - 10px);
                height: parent.height;
                clip: true;
                HorizontalLayout {
                    width: parent.width;
                    height: parent.height;
                    spacing: 10px;
                    padding-left: 6px;
                    // Back from an album opened in the covers view. It and the
                    // name give up room first (they elide), the count after.
                    if AlbumsUi.opened: Rectangle {
                        property <length> full: min(back-label.preferred-width, 220px);
                        preferred-width: full;
                        max-width: full;
                        min-width: min(full, 70px);
                        horizontal-stretch: 1;
                        back-label := Text {
                            width: parent.width;
                            text: "‹ " + AlbumsUi.back-to;
                            overflow: elide;
                            color: bta.has-hover ? Theme.text : Theme.lilac-text;
                            font-size: 14px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        bta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AlbumsUi.back(); }
                        }
                    }
                    Text {
                        text: folder-name;
                        color: Theme.text;
                        font-size: 15px;
                        font-weight: 600;
                        vertical-alignment: center;
                        overflow: elide;
                        // Never wider than the name, so spare room goes past the
                        // count; shrinks before the count does.
                        min-width: min(self.preferred-width, 80px);
                        max-width: self.preferred-width;
                        horizontal-stretch: 1;
                    }
                    if empty-title == "" && AlbumsUi.grid: Text { text: AlbumsUi.tiles.length + (AlbumsUi.tiles.length == 1 ? " Album" : " Albums"); color: Theme.text-dim; font-size: 14px; vertical-alignment: center; }
                    if empty-title == "" && !AlbumsUi.grid: Text { text: rows.length + (results ? (rows.length == 1 ? " Result" : " Results") : LibraryEdit.close-matches ? (rows.length == 1 ? " Close Match" : " Close Matches") : (rows.length == 1 ? " Song" : " Songs")); color: Theme.text-dim; font-size: 14px; vertical-alignment: center; }
                    // The list's time, or how many are picked and their time.
                    if LibraryEdit.picked-count < 2: Text { text: duration; color: Theme.text-dim; font-size: 14px; vertical-alignment: center; overflow: elide; }
                    if LibraryEdit.picked-count > 1 && empty-title == "" && !AlbumsUi.grid: Text {
                        text: LibraryEdit.picked-count + " selected · " + LibraryEdit.picked-time;
                        color: Theme.lilac-text;
                        font-size: 14px;
                        vertical-alignment: center;
                    }
                    // A smart list's search, so it's clear why these tracks are here.
                    Text {
                        text: LibraryEdit.rule != "" && empty-title == "" ? "· " + LibraryEdit.rule : "";
                        color: Theme.lilac-text;
                        font-size: 13px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    if LibraryEdit.making-smart && search-text == "" && !FilterUi.any-active: Text {
                        text: "Add filters for the smart playlist, then Save";
                        color: Theme.lilac-text;
                        font-size: 13px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
            TourMark { id: "ui,search"; x: search-x; width: search-w; height: parent.height; }
            search-edit := LineEdit {
                visible: !LibraryEdit.top-search;
                x: search-x;
                width: search-w;
                height: parent.height;
                // Short: the list's name is already on the left.
                placeholder-text: AlbumsUi.opened ? "Search album" : folder-name != "" && folder-name.character-count <= 20 ? "Search " + folder-name : "Search";
                text <=> search-text;
                edited(t) => {
                    search(t);
                    FilterUi.highlight = -1;
                    FilterUi.find(t);
                }
                // Esc clears the search, or with nothing typed hands the
                // keys back to the list; ↓ goes down into the list. While
                // values that match show under the field, ↓ and ↑ move
                // through them and Return adds the one picked as a filter.
                key-pressed(e) => {
                    if FilterUi.suggestions.length > 0 && search-text != "" {
                        if e.text == Key.DownArrow && FilterUi.highlight < FilterUi.suggestions.length - 1 {
                            FilterUi.highlight += 1;
                            return accept;
                        }
                        if e.text == Key.UpArrow && FilterUi.highlight >= 0 {
                            FilterUi.highlight -= 1;
                            return accept;
                        }
                        if e.text == Key.Return && FilterUi.highlight >= 0 {
                            FilterUi.pick-suggestion(FilterUi.highlight);
                            FilterUi.highlight = -1;
                            search-text = "";
                            search("");
                            return accept;
                        }
                    }
                    if e.text == Key.Escape {
                        if search-text != "" {
                            search-text = "";
                            search("");
                        } else {
                            took-focus();
                        }
                        return accept;
                    }
                    if e.text == Key.DownArrow && rows.length > 0 {
                        FilterUi.find("");
                        took-focus();
                        if current < 0 {
                            current = 0;
                        }
                        return accept;
                    }
                    reject
                }
            }
            // Values of any field that match what's typed, to add as filters.
            // Shown while there's text, not only with focus, so a click on
            // a value lands before the field lets go of the keys.
            if search-text != "" && FilterUi.suggestions.length > 0: Rectangle {
                x: search-x;
                y: parent.height + 4px;
                z: 100;
                width: max(search-w, 280px);
                height: suggestions.preferred-height + 12px;
                background: Theme.n-232326;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.border;
                drop-shadow-blur: 16px;
                drop-shadow-color: Theme.s-00000080;
                suggestions := SuggestionList {
                    x: 6px;
                    y: 6px;
                    width: parent.width - 12px;
                    items: FilterUi.suggestions;
                    highlight: FilterUi.highlight;
                    picked(i) => {
                        FilterUi.pick-suggestion(i);
                        FilterUi.highlight = -1;
                        search-text = "";
                        search("");
                    }
                }
            }
            buttons := HorizontalLayout {
                x: parent.width - self.width;
                width: max(self.preferred-width, parent.width - search-x - search-w - 10px);
                alignment: end;
                spacing: 10px;
                if (search-text != "" || FilterUi.any-active) && LibraryEdit.can-save-search: Rectangle {
                    width: LibraryEdit.making-smart ? 136px : 44px;
                    Text {
                        text: LibraryEdit.making-smart ? "Save Smart Playlist" : "Save";
                        color: sta.has-hover ? Theme.text : Theme.lilac-text;
                        font-size: 13px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    TourMark { id: "ui,save_search"; }
                    sta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            LibraryEdit.making-smart = false;
                            LibraryEdit.name-row = LibraryEdit.save-search(search-text);
                            search-text = "";
                            search("");
                        }
                    }
                }
                // Filter: shows or hides the filter bar; lit while the list
                // is narrowed by a search or a filter.
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        property <bool> lit: search-text != "" || FilterUi.any-active;
                        width: 28px;
                        height: 28px;
                        border-radius: 14px;
                        border-width: 1.5px;
                        background: FilterUi.shown && !results ? Theme.n-ffffff14 : transparent;
                        border-color: lit ? Theme.accent : (fta.has-hover ? Theme.text-dim : Theme.border);
                        Path {
                            width: 16px;
                            height: 16px;
                            viewbox-width: 20;
                            viewbox-height: 20;
                            stroke: lit ? Theme.accent : Theme.text-dim;
                            stroke-width: 2.2px;
                            stroke-line-cap: round;
                            fill: transparent;
                            commands: "M 4 5.5 L 16 5.5 M 6.5 10 L 13.5 10 M 9 14.5 L 11 14.5";
                        }
                        fta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                // Store results have no filters: clear the search.
                                if results {
                                    search-text = "";
                                    search("");
                                } else {
                                    FilterUi.set-shown(!FilterUi.shown);
                                }
                            }
                        }
                        TourMark { id: "ui,filter_button"; }
                    }
                }
                if AlbumsUi.offered: ViewSwitch {}
            }
        }
        if FilterUi.shown && !results: FilterBar {}
        // Column headers, scrolled sideways with the list when the columns
        // are wider than it.
        Rectangle {
            height: AlbumsUi.grid ? 0px : 24px;
            visible: !AlbumsUi.grid;
            clip: true;
        header := HorizontalLayout {
            x: lv.content-x;
            width: list-width;
            height: 24px;
            spacing: 8px;
            padding-left: 6px;
            padding-right: 14px;
            Rectangle { width: w-art; }
            Rectangle { width: w-deck; }
            if results: Rectangle { width: w-action; }
            for col[c] in ColumnUi.columns: HeaderCell {
                horizontal-stretch: 0;
                min-width: col.width;
                max-width: col.width;
                // The Color column is narrow: a dot heads it.
                text: col.kind == 7 ? "●" : col.label;
                column: col.id;
                index: c;
                align: col.right ? right : left;
                sort-column: sort-column;
                ascending: ascending;
                header-x: header.absolute-position.x;
                header-width: header.width;
                // Sorting keeps the same tracks picked, wherever they land.
                sort(id) => { sort(id); }
                menu(x, y) => {
                    column-menu-x = x + lv.content-x;
                    column-menu.show();
                }
            }
            // Every column keeps its width; spare room stays at the end.
            Rectangle { horizontal-stretch: 1; }
        }
        // Where a dragged heading will land.
        if ColumnUi.drop-x >= 0: Rectangle {
            x: lv.content-x + ColumnUi.drop-x - 1px;
            width: 2px;
            height: parent.height;
            background: Theme.accent;
        }
        }
        EdgeLine { left: 6px; right: 6px; }
        if empty-title != "": Placeholder {
            vertical-stretch: 1;
            title: empty-title;
            text: empty-text;
        }
        if AlbumsUi.grid && empty-title == "": AlbumGrid { vertical-stretch: 1; }
        lv := ListView {
            gutter: true;
            vertical-stretch: empty-title != "" || AlbumsUi.grid ? 0 : 1;
            visible: empty-title == "" && !AlbumsUi.grid;
            content-width: list-width;
            for r[i] in rows: Rectangle {
                width: list-width;
                height: row-height;
                property <bool> selected: LibraryEdit.picks[i];
                border-radius: 4px;
                // Rows alternate darker and lighter.
                background: selected ? (focused ? Theme.selection : Theme.selection-idle) : rta.has-hover ? Theme.n-2a2a2e : r.has-color && ColumnUi.color-mode == 2 ? (mod(i, 2) == 1 ? Theme.row-alt : Theme.row).mix(r.color, 0.86) : mod(i, 2) == 1 ? Theme.row-alt : Theme.row;
                DragArea {
                    // Picked rows go together (the browser knows which); any
                    // other row goes alone.
                    data: TrackDrag.payload(i, i);
                    allow-copy: true;
                    changed dragging => {
                        TrackDrag.active = self.dragging;
                        if self.dragging && !selected { pick(i); }
                    }
                    rta := TouchArea {
                        clicked => {
                            if shift-held {
                                extend(i, cmd-held);
                            } else if cmd-held {
                                toggle(i);
                            } else {
                                pick(i);
                            }
                        }
                        double-clicked => { pick(i); activate(i); }
                        pointer-event(e) => {
                            if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                                shift-held = e.modifiers.shift;
                                cmd-held = e.modifiers.control;
                            }
                            // A Spotify track the collection doesn't have: pick which it is.
                            if !r.available && r.streamed && e.button == PointerEventButton.right && e.kind == PointerEventKind.down {
                                // Picked rows stay picked, for Add to Wanted on them all.
                                if !selected { pick(i); }
                                menu-row = i;
                                menu-count = max(1, LibraryEdit.picked-count);
                                menu-matched = false;
                                menu-x = self.mouse-x;
                                menu-y = self.absolute-position.y - root.absolute-position.y + self.mouse-y;
                                StreamMatch.open(i);
                                match-menu.show();
                            }
                            if WantedUi.shown && e.button == PointerEventButton.right && e.kind == PointerEventKind.down {
                                if !selected { pick(i); }
                                menu-row = i;
                                menu-count = max(1, LibraryEdit.picked-count);
                                menu-x = self.mouse-x;
                                menu-y = self.absolute-position.y - root.absolute-position.y + self.mouse-y;
                                wanted-menu.show();
                            }
                            if r.available && r.action == "" && e.button == PointerEventButton.right && e.kind == PointerEventKind.down {
                                if !selected { pick(i); }
                                menu-row = i;
                                menu-last = i;
                                menu-count = max(1, LibraryEdit.picked-count);
                                menu-rating = r.rating;
                                menu-x = self.mouse-x;
                                menu-y = self.absolute-position.y - root.absolute-position.y + self.mouse-y;
                                track-menu.show();
                            }
                        }
                    }
                }
                if r.set-start: Rectangle {
                    y: 0px;
                    height: 1px;
                    background: Theme.lilac.transparentize(0.5);
                }
                if r.has-color && ColumnUi.color-mode == 1: Rectangle {
                    x: 0px;
                    width: 3px;
                    height: parent.height - 8px;
                    border-radius: 1.5px;
                    background: r.color;
                }
                HorizontalLayout {
                    spacing: 8px;
                    padding-left: 6px;
                    // As the header, so the columns line up.
                    padding-right: 14px;
                    // Album art, first.
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: w-art;
                            height: w-art;
                            border-radius: 3px;
                            clip: true;
                            background: Theme.n-2a2a2e;
                            if !r.has-cover: Text { text: "♪"; color: Theme.text-dim; font-size: 12px; }
                            if r.has-cover: Image { width: parent.width; height: parent.height; source: r.cover; image-fit: cover; }
                        }
                    }
                    Rectangle {
                        width: w-deck;
                        // Queued for analysis: a dim dot, pulsing lilac while being analysed.
                        if r.analysing > 0 && r.deck < 0 && !r.missing: Rectangle {
                            width: 7px;
                            height: 7px;
                            border-radius: 3.5px;
                            background: r.analysing == 2 ? (selected ? Theme.on-row-selection : Theme.lilac) : Theme.text-dim;
                            opacity: r.analysing == 2 ? 0.35 + 0.65 * abs(sin(animation-tick() / 1ms * 0.25deg)) : 0.6;
                        }
                        // A Spotify track that isn't in the collection: a hollow green ring.
                        if r.missing: Text {
                            text: "!";
                            color: Theme.c-ff9f0a;
                            font-size: 14px;
                            font-weight: 700;
                        }
                        // A SoundCloud track or Mixcloud show the collection
                        // doesn't have: a play button for its page.
                        if !r.available && r.action == "" && (StoreUi.source == 8 || StoreUi.source == 11): Rectangle {
                            width: 18px;
                            height: 18px;
                            border-radius: 9px;
                            background: pta.has-hover ? (StoreUi.source == 8 ? #ff5500 : #5000ff) : Theme.n-ffffff20;
                            Text { text: "▶"; color: #ffffff; font-size: 9px; x: 6px; }
                            pta := TouchArea { mouse-cursor: pointer; clicked => { current = i; activate(i); } }
                        }
                        if !r.available && r.action == "" && StoreUi.source != 8 && StoreUi.source != 11: Rectangle {
                            width: 10px;
                            height: 10px;
                            border-radius: 5px;
                            border-width: 1.5px;
                            border-color: #1ed760;
                        }
                        if r.deck >= 0: Rectangle {
                            width: 16px;
                            height: 16px;
                            border-radius: 4px;
                            background: selected ? Theme.s-00000040 : Theme.deck-color(r.deck);
                            Text { text: r.deck + 1; color: #fff; font-size: 10px; font-weight: 700; }
                        }
                    }
                    // A store result's button: buy, search the store, or download.
                    if results: Rectangle {
                        width: w-action;
                        if r.action != "": VerticalLayout {
                            alignment: center;
                            Rectangle {
                                height: 20px;
                                width: 54px;
                                border-radius: 10px;
                                background: ata.has-hover ? Theme.accent.brighter(0.15) : Theme.accent;
                                Text { text: r.action; color: #000000; font-size: 11px; font-weight: 700; }
                                ata := TouchArea { mouse-cursor: pointer; clicked => { current = i; activate(i); } }
                            }
                        }
                    }
                    for col[c] in ColumnUi.columns: Rectangle {
                        horizontal-stretch: 0;
                        min-width: col.width;
                        max-width: col.width;
                        property <color> plain: selected ? Theme.on-row-selection : (r.available && !r.missing && !r.fade) || r.action != "" ? Theme.text : Theme.text-dim;
                        if col.kind == 2: Text {
                            width: 100%;
                            text: r.rating == 0 ? "" : stars(r.rating);
                            color: selected ? Theme.on-row-selection : Theme.c-ffd60a;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        if col.kind == 1: Text {
                            width: 100%;
                            text: r.title;
                            color: selected ? Theme.on-row-selection : r.deck >= 0 ? Theme.deck-color(r.deck) : plain;
                            font-size: 15px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        // The key, and the shift that would make it mix.
                        if col.kind == 3: HorizontalLayout {
                            width: 100%;
                            spacing: 3px;
                            alignment: col.right ? end : start;
                            // The key keeps its room; a narrow column clips the mark.
                            Text {
                                min-width: self.preferred-width;
                                text: c < r.cells.length ? r.cells[c] : "";
                                color: selected ? Theme.on-row-selection : r.key-match ? Theme.lilac-text : Theme.text;
                                font-size: 15px;
                                vertical-alignment: center;
                            }
                            if r.key-shift != 0: Text {
                                overflow: clip;
                                text: shift-mark(r.key-shift);
                                color: selected ? Theme.on-row-selection-dim : r.key-shift == 1 || r.key-shift == -1 ? Theme.lilac-dim : Theme.key-far;
                                font-size: 10px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                        // The mini waveform, in lilac (white on the highlight).
                        // The track's color as a dot.
                        if col.kind == 7 && r.has-color: Rectangle {
                            x: (parent.width - self.width) / 2;
                            width: 10px;
                            height: 10px;
                            border-radius: 5px;
                            background: r.color;
                            border-width: selected ? 1.5px : 0px;
                            border-color: Theme.on-row-selection;
                        }
                        if col.kind == 6 && r.has-wave: Image {
                            y: 4px;
                            width: 100%;
                            height: row-height - 8px;
                            source: r.wave;
                            image-fit: fill;
                            colorize: selected ? Theme.on-row-selection : (r.available && !r.missing && !r.fade) ? Theme.lilac : Theme.text-dim;
                        }
                        if col.kind == 0 || col.kind == 4 || col.kind == 5: Text {
                            width: 100%;
                            text: c < r.cells.length ? r.cells[c] : "";
                            color: col.kind == 5 ? (selected ? Theme.on-row-selection : Theme.lilac-text)
                                : col.kind == 4 ? (selected ? Theme.on-row-selection-dim : Theme.text-dim)
                                : plain;
                            font-size: col.kind >= 4 ? 14px : 15px;
                            vertical-alignment: center;
                            horizontal-alignment: col.right ? right : left;
                            overflow: elide;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
        }
    }
    // The open list takes tracks dragged onto it from the side panel or a
    // deck, even while it's empty and shows its placeholder.
    if LibraryEdit.in-list: list-drop := DropArea {
        can-drop(e) => { LibraryEdit.accepts-list-drop(e.data) ? DragAction.copy : DragAction.none }
        dropped(e) => {
            LibraryEdit.drop-on-list(e.data);
            TrackDrag.active = false;
            DragAction.copy
        }
        Rectangle {
            border-radius: 4px;
            border-width: list-drop.has-drag ? 2px : 0px;
            border-color: Theme.accent;
        }
    }

    // A key shift as the library marks it: "+1", "−2".
    pure function shift-mark(n: int) -> string {
        n > 0 ? "+" + n : "−" + (-n)
    }
    pure function stars(n: int) -> string {
        n == 1 ? "★" : n == 2 ? "★★" : n == 3 ? "★★★" : n == 4 ? "★★★★" : "★★★★★"
    }
}

// Starts and stops Automix: a play triangle and the word, green while on.
component AutomixButton inherits Rectangle {
    in property <bool> on;
    callback clicked();
    property <color> green: Theme.automix;
    width: 92px;
    height: 22px;
    border-radius: 11px;
    background: on ? (ta.pressed ? green.darker(0.2) : ta.has-hover ? green.brighter(0.1) : green)
        : ta.pressed ? Theme.control-pressed : ta.has-hover ? Theme.panel-raised.brighter(0.3) : Theme.panel-raised;
    border-width: on ? 0px : 1px;
    border-color: green.with-alpha(0.6);
    HorizontalLayout {
        alignment: center;
        spacing: 5px;
        Path {
            width: 9px;
            height: 22px;
            viewbox-width: 9;
            viewbox-height: 22;
            fill: on ? Theme.n-000000 : green;
            commands: on ? "M 0 6.5 L 3 6.5 L 3 15.5 L 0 15.5 Z M 5.5 6.5 L 8.5 6.5 L 8.5 15.5 L 5.5 15.5 Z" : "M 0.5 6 L 8.5 11 L 0.5 16 Z";
        }
        Text { text: "AUTOMIX"; color: on ? #000000 : Theme.text; font-size: 11px; font-weight: 700; letter-spacing: 0.5px; vertical-alignment: center; }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
    TourMark { id: "ui,automix_button"; }
}

// A small flat button with a word on it.
component SmallButton inherits Rectangle {
    in property <string> text;
    // Names it for the guided tour (see TourMark).
    in property <string> tour-id;
    // Switched on (Repeat): drawn in the accent.
    in property <bool> lit;
    callback clicked();
    width: label.preferred-width + 16px;
    height: 22px;
    y: 1px;
    border-radius: 4px;
    background: lit ? Theme.accent.with-alpha(0.18) : ta.pressed ? Theme.control-pressed : ta.has-hover ? Theme.panel-raised.brighter(0.3) : Theme.panel-raised;
    border-width: lit ? 1px : 0px;
    border-color: Theme.accent;
    label := Text { text: root.text; color: lit ? Theme.lilac-text : Theme.text; font-size: 12px; font-weight: 500; }
    ta := TouchArea { clicked => { root.clicked(); } }
    TourMark { id: root.tour-id; }
}

// A line of a dropdown: a choice, or a heading over the choices below it.
struct Choice {
    text: string,
    header: bool,
    value: int,
}

// A labelled field showing the current choice; clicking opens the choices.
component Dropdown inherits Rectangle {
    // Names it for the guided tour (see TourMark).
    in property <string> tour-id;
    in property <string> label;
    in property <string> text;
    in property <[Choice]> choices;
    in property <int> current;
    callback picked(value: int);
    height: 26px;
    border-radius: Theme.radius;
    background: ta.has-hover ? Theme.n-2a2a2e : Theme.control;
    border-width: 1px;
    border-color: Theme.border;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;
        Text { text: label; color: Theme.text-dim; font-size: 10px; font-weight: 600; letter-spacing: 0.5px; vertical-alignment: center; }
        Text { horizontal-stretch: 1; text: root.text; color: Theme.text; font-size: 12px; font-weight: 600; vertical-alignment: center; overflow: elide; }
        Path {
            width: 8px;
            height: 5px;
            y: (parent.height - self.height) / 2;
            commands: "M 0 0 L 4 4.5 L 8 0";
            stroke: Theme.text-dim;
            stroke-width: 1.5px;
            fill: transparent;
        }
    }
    ta := TouchArea { clicked => { menu.show(); } }
    TourMark { id: root.tour-id; }
    menu := PopupWindow {
        x: 0px;
        y: root.height + 2px;
        width: root.width;
        close-policy: close-on-click-outside;
        MenuBackground {}
        VerticalLayout {
            padding: 6px;
            for c in choices: Rectangle {
                height: c.header ? 22px : 26px;
                border-radius: 4px;
                background: c.header ? transparent : c.value == current ? Theme.accent.with-alpha(0.35) : ita.has-hover ? Theme.n-3a3a3d : transparent;
                Text {
                    x: c.header ? 6px : 12px;
                    width: parent.width - self.x - 6px;
                    text: c.text;
                    color: c.header ? Theme.text-dim : Theme.text;
                    font-size: c.header ? 10px : 13px;
                    font-weight: c.header || c.value == current ? 600 : 400;
                    letter-spacing: c.header ? 0.5px : 0px;
                    vertical-alignment: center;
                    overflow: elide;
                }
                ita := TouchArea {
                    enabled: !c.header;
                    clicked => {
                        picked(c.value);
                        menu.close();
                    }
                }
            }
        }
    }
}

// A switch with its words, for the Fix Names dialog.
component TickLine inherits HorizontalLayout {
    in property <string> text;
    in-out property <bool> on;
    callback toggled();
    horizontal-stretch: 0;
    spacing: 6px;
    VerticalLayout {
        alignment: center;
        Tick { on: root.on; }
    }
    Text { text: root.text; color: Theme.text; font-size: 12px; vertical-alignment: center; }
    TouchArea {
        clicked => {
            root.on = !root.on;
            root.toggled();
        }
    }
}

// A text box for the Fix Names dialog.
component FixBox inherits Rectangle {
    in property <string> hint;
    in-out property <string> text;
    in property <bool> autofocus;
    callback edited();
    callback accepted();
    init => {
        if autofocus { input.focus(); }
    }
    height: 30px;
    border-radius: 4px;
    background: Theme.well;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;
    TouchArea { mouse-cursor: MouseCursor.text; clicked => { input.focus(); } }
    if root.text == "": Text {
        x: 8px;
        text: root.hint;
        color: Theme.text-dim.with-alpha(0.7);
        font-size: 13px;
        vertical-alignment: center;
    }
    input := TextInput {
        x: 8px;
        width: parent.width - 16px;
        text <=> root.text;
        single-line: true;
        color: Theme.text;
        font-size: 13px;
        vertical-alignment: center;
        selection-background-color: Theme.selection;
        selection-foreground-color: Theme.on-selection;
        edited => { root.edited(); }
        accepted => { root.accepted(); }
    }
}

// Fix Names: pick a tool, see what it would change, then review the
// changes in the review table.
component FixNamesDialog inherits Rectangle {
    background: Theme.s-000000a0;
    TouchArea { }
    Rectangle {
        width: min(parent.width - 32px, 640px);
        height: min(parent.height - 32px, col.preferred-height);
        background: Theme.browser;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 24px;
        drop-shadow-color: Theme.s-000000c0;
        col := VerticalLayout {
            padding: 18px;
            spacing: 12px;
            VerticalLayout {
                spacing: 2px;
                Text { text: "Fix names in " + (FixNamesUi.count == 1 ? "1 track" : FixNamesUi.count + " tracks"); color: Theme.text; font-size: 18px; font-weight: 700; }
                Text { text: "Nothing changes until you Apply in the review table. Undo takes the whole change back."; color: Theme.text-dim; font-size: 12px; wrap: word-wrap; }
            }
            // The tools.
            HorizontalLayout {
                height: 30px;
                spacing: 6px;
                for name[i] in ["Find and Replace", "Change Case", "Remove Brackets", "Swap Artist and Title"]: Rectangle {
                    width: tool-text.preferred-width + 22px;
                    border-radius: 15px;
                    background: i == FixNamesUi.tool ? Theme.accent : tool-ta.has-hover ? Theme.panel-raised.brighter(0.3) : Theme.control;
                    tool-text := Text {
                        text: name;
                        color: i == FixNamesUi.tool ? #000000 : Theme.text;
                        font-size: 12px;
                        font-weight: 600;
                    }
                    tool-ta := TouchArea {
                        clicked => {
                            FixNamesUi.tool = i;
                            FixNamesUi.update();
                        }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            if FixNamesUi.tool != 3: HorizontalLayout {
                spacing: 8px;
                Dropdown {
                    width: 180px;
                    label: "IN";
                    text: ["All names", "Track", "Artist", "Remix", "Album", "Genre", "Comment", "Grouping"][FixNamesUi.field];
                    current: FixNamesUi.field;
                    choices: [
                        { text: "All names", value: 0 },
                        { text: "Track", value: 1 },
                        { text: "Artist", value: 2 },
                        { text: "Remix", value: 3 },
                        { text: "Album", value: 4 },
                        { text: "Genre", value: 5 },
                        { text: "Comment", value: 6 },
                        { text: "Grouping", value: 7 },
                    ];
                    picked(v) => {
                        FixNamesUi.field = v;
                        FixNamesUi.update();
                    }
                }
                if FixNamesUi.tool == 0: FixBox {
                    horizontal-stretch: 1;
                    autofocus: true;
                    hint: "Find";
                    text <=> FixNamesUi.find;
                    edited => { FixNamesUi.update(); }
                    accepted => { FixNamesUi.review(); }
                }
                if FixNamesUi.tool == 0: Text { text: "→"; color: Theme.text-dim; font-size: 14px; vertical-alignment: center; }
                if FixNamesUi.tool == 0: FixBox {
                    horizontal-stretch: 1;
                    hint: "Replace with (nothing)";
                    text <=> FixNamesUi.with;
                    edited => { FixNamesUi.update(); }
                    accepted => { FixNamesUi.review(); }
                }
                if FixNamesUi.tool == 1: HorizontalLayout {
                    spacing: 6px;
                    for name[i] in ["Title Case", "Sentence case", "UPPER", "lower"]: Rectangle {
                        width: case-text.preferred-width + 20px;
                        border-radius: 13px;
                        background: i == FixNamesUi.case ? Theme.accent.with-alpha(0.35) : case-ta.has-hover ? Theme.n-ffffff10 : transparent;
                        border-width: 1px;
                        border-color: i == FixNamesUi.case ? Theme.accent : Theme.border;
                        case-text := Text { text: name; color: Theme.text; font-size: 12px; }
                        case-ta := TouchArea {
                            clicked => {
                                FixNamesUi.case = i;
                                FixNamesUi.update();
                            }
                        }
                    }
                }
                if FixNamesUi.tool == 2: Text {
                    text: "Takes out what's in (round) and [square] brackets.";
                    color: Theme.text-dim;
                    font-size: 12px;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: FixNamesUi.tool == 0 ? 0 : 1; }
            }
            if FixNamesUi.tool == 0: HorizontalLayout {
                spacing: 18px;
                TickLine { text: "Match case"; on <=> FixNamesUi.match-case; toggled => { FixNamesUi.update(); } }
                TickLine { text: "Whole words"; on <=> FixNamesUi.whole-words; toggled => { FixNamesUi.update(); } }
                TickLine { text: "Pattern (regular expression)"; on <=> FixNamesUi.pattern; toggled => { FixNamesUi.update(); } }
                Rectangle { horizontal-stretch: 1; }
            }
            if FixNamesUi.tool == 3: Text {
                text: "For tracks whose artist and title are the wrong way round, as from a file called \"Title - Artist\".";
                color: Theme.text-dim;
                font-size: 12px;
                wrap: word-wrap;
            }
            // What it would change.
            VerticalLayout {
                spacing: 2px;
                for r in FixNamesUi.preview: HorizontalLayout {
                    height: 26px;
                    spacing: 10px;
                    property <length> half: (self.width - 70px - 14px - 3 * 10px) / 2;
                    Text { width: 70px; text: r.field; color: Theme.text-dim; font-size: 12px; vertical-alignment: center; overflow: elide; }
                    Text { width: half; text: r.old; color: Theme.text-dim; font-size: 13px; vertical-alignment: center; overflow: elide; }
                    Text { width: 14px; text: "→"; color: Theme.text-dim; font-size: 13px; vertical-alignment: center; }
                    Text { width: half; text: r.new == "" ? "(nothing)" : r.new; color: Theme.text; font-size: 13px; vertical-alignment: center; overflow: elide; }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Text {
                    horizontal-stretch: 1;
                    text: FixNamesUi.error != "" ? FixNamesUi.error
                        : FixNamesUi.tool == 0 && FixNamesUi.find == "" ? "Type what to find."
                        : FixNamesUi.changing == 0 ? "Nothing to change in these tracks."
                        : FixNamesUi.changing + " of " + FixNamesUi.count + (FixNamesUi.count == 1 ? " track changes" : " tracks change");
                    color: FixNamesUi.error != "" ? Theme.danger : Theme.text-dim;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                }
                HealthButton { text: "Cancel"; clicked => { FixNamesUi.cancel(); } }
                HealthButton {
                    text: "Review" + (FixNamesUi.changing > 0 ? " (" + FixNamesUi.changing + ")" : "");
                    primary: FixNamesUi.changing > 0 && FixNamesUi.error == "";
                    clicked => { FixNamesUi.review(); }
                }
            }
        }
    }
}

// A switch line on the Buy sheet: the whole line is clickable.
component BuyTick inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    callback toggled();
    height: 20px;
    HorizontalLayout {
        spacing: 6px;
        alignment: start;
        VerticalLayout {
            alignment: center;
            Tick { on: root.on; }
        }
        Text { text: root.text; color: Theme.text; font-size: 12px; vertical-alignment: center; }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

// Buy: the Wanted tracks picked, grouped by the store chosen for each.
// Opening a store opens its pages one at a time; the DJ adds each to the
// store's cart and checks out there.
component BuyDialog inherits Rectangle {
    background: Theme.s-000000a0;
    TouchArea { }
    Rectangle {
        width: min(parent.width - 32px, 600px);
        height: min(parent.height - 32px, col.preferred-height);
        background: Theme.browser;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 24px;
        drop-shadow-color: Theme.s-000000c0;
        col := VerticalLayout {
            padding: 18px;
            spacing: 12px;
            VerticalLayout {
                spacing: 2px;
                Text { text: BuyUi.count == 1 ? "Buy 1 track" : "Buy " + BuyUi.count + " tracks"; color: Theme.text; font-size: 18px; font-weight: 700; }
                Text {
                    text: BuyUi.looked < BuyUi.count
                        ? "Looking in the stores… " + BuyUi.looked + " of " + BuyUi.count
                        : "Open a store's tracks one by one: add each to the store's cart, then Next. Check out once on that store; payment never goes through openDJ. Click a track to open just that one.";
                    color: Theme.text-dim;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }
            // The stores, best first.
            for g[i] in BuyUi.groups: Rectangle {
                height: 40px;
                border-radius: 6px;
                background: Theme.panel-raised;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 8px;
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Text { text: g.store; color: Theme.text; font-size: 13px; font-weight: 600; overflow: elide; }
                        Text {
                            text: (g.count == 1 ? "1 track" : g.count + " tracks") + (g.found ? "" : " · not found, opens a search");
                            color: Theme.text-dim;
                            font-size: 11px;
                            overflow: elide;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    VerticalLayout {
                        alignment: center;
                        HealthButton {
                            // One page at a time: Open, then Next for the next track.
                            text: g.count == 1 ? (g.found ? "Open" : "Search") + (g.opened > 0 ? " Again" : "")
                                : g.opened >= g.count ? "Start Again"
                                : g.opened == 0 ? (g.found ? "Open" : "Search") + " 1 of " + g.count
                                : "Next: " + (g.opened + 1) + " of " + g.count;
                            primary: g.opened < g.count && g.found;
                            clicked => { BuyUi.open-group(i); }
                        }
                    }
                }
            }
            // The tracks: click the store to pick another.
            Flickable {
                height: min(BuyUi.rows.length * 28px, 196px);
                content-height: BuyUi.rows.length * 28px;
                for r[i] in BuyUi.rows: Rectangle {
                    y: i * 28px;
                    height: 28px;
                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle {
                            horizontal-stretch: 1;
                            Text {
                                width: 100%;
                                text: r.name;
                                color: name-ta.has-hover ? Theme.lilac-text : Theme.text;
                                font-size: 12px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            name-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { BuyUi.open-track(i); }
                            }
                        }
                        if r.price != "": Text {
                            text: r.price;
                            color: Theme.text-dim;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                        // The store chosen; a click lists the others to pick from.
                        chip := Rectangle {
                            width: store-text.preferred-width + 18px;
                            height: 22px;
                            y: 3px;
                            border-radius: 11px;
                            background: store-ta.has-hover && r.others > 0 ? Theme.panel-raised.brighter(0.3) : Theme.control;
                            store-text := Text {
                                text: r.store == "" ? "…" : (r.found ? "" : "Try ") + r.store + (r.others > 0 ? "  ▾" : "");
                                color: r.found ? Theme.text : Theme.text-dim;
                                font-size: 11px;
                            }
                            store-ta := TouchArea {
                                mouse-cursor: r.others > 0 ? pointer : default;
                                clicked => {
                                    if r.others > 0 {
                                        store-menu.show();
                                    }
                                }
                            }
                            store-menu := PopupWindow {
                                x: chip.width - 220px;
                                y: chip.height + 2px;
                                width: 220px;
                                close-policy: close-on-click-outside;
                                MenuBackground {}
                                VerticalLayout {
                                    padding: 6px;
                                    for label[k] in r.stores: MenuLine {
                                        text: (k == r.chosen ? "✓  " : "    ") + label;
                                        clicked => {
                                            store-menu.close();
                                            BuyUi.pick-store(i, k);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            VerticalLayout {
                spacing: 6px;
                BuyTick {
                    text: "Bring purchases into Inbox";
                    on: BuyUi.inbox-on;
                    toggled => { BuyUi.set-inbox(!BuyUi.inbox-on); }
                }
                if BuyUi.music-app-offered: BuyTick {
                    text: "Also take purchases from the Music app";
                    on: BuyUi.music-app-on;
                    toggled => { BuyUi.set-music-app(!BuyUi.music-app-on); }
                }
                Text { text: BuyUi.inbox-note; color: Theme.text-dim; font-size: 11px; wrap: word-wrap; }
            }
            HorizontalLayout {
                alignment: end;
                HealthButton { text: "Done"; clicked => { BuyUi.close(); } }
            }
        }
    }
}

// A row of small choices, one lit: Up Next's mix length or style.
component MixChips inherits HorizontalLayout {
    in property <[string]> names;
    in property <int> current;
    callback picked(value: int);
    spacing: 3px;
    padding-left: 4px;
    padding-right: 4px;
    for n[i] in names: Rectangle {
        height: 22px;
        horizontal-stretch: 1;
        min-width: t.preferred-width + 8px;
        border-radius: 4px;
        border-width: 1px;
        border-color: i == current ? Theme.accent : Theme.border;
        background: i == current ? Theme.accent.with-alpha(0.2) : ta.has-hover ? Theme.n-ffffff14 : transparent;
        t := Text { text: n; color: i == current ? Theme.text : Theme.text-dim; font-size: 11px; font-weight: 600; }
        ta := TouchArea { mouse-cursor: pointer; clicked => { root.picked(i); } }
    }
}

component SidePanel inherits Rectangle {
    in property <[SideRow]> rows;
    in property <string> total;
    // 0 Automix, 1 Sidelist, 2 Related, 3 Info (the selected track's
    // details, see info.slint), 4 Cues (a deck's cues, see cues.slint),
    // 5 Checklist (what makes the deck's track ready, see checklist.slint),
    // 6 Lyrics (the playing track's lyrics, see lyrics.slint).
    in-out property <int> tab: 0;
    callback activate(row: int);
    // Takes out the rows `first` to `last`.
    callback remove(first: int, last: int);
    in property <bool> automix-on;
    in property <string> automix-status;
    // After an Order pick: what the list was put in order by, with Undo.
    in-out property <string> automix-order-note;
    in property <int> automix-length;
    in property <int> automix-style;
    // Played tracks go back to the end of the list instead of leaving it.
    in property <bool> automix-repeat;
    callback automix-set-repeat(bool);
    callback automix-toggle();
    callback automix-mix-now();
    callback automix-skip();
    callback automix-order(int);
    callback automix-order-undo();
    callback automix-set-length(index: int);
    callback automix-set-style(index: int);
    // The row picked with a click, for Delete and the right-click menu;
    // shift-click picks every row from `anchor` to it, as in the track list.
    property <int> selected: -1;
    property <int> anchor: -1;
    property <int> range-end: -1;
    property <bool> ranged: anchor >= 0 && range-end == selected && anchor != selected;
    property <int> first-picked: ranged ? min(anchor, selected) : selected;
    property <int> last-picked: ranged ? max(anchor, selected) : selected;
    property <bool> shift-held;
    function pick(i: int) {
        anchor = i;
        range-end = i;
        selected = i;
    }
    function extend(i: int) {
        if anchor < 0 || !(range-end == selected) {
            anchor = selected;
        }
        range-end = i;
        selected = i;
    }
    function select-all() {
        if rows.length > 0 {
            anchor = rows.length - 1;
            range-end = 0;
            selected = 0;
        }
    }
    // Where a row was just removed, so the one taking its place gets selected.
    property <int> removed-at: -1;
    property <length> row-height: 56px;
    // Where a dragged track would go in, while one is over the list.
    property <int> drop-at: drop.has-drag ? max(0, min(rows.length, round((drag-y - lv.content-y) / row-height))) : -1;
    property <length> drag-y;
    property <length> menu-y;
    changed rows => {
        selected = removed-at >= 0 && rows.length > 0 ? min(removed-at, rows.length - 1) : -1;
        removed-at = -1;
    }
    changed tab => { selected = -1; }
    // Takes out the picked rows.
    function remove-picked() {
        removed-at = first-picked;
        remove(first-picked, last-picked);
    }
    background: Theme.browser;
    width: 340px;
    // The tabs, as words along the top, the one shown underlined.
    tab-bar := Rectangle {
        y: 0px;
        height: 40px;
        HorizontalLayout {
            // Each tab as wide as its word, with the room left shared out,
            // in the DJ's order. A tab switched off folds to nothing, unless
            // it is the one open (Show Info opens Info even when it's off).
            // Cues and Checklist only in the Prep layout.
            for t in SideTabs.tabs: Rectangle {
                property <bool> shown: (t.on || t.i == tab) && (CueList.prep ? t.pos : t.pos-plain) >= 0;
                horizontal-stretch: shown ? 1 : 0;
                preferred-width: shown ? tab-word.preferred-width + 8px : 0px;
                min-width: shown ? tab-word.preferred-width + 4px : 0px;
                max-width: shown ? 1000px : 0px;
                visible: shown;
                property <string> name: t.name;
                property <int> i: t.i;
                property <bool> on: i == tab;
                background: tta.has-hover && !on ? Theme.n-ffffff08 : transparent;
                tab-word := Text {
                    text: name;
                    color: on ? Theme.lilac-text : tta.has-hover ? Theme.text : Theme.text-dim;
                    font-size: 12px;
                    font-weight: on ? 600 : 500;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                Rectangle {
                    y: parent.height - self.height;
                    height: 2px;
                    background: on ? Theme.accent : transparent;
                }
                // Right-click a title to pick the tabs and their order.
                tta := TouchArea {
                    clicked => { tab = i; }
                    pointer-event(e) => {
                        if e.button == PointerEventButton.right && e.kind == PointerEventKind.down {
                            tabs-menu-x = parent.x + self.mouse-x;
                            tabs-menu.show();
                        }
                    }
                }
                TourMark { id: i == 0 ? "ui,side_automix" : ""; }
            }
        }
        Rectangle {
            y: parent.height - 1px;
            height: 1px;
            background: Theme.separator;
        }
    }
    // The tabs' chooser: a switch for each, and a grip to drag it up or down.
    property <length> tabs-menu-x;
    tabs-menu := PopupWindow {
        property <int> n: CueList.prep ? SideTabs.listed : SideTabs.listed-plain;
        property <int> on-count: CueList.prep ? SideTabs.on-count : SideTabs.on-count-plain;
        property <length> row-h: 40px;
        // The row being dragged, how far, and where it would land.
        property <int> drag-from: -1;
        property <length> drag-dy;
        property <length> drag-start;
        property <int> drag-to: drag-from < 0 ? -1 : max(0, min(n - 1, drag-from + round(drag-dy / row-h)));
        property <string> drag-name;
        property <bool> drag-on;
        x: max(4px, min(root.width - self.width - 4px, tabs-menu-x - 30px));
        y: tab-bar.height + 2px;
        width: 240px;
        height: menu-list.preferred-height;
        close-policy: close-on-click-outside;
        Rectangle {
            background: Theme.n-2a2a2d;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 16px;
            drop-shadow-color: Theme.s-00000080;
        }
        menu-list := VerticalLayout {
            padding: 8px;
            spacing: 2px;
            SourceMenuTitle { text: "SIDE PANEL TABS"; }
            rows-box := Rectangle {
                height: n * row-h;
                for t in SideTabs.tabs: Rectangle {
                    property <int> pos: CueList.prep ? t.pos : t.pos-plain;
                    property <bool> locked: t.on && on-count <= 1;
                    // Rows between where the dragged one was and where it
                    // would go step aside for it.
                    property <length> shift: drag-from < 0 || pos == drag-from ? 0px
                        : drag-from < drag-to && pos > drag-from && pos <= drag-to ? -row-h
                        : drag-from > drag-to && pos < drag-from && pos >= drag-to ? row-h : 0px;
                    // The dragged row stays put, unseen, so its grip keeps the mouse.
                    visible: pos >= 0;
                    opacity: pos == drag-from ? 0 : 1;
                    x: 0;
                    y: max(0, pos) * row-h + shift;
                    width: parent.width;
                    height: row-h;
                    animate y { duration: 100ms; }
                    HorizontalLayout {
                        padding-left: 4px;
                        padding-right: 6px;
                        spacing: 8px;
                        Rectangle {
                            width: 16px;
                            DragGrip { dot-color: grip.has-hover ? Theme.text : Theme.text-dim; }
                            grip := TouchArea {
                                mouse-cursor: drag-from >= 0 ? MouseCursor.grabbing : MouseCursor.grab;
                                pointer-event(e) => {
                                    if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                                        drag-from = pos;
                                        drag-name = t.name;
                                        drag-on = t.on;
                                        drag-start = self.absolute-position.y + self.mouse-y;
                                        drag-dy = 0px;
                                    }
                                    if e.button == PointerEventButton.left && e.kind == PointerEventKind.up && drag-from >= 0 {
                                        if drag-to != drag-from {
                                            SideTabs.moved(t.i, drag-to - drag-from);
                                        }
                                        drag-from = -1;
                                        drag-dy = 0px;
                                    }
                                }
                                moved => {
                                    if drag-from >= 0 {
                                        drag-dy = self.absolute-position.y + self.mouse-y - drag-start;
                                    }
                                }
                            }
                        }
                        Text { text: t.name; color: Theme.text; font-size: 15px; vertical-alignment: center; horizontal-stretch: 1; }
                        if (t.i == 4 || t.i == 5): Text { text: "Prep"; color: Theme.text-dim; font-size: 10px; vertical-alignment: center; }
                        VerticalLayout {
                            alignment: center;
                            Switch {
                                on: t.on;
                                opacity: locked ? 0.45 : 1;
                                toggled => {
                                    if !locked {
                                        SideTabs.toggled(t.i);
                                    }
                                }
                            }
                        }
                    }
                }
                // The row being dragged, over the others.
                if drag-from >= 0: Rectangle {
                    y: max(0px, min(parent.height - row-h, drag-from * row-h + drag-dy));
                    width: parent.width;
                    height: row-h;
                    border-radius: 8px;
                    background: Theme.n-36363b;
                    drop-shadow-blur: 10px;
                    drop-shadow-color: Theme.s-00000080;
                    HorizontalLayout {
                        padding-left: 4px;
                        padding-right: 6px;
                        spacing: 8px;
                        Rectangle {
                            width: 16px;
                            DragGrip { dot-color: Theme.text; }
                        }
                        Text { text: drag-name; color: Theme.text; font-size: 15px; vertical-alignment: center; horizontal-stretch: 1; }
                        VerticalLayout { alignment: center; Switch { on: drag-on; } }
                    }
                }
            }
            Rectangle { height: 9px; Rectangle { height: 1px; background: Theme.border; } }
            reset-row-h := Rectangle {
                height: 32px;
                border-radius: 8px;
                background: rta.has-hover ? Theme.n-ffffff0d : transparent;
                Text { x: 6px; text: "Reset to default"; color: rta.has-hover ? Theme.text : Theme.text-dim; font-size: 13px; vertical-alignment: center; }
                rta := TouchArea { mouse-cursor: pointer; clicked => { SideTabs.reset(); } }
            }
        }
    }
    if tab == 3: InfoPanel {
        y: tab-bar.height;
        height: parent.height - tab-bar.height;
    }
    if tab == 6: LyricsPanel {
        y: tab-bar.height;
        height: parent.height - tab-bar.height;
    }
    if tab == 4 && CueList.prep: CuesPanel {
        y: tab-bar.height;
        height: parent.height - tab-bar.height;
    }
    if tab == 5 && CueList.prep: ChecklistPanel {
        y: tab-bar.height;
        height: parent.height - tab-bar.height;
    }
    keys := FocusScope {
        y: tab-bar.height;
        width: parent.width;
        height: parent.height - tab-bar.height;
        visible: tab < 3;
        key-pressed(e) => {
            // ⌘A (Ctrl+A on Linux and Windows) picks every row, to drag or remove them all.
            if (e.text == "a" || e.text == "A") && e.modifiers.control && !e.modifiers.alt && !e.modifiers.shift {
                select-all();
                return accept;
            }
            if selected >= 0 && selected < rows.length && (e.text == Key.Delete || e.text == Key.Backspace) {
                remove-picked();
                return accept;
            }
            if e.text == Key.UpArrow && selected > 0 {
                selected -= 1;
                return accept;
            }
            if e.text == Key.DownArrow && selected < rows.length - 1 {
                selected += 1;
                return accept;
            }
            if e.text == Key.Return && selected >= 0 {
                activate(selected);
                return accept;
            }
            reject
        }
        VerticalLayout {
            padding: 6px;
            spacing: 4px;
            HorizontalLayout {
                height: 30px;
                spacing: 8px;
                Text { text: ["Automix", "Sidelist", "Related"][tab]; color: Theme.text; font-size: 15px; font-weight: 600; vertical-alignment: center; }
                Text { text: total; color: Theme.label; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                if tab == 0: VerticalLayout {
                    alignment: center;
                    AutomixButton {
                        on: automix-on;
                        clicked => { automix-toggle(); }
                    }
                }
            }
            if tab == 0: VerticalLayout {
                spacing: 4px;
                HorizontalLayout {
                    spacing: 6px;
                    Dropdown {
                        horizontal-stretch: 1;
                        label: "LENGTH";
                        tour-id: "ui,automix_length";
                        text: ["0 s", "12 s", "15 s", "30 s", "16 bars", "32 bars", "Phrases"][automix-length];
                        current: automix-length;
                        choices: [
                            { text: "TIME", header: true, value: -1 },
                            // No mix: each track plays to its end and the next starts at once.
                            { text: "0 seconds (gapless)", value: 0 },
                            { text: "12 seconds", value: 1 },
                            { text: "15 seconds", value: 2 },
                            { text: "30 seconds", value: 3 },
                            { text: "BARS", header: true, value: -1 },
                            { text: "16 bars", value: 4 },
                            { text: "32 bars", value: 5 },
                            { text: "PHRASES", header: true, value: -1 },
                            // Intro over outro: from the outgoing outro, as long as the incoming intro.
                            { text: "Intro over outro", value: 6 },
                        ];
                        picked(i) => { automix-set-length(i); }
                    }
                    Dropdown {
                        horizontal-stretch: 1;
                        label: "STYLE";
                        tour-id: "ui,automix_style";
                        text: ["Smooth", "Bass swap", "Filter", "Cut"][automix-style];
                        current: automix-style;
                        choices: [
                            { text: "Smooth", value: 0 },
                            { text: "Bass swap", value: 1 },
                            { text: "Filter", value: 2 },
                            { text: "Cut", value: 3 },
                        ];
                        picked(i) => { automix-set-style(i); }
                    }
                }
                // Always there, so the list below doesn't move when the status comes and goes.
                HorizontalLayout {
                    height: 24px;
                    spacing: 6px;
                    Text {
                        horizontal-stretch: 1;
                        min-width: 0px;
                        text: automix-order-note != "" ? automix-order-note : automix-status;
                        color: automix-on || automix-order-note != "" ? Theme.text : Theme.text-dim;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    if automix-order-note != "": SmallButton { text: "Undo"; clicked => { automix-order-undo(); automix-order-note = ""; } }
                    // The note and its Undo go after a few seconds.
                    Timer {
                        interval: 8s;
                        running: automix-order-note != "";
                        triggered => { automix-order-note = ""; }
                    }
                    if rows.length > 2: SmallButton {
                        text: "Order ▾";
                        clicked => { order-menu.show(); }
                    }
                    // The list keeps going round: played tracks go back to its end.
                    SmallButton {
                        text: "Repeat";
                        lit: automix-repeat;
                        clicked => { automix-set-repeat(!automix-repeat); }
                    }
                    if automix-on: SmallButton { text: "Mix now"; tour-id: "ui,automix_mix_now"; clicked => { automix-mix-now(); } }
                    if automix-on: SmallButton { text: "Skip"; clicked => { automix-skip(); } }
                }
                // Player mode's cruise control: when the list runs out, tracks
                // that mix follow, from the pool picked here.
                if KeepGoingUi.player: HorizontalLayout {
                    spacing: 6px;
                    SmallButton {
                        text: "Keep going";
                        lit: KeepGoingUi.on;
                        clicked => { KeepGoingUi.set-on(!KeepGoingUi.on); }
                    }
                    Dropdown {
                        horizontal-stretch: 1;
                        label: "FROM";
                        text: KeepGoingUi.pool;
                        current: -1;
                        choices: KeepGoingUi.list-name != ""
                            ? [{ text: "Everything", value: 0 }, { text: KeepGoingUi.list-name, value: 1 }]
                            : [{ text: "Everything", value: 0 }];
                        picked(i) => { KeepGoingUi.pick-pool(i); }
                    }
                }
            }
            if tab == 0 && KeepGoingUi.player && UpNextUi.now-loaded: HorizontalLayout {
                height: 64px;
                padding: 4px;
                spacing: 10px;
                Rectangle {
                    width: 56px;
                    border-radius: 4px;
                    clip: true;
                    background: @linear-gradient(135deg, UpNextUi.now-tint 0%, UpNextUi.now-tint.darker(0.6) 100%);
                    if !UpNextUi.now-has-cover: Text { text: UpNextUi.now-initials; color: #ffffffd8; font-size: 18px; font-weight: 700; }
                    if UpNextUi.now-has-cover: Image { width: parent.width; height: parent.height; source: UpNextUi.now-cover; image-fit: cover; }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text { text: "NOW PLAYING"; color: Theme.lilac-text; font-size: 10px; font-weight: 700; letter-spacing: 0.5px; }
                    Text { text: UpNextUi.now-title; color: Theme.text; font-size: 14px; font-weight: 600; overflow: elide; }
                    Text { text: UpNextUi.now-artist; color: Theme.text-dim; font-size: 13px; overflow: elide; }
                }
            }
            if tab == 0 && KeepGoingUi.player && UpNextUi.now-loaded: Text { x: 8px; height: 20px; text: "UP NEXT"; color: Theme.label; font-size: 12px; font-weight: 700; letter-spacing: 0.4px; vertical-alignment: center; }
            EdgeLine { left: 6px; right: 6px; }
            order-menu := PopupWindow {
                x: root.width - self.width - 6px;
                // Just under the Order button.
                y: 98px;
                width: 230px;
                close-policy: close-on-click-outside;
                MenuBackground {}
                VerticalLayout {
                    padding: 6px;
                    Text {
                        height: 22px;
                        x: 6px;
                        text: "PUT THE LIST IN ORDER";
                        color: Theme.text-dim;
                        font-size: 10px;
                        font-weight: 600;
                        letter-spacing: 0.5px;
                        vertical-alignment: center;
                    }
                    // In automix_order::ORDERS order.
                    for name[i] in ["Shuffle", "BPM low to high", "BPM high to low", "Harmonic path", "Smooth flow (key and BPM)", "Reverse"]: Rectangle {
                        height: 26px;
                        border-radius: 4px;
                        background: ota.has-hover ? Theme.n-3a3a3d : transparent;
                        Text { x: 12px; text: name; color: Theme.text; font-size: 13px; vertical-alignment: center; }
                        ota := TouchArea {
                            clicked => {
                                automix-order(i);
                                order-menu.close();
                            }
                        }
                    }
                    Rectangle { height: 4px; }
                    Text {
                        x: 6px;
                        width: parent.width - 12px;
                        text: "The first track, and the ones Automix is playing or has waiting, stay where they are.";
                        color: Theme.text-dim;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                }
            }
            Rectangle {
                vertical-stretch: 1;
                border-radius: 4px;
                border-width: drop.has-drag ? 2px : TrackDrag.active ? 1px : 0px;
                border-color: drop.has-drag ? #30c158 : #30c15880;
                lv := ListView {
                    gutter: true;
                    for r[i] in rows: Rectangle {
                        height: r.heading != "" ? 30px : row-height;
                        opacity: r.suggested ? 0.45 : 1;
                        // A section heading in the Linked tab.
                        if r.heading != "": Text {
                            x: 8px;
                            text: r.heading;
                            color: Theme.label;
                            font-size: 12px;
                            font-weight: 700;
                            letter-spacing: 0.4px;
                            vertical-alignment: center;
                        }
                        border-radius: 4px;
                        // Lilac while focused, a darker lilac otherwise.
                        property <bool> picked: i >= first-picked && i <= last-picked;
                        background: picked ? (keys.has-focus ? Theme.selection : #5a4d80) : sta.has-hover ? Theme.n-1f1f22 : transparent;
                        // Picked rows go together, onto a deck, a list in
                        // the tree, or elsewhere in this list to reorder it.
                        DragArea {
                            data: picked ? TrackDrag.side-payload(tab, first-picked, last-picked) : TrackDrag.side-payload(tab, i, i);
                            allow-copy: true;
                            changed dragging => {
                                TrackDrag.active = self.dragging;
                                if self.dragging && !picked { pick(i); }
                            }
                            sta := TouchArea {
                                enabled: r.heading == "" && !r.suggested;
                                clicked => {
                                    if shift-held {
                                        extend(i);
                                    } else {
                                        pick(i);
                                    }
                                    keys.focus();
                                }
                                double-clicked => { pick(i); activate(i); }
                                pointer-event(e) => {
                                    if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                                        shift-held = e.modifiers.shift;
                                    }
                                    if e.button == PointerEventButton.right && e.kind == PointerEventKind.down {
                                        if !picked { pick(i); }
                                        keys.focus();
                                        menu-y = self.absolute-position.y - root.absolute-position.y + self.mouse-y;
                                        row-menu.show();
                                    }
                                }
                            }
                        }
                        // Cover, then two lines: title and tempo; artist, key and length.
                        if r.heading == "": HorizontalLayout {
                            padding: 4px;
                            spacing: 10px;
                            Rectangle {
                                width: row-height - 8px;
                                border-radius: 3px;
                                clip: true;
                                background: Theme.n-2a2a2e;
                                if !r.has-cover: Text { text: "♪"; color: Theme.text-dim; font-size: 18px; }
                                if r.has-cover: Image { width: parent.width; height: parent.height; source: r.cover; image-fit: cover; }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 2px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text { horizontal-stretch: 1; text: r.title; color: (i >= first-picked && i <= last-picked) && keys.has-focus ? Theme.on-row-selection : Theme.text; font-size: 14px; font-weight: 500; overflow: elide; }
                                    Text { text: r.bpm == "" ? "" : r.bpm + " BPM"; color: (i >= first-picked && i <= last-picked) && keys.has-focus ? Theme.on-row-selection : Theme.text; font-size: 14px; font-weight: 500; }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    property <color> dim: (i >= first-picked && i <= last-picked) ? (keys.has-focus ? Theme.on-row-selection-dim : Theme.n-ffffffc0) : Theme.text-dim;
                                    Text { horizontal-stretch: 1; text: r.artist; color: dim; font-size: 13px; overflow: elide; }
                                    HorizontalLayout {
                                        spacing: 2px;
                                        Text { text: r.key; color: (i >= first-picked && i <= last-picked) ? (keys.has-focus ? Theme.on-row-selection : #ffffff) : r.key-match ? Theme.lilac-text : Theme.text; font-size: 13px; font-weight: 500; }
                                        if r.key-shift != 0: Text {
                                            text: r.key-shift > 0 ? "+" + r.key-shift : "−" + (-r.key-shift);
                                            color: (i >= first-picked && i <= last-picked) ? Theme.on-row-selection-dim : r.key-shift == 1 || r.key-shift == -1 ? Theme.lilac-dim : Theme.key-far;
                                            font-size: 9px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }
                                    }
                                    if r.mix != "": Text { text: "⤵ " + r.mix; color: (i >= first-picked && i <= last-picked) ? dim : Theme.lilac-text; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                                    Text { text: r.length; color: dim; font-size: 13px; }
                                }
                            }
                        }
                    }
                }
                // Where a dropped track goes in.
                if drop-at >= 0 && tab != 2: Rectangle {
                    x: 4px;
                    y: max(0px, min(parent.height - 2px, drop-at * row-height + lv.content-y - 1px));
                    width: parent.width - 8px;
                    height: 2px;
                    background: #30c158;
                }
                if rows.length == 0: Text {
                    x: 8px;
                    width: parent.width - 16px;
                    text: tab == 0 ? "Empty. Drag tracks here, or right-click a track and choose Add to Automix."
                        : tab == 1 ? "Empty. Drag tracks here."
                        : total == "" ? "Select a track in the browser to see the tracks linked to it and those played next to it."
                        : "Nothing linked yet. Drag tracks here to link them to this one; tracks played next to it in your history show up here too.";
                    color: Theme.text-dim;
                    font-size: 12px;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }
                drop := DropArea {
                    can-drop(e) => {
                        drag-y = e.position.y;
                        TrackDrag.accepts(e.data) ? DragAction.copy : DragAction.none
                    }
                    dropped(e) => {
                        TrackDrag.drop-side(max(0, min(rows.length, round((e.position.y - lv.content-y) / row-height))), e.data);
                        TrackDrag.active = false;
                        DragAction.copy
                    }
                }
            }
        }
    }
    row-menu := PopupWindow {
        x: tab == 0 ? max(4px, root.width - self.width - 8px) : 20px;
        y: min(menu-y, root.height - (tab == 0 ? 200px : 70px));
        width: tab == 0 ? 300px : 180px;
        close-policy: close-on-click-outside;
        MenuBackground {}
        VerticalLayout {
            padding: 6px;
            spacing: 2px;
            // The mix into this track, over the panel's LENGTH and STYLE.
            if tab == 0 && selected >= 0 && selected < rows.length && rows[selected].heading == "" && !rows[selected].suggested: VerticalLayout {
                spacing: 4px;
                padding-bottom: 4px;
                Text { x: 6px; height: 20px; text: "MIX INTO IT"; color: Theme.text-dim; font-size: 10px; font-weight: 600; letter-spacing: 0.5px; vertical-alignment: center; }
                MixChips {
                    names: ["Panel", "0 s", "12 s", "15 s", "30 s", "16 b", "32 b", "Phr"];
                    current: rows[selected].mix-length;
                    picked(v) => { UpNextUi.set-mix(selected, v, rows[selected].mix-style); row-menu.close(); }
                }
                MixChips {
                    names: ["Panel", "Smooth", "Bass", "Filter", "Cut"];
                    current: rows[selected].mix-style;
                    picked(v) => { UpNextUi.set-mix(selected, rows[selected].mix-length, v); row-menu.close(); }
                }
                MenuSeparator {}
            }
            MenuLine {
                text: "Load on a free deck";
                clicked => {
                    activate(selected);
                    row-menu.close();
                }
            }
            MenuLine {
                text: tab == 2 ? "Unlink" : "Remove";
                text-color: Theme.c-ff6961;
                clicked => {
                    remove-picked();
                    row-menu.close();
                }
            }
        }
    }
}

export component Browser inherits HorizontalLayout {
    in property <[Folder]> folders;
    in property <int> current-folder;
    in property <[TrackRow]> rows;
    in property <int> sort-column;
    in property <bool> ascending;
    in-out property <int> current-row <=> list.current;
    out property <length> list-scroll-y: list.scroll-y;
    public function show-list-at(row: int, offset: length, y: length) {
        list.show-at(row, offset, y);
    }
    // The rows picked in the track list, for keyboard shortcuts.
    out property <int> first-picked: list.first-picked;
    out property <int> last-picked: list.last-picked;
    // ⌘A in the track list, when it has the focus rather than the folders.
    public function select-all() {
        if !folders-focused && list.visible {
            list.select-all();
        }
    }
    in property <[SideRow]> side-rows;
    in property <string> side-total;
    in-out property <int> side-tab;
    in property <string> folder-name;
    in property <string> folder-duration;
    in-out property <bool> folders-focused;
    in property <bool> spotify-connected;
    in property <string> spotify-user;
    in property <string> spotify-status;
    in-out property <string> spotify-client-id;
    // Shown instead of a Spotify playlist's rows while it loads or fails.
    in property <string> list-notice;
    // A track in the list was picked, so the keys go back to the window's
    // shortcuts (⌘A among them) from the side list or the search field.
    public function focus-search() {
        list.focus-search();
    }
    callback list-clicked();
    callback select-source(source: int);
    callback spotify-connect(client-id: string);
    callback spotify-disconnect();
    callback spotify-copy();
    // Fetch the streaming service's playlists again.
    callback spotify-refresh();
    callback select-folder(index: int);
    callback toggle-folder(index: int);
    callback sort(column: int);
    callback search(text: string);
    callback activate(row: int);
    callback side-activate(row: int);
    callback side-remove(first: int, last: int);
    in property <bool> automix-on;
    in property <string> automix-status;
    // After an Order pick: what the list was put in order by, with Undo.
    in-out property <string> automix-order-note;
    in property <int> automix-length;
    in property <int> automix-style;
    // Played tracks go back to the end of the list instead of leaving it.
    in property <bool> automix-repeat;
    callback automix-set-repeat(bool);
    callback automix-toggle();
    callback automix-mix-now();
    callback automix-skip();
    callback automix-order(int);
    callback automix-order-undo();
    callback automix-set-length(index: int);
    callback automix-set-style(index: int);
    property <int> source <=> StoreUi.source;
    property <int> library-tab;
    // The app went back from the history to the library (the track menu's
    // "Go to" lines).
    property <bool> history-tab: LibraryEdit.history-tab;
    changed history-tab => { library-tab = history-tab ? 1 : 0; }
    property <[string]> source-names: ["Collection", "Files", "Spotify", "TIDAL", "Apple Music", "Bandcamp", "Beatport", "OneLibrary", "SoundCloud", "Albums", "Recordings", "Mixcloud", "Jam"];
    // Which sources the rail shows, by index; picked under its "...".
    in-out property <[bool]> sources-shown: [true, true, true, true, true, true, true, true, true, true, true, true, true, true];
    callback source-shown-changed(source: int, on: bool);
    in property <bool> side-visible: true;
    // Player mode's Now Playing, in place of the sources, the lists and
    // the track list; Up Next stays beside it.
    in property <bool> now-playing;
    // Square panels split by thin black lines.
    spacing: 1px;
    // Sources with a list of their own: the collection, Files, the stores,
    // and Spotify once signed in.
    property <bool> listing: source == 0 || source == 1 || source == 9 || source == 10 || (StoreUi.stores && source == 5) || (StoreUi.streaming && StoreUi.stream(source) && spotify-connected);
    if !now-playing: SourceRail {
        source <=> source;
        shown <=> sources-shown;
        picked(s) => {
            // History lives under the collection: other sources open on
            // their lists.
            if s != 0 && library-tab == 1 {
                library-tab = 0;
                LibraryEdit.history-tab = false;
                LibraryEdit.show-history(false);
            }
            select-source(s);
        }
        health-picked => {
            library-tab = 0;
            LibraryEdit.history-tab = false;
            HealthUi.show(true);
        }
        shown-changed(s, on) => {
            // Hiding Collection Health while it shows goes back to the collection.
            if !on && s == -1 && HealthUi.view {
                HealthUi.show(false);
            }
            // Hiding the source on show goes back to the collection.
            if !on && s == source {
                source = 0;
                select-source(0);
            }
            source-shown-changed(s, on);
        }
    }
    // An add-on's source: its searches and results instead.
    property <bool> plugin-source: source >= source-names.length;
    property <int> plugin-index: source - source-names.length;
    if plugin-source && !now-playing: SearchesPanel {
        source-name: plugin-index < SourceUi.sources.length ? SourceUi.sources[plugin-index].name : "";
    }
    // The Jam source: its page over the tree and the list.
    property <bool> instruments-source: source == 12;
    if !plugin-source && !instruments-source && !now-playing: FolderTree {
        folders: folders;
        current: current-folder;
        focused: folders-focused;
        source: source;
        tab <=> library-tab;
        spotify-connected: spotify-connected;
        spotify-user: spotify-user;
        spotify-status: spotify-status;
        spotify-client-id <=> spotify-client-id;
        select(i) => {
            folders-focused = true;
            select-folder(i);
        }
        toggle(i) => { toggle-folder(i); }
        spotify-connect(id) => { spotify-connect(id); }
        spotify-disconnect => { spotify-disconnect(); }
        spotify-refresh => { spotify-refresh(); }
    }
    // The Collection Health page, or the bar over one check's tracks.
    property <bool> cleanup-page: source == 0 && (CleanupUi.open || CleanupUi.genres-open);
    // Player's artist and album pages, over the list.
    property <bool> page-open: KeepGoingUi.player && PageUi.kind != 0 && !now-playing && source == 0;
    property <bool> health-page: source == 0 && HealthUi.overview && !cleanup-page;
    property <bool> health-bar: source == 0 && HealthUi.check >= 0 && HealthUi.check < HealthUi.cards.length;
    Rectangle {
        horizontal-stretch: 1;
        if health-bar: HealthBar {
            y: 0;
            card: HealthUi.cards[HealthUi.check];
            listed: rows.length;
        }
        list := TrackList {
            focused: !folders-focused;
            visible: !plugin-source && !instruments-source && !health-page && !cleanup-page && !(health-bar && HealthUi.reviewing) && !now-playing && !page-open;
            y: health-bar ? (HealthUi.chips.length > 0 ? 81px : 45px) : 0;
            width: 100%;
            height: parent.height - self.y;
            rows: listing ? rows : [];
            results: StoreUi.stores && source == 5;
            sort-column: sort-column;
            ascending: ascending;
            folder-name: listing ? folder-name : source-names[source];
            duration: listing ? folder-duration : "";
            empty-title: source == 0 ? "" : listing ? (list-notice != "" ? " " : "") : source-names[source];
            empty-text: source >= 2 && source != 9 && source != 10 && source < 12 && !(StoreUi.streaming && StoreUi.stream(source)) && !(StoreUi.stores && source == 5) ? "Coming soon."
                : StoreUi.stream(source) && !spotify-connected ? "Sign in on the left to see your playlists here."
                : listing ? list-notice
                : source-names[source] + " isn't connected yet.";
            sort(c) => { sort(c); }
            search(t) => { search(t); }
            activate(r) => { activate(r); }
            took-focus => {
                folders-focused = false;
                list-clicked();
            }
        }
        if health-page: HealthPanel {
            width: 100%;
            height: 100%;
        }
        if health-bar && HealthUi.reviewing: ReviewCard {
            y: list.y;
            width: 100%;
            height: parent.height - self.y;
        }
        if source == 0 && CleanupUi.open: CleanupPanel {
            width: 100%;
            height: 100%;
        }
        if source == 0 && CleanupUi.genres-open && !CleanupUi.open: GenrePanel {
            width: 100%;
            height: 100%;
        }
        if FixNamesUi.open: FixNamesDialog {
            width: 100%;
            height: 100%;
        }
        if BuyUi.open: BuyDialog {
            width: 100%;
            height: 100%;
        }
        if plugin-source && SourceUi.setup.length > 0: SourceSetup {
            width: 100%;
            height: 100%;
            source-name: plugin-index < SourceUi.sources.length ? SourceUi.sources[plugin-index].name : "";
        }
        if plugin-source && SourceUi.setup.length == 0: SourceResults {
            width: 100%;
            height: 100%;
            hint: plugin-index < SourceUi.sources.length ? SourceUi.sources[plugin-index].hint : "";
        }
        if instruments-source: InstrumentsPanel {
            width: 100%;
            height: 100%;
            decks: LibraryEdit.decks;
        }
        if now-playing: NowPlayingView {
            width: 100%;
            height: 100%;
        }
        if page-open: PageView {
            width: 100%;
            height: 100%;
        }
    }
    // Shown and hidden from the footer's right-hand button.
    if side-visible: SidePanel {
        rows: side-rows;
        total: side-total;
        tab <=> side-tab;
        activate(r) => { side-activate(r); }
        remove(first, last) => { side-remove(first, last); }
        automix-on: automix-on;
        automix-status: automix-status;
        automix-length: automix-length;
        automix-style: automix-style;
        automix-toggle => { automix-toggle(); }
        automix-mix-now => { automix-mix-now(); }
        automix-skip => { automix-skip(); }
        automix-order(i) => { automix-order(i); }
        automix-order-undo => { automix-order-undo(); }
        automix-order-note <=> automix-order-note;
        automix-set-length(i) => { automix-set-length(i); }
        automix-set-style(i) => { automix-set-style(i); }
        automix-repeat: automix-repeat;
        automix-set-repeat(on) => { automix-set-repeat(on); }
    }
}
