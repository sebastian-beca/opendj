// Macro lanes: an instrument deck's knobs drawn as lines on its scrolling
// waveform instead of its note roll (2-Deck Basic only), a colour each.
export global MacroLanes {
    // `shown[d]`: deck d shows them. Set by the app; `toggle` flips one.
    in property <[bool]> shown: [false, false, false, false];
    // Which of the page's eight knobs moved in view and so draw a line.
    // Set by the app.
    in property <[bool]> moved: [false, false, false, false, false, false, false, false];
    // Each knob's line colour, as the waveform draws it (LEVEL_COLORS).
    out property <[color]> colors: [#FF6B6B, #FFB347, #FFE066, #7BE495, #4FD1C5, #63B3ED, #B69CFF, #F78FB3];
    callback toggle(deck: int);
}

// One knob's colour, name and value, beside the play line; dimmed while
// it draws no line.
component MacroLabel inherits HorizontalLayout {
    in property <string> name;
    in property <float> value;
    in property <color> tint;
    in property <bool> moved;
    spacing: 5px;
    if name != "": Rectangle {
        width: 7px;
        height: 7px;
        y: (parent.height - self.height) / 2;
        border-radius: 1px;
        background: moved ? tint : tint.with-alpha(0.35);
    }
    if name != "": Text {
        text: name + "  " + round(value * 100) + "%";
        color: moved ? Theme.text : Theme.text-dim;
        font-size: clamp(root.height - 1px, 7px, 10px);
        vertical-alignment: center;
        overflow: elide;
    }
}

// A button in the Edit Grid popover: presses `key` once, or runs
// `clicked` where there's no key.
component EditGridButton inherits Rectangle {
    in property <string> group;
    in property <string> key;
    in property <string> text;
    in property <color> ink: Theme.text;
    callback clicked();
    height: 30px;
    border-radius: 6px;
    background: ta.pressed ? Theme.control-pressed : ta.has-hover ? Theme.panel-raised.brighter(0.35) : Theme.panel-raised.brighter(0.18);
    Text { text: root.text; color: ink; font-size: 13px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            if key != "" {
                Controls.set-value(Controls.resolve(group, key), 1);
                Controls.set-value(Controls.resolve(group, key), 0);
            }
            root.clicked();
        }
    }
}

// Scrolling waveform, rendered on the GPU into `source`. Hold it to stop
// the track under the pointer, like a hand on a record, and drag left or
// right to move through it, hearing what passes, to set cues and grids by
// ear. Letting go carries on as before, playing or paused.
//
// The dimmed pencil in its bottom right corner edits the beat grid: it
// turns on the deck's grid edit mode (`beats_edit`) and opens the Edit Grid
// popover. While editing, the grid is drawn louder and dragging moves an
// unlocked grid with the audio (Alt-drag still scrubs). The pencil again,
// Done or Esc finishes. Prep's waveform always edits.
component Waveform inherits Rectangle {
    in property <image> source;
    in property <string> group;
    // The deck it shows (0 up), where it can switch to macro lanes; -1 where
    // it can't (4-Deck, Prep).
    in property <int> deck: -1;
    // The deck whose lyrics run along the bottom (0 up), in every layout.
    in property <int> lyrics-deck: deck;
    // The deck's grid, for the Edit Grid popover and its More… menu.
    in property <DeckInfo> info;
    // Prep's waveform: always in grid edit mode.
    in property <bool> drag-grid;
    // The track seconds the waveform shows across its width: the shared
    // zoom's, more when the deck plays faster (as the app draws it).
    property <float> visible-seconds: WaveZoom.seconds * (1 + Controls.value(rate-index, Controls.tick) * Controls.value(range-index, Controls.tick));
    // The top large waveform of the layout: the zoom's step shows on it
    // after a change from the keys, menus or a controller.
    in property <bool> first;
    // When the last mouse wheel notch came, so a notch's second event
    // isn't taken as another step.
    property <duration> wheel-notched: -1s;
    // The zoom's step shows a moment after it changes.
    property <int> zoom-changes: WaveZoom.changes;
    property <bool> zoom-flash;
    changed zoom-changes => {
        zoom-flash = true;
        zoom-hide.running = false;
        zoom-hide.running = true;
    }
    zoom-hide := Timer {
        interval: 900ms;
        running: false;
        triggered => {
            zoom-flash = false;
            self.running = false;
        }
    }
    property <int> rate-index: Controls.resolve(group, "rate");
    property <int> range-index: Controls.resolve(group, "rateRange");
    property <int> position-index: Controls.resolve(group, "playposition");
    property <int> duration-index: Controls.resolve(group, "duration");
    property <int> scrub-index: Controls.resolve(group, "scrub_position");
    property <int> scrub-enable-index: Controls.resolve(group, "scrub_enable");
    property <int> grid-by-index: Controls.resolve(group, "beats_translate_by");
    property <int> edit-index: Controls.resolve(group, "beats_edit");
    property <bool> locked: Controls.value(Controls.resolve(group, "bpmlock"), Controls.tick) > 0;
    property <bool> editing: drag-grid || Controls.value(edit-index, Controls.tick) > 0;
    property <bool> grid-open: editing && !locked;
    property <bool> loaded: Controls.value(duration-index, Controls.tick) > 0;
    property <float> press-position;
    property <bool> holding;
    // While the grid is dragged: whether it is, and how far it has moved.
    property <bool> moving-grid;
    property <float> grid-moved;
    // An instrument deck: its knobs can show as macro lanes. (A Groove Box
    // deck keeps its step lanes.)
    property <bool> groove: deck >= 0 && Controls.value(Controls.resolve("[Groove" + (deck + 1) + "]", "enabled"), Controls.tick) > 0;
    property <bool> live-knobs: deck >= 0 && !groove && Controls.value(duration-index, Controls.tick) <= 0
        && InstrumentsUi.live(deck) == 3;
    property <bool> macros: live-knobs && MacroLanes.shown[deck];
    property <int> page: InstrumentsUi.knob-page;
    background: Theme.well;
    clip: true;
    Image { width: parent.width; height: parent.height; source: source; image-fit: fill; }
    // Where the right-click menu opens.
    property <length> menu-x;
    property <length> menu-y;
    wave-touch := TouchArea {
        mouse-cursor: Controls.value(duration-index, Controls.tick) > 0 ? ew-resize : default;
        // Up zooms in, down out, on every large waveform at once: smoothly,
        // settling on the nearest step once the wheel or trackpad stops. A
        // trackpad moves a step per 40 px of swipe; a mouse wheel's notch
        // (a big jump of scroll, which can come as two events) one step.
        scroll-event(e) => {
            if e.delta-y == 0 {
                return reject;
            }
            if abs(e.delta-y) >= 40px {
                if animation-tick() - wheel-notched < 70ms {
                    return accept;
                }
                wheel-notched = animation-tick();
            }
            WaveZoom.nudge(clamp(e.delta-y / 40px, -1, 1));
            accept
        }
        pointer-event(e) => {
            if e.button == PointerEventButton.right && e.kind == PointerEventKind.down {
                menu-x = self.mouse-x;
                menu-y = self.mouse-y;
                wave-menu.show();
                return;
            }
            if e.button != PointerEventButton.left && e.kind != PointerEventKind.cancel {
                return;
            }
            if e.kind == PointerEventKind.down {
                holding = Controls.value(duration-index, Controls.tick) > 0;
                if holding {
                    moving-grid = grid-open && !e.modifiers.alt;
                    grid-moved = 0;
                    press-position = Controls.value(position-index, Controls.tick);
                    Controls.set-value(scrub-index, press-position);
                    Controls.set-value(scrub-enable-index, 1);
                }
            } else if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                if holding {
                    Controls.set-value(scrub-enable-index, 0);
                }
                holding = false;
            }
        }
        moved => {
            if self.pressed && holding {
                // Dragging right pulls earlier audio under the playhead.
                Controls.set-value(scrub-index, clamp(press-position - (self.mouse-x - self.pressed-x) / self.width * visible-seconds / Controls.value(duration-index, Controls.tick), 0, 1));
                // The grid moves back as far as the audio does, so it stays
                // where it is on screen while the audio slides under it.
                if moving-grid {
                    let moved = -(self.mouse-x - self.pressed-x) / self.width * visible-seconds;
                    Controls.set-value(grid-by-index, Controls.value(grid-by-index, Controls.tick) + moved - grid-moved);
                    grid-moved = moved;
                }
            }
        }
    }
    // Each lane's knob and value, top first, just past the play line: the
    // instrument's knobs on the page its deck shows, or the Groove Box's
    // tracks' levels.
    if macros: Rectangle {
        x: parent.width / 2 + 6px;
        width: parent.width / 2 - 40px;
        for i in 8: MacroLabel {
            y: i * parent.height / 8;
            height: parent.height / 8;
            width: parent.width;
            name: InstrumentsUi.param-names[page * 8 + i];
            value: Controls.value(Controls.resolve("[Instrument1]", "parameter" + (page * 8 + i + 1)), Controls.tick);
            tint: MacroLanes.colors[i];
            moved: MacroLanes.moved[i];
        }
    }
    // The track's timed lyrics along the bottom, under the play line.
    property <[WaveLine]> lyric-lines: lyrics-deck >= 0 && lyrics-deck < WaveLyrics.decks.length ? WaveLyrics.decks[lyrics-deck].lines : [];
    if WaveLyrics.shown && lyric-lines.length > 0 && !macros: LyricsLane {
        x: 0;
        y: parent.height - self.height;
        width: parent.width;
        lines: lyric-lines;
        now: WaveLyrics.now(lyrics-deck);
        visible-seconds: root.visible-seconds;
    }
    // The pointer over this waveform shows the zoom's bar (at the left
    // edge of the whole strip, beside every deck's waveform) and puts the
    // zoom's step on this one a moment after it changes; with the pointer
    // elsewhere, the step shows on the layout's top waveform, so it shows
    // once whatever the number of decks.
    property <bool> pointer-here: wave-touch.has-hover;
    changed pointer-here => {
        if pointer-here {
            WaveZoom.hovered = group;
        } else if WaveZoom.hovered == group {
            WaveZoom.hovered = "";
        }
    }
    ZoomReadout {
        x: 28px;
        y: 6px;
        shown: zoom-flash && (WaveZoom.hovered == group || (WaveZoom.hovered == "" && first));
    }
    // Right-click: show or hide the phrase flags on every scrolling
    // waveform, and zoom them all.
    wave-menu := PopupWindow {
        x: min(menu-x, root.width - 130px);
        y: min(menu-y, root.height - 158px);
        width: 130px;
        Rectangle {
            background: Theme.panel-raised;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 8px;
            drop-shadow-color: Theme.s-00000080;
        }
        VerticalLayout {
            padding: 4px;
            Rectangle {
                height: 24px;
                background: wpa.has-hover ? Theme.panel-raised.brighter(0.3) : transparent;
                border-radius: 4px;
                Text {
                    x: 10px;
                    text: PhraseView.waveform-visible ? "Hide phrases" : "Show phrases";
                    color: Theme.text;
                    font-size: 11px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                wpa := TouchArea {
                    clicked => {
                        PhraseView.waveform-visible = !PhraseView.waveform-visible;
                        PhraseView.waveform-changed(PhraseView.waveform-visible);
                    }
                }
            }
            for item[i] in [
                { text: "Zoom in", enabled: WaveZoom.level < WaveZoom.steps, by: 1 },
                { text: "Zoom out", enabled: WaveZoom.level > 1, by: -1 },
                { text: "Reset zoom", enabled: WaveZoom.level != WaveZoom.default-level, by: 0 },
            ]: Rectangle {
                height: 24px;
                background: zta.has-hover && item.enabled ? Theme.panel-raised.brighter(0.3) : transparent;
                border-radius: 4px;
                Text {
                    x: 10px;
                    text: item.text;
                    color: item.enabled ? Theme.text : Theme.text-dim;
                    font-size: 11px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                if i == 0: Text {
                    x: parent.width - self.width - 10px;
                    text: WaveZoom.percent(WaveZoom.level);
                    color: Theme.text-dim;
                    font-family: "Inter Tabular";
                    font-size: 11px;
                    vertical-alignment: center;
                }
                zta := TouchArea {
                    enabled: item.enabled;
                    clicked => {
                        if item.by == 0 {
                            WaveZoom.reset();
                        } else {
                            WaveZoom.step(item.by);
                        }
                    }
                }
            }
            // How tall the large waveforms are in this layout.
            Rectangle {
                height: 22px;
                Text {
                    x: 10px;
                    text: "Height";
                    color: Theme.text-dim;
                    font-size: 10px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
            // − step +, as the zoom steps are in Prep.
            HorizontalLayout {
                height: 26px;
                spacing: 4px;
                padding-left: 6px;
                padding-right: 6px;
                padding-bottom: 2px;
                for b in [{ text: "−", by: -1 }, { text: "", by: 0 }, { text: "+", by: 1 }]: Rectangle {
                    property <bool> enabled: b.by < 0 ? WaveHeight.level > 1 : b.by > 0 ? WaveHeight.level < WaveHeight.steps : false;
                    border-radius: 4px;
                    background: b.by == 0 ? transparent : hta.has-hover && enabled ? Theme.panel-raised.brighter(0.3) : Theme.panel-raised.brighter(0.12);
                    Text {
                        text: b.by == 0 ? WaveHeight.level : b.text;
                        color: b.by == 0 || enabled ? Theme.text : Theme.text-dim;
                        font-family: "Inter Tabular";
                        font-size: b.by == 0 ? 12px : 14px;
                        font-weight: b.by == 0 ? 700 : 500;
                    }
                    hta := TouchArea {
                        enabled: enabled;
                        clicked => { WaveHeight.step(b.by); }
                    }
                }
            }
        }
    }
    // The pencil: dimmed until hovered, lit while editing.
    if loaded: Rectangle {
        x: parent.width - self.width - 5px;
        y: parent.height - self.height - 5px;
        width: 24px;
        height: 22px;
        border-radius: 5px;
        background: pta.pressed ? Theme.control-pressed : pta.has-hover ? Theme.s-000000c0 : transparent;
        // A pencil, point down to the left.
        Path {
            width: 14px;
            height: 14px;
            viewbox-width: 16;
            viewbox-height: 16;
            stroke: grid-open ? Theme.accent : Theme.text;
            stroke-width: 1.4px;
            fill: transparent;
            opacity: grid-open || pta.has-hover ? 1 : 0.4;
            commands: "M 2 14 L 2.8 10.6 L 10.8 2.6 L 13.4 5.2 L 5.4 13.2 Z M 9.2 4.2 L 11.8 6.8";
        }
        pta := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                if drag-grid || !editing {
                    if !drag-grid {
                        Controls.set-value(edit-index, 1);
                    }
                    edit-popup.show();
                } else {
                    Controls.set-value(edit-index, 0);
                }
            }
        }
    }
    // Edit Grid: bar 1 at the play line, nudges, the rest of the grid tools
    // (More…), back to the detected grid, lock, and Done.
    edit-popup := PopupWindow {
        x: root.width - self.width - 5px;
        y: root.height - 2px;
        width: 232px;
        close-policy: close-on-click-outside;
        Rectangle {
            background: Theme.panel-raised;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 14px;
            drop-shadow-color: Theme.s-000000a0;
        }
        VerticalLayout {
            padding: 12px;
            spacing: 8px;
            HorizontalLayout {
                height: 22px;
                Text { text: "Edit Grid"; color: Theme.text; font-size: 15px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                Text {
                    text: info.grid-unsure && info.grid-source == "Detected" ? "check by ear" : info.grid-source;
                    color: info.grid-unsure && info.grid-source == "Detected" ? Theme.stage-prep : Theme.text-dim;
                    font-size: 11px;
                    vertical-alignment: center;
                }
            }
            if locked: Text {
                text: "The grid is locked.";
                color: Theme.text-dim;
                font-size: 13px;
            }
            if locked: EditGridButton {
                text: "Unlock";
                clicked => { Controls.set-value(Controls.resolve(group, "bpmlock"), 0); }
            }
            if !locked: EditGridButton { group: group; key: "beats_downbeat_here"; text: "Set Downbeat"; }
            if !locked: HorizontalLayout {
                spacing: 6px;
                EditGridButton { group: group; key: "beats_translate_earlier"; text: "◀ |"; }
                EditGridButton { group: group; key: "beats_translate_later"; text: "| ▶"; }
            }
            if !locked: EditGridButton {
                text: "More…";
                ink: Theme.text-dim;
                clicked => {
                    edit-popup.close();
                    grid-menu.show();
                }
            }
            HorizontalLayout {
                spacing: 6px;
                if !locked && info.grid-source != "Detected": EditGridButton { group: group; key: "beats_reset"; text: "Reset"; ink: #ff6b6b; }
                if !locked: EditGridButton {
                    text: "Lock";
                    clicked => { Controls.set-value(Controls.resolve(group, "bpmlock"), 1); }
                }
                EditGridButton {
                    text: "Done";
                    ink: Theme.accent;
                    clicked => {
                        if !drag-grid {
                            Controls.set-value(edit-index, 0);
                        }
                        edit-popup.close();
                    }
                }
            }
        }
    }
    grid-menu := GridMenu {
        group: group;
        info: info;
        x: root.width - 245px;
        y: root.height - 2px;
    }
    // The switch between the note roll and the macro lanes.
    if live-knobs: Rectangle {
        x: parent.width - self.width - 6px;
        y: 4px;
        width: 24px;
        height: 18px;
        border-radius: 4px;
        background: kta.pressed ? Theme.control-pressed : kta.has-hover ? Theme.n-2a2b2e : Theme.s-000000a0;
        border-width: 1px;
        border-color: macros ? Theme.accent : transparent;
        // Three sliders: knobs as lines.
        Path {
            width: 14px;
            height: 12px;
            viewbox-width: 14;
            viewbox-height: 12;
            stroke: macros ? Theme.accent : kta.has-hover ? Theme.text : Theme.text-dim;
            stroke-width: 1.3px;
            fill: transparent;
            commands: "M 0 2 L 14 2 M 0 6 L 14 6 M 0 10 L 14 10 M 4 0.5 L 4 3.5 M 10 4.5 L 10 7.5 M 6 8.5 L 6 11.5";
        }
        kta := TouchArea {
            mouse-cursor: pointer;
            clicked => { MacroLanes.toggle(deck); }
        }
    }
}

// An icon button in the footer, lit while its panel is open or expanded.
// The icons are drawn (SVG path commands in a 20 x 20 box).
component FooterButton inherits Rectangle {
    in property <string> icon;
    // Drawn instead of `icon` while lit. (A Path doesn't redraw when its
    // commands change, so each icon is its own.)
    in property <string> lit-icon: icon;
    in property <bool> lit;
    // Named in a tooltip beside it after a moment's hover.
    in property <string> tip;
    in property <string> tip-body;
    property <bool> tip-mine;
    callback clicked();
    property <color> ink: lit ? Theme.accent : ta.has-hover ? Theme.text : Theme.text-dim;
    width: 34px;
    height: 26px;
    border-radius: 5px;
    background: ta.pressed ? Theme.control-pressed : ta.has-hover ? Theme.n-2a2a2e : transparent;
    if !lit: Path { width: 18px; height: 18px; viewbox-width: 20; viewbox-height: 20; stroke: ink; stroke-width: 1.5px; fill: transparent; commands: icon; }
    if lit: Path { width: 18px; height: 18px; viewbox-width: 20; viewbox-height: 20; stroke: ink; stroke-width: 1.5px; fill: transparent; commands: lit-icon; }
    ta := TouchArea {
        clicked => { root.clicked(); }
        changed has-hover => {
            if !self.has-hover && tip-mine {
                tip-mine = false;
                HoverTip.shown = false;
            }
        }
    }
    Timer {
        interval: 600ms;
        running: tip != "" && ta.has-hover && !tip-mine;
        triggered => {
            tip-mine = true;
            HoverTip.title = tip;
            HoverTip.body = tip-body;
            HoverTip.right-aligned = false;
            HoverTip.x = root.absolute-position.x + root.width + 6px;
            HoverTip.y = root.absolute-position.y - 8px;
            HoverTip.shown = true;
        }
    }
}

// MIC: puts the microphone on (`[Microphone],talkover`), lit amber while it
// is, with its level beside it once an input is chosen in the settings.
// The arrow at its right end opens the MIC panel: the microphone's and
// auxiliary input's levels, EQ and effects.
component MicButton inherits Rectangle {
    property <int> on-index: Controls.resolve("[Microphone]", "talkover");
    property <bool> on: Controls.value(on-index, Controls.tick) > 0;
    property <bool> configured: Controls.value(Controls.resolve("[Microphone]", "input_configured"), Controls.tick) > 0;
    property <color> tint: Theme.mic;
    background: on ? tint.with-alpha(0.16) : Theme.panel-raised;
    border-radius: 10px;
    border-width: 1px;
    border-color: on ? tint : transparent;
    height: 36px;
    y: 8px;
    horizontal-stretch: 0;
    clip: true;
    HorizontalLayout {
        Rectangle {
            background: ta.pressed ? Theme.control-pressed : ta.has-hover ? Theme.n-ffffff10 : transparent;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 10px;
                spacing: 7px;
                // A microphone on a stand.
                Path {
                    width: 12px;
                    height: 16px;
                    y: (parent.height - self.height) / 2;
                    viewbox-width: 12;
                    viewbox-height: 16;
                    stroke: on ? tint : Theme.text-dim;
                    stroke-width: 1.5px;
                    fill: transparent;
                    commands: "M 3.5 3 A 2.5 2.5 0 0 1 8.5 3 L 8.5 7.5 A 2.5 2.5 0 0 1 3.5 7.5 Z M 1 7 A 5 5 0 0 0 11 7 M 6 12 L 6 15 M 3 15 L 9 15";
                }
                Text { text: "MIC"; color: on ? tint : Theme.text-dim; font-size: 11px; font-weight: 700; letter-spacing: 0.5px; vertical-alignment: center; }
                if configured: VerticalLayout {
                    alignment: center;
                    VuMeter { group: "[Microphone]"; key: "VuMeter"; width: 4px; height: 16px; segments: 8; }
                }
            }
            ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { Controls.toggle(on-index); }
            }
        }
        Rectangle { width: 1px; background: on ? tint.with-alpha(0.5) : Theme.n-ffffff18; }
        Rectangle {
            width: 26px;
            background: arrow.pressed ? Theme.control-pressed : arrow.has-hover ? Theme.n-ffffff10 : transparent;
            Path {
                width: 8px;
                height: 5px;
                commands: "M 0 0 L 4 4 L 8 0";
                stroke: arrow.has-hover ? Theme.text : on ? tint : Theme.text-dim;
                stroke-width: 1.4px;
                fill: transparent;
            }
            arrow := TouchArea {
                mouse-cursor: pointer;
                clicked => { panel.show(); }
            }
        }
    }
    panel := MicPanel {
        x: 0px;
        y: root.height + 6px;
    }
}

component MapBarButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    callback clicked();
    height: 26px;
    y: 7px;
    width: tl.preferred-width;
    border-radius: 6px;
    background: primary ? (ta.has-hover ? Theme.lilac.brighter(0.1) : Theme.lilac) : ta.has-hover ? Theme.n-ffffff20 : Theme.n-ffffff12;
    tl := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        Text { text: root.text; color: primary ? #1a1426 : Theme.text; font-size: 12px; font-weight: 600; vertical-alignment: center; }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Map mode's bar under the top bar: what to do next, what the last control
// learned, and Undo, Keep both and Done. The mapping wizard asks which
// controller and how many decks here, then walks through the usual
// controls, with Skip.
component MapBar inherits Rectangle {
    height: 40px;
    width: bl.preferred-width;
    border-radius: 10px;
    background: #2a2236;
    border-width: 1px;
    border-color: Theme.lilac;
    drop-shadow-blur: 16px;
    drop-shadow-color: Theme.s-000000a0;
    bl := HorizontalLayout {
        padding-left: 16px;
        padding-right: 8px;
        spacing: 12px;
        Text { text: MapMode.walking || MapMode.asking-decks || MapMode.asking-device ? "MAPPING WIZARD" : "MIDI MAP"; color: Theme.lilac-text; font-size: 11px; font-weight: 700; letter-spacing: 0.8px; vertical-alignment: center; }
        if MapMode.walking: Text { text: MapMode.step; color: Theme.text-dim; font-size: 12px; vertical-alignment: center; }
        // While walking, what to do now; otherwise what was learned last.
        Text { text: MapMode.last != "" && !MapMode.walking ? MapMode.last : MapMode.status; color: Theme.text; font-size: 12px; vertical-alignment: center; }
        if MapMode.walking && MapMode.last != "": Text { text: MapMode.last; color: Theme.text-dim; font-size: 12px; vertical-alignment: center; }
        if MapMode.replaced != "" && !MapMode.walking: Text { text: "(was " + MapMode.replaced + ")"; color: Theme.text-dim; font-size: 12px; vertical-alignment: center; }
        if MapMode.replaced != "" && !MapMode.walking: MapBarButton { text: "Keep both"; clicked => { MapMode.keep-both(); } }
        if MapMode.asking-device: HorizontalLayout {
            spacing: 6px;
            for d[i] in MapMode.devices: MapBarButton { text: d; primary: true; clicked => { MapMode.choose-device(i); } }
        }
        if MapMode.asking-decks: MapBarButton { text: "2 decks"; primary: true; clicked => { MapMode.choose-decks(2); } }
        if MapMode.asking-decks: MapBarButton { text: "4 decks"; primary: true; clicked => { MapMode.choose-decks(4); } }
        if MapMode.walking: MapBarButton { text: "Skip"; clicked => { MapMode.skip(); } }
        if MapMode.can-undo: MapBarButton { text: "Undo"; clicked => { MapMode.undo(); } }
        if !MapMode.walking && !MapMode.asking-decks && !MapMode.asking-device: MapBarButton { text: "Mapping wizard"; clicked => { MapMode.quick-map(""); } }
        MapBarButton { text: "Done"; primary: !MapMode.asking-decks && !MapMode.asking-device; clicked => { MapMode.done(); } }
    }
}

// Records the mix: a red dot that pulses while recording, with the time.
// [Recording],toggle_recording starts and stops, as in Mixxx, so
// controller mappings can use it too.
component RecordButton inherits Rectangle {
    property <int> toggle-index: Controls.resolve("[Recording]", "toggle_recording");
    property <bool> on: Controls.value(Controls.resolve("[Recording]", "status"), Controls.tick) > 1;
    property <float> seconds: Controls.value(Controls.resolve("[Recording]", "duration"), Controls.tick);
    property <int> hours: floor(seconds / 3600);
    property <int> minutes: mod(floor(seconds / 60), 60);
    property <int> secs: mod(floor(seconds), 60);
    background: ta.pressed ? Theme.control-pressed : on ? #e5484d.with-alpha(0.16) : ta.has-hover ? Theme.n-2e2e32 : Theme.panel-raised;
    border-radius: 10px;
    border-width: 1px;
    border-color: on ? #e5484d : transparent;
    height: 36px;
    y: 8px;
    horizontal-stretch: 0;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 10px;
                height: 10px;
                border-radius: 5px;
                background: on ? #e5484d : Theme.text-dim;
                // A slow blink while recording.
                opacity: on && mod(animation-tick() / 1ms, 1400) > 900 ? 0.35 : 1.0;
            }
        }
        Text {
            text: on ? (hours > 0 ? hours + ":" : "") + (minutes < 10 && hours > 0 ? "0" : "") + minutes + ":" + (secs < 10 ? "0" : "") + secs : "REC";
            color: on ? Theme.text : Theme.text-dim;
            font-size: on ? 13px : 11px;
            font-weight: on ? 500 : 700;
            letter-spacing: on ? 0px : 0.5px;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { Controls.set-value(toggle-index, 1); }
    }
}

// ON AIR: opens the broadcast panel. While on air it turns red with the
// time, a light for how the stations are doing and the listeners.
component OnAirButton inherits Rectangle {
    property <bool> on: Controls.value(Controls.resolve("[Shoutcast]", "enabled"), Controls.tick) > 0;
    // 0 off, 1 connecting, 2 every station on air, 3 failed, 4 some.
    property <int> status: Controls.value(Controls.resolve("[Shoutcast]", "status"), Controls.tick);
    property <float> seconds: Controls.value(Controls.resolve("[Broadcast]", "on_air_seconds"), Controls.tick);
    property <color> light: status == 2 ? #e5484d : status == 3 ? Theme.n-7a7a80 : #f5a524;
    background: ta.pressed ? Theme.control-pressed : on ? #e5484d.with-alpha(0.16) : ta.has-hover ? Theme.n-2e2e32 : Theme.panel-raised;
    border-radius: 10px;
    border-width: 1px;
    border-color: on ? light : transparent;
    height: 36px;
    y: 8px;
    horizontal-stretch: 0;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 7px;
        // A mast sending out waves.
        Path {
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            viewbox-width: 24;
            viewbox-height: 24;
            fill: transparent;
            stroke: on ? light : Theme.text-dim;
            stroke-width: 2px;
            commands: "M 10.5 9 A 1.5 1.5 0 1 0 13.5 9 A 1.5 1.5 0 1 0 10.5 9 M 12 10.5 L 12 21 M 8.5 5.5 A 5 5 0 0 0 8.5 12.5 M 15.5 5.5 A 5 5 0 0 1 15.5 12.5 M 5.5 3 A 8.5 8.5 0 0 0 5.5 15 M 18.5 3 A 8.5 8.5 0 0 1 18.5 15";
            // Pulses while connecting.
            opacity: on && status != 2 && mod(animation-tick() / 1ms, 1000) > 600 ? 0.4 : 1.0;
        }
        Text {
            text: on ? AirTime.text(seconds) : "ON AIR";
            color: on ? Theme.text : Theme.text-dim;
            font-size: on ? 13px : 11px;
            font-weight: on ? 500 : 700;
            letter-spacing: on ? 0px : 0.5px;
            vertical-alignment: center;
        }
        if on && BroadcastState.listeners >= 0: Text {
            text: BroadcastState.listeners + (BroadcastState.listeners == 1 ? " listener" : " listeners");
            color: Theme.text-dim;
            font-size: 11px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { panel.show(); }
    }
    panel := OnAirPanel {
        x: root.width - self.width;
        y: root.height + 6px;
    }
}

// Opens the settings: the gear at the right of the top bar.
// A small picture of a layout, after djay's: 0 two decks side by side,
// 1 Player (a cover beside two lines), 2 four decks, 3 Automix (a play arrow
// between lines), 4 Prep (one deck with beat lines over it).
component LayoutIcon inherits Rectangle {
    in property <int> kind;
    in property <color> tint: Theme.text;
    width: 22px;
    height: 16px;
    if kind != 3: Rectangle {
        border-width: 1.5px;
        border-color: tint;
        border-radius: 2px;
    }
    if kind == 0: HorizontalLayout {
        padding: 3.5px;
        spacing: 2px;
        Rectangle { background: tint; border-radius: 1px; }
        Rectangle { background: tint; border-radius: 1px; }
    }
    if kind == 1: HorizontalLayout {
        padding: 3.5px;
        spacing: 2px;
        Rectangle { width: 6px; background: tint; border-radius: 1px; }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Rectangle { height: 1.5px; background: tint; }
            Rectangle { height: 1.5px; width: 60%; background: tint; }
        }
    }
    // 2-Deck Basic: two short decks over the pad bar.
    if kind == 5: VerticalLayout {
        padding: 3.5px;
        spacing: 2px;
        HorizontalLayout {
            spacing: 2px;
            vertical-stretch: 1;
            Rectangle { background: tint; border-radius: 1px; }
            Rectangle { background: tint; border-radius: 1px; }
        }
        Rectangle { height: 1.5px; background: tint; }
    }
    if kind == 2: HorizontalLayout {
        padding: 3.5px;
        spacing: 1.5px;
        for _ in 4: Rectangle { background: tint; border-radius: 0.5px; }
    }
    if kind == 4: Path {
        width: 22px;
        height: 16px;
        viewbox-width: 22;
        viewbox-height: 16;
        stroke: tint;
        stroke-width: 1.5px;
        commands: "M 7 4 L 7 12 M 11 4 L 11 12 M 15 4 L 15 12";
    }
    if kind == 3: Path {
        width: 22px;
        height: 16px;
        viewbox-width: 22;
        viewbox-height: 16;
        stroke: tint;
        stroke-width: 1.5px;
        commands: "M 2 2 L 20 2 M 2 14 L 20 14 M 2 8 L 7 8 M 15 8 L 20 8";
    }
    if kind == 3: Path {
        width: 22px;
        height: 16px;
        viewbox-width: 22;
        viewbox-height: 16;
        fill: tint;
        commands: "M 8.5 4.5 L 14 8 L 8.5 11.5 Z";
    }
}

// One layout in the layout menu; ones still to come are greyed out.
component LayoutItem inherits Rectangle {
    in property <int> kind;
    in property <string> text;
    in property <bool> current;
    in property <bool> enabled: true;
    callback picked();
    height: 32px;
    border-radius: 6px;
    background: enabled && ta.has-hover ? Theme.panel-raised.brighter(0.3) : transparent;
    property <color> tint: !enabled ? Theme.text-dim.with-alpha(0.5) : current ? Theme.accent : Theme.text;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        VerticalLayout { alignment: center; LayoutIcon { kind: kind; tint: tint; } }
        Text { text: root.text; color: tint; font-size: 13px; font-weight: 500; vertical-alignment: center; horizontal-stretch: 1; }
        if !enabled: Text { text: "Soon"; color: Theme.text-dim.with-alpha(0.5); font-size: 10px; vertical-alignment: center; }
        if current: Text { text: "✓"; color: Theme.lilac-text; font-size: 13px; vertical-alignment: center; }
    }
    ta := TouchArea {
        mouse-cursor: enabled ? pointer : default;
        clicked => {
            if enabled {
                root.picked();
            }
        }
    }
}

// Dark, Light or Auto (Match system): three segments at the foot of the
// layout menu, the one in use lit.
component AppearanceRow inherits Rectangle {
    property <[string]> names: ["Dark", "Light", "Auto"];
    height: 28px;
    border-radius: 7px;
    background: Theme.n-ffffff0d;
    HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        for name[i] in names: Rectangle {
            property <bool> on: LayoutsUi.appearance == i;
            border-radius: 5px;
            background: on ? Theme.accent.with-alpha(0.18) : ta.has-hover ? Theme.n-ffffff0d : transparent;
            border-width: on ? 1px : 0px;
            border-color: Theme.accent;
            Text { text: name; color: on ? Theme.lilac-text : ta.has-hover ? Theme.text : Theme.text-dim; font-size: 12px; font-weight: on ? 600 : 500; }
            ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { LayoutsUi.appearance-picked(i); }
            }
        }
    }
}

// The layout menu's pencil, and the lit one on its chooser.
component LayoutPencil inherits Rectangle {
    in property <bool> lit;
    callback clicked();
    width: 22px;
    height: 22px;
    border-radius: 5px;
    background: lit ? Theme.accent.with-alpha(0.18) : ta.has-hover ? Theme.panel-raised.brighter(0.3) : transparent;
    Path {
        width: 14px;
        height: 14px;
        viewbox-width: 16;
        viewbox-height: 16;
        fill: transparent;
        stroke: lit ? Theme.accent : ta.has-hover ? Theme.text : Theme.text-dim;
        stroke-width: 1.4px;
        stroke-line-join: round;
        commands: "M 10.5 2.5 L 13.5 5.5 L 5.5 13.5 L 2 14 L 2.5 10.5 Z M 9 4 L 12 7";
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// An on/off switch, as on the side panel tabs' chooser.
component LayoutSwitch inherits Rectangle {
    in property <bool> on;
    callback toggled();
    width: 34px;
    height: 20px;
    border-radius: 10px;
    background: on ? Theme.accent : Theme.n-48484a;
    Rectangle {
        x: on ? 16px : 2px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        // The knob stays white in Light too, as macOS draws it.
        background: #ffffff;
    }
    TouchArea { mouse-cursor: pointer; clicked => { toggled(); } }
}

// The layout menu's chooser: every layout with a switch for whether the
// menu offers it, and a grip to drag it up or down, as the side panel
// tabs' and the rail's choosers have. The layout in use, and the last one
// on, stay on.
component LayoutChooser inherits Rectangle {
    callback done();
    property <int> n: LayoutsUi.all.length;
    property <length> row-h: 40px;
    // The row being dragged, how far, and where it would land.
    property <int> drag-from: -1;
    property <length> drag-dy;
    property <length> drag-start;
    property <int> drag-to: drag-from < 0 ? -1 : max(0, min(n - 1, drag-from + round(drag-dy / row-h)));
    property <LayoutEntry> dragged;
    height: list.preferred-height;
    Rectangle {
        background: Theme.n-2a2a2d;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 16px;
        drop-shadow-color: Theme.s-00000080;
    }
    list := VerticalLayout {
        padding: 8px;
        spacing: 2px;
        HorizontalLayout {
            height: 28px;
            padding-left: 6px;
            Text { text: "LAYOUTS"; color: Theme.text-dim; font-size: 10px; font-weight: 700; letter-spacing: 0.5px; vertical-alignment: center; horizontal-stretch: 1; }
            VerticalLayout { alignment: center; LayoutPencil { lit: true; clicked => { root.done(); } } }
        }
        Rectangle {
            height: n * row-h;
            for e[pos] in LayoutsUi.all: Rectangle {
                // Rows between where the dragged one was and where it would
                // go step aside for it.
                property <length> shift: drag-from < 0 || pos == drag-from ? 0px
                    : drag-from < drag-to && pos > drag-from && pos <= drag-to ? -row-h
                    : drag-from > drag-to && pos < drag-from && pos >= drag-to ? row-h : 0px;
                // The dragged row stays put, unseen, so its grip keeps the mouse.
                opacity: pos == drag-from ? 0 : 1;
                x: 0;
                y: pos * row-h + shift;
                width: parent.width;
                height: row-h;
                animate y { duration: 100ms; }
                HorizontalLayout {
                    padding-left: 4px;
                    padding-right: 6px;
                    spacing: 8px;
                    Rectangle {
                        width: 14px;
                        DragGrip { dot-color: grip.has-hover ? Theme.text : Theme.text-dim; }
                        grip := TouchArea {
                            mouse-cursor: drag-from >= 0 ? MouseCursor.grabbing : MouseCursor.grab;
                            pointer-event(ev) => {
                                if ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down {
                                    drag-from = pos;
                                    dragged = e;
                                    drag-start = self.absolute-position.y + self.mouse-y;
                                    drag-dy = 0px;
                                }
                                if ev.button == PointerEventButton.left && ev.kind == PointerEventKind.up && drag-from >= 0 {
                                    if drag-to != drag-from {
                                        LayoutsUi.moved(e.layout, drag-to - drag-from);
                                    }
                                    drag-from = -1;
                                    drag-dy = 0px;
                                }
                            }
                            moved => {
                                if drag-from >= 0 {
                                    drag-dy = self.absolute-position.y + self.mouse-y - drag-start;
                                }
                            }
                        }
                    }
                    VerticalLayout { alignment: center; LayoutIcon { kind: e.layout == 3 ? 4 : e.layout == 4 ? 5 : e.layout; tint: e.on ? Theme.text : Theme.text-dim; } }
                    Text { text: e.name; color: e.on ? Theme.text : Theme.text-dim; font-size: 15px; vertical-alignment: center; horizontal-stretch: 1; }
                    VerticalLayout {
                        alignment: center;
                        LayoutSwitch {
                            on: e.on;
                            opacity: e.locked ? 0.45 : 1;
                            toggled => {
                                if !e.locked {
                                    LayoutsUi.toggled(e.layout);
                                }
                            }
                        }
                    }
                }
            }
            // The row being dragged, over the others.
            if drag-from >= 0: Rectangle {
                y: max(0px, min(parent.height - row-h, drag-from * row-h + drag-dy));
                width: parent.width;
                height: row-h;
                border-radius: 8px;
                background: Theme.n-36363b;
                drop-shadow-blur: 10px;
                drop-shadow-color: Theme.s-00000080;
                HorizontalLayout {
                    padding-left: 4px;
                    padding-right: 6px;
                    spacing: 8px;
                    Rectangle { width: 14px; DragGrip { dot-color: Theme.text; } }
                    VerticalLayout { alignment: center; LayoutIcon { kind: dragged.layout == 3 ? 4 : dragged.layout == 4 ? 5 : dragged.layout; } }
                    Text { text: dragged.name; color: Theme.text; font-size: 15px; vertical-alignment: center; horizontal-stretch: 1; }
                    VerticalLayout { alignment: center; LayoutSwitch { on: dragged.on; } }
                }
            }
        }
        Rectangle { height: 9px; Rectangle { height: 1px; background: Theme.border; } }
        Rectangle {
            height: 32px;
            border-radius: 8px;
            background: rta.has-hover ? Theme.n-ffffff0d : transparent;
            Text { x: 6px; text: "Reset to default"; color: rta.has-hover ? Theme.text : Theme.text-dim; font-size: 13px; vertical-alignment: center; }
            rta := TouchArea { mouse-cursor: pointer; clicked => { LayoutsUi.reset(); } }
        }
    }
}

// The layout button: the current layout's icon and name, opening a menu of
// the DJ's layouts (LayoutsUi.menu), and its pencil the chooser that picks
// them. 0 is 2-Deck, 1 Player, 2 4-Deck,
// 3 Prep and 4 2-Deck Basic (the stored values); Player is the Automix layout.
component LayoutPill inherits Rectangle {
    in-out property <int> layout;
    callback changed-to(layout: int);
    background: ta.has-hover ? Theme.n-3a3a3d : Theme.panel-raised;
    border-radius: 10px;
    height: 36px;
    y: 8px;
    horizontal-stretch: 0;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 14px;
        spacing: 8px;
        VerticalLayout { alignment: center; LayoutIcon { kind: layout == 3 ? 4 : layout == 4 ? 5 : layout; } }
        Text { text: layout == 1 ? "Player" : layout == 2 ? "4-Deck" : layout == 3 ? "Prep" : layout == 4 ? "2-Deck Basic" : "2-Deck"; color: Theme.text; font-size: 13px; font-weight: 600; vertical-alignment: center; }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { menu.show(); }
    }
    menu := PopupWindow {
        y: root.height + 6px;
        width: 180px;
        Rectangle {
            background: Theme.panel-raised;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 12px;
            drop-shadow-color: Theme.s-00000080;
        }
        VerticalLayout {
            padding: 6px;
            spacing: 2px;
            HorizontalLayout {
                height: 22px;
                padding-left: 10px;
                Text { text: "LAYOUT"; color: Theme.text-dim; font-size: 10px; font-weight: 700; letter-spacing: 0.5px; vertical-alignment: center; horizontal-stretch: 1; }
                // The pencil: opens the chooser, where the DJ picks what
                // this menu offers.
                LayoutPencil {
                    clicked => {
                        menu.close();
                        chooser.show();
                    }
                }
            }
            // The DJ's layouts (switched on in the menu's chooser), in their order.
            for e in LayoutsUi.menu: LayoutItem {
                kind: e.layout == 3 ? 4 : e.layout == 4 ? 5 : e.layout;
                text: e.name;
                current: layout == e.layout;
                picked => {
                    layout = e.layout;
                    changed-to(e.layout);
                }
            }
            Rectangle { height: 9px; Rectangle { height: 1px; background: Theme.border; } }
            // Dark, Light or Auto (Match system), as in Settings › Appearance.
            AppearanceRow {}
        }
    }
    chooser := PopupWindow {
        y: root.height + 6px;
        width: 240px;
        height: chooser-view.preferred-height;
        close-policy: close-on-click-outside;
        chooser-view := LayoutChooser {
            done => {
                chooser.close();
                menu.show();
            }
        }
    }
}

// Shows or hides the large scrolling waveforms above the decks: a
// waveform icon, lit while they show. Hidden, the room goes to the browser.
// The arrow at its right end, as on MIC, opens their heights.
component WaveformsButton inherits Rectangle {
    in-out property <bool> on;
    // The highest step the window has room for now.
    in property <int> fits: 10;
    callback changed-to(on: bool);
    background: on ? Theme.accent.with-alpha(0.18) : Theme.panel-raised;
    border-radius: 10px;
    border-width: 1px;
    border-color: on ? Theme.accent : transparent;
    height: 36px;
    y: 8px;
    horizontal-stretch: 0;
    clip: true;
    HorizontalLayout {
        Rectangle {
            background: ta.pressed ? Theme.control-pressed : ta.has-hover ? Theme.n-ffffff10 : transparent;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 10px;
                // A small waveform.
                Path {
                    width: 16px;
                    height: 12px;
                    y: (parent.height - self.height) / 2;
                    viewbox-width: 16;
                    viewbox-height: 12;
                    stroke: on ? Theme.accent : Theme.text-dim;
                    stroke-width: 1.5px;
                    commands: "M 1 5 L 1 7 M 4 3 L 4 9 M 7 0.5 L 7 11.5 M 10 2 L 10 10 M 13 4 L 13 8 M 15.5 5.5 L 15.5 6.5";
                }
            }
            ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    on = !on;
                    changed-to(on);
                }
            }
        }
        Rectangle { width: 1px; background: on ? Theme.accent.with-alpha(0.5) : Theme.n-ffffff18; }
        Rectangle {
            width: 24px;
            background: arrow.pressed ? Theme.control-pressed : arrow.has-hover ? Theme.n-ffffff10 : transparent;
            Path {
                width: 8px;
                height: 5px;
                commands: "M 0 0 L 4 4 L 8 0";
                stroke: arrow.has-hover ? Theme.text : on ? Theme.accent : Theme.text-dim;
                stroke-width: 1.4px;
                fill: transparent;
            }
            arrow := TouchArea {
                mouse-cursor: pointer;
                clicked => { sizes.show(); }
            }
        }
    }
    sizes := PopupWindow {
        x: 0px;
        y: root.height + 6px;
        width: 270px;
        close-policy: close-on-click-outside;
        Rectangle {
            background: Theme.panel-raised;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 16px;
            drop-shadow-color: Theme.s-000000b0;
        }
        WaveHeightList {
            fits: root.fits;
            picked => {
                // Picking a height shows the waveforms if they were hidden.
                if !root.on {
                    root.on = true;
                    root.changed-to(true);
                }
                sizes.close();
            }
        }
    }
}

// Shows or hides the FX bar under the decks: "FX", lit while it shows.
component FxButton inherits Rectangle {
    in-out property <bool> on;
    callback changed-to(on: bool);
    background: ta.pressed ? Theme.control-pressed : on ? Theme.accent.with-alpha(0.18) : ta.has-hover ? Theme.n-3a3a3d : Theme.panel-raised;
    border-radius: 10px;
    border-width: 1px;
    border-color: on ? Theme.accent : transparent;
    height: 36px;
    y: 8px;
    horizontal-stretch: 0;
    HorizontalLayout {
        padding-left: 11px;
        padding-right: 11px;
        Text { text: "FX"; color: on ? Theme.lilac-text : Theme.text-dim; font-size: 14px; font-weight: 700; font-italic: true; vertical-alignment: center; }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            on = !on;
            changed-to(on);
        }
    }
    TourMark { id: "ui,fx_button"; }
}

// Shows or hides the pad grid in the decks: a small grid of eight pads,
// two rows of four as on most controllers, lit while they show. Hidden,
// 4-Deck strips get shorter and the browser gets the room.
component PadsButton inherits Rectangle {
    in-out property <bool> on;
    callback changed-to(on: bool);
    background: ta.pressed ? Theme.control-pressed : on ? Theme.accent.with-alpha(0.18) : ta.has-hover ? Theme.n-3a3a3d : Theme.panel-raised;
    border-radius: 10px;
    border-width: 1px;
    border-color: on ? Theme.accent : transparent;
    height: 36px;
    y: 8px;
    horizontal-stretch: 0;
    HorizontalLayout {
        padding-left: 11px;
        padding-right: 11px;
        // Eight small pads in two rows of four.
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            for row in 2: HorizontalLayout {
                spacing: 2px;
                for pad in 4: Rectangle {
                    width: 4px;
                    height: 4px;
                    border-radius: 1px;
                    background: on ? Theme.accent : Theme.text-dim;
                }
            }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            on = !on;
            changed-to(on);
        }
    }
    TourMark { id: "ui,pads_button"; }
}

// JOG, in 2-Deck Basic: shows a jog on the mixer side of each deck.
component JogsButton inherits Rectangle {
    in-out property <bool> on;
    callback changed-to(on: bool);
    background: ta.pressed ? Theme.control-pressed : on ? Theme.accent.with-alpha(0.18) : ta.has-hover ? Theme.n-3a3a3d : Theme.panel-raised;
    border-radius: 10px;
    border-width: 1px;
    border-color: on ? Theme.accent : transparent;
    height: 36px;
    y: 8px;
    horizontal-stretch: 0;
    HorizontalLayout {
        padding-left: 11px;
        padding-right: 11px;
        // A platter: a ring with a dot in the middle.
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 14px;
                height: 14px;
                border-radius: 7px;
                border-width: 1.5px;
                border-color: on ? Theme.accent : Theme.text-dim;
                Rectangle {
                    width: 4px;
                    height: 4px;
                    border-radius: 2px;
                    background: on ? Theme.accent : Theme.text-dim;
                }
            }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            on = !on;
            changed-to(on);
        }
    }
}

// MASTER: the main meters and the clock. A click opens the MASTER panel
// with the output levels, Ableton Link and MIDI clock; LINK and CLOCK
// show while they are on.
component MasterPill inherits Rectangle {
    in property <string> clock;
    property <bool> link: Controls.value(Controls.resolve("[Link]", "enabled"), Controls.tick) > 0;
    property <bool> midi-clock: Controls.value(Controls.resolve("[MidiClock]", "enabled"), Controls.tick) > 0;
    background: ta.pressed ? Theme.control-pressed : ta.has-hover ? Theme.n-2e2e32 : Theme.panel-raised;
    border-radius: 10px;
    height: 36px;
    y: 8px;
    horizontal-stretch: 0;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        Text { text: "MASTER"; color: Theme.text-dim; font-size: 11px; font-weight: 600; letter-spacing: 0.5px; vertical-alignment: center; }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            VuMeter { group: "[Master]"; key: "VuMeterL"; width: 120px; height: 4px; vertical: false; segments: 24; }
            VuMeter { group: "[Master]"; key: "VuMeterR"; width: 120px; height: 4px; vertical: false; segments: 24; }
        }
        if link: Text { text: "LINK"; color: Theme.lilac-text; font-size: 10px; font-weight: 700; letter-spacing: 0.5px; vertical-alignment: center; }
        if midi-clock: Text { text: "CLOCK"; color: Theme.lilac-text; font-size: 10px; font-weight: 700; letter-spacing: 0.5px; vertical-alignment: center; }
        Text { text: clock; color: Theme.text; font-size: 14px; font-weight: 500; vertical-alignment: center; }
        Path {
            width: 8px;
            height: 5px;
            y: (parent.height - self.height) / 2;
            commands: "M 0 0 L 4 4 L 8 0";
            stroke: ta.has-hover ? Theme.text : Theme.text-dim;
            stroke-width: 1.4px;
            fill: transparent;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            AudioSettings.refresh();
            panel.show();
        }
    }
    panel := MasterPanel {
        x: root.width - 300px;
        y: root.height + 6px;
    }
}

export component AppWindow inherits Window {
    title: "openDJ";
    icon: @image-url("icons/opendj.svg");
    preferred-width: 1680px;
    preferred-height: 1050px;
    min-width: 1280px;
    min-height: 800px;
    background: Theme.n-000000;
    default-font-family: Theme.font-family;

    in property <[DeckInfo]> decks: [{}, {}, {}, {}];
    in property <image> waveform-1;
    in property <image> waveform-2;
    in property <image> waveform-3;
    in property <image> waveform-4;
    in property <image> overview-1;
    in property <image> overview-2;
    in property <image> overview-3;
    in property <image> overview-4;
    in property <angle> spin-1;
    in property <angle> spin-2;
    in property <string> clock;
    in-out property <bool> folders-focused;

    in property <[Folder]> folders;
    in property <int> current-folder;
    in property <string> folder-name;
    in property <string> folder-duration;
    in property <bool> spotify-connected;
    in property <string> spotify-user;
    in property <string> spotify-status;
    in-out property <string> spotify-client-id;
    in property <string> list-notice;
    // Why something didn't happen, such as a track that couldn't be loaded.
    in-out property <string> alert;
    // A newer release on GitHub, shown at the top right until dismissed;
    // the app hides it while a deck plays.
    in-out property <string> update-version;
    // "Install & restart" when openDJ can update itself, else "Download".
    in property <string> update-action: "Download";
    // While installing: "Downloading…" and so on, in place of the buttons.
    in property <string> update-status;
    callback update-download();
    callback update-dismiss();
    in property <[TrackRow]> tracks;
    in property <int> sort-column: 1;
    in property <bool> sort-ascending: true;
    in-out property <int> current-track <=> browser.current-row;
    // The track list's scroll, kept per list while openDJ runs.
    out property <length> track-scroll-y: browser.list-scroll-y;
    public function show-tracks-at(row: int, offset: length, y: length) {
        browser.show-list-at(row, offset, y);
    }
    in property <[SideRow]> side-rows;
    in property <string> side-total;
    in-out property <int> side-tab <=> browser.side-tab;
    // Footer toggles: the library over the decks, and the side panel.
    in-out property <bool> library-expanded: false;
    in-out property <bool> side-panel-visible: true;
    in property <bool> automix-on;
    in property <string> automix-status;
    in property <int> automix-length;
    in property <int> automix-style;
    // Tracks left on the Automix list, Automix's live deck and the deck
    // it is mixing into (-1 for none), for the Player bar.
    in property <int> automix-queued;
    in property <int> automix-live: -1;
    in property <int> automix-into: -1;
    // The track Automix plays next and the time before its mix starts.
    in property <string> automix-next;
    in property <string> automix-next-in;
    // Played tracks go back to the end of the Automix list (Repeat).
    in property <bool> automix-repeat;
    // 0 2-Deck (the full decks and mixer), 1 Player (one bar: a music
    // player over Automix), 2 four decks in strips, 3 Prep (deck 1 alone,
    // for preparing tracks).
    in-out property <int> layout: 0;
    callback layout-changed(layout: int);
    // The large scrolling waveforms above the decks, from the top bar button.
    in-out property <bool> waveforms-visible: true;
    callback waveforms-visible-changed(on: bool);
    // The FX bar under the waveforms, from the top bar's FX button.
    in-out property <bool> fx-bar-visible: true;
    callback fx-bar-visible-changed(on: bool);
    // The pad grid in the decks: the PADS button beside FX.
    in-out property <bool> pads-visible <=> PadsUi.visible;
    in-out property <bool> jogs-visible <=> LiteUi.jogs;
    callback jogs-visible-changed(on: bool);
    callback pads-visible-changed(on: bool);

    // Physical sizes the GPU textures should be rendered at.
    // Room on the left of the top bar for macOS's window buttons.
    in property <length> traffic-light-inset: 0px;
    callback drag-window();
    callback zoom-window();
    out property <length> waveform-width: waveforms.width;
    // Two waveforms, or four in 4-Deck, share the room between the lines.
    out property <length> waveform-height: max(1px, (waveforms.height - (wave-rows + 1) * 1px - (prep ? 24px : 0px)) / wave-rows);
    property <int> wave-rows: four ? 4 : prep ? 1 : 2;
    // The waveforms' strip at each of the ten height steps
    // (wave_height.slint), 1 first, 3 being the height it always had: each
    // waveform 48 to 144 px in 2-Deck Basic and 2-Deck, 36 to 84 px in 4-Deck,
    // 120 to 320 px in Prep, with the lines between (and Prep's key hints).
    property <[length]> strip-heights: four ? [149px, 181px, 213px, 233px, 249px, 269px, 285px, 305px, 321px, 341px] : prep ? [146px, 173px, 200px, 221px, 242px, 263px, 283px, 304px, 325px, 346px] : [99px, 123px, 144px, 167px, 189px, 209px, 229px, 249px, 271px, 291px];
    // Everything else down the window but the library, which is as tall as
    // this layout makes it whatever the waveforms' height: the top bar, the
    // decks, the FX bar and the footer, with the lines between.
    property <length> deck-rows: layout == 0 ? LiteUi.deck-height + 1px + LiteUi.bar-height
        : lite ? lite-row + (PadsUi.visible ? 1px + LiteUi.bar-height : 0px)
        : four ? (PadsUi.visible ? 330px : 247px) + 1px + 48px
        : prep ? 280px : 0px;
    property <length> other-rows: 52px + 1px + 1px + deck-rows + 1px + (fx-bar-visible && !prep ? (four ? 96px : 68px) + 1px : 0px) + 1px + 36px;
    // The library keeps room for about five tracks under its header: a
    // step with less shows the highest one that fits, but never below 3
    // unless the DJ chose less. The chosen one comes back
    // when the window has room again.
    property <length> library-floor: 230px;
    // The window's height as `changed height` passes it on: reading
    // root.height here would tie the window's own size to the waveforms'.
    property <length> strip-room: LibraryEdit.window-height - other-rows - library-floor;
    property <int> wave-fits: strip-heights[9] <= strip-room ? 10 : strip-heights[8] <= strip-room ? 9 : strip-heights[7] <= strip-room ? 8 : strip-heights[6] <= strip-room ? 7 : strip-heights[5] <= strip-room ? 6 : strip-heights[4] <= strip-room ? 5 : strip-heights[3] <= strip-room ? 4 : strip-heights[2] <= strip-room ? 3 : strip-heights[1] <= strip-room ? 2 : 1;
    property <int> wave-level: min(WaveHeight.level, max(wave-fits, min(WaveHeight.level, WaveHeight.default-level)));
    // From whichever layout's deck A is showing.
    // 2-Deck measures the overviews on deck 1, or on deck 2 while deck 1
    // is a Mixer deck: that has no overview, and its zero height would draw
    // every overview as only its phrase bar, stretched to fill.
    property <bool> pro-overview-b: deck-a.overview-height < 1px && deck-b.overview-height >= 1px;
    property <length> pro-overview-width: pro-overview-b ? deck-b.overview-width : deck-a.overview-width;
    property <length> pro-overview-height: pro-overview-b ? deck-b.overview-height : deck-a.overview-height;
    out property <length> overview-width: player ? 1px : four ? strip-1.overview-width : compact ? player-a.overview-width : prep ? prep-deck.overview-width : lite ? lite-a.overview-width : pro-overview-width;
    out property <length> overview-height: player ? 1px : four ? strip-1.overview-height : compact ? player-a.overview-height : prep ? prep-deck.overview-height : lite ? lite-a.overview-height : pro-overview-height;
    property <bool> four: layout == 2 && !library-expanded;
    // 2-Deck Basic, the lighter two-deck layout (lite.slint). A deck there holding
    // a Groove Box or an instrument shows the full deck, and the row is as
    // tall as 2-Deck's.
    property <bool> lite: layout == 4 && !library-expanded;
    property <bool> lite-full-a: Controls.value(Controls.resolve("[Groove1]", "enabled"), Controls.tick) > 0 || (!decks[0].loaded && InstrumentsUi.live(0) > 0);
    // The 2-Deck Basic deck row: the full deck's height when one holds a Groove
    // Box or an instrument.
    property <length> lite-row: lite-full-a || lite-full-b ? 272px : LiteUi.deck-height;
    property <bool> lite-full-b: Controls.value(Controls.resolve("[Groove2]", "enabled"), Controls.tick) > 0 || (!decks[1].loaded && InstrumentsUi.live(1) > 0);
    // A hardware mixer does the mixing (`[Master],external_mixer`): no
    // on-screen mixer, only each deck's level.
    property <bool> external-mixer: Controls.value(Controls.resolve("[Master]", "external_mixer"), Controls.tick) > 0;
    property <bool> prep: layout == 3 && !library-expanded;
    // The Player layout: one bar, no waveforms or FX bar.
    property <bool> player: layout == 1;
    property <bool> recording: Controls.value(Controls.resolve("[Recording]", "status"), Controls.tick) > 1;
    // The compact row shows in 2-Deck Basic, 4-Deck and Prep while the footer
    // button has the library expanded (then with no waveforms).
    property <bool> compact: library-expanded && !player;

    callback select-source(source: int);
    // Which sources the library rail shows, by index.
    in-out property <[bool]> sources-shown: [true, true, true, true, true, true, true, true, true, true, true, true, true];
    callback source-shown-changed(source: int, on: bool);
    // Settings › Sources signs out of streaming service `source`.
    callback stream-sign-out(source: int);
    callback spotify-connect(client-id: string);
    callback spotify-disconnect();
    callback spotify-copy();
    // Fetch the streaming service's playlists again.
    callback spotify-refresh();
    callback select-folder(index: int);
    callback toggle-folder(index: int);
    callback sort(column: int);
    callback search(text: string);
    callback activate-track(row: int);
    callback load-track(deck: int, row: int);
    callback side-activate(row: int);
    callback side-remove(first: int, last: int);
    // A key no field took, for the keyboard shortcuts (shortcuts.rs);
    // true when it ran one. master is 0 for deck 1; first and last are
    // the rows picked in the track list.
    callback shortcut(text: string, cmd: bool, alt: bool, shift: bool, master: int, first: int, last: int) -> bool;
    callback automix-toggle();
    callback automix-mix-now();
    // Player's Next: on to the next track with a cut.
    callback automix-cut-now();
    // Opens the mini player window and hides this one (mini_player.rs).
    callback mini-player();
    // The deck the Player bar and the mini player show.
    out property <int> player-deck: automix-live >= 0 ? automix-live : master-deck;
    callback automix-set-repeat(bool);
    callback automix-skip();
    callback automix-order(int);
    callback automix-order-undo();
    in-out property <string> automix-order-note;
    callback automix-set-length(index: int);
    callback automix-set-style(index: int);

    public function focus-search() {
        browser.focus-search();
    }

    // Edit › Find, and ⌘F (Ctrl+F on Linux and Windows): the library
    // search, or the top bar's in Player.
    public function find() {
        if player {
            QuickSearch.focus-box();
        } else {
            focus-search();
        }
    }

    // Text fields and other std widgets follow the appearance.
    property <bool> light-look: Theme.light;
    changed light-look => {
        Palette.color-scheme = self.light-look ? ColorScheme.light : ColorScheme.dark;
    }

    init => {
        Palette.color-scheme = Theme.light ? ColorScheme.light : ColorScheme.dark;
        Theme.player = player;
        WaveHeight.layout = layout;
        keys.focus();
        LibraryEdit.window-height = root.height;
        LibraryEdit.window-width = root.width;
        LibraryEdit.top-search = player;
    }
    changed layout => {
        WaveHeight.layout = layout;
    }
    changed player => {
        Theme.player = player;
        LibraryEdit.top-search = player;
        // Now Playing and its large lyrics only show in Player mode.
        if !player {
            NowPlayingUi.close();
        }
        // The list's search carries over into the top bar's box.
        if player {
            QuickSearch.text = StoreUi.search-text;
        }
    }
    // For the track menu, which moves up to fit in the window.
    changed height => { LibraryEdit.window-height = root.height; }
    changed width => { LibraryEdit.window-width = root.width; }

    // Back to the shortcuts when settings close, so ⌘, opens them again.
    property <bool> settings-open: Preferences.open;
    changed settings-open => {
        if !settings-open {
            keys.focus();
        }
    }

    // The master deck: the deck playing; with
    // more than one playing, the one that started first; when it stops while
    // another plays, that one. With none playing it stays the last one,
    // so the space bar resumes it. 0 is deck 1.
    property <[int]> play-index: [
        Controls.resolve("[Channel1]", "play"),
        Controls.resolve("[Channel2]", "play"),
        Controls.resolve("[Channel3]", "play"),
        Controls.resolve("[Channel4]", "play"),
    ];
    property <bool> playing-1: Controls.value(play-index[0], Controls.tick) > 0;
    property <bool> playing-2: Controls.value(play-index[1], Controls.tick) > 0;
    property <bool> playing-3: Controls.value(play-index[2], Controls.tick) > 0;
    property <bool> playing-4: Controls.value(play-index[3], Controls.tick) > 0;
    property <[bool]> playing: [playing-1, playing-2, playing-3, playing-4];
    property <int> master-deck: 0;
    // The deck started last, the one being mixed in: ← and → bend it.
    property <int> last-started: 0;
    // The bend control an arrow key holds down, -1 for none.
    property <int> bend-held: -1;
    // Presses one of deck 1's controls once, for Prep's keys.
    function press(key: string) {
        Controls.set-value(Controls.resolve("[Channel1]", key), 1);
        Controls.set-value(Controls.resolve("[Channel1]", key), 0);
    }
    function flip(key: string) {
        let i = Controls.resolve("[Channel1]", key);
        Controls.set-value(i, Controls.value(i, Controls.tick) > 0 ? 0 : 1);
    }
    // The Prep layout's keys (see the prep-layout spec); true when one ran.
    // Option+1-9 in Prep: ticks checklist line 1-9 (macOS types ¡™£¢∞§¶•ª
    // for them).
    function prep-alt-key(text: string) -> bool {
        let n = text == "1" || text == "¡" ? 1 : text == "2" || text == "™" ? 2 : text == "3" || text == "£" ? 3 : text == "4" || text == "¢" ? 4
            : text == "5" || text == "∞" ? 5 : text == "6" || text == "§" ? 6 : text == "7" || text == "¶" ? 7 : text == "8" || text == "•" ? 8
            : text == "9" || text == "ª" ? 9 : 0;
        if n > 0 {
            ChecklistUi.tick(n - 1);
        }
        n > 0
    }
    function prep-key(text: string, shift: bool) -> bool {
        if text == Key.Return {
            PrepUi.ready();
            return true;
        }
        let n = text == "1" || text == "!" ? 1 : text == "2" || text == "@" ? 2 : text == "3" || text == "#" ? 3 : text == "4" || text == "$" ? 4
            : text == "5" || text == "%" ? 5 : text == "6" || text == "^" ? 6 : text == "7" || text == "&" ? 7 : text == "8" || text == "*" ? 8 : 0;
        if n > 0 {
            press("hotcue_" + n + (shift ? "_clear" : "_activate"));
            return true;
        }
        // Quick review: phrase by phrase, or four bars at a time.
        if text == Key.Tab || text == Key.Backtab {
            PrepUi.phrase(shift || text == Key.Backtab ? -1 : 1);
            return true;
        }
        if text == Key.LeftArrow || text == Key.RightArrow {
            press(text == Key.RightArrow ? "beatjump_16_forward" : "beatjump_16_backward");
            return true;
        }
        if shift {
            return false;
        }
        let locked = Controls.value(Controls.resolve("[Channel1]", "bpmlock"), Controls.tick) > 0;
        if text == "l" {
            flip("bpmlock");
            return true;
        }
        if text == "m" {
            flip("metronome");
            return true;
        }
        if text == "c" {
            CueList.add-memory();
            return true;
        }
        if locked {
            return false;
        }
        if text == "b" {
            press("beats_downbeat_here");
            return true;
        }
        if text == "t" {
            press("bpm_tap");
            return true;
        }
        if text == "[" {
            press("beats_translate_earlier");
            return true;
        }
        if text == "]" {
            press("beats_translate_later");
            return true;
        }
        if text == "-" {
            press("beats_adjust_slower");
            return true;
        }
        if text == "=" {
            press("beats_adjust_faster");
            return true;
        }
        false
    }
    // Whether a deck's grid is being edited (its waveform's pencil).
    function grid-editing() -> bool {
        Controls.value(Controls.resolve("[Channel1]", "beats_edit"), Controls.tick) > 0
            || Controls.value(Controls.resolve("[Channel2]", "beats_edit"), Controls.tick) > 0
            || Controls.value(Controls.resolve("[Channel3]", "beats_edit"), Controls.tick) > 0
            || Controls.value(Controls.resolve("[Channel4]", "beats_edit"), Controls.tick) > 0
    }
    function playing-changed(deck: int) {
        if playing[deck] {
            last-started = deck;
            if !playing[master-deck] {
                master-deck = deck;
            }
        } else if deck == master-deck {
            master-deck = playing[0] ? 0 : playing[1] ? 1 : playing[2] ? 2 : playing[3] ? 3 : deck;
        }
    }
    changed playing-1 => { playing-changed(0); }
    changed playing-2 => { playing-changed(1); }
    changed playing-3 => { playing-changed(2); }
    changed playing-4 => { playing-changed(3); }

    // Shortcuts no focused field took: ⌘, opens settings (Ctrl+, on
    // Linux; Slint reads ⌘ as control on macOS), Esc closes them, and the
    // space bar pauses or resumes the master deck. Any other key goes to
    // the keyboard shortcuts, which run openDJscript (⌘1 to ⌘5 rate the
    // picked tracks).
    keys := FocusScope {
        // ← and → bend the deck started last while held, by 2% (4% with
        // Shift), to nudge its beat into line (see key-pressed).
        key-released(e) => {
            if (e.text == Key.LeftArrow || e.text == Key.RightArrow) && bend-held >= 0 {
                Controls.set-value(bend-held, 0);
                bend-held = -1;
                return accept;
            }
            reject
        }
        key-pressed(e) => {
            if e.text == " " && !Preferences.open && !e.modifiers.control && !e.modifiers.meta && !e.modifiers.alt {
                Controls.set-value(play-index[master-deck], playing[master-deck] ? 0 : 1);
                return accept;
            }
            // Only opens, as in other Mac apps, so it can't undo the app
            // menu's Settings… when both see the key.
            if e.text == "," && e.modifiers.control {
                if !Preferences.open {
                    Preferences.show(Preferences.page);
                }
                return accept;
            }
            // Ctrl+Q quits on Linux and Windows, as File › Quit says
            // (macOS's own app menu has ⌘Q).
            if AppMenu.shown && (e.text == "q" || e.text == "Q") && e.modifiers.control && !e.modifiers.alt && !e.modifiers.shift {
                AppMenu.activated(AppMenu.quit-action);
                return accept;
            }
            if MapMode.active && e.text == Key.Escape {
                MapMode.done();
                return accept;
            }
            if MapMode.active && (e.text == "z" || e.text == "Z") && e.modifiers.control {
                MapMode.undo();
                return accept;
            }
            // ⌘Z (Ctrl+Z on Linux and Windows) takes back the last stage
            // change or merge of copies; text fields take it first.
            if (e.text == "z" || e.text == "Z") && e.modifiers.control && !e.modifiers.alt && !e.modifiers.shift && !Preferences.open && LibraryEdit.undo-text != "" {
                LibraryEdit.undo-stage();
                return accept;
            }
            if e.text == Key.Escape && UsbExport.open && !UsbExport.running {
                UsbExport.open = false;
                return accept;
            }
            if e.text == Key.Escape && Tour.mode == 1 && !ImportWizard.open && !ControllerEditor.open && !Preferences.open {
                Tour.end();
                return accept;
            }
            if e.text == Key.Escape && ControllerEditor.dialog != 0 {
                ControllerEditor.dialog-done(false);
                return accept;
            }
            if e.text == Key.Escape && ControllerEditor.open {
                ControllerEditor.open = false;
                return accept;
            }
            if e.text == Key.Escape && Preferences.open {
                Preferences.open = false;
                return accept;
            }
            // Esc finishes editing beat grids (the waveforms' pencils).
            if e.text == Key.Escape && !Preferences.open && grid-editing() {
                Controls.set-value(Controls.resolve("[Channel1]", "beats_edit"), 0);
                Controls.set-value(Controls.resolve("[Channel2]", "beats_edit"), 0);
                Controls.set-value(Controls.resolve("[Channel3]", "beats_edit"), 0);
                Controls.set-value(Controls.resolve("[Channel4]", "beats_edit"), 0);
                return accept;
            }
            // Esc clears the library search, as in the search box itself.
            if e.text == Key.Escape && StoreUi.search-text != "" && !Preferences.open && !ImportWizard.open && !UsbExport.open {
                StoreUi.search-text = "";
                QuickSearch.text = "";
                QuickSearch.open = false;
                search("");
                return accept;
            }
            // ⇧⌘M (Ctrl+Shift+M on Linux and Windows): the mini player.
            if (e.text == "m" || e.text == "M") && e.modifiers.control && e.modifiers.shift && !e.modifiers.alt && !Preferences.open {
                mini-player();
                return accept;
            }
            // ⌘F (Ctrl+F on Linux and Windows) goes to the library search.
            // ⌘= (or ⌘+) and ⌘− zoom the large waveforms, ⌘0 resets them.
            if (e.text == "=" || e.text == "+" || e.text == "-" || e.text == "0") && e.modifiers.control && !e.modifiers.alt && !Preferences.open {
                if e.text == "0" {
                    WaveZoom.reset();
                } else {
                    WaveZoom.step(e.text == "-" ? -1 : 1);
                }
                return accept;
            }
            // ⌥⌘↑ and ⌥⌘↓ (Ctrl+Alt on Linux and Windows) make the large
            // waveforms taller or shorter in this layout.
            if (e.text == Key.UpArrow || e.text == Key.DownArrow) && e.modifiers.control && e.modifiers.alt && !e.modifiers.shift && !Preferences.open && !player {
                WaveHeight.step(e.text == Key.UpArrow ? 1 : -1);
                return accept;
            }
            if (e.text == "f" || e.text == "F") && e.modifiers.control && !e.modifiers.alt && !e.modifiers.shift && !Preferences.open {
                find();
                return accept;
            }
            // ⌘A (Ctrl+A on Linux and Windows) picks every track in the
            // list; the side list and text fields take it first themselves.
            if (e.text == "a" || e.text == "A") && e.modifiers.control && !e.modifiers.alt && !e.modifiers.shift && !Preferences.open {
                browser.select-all();
                return accept;
            }
            // Prep's own keys, ahead of the DJ's shortcuts: Enter for Play
            // Ready and next, 1-8 the hot cues, and the grid tools.
            if prep && !Preferences.open && !e.modifiers.control && !e.modifiers.meta && !e.modifiers.alt && prep-key(e.text, e.modifiers.shift) {
                return accept;
            }
            if prep && !Preferences.open && e.modifiers.alt && !e.modifiers.control && !e.modifiers.meta && prep-alt-key(e.text) {
                return accept;
            }
            if !Preferences.open && shortcut(e.text, e.modifiers.control, e.modifiers.alt, e.modifiers.shift, master-deck, browser.first-picked, browser.last-picked) {
                return accept;
            }
            // Unless the DJ gave the arrows shortcuts of their own.
            if (e.text == Key.LeftArrow || e.text == Key.RightArrow) && !Preferences.open && !e.modifiers.control && !e.modifiers.meta && !e.modifiers.alt {
                if bend-held < 0 {
                    let group = "[Channel" + (last-started + 1) + "]";
                    bend-held = Controls.resolve(group, (e.text == Key.RightArrow ? "rate_temp_up" : "rate_temp_down") + (e.modifiers.shift ? "" : "_small"));
                    Controls.set-value(bend-held, 1);
                }
                return accept;
            }
            reject
        }
        VerticalLayout {
            // The window's black shows between the panels as thin lines:
            // one line under each panel that shows, so the panels folded to
            // nothing add no gaps.
            spacing: 0px;

            // Top bar: pill-shaped groups on a dark strip, app name in the middle.
            Rectangle {
                // A tall bar; on macOS the title bar is made the same
                // height (TOP_BAR_HEIGHT in main.rs) so the traffic lights
                // sit in the middle.
                height: 52px;
                // The top bar moves the window, as a title bar would: on macOS
                // the real one is hidden.
                TouchArea {
                    pointer-event(e) => {
                        if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                            drag-window();
                        }
                    }
                    double-clicked => { zoom-window(); }
                }
                // The logo and name, centred on the window whatever the pills'
                // widths; in Player, the search box takes their place.
                if !player: HorizontalLayout {
                    alignment: center;
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        Image { source: @image-url("icons/opendj-mark.svg"); width: 32px; height: 20px; }
                    }
                    Text { text: "openDJ"; color: Theme.text; font-family: Theme.brand-font; font-size: 21px; vertical-alignment: center; }
                }
                HorizontalLayout {
                    padding-left: 4px + traffic-light-inset;
                    padding-right: 4px;
                    spacing: 10px;
                    // File and Edit, on Windows and Linux (macOS has its
                    // menu bar).
                    if AppMenu.shown: AppMenuButton { }
                    LayoutPill { layout <=> root.layout; changed-to(l) => { layout-changed(l); } }
                    // Prep always shows its waveform and never the FX bar,
                    // so neither button is offered there.
                    if !player && layout != 3: WaveformsButton { on <=> root.waveforms-visible; fits: wave-fits; changed-to(on) => { waveforms-visible-changed(on); } }
                    if !player && layout != 3: FxButton { on <=> root.fx-bar-visible; changed-to(on) => { fx-bar-visible-changed(on); } }
                    if layout == 2 || layout == 4: PadsButton { on <=> root.pads-visible; changed-to(on) => { pads-visible-changed(on); } }
                    if layout == 4: JogsButton { on <=> root.jogs-visible; changed-to(on) => { jogs-visible-changed(on); } }
                    if !player: Rectangle { horizontal-stretch: 1; }
                    // Between the pills, centred on the window (as the
                    // Player bar below is) while there is room, else
                    // pushed aside by the wider group of pills.
                    if player: HomeButton { }
                    if player: search-area := Rectangle {
                        horizontal-stretch: 1;
                        property <length> room: self.width - 20px;
                        TopSearch {
                            width: min(560px, room);
                            x: 10px + clamp(root.width / 2 - search-area.absolute-position.x - 10px - self.width / 2, 0px, room - self.width);
                        }
                    }
                    RemoteButton { }
                    // Player keeps the top bar for search: no MIC button,
                    // REC (File › Record Mix) only while recording, and no
                    // MASTER, as the bar's volume is the master volume.
                    if !player: MicButton { }
                    // Only for DJs who broadcast; on air from a controller
                    // shows it too.
                    if BroadcastState.shown || Controls.value(Controls.resolve("[Shoutcast]", "enabled"), Controls.tick) > 0: OnAirButton { }
                    if !player || recording: RecordButton { }
                    if !player: MasterPill { clock: clock; }
                }
            }

            // Under the top bar: a lighter grey line when the decks come
            // next (the waveforms draw their own).
            Rectangle { height: 1px; background: waveforms.visible ? transparent : Theme.border; }

            // Scrolling waveforms, deck A above deck B; in 4-Deck all four,
            // in the strips' order 3, 1, 2, 4.
            waveforms := Rectangle {
                // Not rounded or clipped: that renders into a cached layer, which
                // would freeze the GPU-updated waveform images. Folded away while
                // the library is expanded or the top bar button hides them
                // (Prep has no such button: its waveform always shows).
                height: library-expanded || !(waveforms-visible || prep) || player ? 0px : wave-grip.dragging ? wave-grip.drag-height : strip-heights[wave-level - 1];
                visible: !library-expanded && (waveforms-visible || prep) && !player;
                background: Theme.well;
                // Thin grey lines above, between and below the waveforms.
                if prep: VerticalLayout {
                    spacing: 0px;
                    Rectangle { height: 1px; background: Theme.border; }
                    Waveform { source: waveform-1; group: "[Channel1]"; info: decks[0]; vertical-stretch: 1; lyrics-deck: 0; drag-grid: true; first: true; }
                    // The quick review keys, and how long this track has taken.
                    Rectangle {
                        height: 24px;
                        background: Theme.panel;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 14px;
                            for hint in ["Tab", "next phrase", "← →", "4 bars", "1–8", "hot cues", "B", "bar 1", "[ ]", "move grid", "M", "click", "⌥1–9", "checklist", "⏎", "ready, next"]: Text {
                                // Keys and what they do take turns.
                                text: hint;
                                color: hint == "Tab" || hint == "← →" || hint == "1–8" || hint == "B" || hint == "[ ]" || hint == "M" || hint == "⌥1–9" || hint == "⏎" ? Theme.text : Theme.text-dim;
                                font-size: 11px;
                                font-weight: hint == "Tab" || hint == "← →" || hint == "1–8" || hint == "B" || hint == "[ ]" || hint == "M" || hint == "⌥1–9" || hint == "⏎" ? 700 : 400;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Text {
                                text: "This track " + PrepUi.clock(PrepUi.track-seconds) + (PrepUi.average-seconds > 0 ? "  ·  average " + PrepUi.clock(PrepUi.average-seconds) : "");
                                color: Theme.text-dim;
                                font-family: "Inter Tabular";
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                        }
                    }
                    Rectangle { height: 1px; background: Theme.border; }
                }
                if !four && !prep: VerticalLayout {
                    spacing: 0px;
                    Rectangle { height: 1px; background: Theme.border; }
                    Waveform { source: waveform-1; group: "[Channel1]"; info: decks[0]; deck: 0; vertical-stretch: 1; first: true; }
                    Rectangle { height: 1px; background: Theme.border; }
                    Waveform { source: waveform-2; group: "[Channel2]"; info: decks[1]; deck: 1; vertical-stretch: 1; }
                    Rectangle { height: 1px; background: Theme.border; }
                }
                if four: VerticalLayout {
                    spacing: 0px;
                    Rectangle { height: 1px; background: Theme.border; }
                    Waveform { source: waveform-3; group: "[Channel3]"; info: decks[2]; vertical-stretch: 1; lyrics-deck: 2; first: true; }
                    Rectangle { height: 1px; background: Theme.border; }
                    Waveform { source: waveform-1; group: "[Channel1]"; info: decks[0]; vertical-stretch: 1; lyrics-deck: 0; }
                    Rectangle { height: 1px; background: Theme.border; }
                    Waveform { source: waveform-2; group: "[Channel2]"; info: decks[1]; vertical-stretch: 1; lyrics-deck: 1; }
                    Rectangle { height: 1px; background: Theme.border; }
                    Waveform { source: waveform-4; group: "[Channel4]"; info: decks[3]; vertical-stretch: 1; lyrics-deck: 3; }
                    Rectangle { height: 1px; background: Theme.border; }
                }
                // The zoom's bar, down the left edge of all the waveforms at
                // once (Prep's one, not its key hints), while the pointer is
                // over any of them or on the bar.
                ZoomBar {
                    x: 0;
                    y: 0;
                    height: prep ? max(0px, parent.height - 26px) : parent.height;
                    shown: WaveZoom.hovered != "";
                }
            }

            Rectangle { height: waveforms.visible ? 1px : 0px; }

            // The deck area: whichever of the rows below the layout shows.
            // Grouped, so the rows folded to nothing add no gaps.
            VerticalLayout {
                spacing: 0px;
                // Decks and mixer
                // Split by thin black lines.
                // In Player, folded away (rather than removed, so the overview
                // sizes the renderer reads stay valid) for the compact row below.
                HorizontalLayout {
                    spacing: 1px;
                    // As tall as 2-Deck Basic with its pad bar, so switching between
                    // them leaves the library where it is.
                    height: library-expanded || layout != 0 ? 0px : LiteUi.deck-height + 1px + LiteUi.bar-height;
                    visible: !library-expanded && layout == 0;
                    // The decks share the room equally whatever they show: sized by
                    // their contents, a changing time or title would nudge the
                    // mixer sideways every frame.
                    deck-a := Deck { deck: 0; info: decks[0]; spin: spin-1; overview: overview-1; horizontal-stretch: 1; min-width: 400px; preferred-width: 400px; }
                    if !external-mixer: Mixer { }
                    if external-mixer: ExternalMixer { }
                    deck-b := Deck { deck: 1; info: decks[1]; spin: spin-2; overview: overview-2; mirrored: true; horizontal-stretch: 1; min-width: 400px; preferred-width: 400px; }
                }

                // 2-Deck Basic: the lighter decks either side of the slim mixer, each
                // with its half of the pad bar (with PADS) under it. The mixer
                // runs the full height of both, using the room between the pads.
                // A deck with a Groove Box or an instrument shows the full deck,
                // and then the deck row and mixer are 2-Deck's.
                HorizontalLayout {
                    spacing: 1px;
                    height: lite ? lite-row + (PadsUi.visible ? 1px + LiteUi.bar-height : 0px) : 0px;
                    visible: lite;
                    VerticalLayout {
                        spacing: 1px;
                        horizontal-stretch: 1;
                        min-width: 400px;
                        preferred-width: 400px;
                        Rectangle {
                            height: lite-row;
                            lite-a := LiteDeck { width: parent.width; height: parent.height; visible: !lite-full-a; deck: 0; info: decks[0]; overview: overview-1; spin: spin-1; }
                            if lite-full-a: Deck { width: parent.width; height: parent.height; deck: 0; info: decks[0]; spin: spin-1; overview: overview-1; }
                        }
                        if PadsUi.visible: PadBarHalf { height: LiteUi.bar-height; deck: 0; info: decks[0]; }
                    }
                    // With the pad bar the row is 2-Deck Pro's height, so it
                    // takes the same full mixer: GAIN knobs, cues under the faders.
                    if !external-mixer && !(lite-full-a || lite-full-b) && !PadsUi.visible: LiteMixer { }
                    if !external-mixer && !(lite-full-a || lite-full-b) && PadsUi.visible: Mixer { }
                    if !external-mixer && (lite-full-a || lite-full-b): VerticalLayout {
                        Mixer { height: 272px; }
                        Rectangle { background: Theme.panel; vertical-stretch: 1; }
                    }
                    if external-mixer: VerticalLayout {
                        ExternalMixer { height: lite-row; }
                        Rectangle { background: Theme.panel; vertical-stretch: 1; }
                    }
                    VerticalLayout {
                        spacing: 1px;
                        horizontal-stretch: 1;
                        min-width: 400px;
                        preferred-width: 400px;
                        Rectangle {
                            height: lite-row;
                            LiteDeck { width: parent.width; height: parent.height; visible: !lite-full-b; deck: 1; info: decks[1]; overview: overview-2; mirrored: true; spin: spin-2; }
                            if lite-full-b: Deck { width: parent.width; height: parent.height; deck: 1; info: decks[1]; spin: spin-2; overview: overview-2; mirrored: true; }
                        }
                        if PadsUi.visible: PadBarHalf { height: LiteUi.bar-height; deck: 1; info: decks[1]; mirrored: true; }
                    }
                }

                // 4-Deck: four strips, decks 3, 1, 2 and 4, then the bar with the
                // crossfader. Folded away, like the 2-Deck Basic row, in the other
                // layouts.
                HorizontalLayout {
                    spacing: 1px;
                    height: four ? (PadsUi.visible ? 330px : 247px) : 0px;
                    visible: four;
                    DeckStrip { deck: 2; info: decks[2]; overview: overview-3; horizontal-stretch: 1; min-width: 270px; preferred-width: 270px; }
                    strip-1 := DeckStrip { deck: 0; info: decks[0]; overview: overview-1; horizontal-stretch: 1; min-width: 270px; preferred-width: 270px; }
                    DeckStrip { deck: 1; info: decks[1]; overview: overview-2; horizontal-stretch: 1; min-width: 270px; preferred-width: 270px; }
                    DeckStrip { deck: 3; info: decks[3]; overview: overview-4; horizontal-stretch: 1; min-width: 270px; preferred-width: 270px; }
                }

                // Over the expanded library: the deck headers either side of
                // the basics, in one short row.
                HorizontalLayout {
                    spacing: 1px;
                    height: compact ? 108px : 0px;
                    visible: compact;
                    player-a := PlayerDeck { deck: 0; info: decks[0]; overview: overview-1; horizontal-stretch: 1; min-width: 330px; }
                    PlayerMixer { decks: decks; spin-1: spin-1; spin-2: spin-2; }
                    PlayerDeck { deck: 1; info: decks[1]; overview: overview-2; mirrored: true; horizontal-stretch: 1; min-width: 330px; }
                }

                // Prep: deck 1's header over the grid tools, transport and hot
                // cue pads.
                prep-deck := PrepDeck {
                    info: decks[0];
                    overview: overview-1;
                    height: prep ? 280px : 0px;
                    visible: prep;
                }

                Rectangle { height: four ? 1px : 0px; }
                FourDeckBar {
                    decks: decks;
                    height: four ? 48px : 0px;
                    visible: four;
                }
            }

            Rectangle { height: !player ? 1px : 0px; }

            // The FX bar under the decks: deck effects either side of the
            // Beat FX. Folded away while the library is expanded or the top
            // bar hides it.
            FxBar {
                four: four;
                height: library-expanded || !fx-bar-visible || player || prep ? 0px : four ? 96px : 68px;
                visible: !library-expanded && fx-bar-visible && !player && !prep;
            }

            Rectangle { height: !library-expanded && fx-bar-visible && !player && !prep ? 1px : 0px; }

            browser := Browser {
                vertical-stretch: 1;
                folders: folders;
                current-folder: current-folder;
                folders-focused <=> folders-focused;
                folder-name: folder-name;
                folder-duration: folder-duration;
                spotify-connected: spotify-connected;
                spotify-user: spotify-user;
                spotify-status: spotify-status;
                spotify-client-id <=> spotify-client-id;
                list-notice: list-notice;
                select-source(s) => { select-source(s); }
                sources-shown <=> sources-shown;
                source-shown-changed(s, on) => { source-shown-changed(s, on); }
                spotify-connect(id) => { spotify-connect(id); }
                spotify-disconnect => { spotify-disconnect(); }
                spotify-copy => { spotify-copy(); }
                spotify-refresh => { spotify-refresh(); }
                rows: tracks;
                sort-column: sort-column;
                ascending: sort-ascending;
                side-rows: side-rows;
                side-total: side-total;
                list-clicked => { keys.focus(); }
                select-folder(i) => { select-folder(i); }
                toggle-folder(i) => { toggle-folder(i); }
                sort(c) => { sort(c); }
                search(t) => { search(t); }
                activate(r) => { activate-track(r); }
                side-activate(r) => { side-activate(r); }
                side-remove(first, last) => { side-remove(first, last); }
                automix-on: automix-on;
                automix-status: automix-status;
                automix-length: automix-length;
                automix-style: automix-style;
                automix-toggle => { automix-toggle(); }
                automix-mix-now => { automix-mix-now(); }
                automix-skip => { automix-skip(); }
                automix-order(i) => { automix-order(i); }
                automix-order-undo => { automix-order-undo(); }
                automix-order-note <=> automix-order-note;
                automix-set-length(i) => { automix-set-length(i); }
                automix-set-style(i) => { automix-set-style(i); }
                automix-repeat: automix-repeat;
                automix-set-repeat(on) => { automix-set-repeat(on); }
                side-visible: side-panel-visible;
                now-playing: player && NowPlayingUi.open;
            }

            // Footer: on the left, expand the library, leaving just the
            // Player row above it; on the right, show or hide the side panel.
            // Player has its bar instead, so only while analysis runs.
            Rectangle { height: !player || LibraryEdit.analysis-status != "" ? 1px : 0px; }
            Rectangle {
                height: !player || LibraryEdit.analysis-status != "" ? 36px : 0px;
                visible: !player || LibraryEdit.analysis-status != "";
                background: Theme.panel;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    alignment: space-between;
                    FooterButton {
                        y: 5px;
                        lit: library-expanded;
                        tip: library-expanded ? "Shrink Browser" : "Expand Browser";
                        tip-body: "Also from a controller or key: expand_browser";
                        // A screen with an arrow pointing up, or down to fold back.
                        icon: "M 2 4 L 18 4 L 18 16 L 2 16 Z M 10 13 L 10 7 M 7 10 L 10 7 L 13 10";
                        lit-icon: "M 2 4 L 18 4 L 18 16 L 2 16 Z M 10 7 L 10 13 M 7 10 L 10 13 L 13 10";
                        clicked => { library-expanded = !library-expanded; }
                    }
                    // How background analysis is going, with a ✕ that stops it.
                    if LibraryEdit.analysis-status != "": HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: LibraryEdit.analysis-status;
                            color: Theme.text-dim;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            width: 20px;
                            CloseIcon { size: 8px; color: stop-touch.has-hover ? Theme.text : Theme.text-dim; }
                            stop-touch := TouchArea { clicked => { LibraryEdit.cancel-analysis(); } }
                        }
                    }
                    FooterButton {
                        y: 5px;
                        lit: side-panel-visible;
                        // A list.
                        icon: "M 6 5 L 18 5 M 6 10 L 18 10 M 6 15 L 18 15 M 2 5 L 3 5 M 2 10 L 3 10 M 2 15 L 3 15";
                        clicked => { side-panel-visible = !side-panel-visible; }
                    }
                }
            }

            // Player: one bar along the bottom, as in music players: what is
            // playing, the transport and the queue button.
            Rectangle { height: player ? 1px : 0px; }
            player-bar := PlayerBar {
                height: player ? 104px : 0px;
                visible: player;
                decks: decks;
                live: player-deck;
                mini-player => { mini-player(); }
                mixing-into: automix-into;
                automix-on: automix-on;
                automix-status: automix-status;
                automix-next: automix-next;
                automix-next-in: automix-next-in;
                queue-has-tracks: automix-queued > 0;
                queue-shown: side-panel-visible && side-tab == 0;
                automix-toggle => { automix-toggle(); }
                automix-cut-now => { automix-cut-now(); }
                toggle-queue => {
                    if side-panel-visible && side-tab != 0 {
                        side-tab = 0;
                    } else {
                        side-panel-visible = !side-panel-visible;
                        side-tab = 0;
                    }
                }
            }
        }

        // The grip on the line under the waveforms, to make them taller
        // or shorter; over everything, so it can be grabbed from just
        // below the line too. While dragging, the waveforms take its height.
        wave-grip := WaveHeightGrip {
            visible: waveforms.visible;
            x: waveforms.absolute-position.x - keys.absolute-position.x;
            y: 0;
            width: waveforms.width;
            height: parent.height;
            strip-top: waveforms.absolute-position.y - keys.absolute-position.y;
            strip-height: waveforms.height;
            heights: strip-heights;
            fits: wave-fits;
            shown: wave-level;
        }

        if update-version != "": Rectangle {
            x: root.width - self.width - 16px;
            y: 64px;
            width: update-row.preferred-width;
            height: 40px;
            background: Theme.panel-raised;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.lilac;
            drop-shadow-blur: 12px;
            drop-shadow-color: Theme.s-000000a0;
            update-row := HorizontalLayout {
                padding-left: 14px;
                padding-right: update-status == "" ? 6px : 14px;
                spacing: 12px;
                Text {
                    text: "openDJ " + update-version + " is available";
                    color: Theme.text;
                    font-size: 13px;
                    vertical-alignment: center;
                }
                if update-status != "": Text {
                    text: update-status;
                    color: Theme.text-dim;
                    font-size: 13px;
                    vertical-alignment: center;
                }
                if update-status == "": VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: action-text.preferred-width + 22px;
                        height: 26px;
                        background: action-touch.has-hover ? Theme.lilac.brighter(0.15) : Theme.lilac;
                        border-radius: 13px;
                        action-text := Text {
                            text: update-action;
                            color: #000000;
                            font-size: 12px;
                            font-weight: 600;
                        }
                        action-touch := TouchArea { clicked => { update-download(); } }
                    }
                }
                if update-status == "": Rectangle {
                    width: 24px;
                    CloseIcon { size: 9px; color: dismiss-touch.has-hover ? Theme.text : Theme.text-dim; }
                    dismiss-touch := TouchArea { clicked => { update-dismiss(); } }
                }
            }
        }

        if alert != "": Rectangle {
            x: (root.width - self.width) / 2;
            y: 64px;
            width: min(560px, root.width - 40px);
            height: alert-text.preferred-height + 24px;
            background: Theme.panel-raised;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.lilac;
            drop-shadow-blur: 12px;
            drop-shadow-color: Theme.s-000000a0;
            alert-text := Text {
                x: 14px;
                width: parent.width - 28px;
                text: alert;
                color: Theme.text;
                font-size: 13px;
                wrap: word-wrap;
                vertical-alignment: center;
            }
            TouchArea { clicked => { alert = ""; } }
        }

        // Player's search results, under the box in the top bar. A click
        // anywhere else closes them; the wheel scrolls only the results.
        if player && QuickSearch.open && QuickSearch.text != "": TouchArea {
            y: 52px;
            height: root.height - 52px;
            clicked => { QuickSearch.open = false; }
            scroll-event(e) => { accept }
        }
        if player && QuickSearch.open && QuickSearch.text != "": QuickResults {
            x: (root.width - self.width) / 2;
            y: 48px;
            max-list-height: root.height - 48px - 60px;
        }

        if Tour.offer && Tour.mode == 0 && update-version == "": TourOffer {
            x: (root.width - self.width) / 2;
            y: 64px;
        }

        // A lesson's tip, over the app but under the dialogs it may open.
        if Tour.mode == 2: TourTip { width: root.width; height: root.height; }

        HoverTipView { width: root.width; height: root.height; }

        // Map mode: a lilac edge round the window (it takes no clicks) and
        // the bar.
        if MapMode.active: Rectangle {
            border-width: 3px;
            border-color: Theme.lilac;
        }
        if MapMode.active: MapBar {
            x: (root.width - self.width) / 2;
            y: 58px;
        }

        // Under Settings and the Controller Editor, which it can open.
        if Tour.mode == 1: TourSetupDialog {
            width: root.width;
            height: root.height;
        }

        // Inside the shortcuts' scope, so Esc reaches it from the search box.
        if Preferences.open: PreferencesOverlay {
            width: root.width;
            height: root.height;
            init => { self.focus-search(); }
        }
        if ControllerEditor.open: ControllerEditorOverlay {
            width: root.width;
            height: root.height;
        }
        if UsbExport.open: UsbExportDialog {
            width: root.width;
            height: root.height;
        }
    }
}
