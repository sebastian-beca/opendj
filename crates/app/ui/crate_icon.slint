// A crate's icon, as the sidebar and the filter bar's Crates list draw it:
// an open box with its slats, or the icon the DJ picked, in its color.
import { Theme } from "theme.slint";

export global CrateColors {
    // Colors a crate can have, as the track menu offers for tracks: red,
    // orange, yellow, green, cyan, blue, purple, pink.
    out property <[color]> colors: [#ff3b30, #ff9500, #ffcc00, #34c759, #5ac8fa, #007aff, #af52de, #ff2d55];
}

export component CrateIcon inherits Path {
    // 0 = crate, then star, heart, flame, bolt, moon, sun, leaf
    // (LIST_ICONS in the library).
    in property <int> icon;
    // An index into CrateColors.colors; -1 for none.
    in property <int> tint: -1;
    width: 18px;
    height: 18px;
    viewbox-width: 18;
    viewbox-height: 18;
    stroke: tint >= 0 ? CrateColors.colors[tint] : Theme.text;
    stroke-width: 1.5px;
    fill: transparent;
    commands: icon == 1 ? "M 9 2 L 11.1 6.6 L 16 7.1 L 12.3 10.4 L 13.4 15.3 L 9 12.8 L 4.6 15.3 L 5.7 10.4 L 2 7.1 L 6.9 6.6 Z"
        : icon == 2 ? "M 9 15.5 C 3 11.5 1.5 8.5 2.5 5.8 C 3.5 3.2 7 2.8 9 5.5 C 11 2.8 14.5 3.2 15.5 5.8 C 16.5 8.5 15 11.5 9 15.5 Z"
        : icon == 3 ? "M 9 16 C 5.5 16 3.5 13.5 3.8 10.5 C 4.1 7.8 6.5 6.5 7 2.5 C 9.5 4.5 10 7 9.5 8.5 C 10.8 7.8 11.5 6.8 11.7 5.6 C 13.6 7.3 14.6 9.3 14.3 11.4 C 13.9 14.2 12 16 9 16 Z"
        : icon == 4 ? "M 10.5 1.5 L 3.5 10 L 8.5 10 L 7.5 16.5 L 14.5 8 L 9.5 8 Z"
        : icon == 5 ? "M 14.5 11.5 A 6.5 6.5 0 1 1 7 2.8 A 5 5 0 0 0 14.5 11.5 Z"
        : icon == 6 ? "M 9 6 A 3 3 0 1 1 8.99 6 Z M 9 1.5 L 9 3.5 M 9 14.5 L 9 16.5 M 1.5 9 L 3.5 9 M 14.5 9 L 16.5 9 M 3.7 3.7 L 5.1 5.1 M 12.9 12.9 L 14.3 14.3 M 3.7 14.3 L 5.1 12.9 M 12.9 5.1 L 14.3 3.7"
        : icon == 7 ? "M 3 15 C 3 8 7 3 15.5 2.5 C 15.5 10 11 15 3 15 Z M 3 15 L 10 8"
        : "M 2 5 L 16 5 L 16 15 L 2 15 Z M 2 8.5 L 16 8.5 M 2 11.8 L 16 11.8";
}
